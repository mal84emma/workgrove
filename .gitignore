*.bak
.DS_Store

# Machine-local overrides (~/.zshrc.local, ~/.gitconfig.local, ~/.zshenv.local).
*.local

# Worktrees that wt makes inside this repo. ~/.gitignore_global lists them too,
# but install.sh does not overwrite an excludesFile that you already have. So a
# clone cannot depend on ~/.gitignore_global.
.worktrees/
.claude/worktrees/

# Temporary and backup files.
tmp/
*/tmp/

# The machine-local copies that install.sh makes from the .base templates. Only
# the templates are versioned.
home/.claude/settings.json
home/.claude.json
home/.codex/config.toml
home/.codex/hooks.json

# Credentials and environment files.
auth.json
credentials.json
.netrc
.env
.env.*

# Private keys.
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*

# A real ssh config. The repo ships docs/ssh-config.example instead.
home/.ssh/config
