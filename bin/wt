#!/usr/bin/env bash
# wt — task worktrees for coding agents (git worktree + cmux row + VS Code on demand).
#
# One task is one worktree at <repo>/.worktrees/<name> on branch wt/<name>.
# Every command is safe to run from the main checkout or from inside any worktree.
#
# Usage:
#   Use -- to end options. Give valued long options as --option=value or --option value.
#   Use wt <command> -h for that command's help.
#   wt new  [name] [-p|--prompt TEXT] [--prompt-stdin] [-b|--base REF] [--head]
#           [-a|--agent claude|codex|none] [-m|--model MODEL] [--no-workspace] [-r|--repo PATH]
#                                                             create a worktree and a cmux row that runs `wt run`.
#                                                             --no-workspace leaves the worktree ready for `wt attach`
#   wt run  <name> [-r PATH]                                  run the worktree's agent with its brief (cmux runs this)
#   wt list [--all] [--json] [-r PATH]                        list worktrees (--all: every repo in $WT_REPOS_DIR)
#                                                             --json prints task status for scripts.
#   wt show <name> [--diff|--json] [-r PATH]                   show a status summary. --diff also opens a cmux diff pane
#                                                             --json prints task status for scripts.
#   wt open [name] [-r PATH]                                  open a worktree in VS Code (default: the one you are in)
#   wt diff <name> [-r PATH]                                  = wt show <name> --diff
#   wt attach <name> [-a AGENT] [-p TEXT] [-r PATH]           open a cmux row for an existing worktree
#   wt sync <name> [--merge] [-r PATH]                        rebase (default) or merge the worktree branch onto its base
#   wt pr <name> [--draft] [-r PATH]                          push the branch and open a GitHub pull request (with gh)
#   wt rm <name> [--force] [--keep-branch] [--discard-commits] [-r PATH]
#                                                             remove a worktree. To protect work, rm refuses if it finds
#                                                             any of these:
#                                                             - uncommitted changes
#                                                             - commits on the branch that are not merged and are not
#                                                               still on a remote. "Merged" means an ancestor of the
#                                                               base, or a squash merge whose changes are all in the base
#                                                             - a base ref that rm cannot compare the branch with
#                                                               (a deleted ref, or a literal HEAD from an older wt)
#                                                             - a HEAD that is not that branch
#                                                             - an edited or newly created .wt-include file
#                                                             --force waives all of these refusals.
#                                                             --discard-commits waives only the commit refusal
#                                                             (for a squash that the base later edited or reverted).
#                                                             When rm runs in the task's own VM tmux session, it asks
#                                                             the Mac to close the task's row and to stop that session
#                                                             after removal
#   wt prune [--dry-run] [-r PATH]                           remove worktrees whose branch is merged (by ancestry or
#                                                             as a squash) and whose tree is clean
#   wt repos [<name>] [--porcelain|--table]                   list every git repo in $WT_REPOS_DIR.
#                                                             On a terminal: a table of name, task count and location.
#                                                             Piped: "<name><tab><path>" per repo.
#                                                             With a name or path: print only that repo's path
#   wt setup --root PATH [--storage volume|os-disk] [--mount PATH]
#           [--source URL] [--revision COMMIT] [--git-identity FILE]
#           [--persist-agents] [--with-tmux-conf] [--restore-only]
#           [--claude-args-json JSON] [--codex-args-json JSON]
#                                                             prepare a host with -H; see docs/remote-setup.md
#                                                             --trust-personal-volume accepts relaxed mode checks for one personal volume
#                                                             --strict-permissions removes a saved permission exception after strict checks pass
#   wt doctor [--record DIR]                                check cmux contracts; save redacted fixtures below DIR
#   wt doctor --environment [--root PATH] [--json]           inspect portable readiness; --root or --json also selects it
#   wt hosts [--json]                                         probe SSH aliases for reachability, CPU, RAM and GPUs
#   wt task [--where local|<host>] [-a claude|codex|repo-shell|vm-shell] [-r REPO] [-p TEXT]
#                                                             the task picker: choose where, kind, repo, name and brief,
#                                                             then start the task (on the Mac; needs fzf)
#   wt driver                                                 open (or select) the driver row (@local)
#   wt version                                              print the repository commit and protocol number as JSON
#   wt update [--refresh-config] [--opinionated-config] [--with-*]
#                                                             show what git pull would bring in. After you confirm,
#                                                             wt pulls this repo and re-runs install.sh
#                                                             Portable hosts accept only --refresh-config and --with-tmux-conf.
#   wt path <name> [-r PATH]
#   wt current
#   wt help
#
#   @WT_REMOTE_USAGE@
#                                                             run wt on that VM over ssh. The cmux row stays local.
#                                                             show, rm, path, open and attach need -r.
#                                                             new --no-workspace leaves the VM task unstarted.
#                                                             A plain attach starts it later with its saved brief.
#                                                             attach reattaches when it
#                                                             confirms the task's detached tmux session and the row's
#                                                             shell prompt.
#                                                             For an attached task row, attach restores tmux's mouse,
#                                                             focus, paste and extended-key terminal modes.
#                                                             Otherwise, use --reattach.
#                                                             --restart-agent starts over.
#                                                             With -H, attach rejects -a/--agent and -p/--prompt.
#                                                             Direct attach rejects --reattach and --restart-agent.
#                                                             Direct attach can run on the Mac or inside a VM.
#                                                             update asks you to confirm here, so run it from a terminal
#
# Where it runs: on the Mac, wt drives cmux directly. On a VM (see is_remote), wt only prepares worktrees and
# asks the Mac for rows and VS Code windows. It sends these requests through `cmux notify` over the relay socket.
# A VM task's row is a plain `cmux ssh` row whose shell runs tmux_cmd, which creates or takes over that task's
# tmux session.
#
# Identity: a task's cmux row is titled "<name>". Its description (the sidebar's second line) is
# "@<host> · <repo>". <host> is "local" or the VM's alias. The separator is a space, a middle dot (U+00B7)
# and a space. The driver row, a "<repo> shell" row and a VM's "shell" row have the description "@<host>".
# A row that an older wt titled "<repo>:<name>" keeps that title. wt rm, the name check of wt new, and
# wt -H new, attach and rm still find it. Leave a task row's description as wt wrote it: wt finds the row by it.
# The tmux session is "wt-<repo>-<name>". <repo> is the repo basename, with each character outside
# [A-Za-z0-9-] replaced by '-'. Task names match ^[a-z0-9][a-z0-9_-]{0,62}$ (no '.').
#
# Task files (never committed): <repo>/.git/wt/<name>.json    base, created, agent, model, title, session, includes
#                               <repo>/.git/wt/<name>.prompt  the brief, which `wt run` passes to the agent
#                               <repo>/.git/wt/<name>.started marker: once it exists, Claude resumes with -c
#
# Environment / git config:
#   WT_REPOS_DIR        ':'-separated folders that `wt list --all`, `wt repos` and `wt new -r <name>` search for
#                       repos, in order (default ~/Documents/Repositories). If a repo name is in two of these
#                       folders, give that repo as a path
#   WT_HOST             on a VM: this VM's alias in the Mac's ~/.ssh/config (install.sh sets it in ~/.zshenv.local)
#   WT_AGENT            default agent for `wt new`                                              (default claude)
#   WT_AGENT_ARGS       extra agent args. A task's -m model overrides the model options and Claude's --fallback-model here
#   git config wt.dir   per-repo override of the worktree folder name                           (default .worktrees)
#
# Per-repo hooks:
#   .wt-include         gitignore-style patterns of *ignored* files to copy into each new worktree (.env and similar)
#   .wt-setup           an executable that runs inside each new worktree after creation (for example, to install deps)
set -euo pipefail

# The scripts in bin/ need bash 5 or later (README, "Requirements").
# When /bin/bash 3.2 starts this script, use the first Homebrew candidate with version 5 or later.
# WORKGROVE_REEXEC prevents a loop if the candidate changes after the version check.
# This block must use bash 3.2 syntax.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]] && "$bash5" -c '((BASH_VERSINFO[0] >= 5))' >/dev/null 2>&1; then
      export WORKGROVE_REEXEC=1
      exec "$bash5" "$0" "$@"
    fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then
  printf 'wt: needs bash 5 or later, but this is bash %s; install it: brew install bash\n' "$BASH_VERSION" >&2
  exit 1
fi

WG_MACHINE_RESULT=${WT_MACHINE:-}
export -n WG_MACHINE_RESULT
unset WT_MACHINE

# The portable profile contains exports only. Restoration always requires an explicit command.
if [[ -f $HOME/.config/workgrove/env.sh ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workgrove/env.sh" || exit 1
fi

# Load lib/workgrove/common.sh from the repository that holds this script. install.sh links the script into
# ~/.local/bin, so follow the link chain to the real file. macOS readlink has no -f, so take one link at a time,
# as resolve_config_path in bin/azml-ssh-host does. A relative target is read from the link's folder.
wg_path=$0 wg_hops=0
# Given a name with no '/', bash runs the file in the current folder or else the first one on PATH. Do the same.
[[ $wg_path == */* || -e $wg_path ]] || wg_path=$(type -P -- "$wg_path") || true
while [[ -L $wg_path && $wg_hops -lt 32 ]]; do
  wg_hops=$((wg_hops + 1))
  wg_target=$(readlink "$wg_path") || break
  case $wg_target in
    /*) wg_path=$wg_target ;;
    *) case $wg_path in */*) wg_path=${wg_path%/*}/$wg_target ;; *) wg_path=$wg_target ;; esac ;;
  esac
done
case $wg_path in */*) wg_lib=${wg_path%/*}/../lib/workgrove/common.sh ;; *) wg_lib=../lib/workgrove/common.sh ;; esac
unset wg_path wg_hops wg_target
# shellcheck source=lib/workgrove/common.sh
if ! source "$wg_lib" 2>/dev/null; then
  printf 'wt: cannot load %s; reinstall workgrove or check the link to bin/wt\n' "$wg_lib" >&2
  exit 1
fi
# An absolute path, because cmd_run changes folder before it uses WG_LIB_DIR.
case $wg_lib in /*) WG_LIB_DIR=${wg_lib%/*} ;; *) WG_LIB_DIR=$PWD/${wg_lib%/*} ;; esac
unset wg_lib
WG_PREFIX=wt
for wg_module in safety teardown remote recovery hosts picker setup doctor; do
  # ShellCheck checks each module directly; this source path depends on the loop variable.
  # shellcheck source=/dev/null
  if ! source "$WG_LIB_DIR/$wg_module.sh" 2>/dev/null; then
    printf 'wt: cannot load %s/%s.sh; reinstall workgrove or check the link to bin/wt\n' "$WG_LIB_DIR" "$wg_module" >&2
    exit 1
  fi
done
unset wg_module

usage() { wt_usage; }

cmd_help() { usage; }
cmd_diff() {
  [[ $# -gt 0 ]] || die "diff: worktree name required"
  local WT_HELP_COMMAND=diff
  cmd_show --diff "$@"
}

# ---------------------------------------------------------------- commands
cmd_new() {
  local name="" prompt="" stdin_prompt=0 base="" from_head=0 agent="$DEFAULT_AGENT" model="" workspace=1 repo=""
  local -A opts=()
  wt_opts "$(wt_spec new)" opts "$@"
  name=${opts[name]-$name}
  prompt=${opts[prompt]-$prompt}
  stdin_prompt=${opts[stdin_prompt]-$stdin_prompt}
  base=${opts[base]-$base}
  from_head=${opts[from_head]-$from_head}
  agent=${opts[agent]-$agent}
  model=${opts[model]-$model}
  workspace=${opts[workspace]-$workspace}
  repo=${opts[repo]-$repo}
  if [[ $stdin_prompt -eq 1 ]]; then IFS= read -r -d '' prompt || true; fi
  lookup_new_repo "$repo"; need_commits
  name=$(tidy_name "$name")
  [[ -n "$name" ]] || name=$(slugify "$prompt")
  [[ -n "$name" ]] || name="task-$(date +%Y%m%d-%H%M%S)"
  need_name "$name"
  valid_agent "$agent"
  [[ "$agent" != none || -z "$model" ]] || die "new: -m needs an agent (claude or codex)"
  [[ "$agent" != codex || "$model" != *'['* ]] || die "new: [suffix] models are for Claude, not Codex"
  local p b; p=$(wt_path "$name"); b=$(wt_branch "$name")
  [[ -e "$p" ]] && die "worktree '$name' already exists at $p (wt attach $name to open it)"
  git -C "$REPO" show-ref -q --verify "refs/heads/$b" && die "branch $b already exists (kept by wt rm --keep-branch, or by a removal git would not call merged, or left behind by a worktree deleted outside wt); inspect it (git -C $REPO log $b), then delete it (git -C $REPO branch -D $b) or pick another name"
  if [[ -f $REPO/.git/wt/teardown/$name.json ]]; then
    [[ $(jq -r .stage "$REPO/.git/wt/teardown/$name.json") == complete ]] \
      || die "cleanup remains pending for $name; retry wt rm $name before reusing this name"
  fi
  check_identity "$name"
  if [[ $workspace -eq 1 ]] && is_remote; then   # the row request needs the host; fail before anything exists
    wt_host >/dev/null
  fi

  # --head is this checkout's HEAD: its branch name, or its commit when HEAD is detached (mid-rebase, a
  # checked-out tag). Never use the literal "HEAD": it resolves in each worktree to that worktree's own tip.
  # The base would then compare the worktree with itself, and rm and prune would find nothing to lose.
  if [[ $from_head -eq 1 ]]; then
    base=$(git -C "$PWD" symbolic-ref -q --short HEAD 2>/dev/null || git -C "$PWD" rev-parse HEAD 2>/dev/null) \
      || base=$(git -C "$REPO" symbolic-ref -q --short HEAD || git -C "$REPO" rev-parse HEAD)
  fi
  [[ -n "$base" ]] || base=$(default_base)
  if [[ "$base" == origin/* ]]; then
    git -C "$REPO" fetch -q origin "${base#origin/}" 2>/dev/null || warn "fetch of $base failed; using local ref"
  fi
  git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null || die "base ref not found: $base"
  # "HEAD", "@", "HEAD^0", "@{0}" … are all the same thing. Each one re-resolves in every worktree to that
  # worktree's own tip. A base stored in that form would compare the worktree with itself, and rm and prune
  # would find nothing to lose. So canonicalize the base; do not try to block each bad spelling. Only a
  # plain ref name means the same thing in every worktree tomorrow, so keep a ref in its given shorthand
  # (--symbolic-full-name names it). Pin anything else (an expression or a raw sha) to the commit that it
  # means now.
  local sym; sym=$(git -C "$REPO" rev-parse --symbolic-full-name "$base" 2>/dev/null || true)
  # For a detached checkout, --symbolic-full-name prints the bare word HEAD. That word is not a ref, and it is
  # the spelling that this block exists to catch. Only a refs/… answer names the same thing in every worktree.
  case "$sym" in refs/*) ;; *) sym="" ;; esac
  case "$base" in
    "$sym"|"${sym#refs/heads/}"|"${sym#refs/remotes/}"|"${sym#refs/tags/}") ;;
    *) base=$(git -C "$REPO" rev-parse "$base^{commit}") ;;
  esac

  mkdir -p "$(wt_root)"
  git -C "$REPO" worktree add -q -b "$b" "$p" "$base" || die "git worktree add failed"
  # The worktree is now registered. Save its brief, agent and model before the slow copy/setup work.
  # If the SSH channel closes during a hook, attach --restart-agent must still know what to run.
  mkdir -p "$REPO/.git/wt"
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; fi
  meta_set "$name" "base=$base" "metadata_version:=2" "creation_commit=$(git -C "$REPO" rev-parse "$base^{commit}")" \
    "generation=$(printf '%s\n' "$BASHPID-$RANDOM-$(date -u +%s)" | git hash-object --stdin)" "created=$(date -u +%FT%TZ)" "agent=$agent" "model=$model" \
    "title=$(row_title "$name")" "session=$(wt_session "$name" "$REPO")" \
    "includes:=[]" "setup:=[]"
  local landing_ref="$base" landing_remote='' parent_name
  local -A parent_meta=()
  case $base in
    wt/*|refs/heads/wt/*)
      parent_name=${base#refs/heads/}; parent_name=${parent_name#wt/}
      meta_load "$parent_name" parent_meta || true
      landing_ref=${parent_meta[landing_ref]:-${parent_meta[base]-}}
      case $landing_ref in wt/*|refs/heads/wt/*) landing_ref='' ;; esac
      landing_remote=${parent_meta[landing_remote]-}
      ;;
    refs/remotes/*) landing_remote=${base#refs/remotes/}; landing_remote=${landing_remote%%/*} ;;
    */*) if git -C "$REPO" remote | grep -xF "${base%%/*}" >/dev/null; then landing_remote=${base%%/*}; fi ;;
  esac
  if [[ -z $landing_remote && $landing_ref == */* ]] && git -C "$REPO" remote | grep -xF "${landing_ref%%/*}" >/dev/null; then
    landing_remote=${landing_ref%%/*}
  fi
  # Reload this task after reading its parent. Preserve every existing metadata field.
  meta_set "$name" "landing_ref=$landing_ref" "landing_remote=$landing_remote" "parent_generation=${parent_meta[generation]-}"
  local includes; includes=$(copy_includes "$p")
  meta_set "$name" "includes:=$(printf '%s' "$includes" | jq -Rs 'split("\n") | map(select(length > 0))')"
  local setup=""
  if [[ -x "$REPO/.wt-setup" ]]; then
    ( cd "$p" && WT_NAME="$name" WT_REPO="$REPO" "$REPO/.wt-setup" ) || warn ".wt-setup exited non-zero"
    setup=$(setup_dirt "$p")               # recorded even when the hook failed: it may have written part of it
    meta_set "$name" "setup:=$(printf '%s' "$setup" | jq -Rs 'split("\n") | map(select(length > 0))')"
  fi

  printf 'created %s\n  path:   %s\n  branch: %s (from %s)\n  repo:   %s\n  session: %s\n' \
    "$name" "$p" "$b" "$base" "$REPO" "$(wt_session "$name" "$REPO")"
  wt_result new created "$name" "$REPO" "$(wt_session "$name" "$REPO")"
  [[ $workspace -eq 1 ]] || return 0
  if is_remote; then request_row "$name"; else cmux_require open_workspace "$name"; fi   # a VM never starts an agent
  return 0
}

cmd_run() { # run the task's agent here; cmux types this into the row's shell, which stays after the agent exits
  local name="" repo=""
  local -A opts=()
  wt_opts "$(wt_spec run)" opts "$@"
  name=${opts[name]-$name}
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "run: worktree name required (wt run <name> -r <repo>)"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "run"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH"; export PATH ;; esac
  cd "$path"
  local agent model brief="" f rc=0
  meta_require "$name"
  agent=${WT_META[agent]-} model=${WT_META[model]-}
  [[ -n "$agent" ]] || agent="$DEFAULT_AGENT"
  case "$agent" in
    none|shell|"") printf '%s: %s\n  agent:  none — this is your shell\n' "$name" "$path"; return 0 ;;
    claude|codex) ;;
    *) die "unknown agent '$agent' in $(wt_meta "$name")" ;;
  esac
  valid_model "$model" || [[ -z "$model" ]] || die "invalid model '$model' in $(wt_meta "$name")"
  [[ "$agent" != codex || "$model" != *'['* ]] || die "Claude-style model suffix in $(wt_meta "$name") for Codex"
  f=$(wt_prompt "$name")                         # a command substitution would remove the trailing newline
  if [[ -f "$f" ]]; then IFS= read -r -d '' brief <"$f" || true; fi
  local extra=() filtered=() model_arg=() args=() i=0
  local profile_args='[]'
  if [[ $agent == claude ]]; then profile_args=${WT_CLAUDE_ARGS_JSON:-'[]'}
  else profile_args=${WT_CODEX_ARGS_JSON:-'[]'}; fi
  jq -e 'type == "array" and all(.[]; type == "string" and (length > 0 and (explode | all(. >= 32))))' \
    <<<"$profile_args" >/dev/null || die 'invalid profile agent arguments'
  mapfile -t extra < <(jq -r '.[]' <<<"$profile_args")
  if [[ -n "${WT_AGENT_ARGS:-}" ]]; then
    # shellcheck disable=SC2206   # word splitting is the point
    extra+=($WT_AGENT_ARGS)
  fi
  if [[ -n "$model" ]]; then
    # Remove machine-wide model choices and Claude's fallback before adding this task's choice. Then neither
    # CLI has to decide which repeated model flag wins, even on a Claude -c resume.
    while [[ $i -lt ${#extra[@]} ]]; do
      case "${extra[$i]}" in
        -m|--model|--fallback-model) i=$((i + 2)); continue ;;
        -m?*|--model=*|--fallback-model=*) i=$((i + 1)); continue ;;
        -c|--config)
          if [[ "$agent" == codex && "${extra[$((i + 1))]:-}" == model=* ]]; then i=$((i + 2)); continue; fi ;;
        -cmodel=*|--config=model=*)
          if [[ "$agent" == codex ]]; then i=$((i + 1)); continue; fi ;;
      esac
      filtered+=("${extra[$i]}"); i=$((i + 1))
    done
    extra=("${filtered[@]}")
    if [[ "$agent" == claude ]]; then model_arg=(--model "$model"); else model_arg=(-m "$model"); fi
  fi
  if [[ "$agent" == claude && -e "$(wt_started "$name")" ]]; then
    args=(-c)                                    # resume this worktree's last conversation
  elif [[ -n "$brief" ]]; then
    args=(-- "$brief")                           # Codex always restarts from the brief
  fi
  if [[ $agent == codex ]] && ! is_remote; then
    "$agent" --help 2>/dev/null | grep -- '--no-daemon' >/dev/null \
      || die 'Codex lacks --no-daemon; update Codex before launching a local task'
    local owned_mode=0
    for f in "${extra[@]}"; do
      case $f in
        --remote|--remote=*) die 'local task Codex requires a task-owned runtime; --remote is unsupported' ;;
        --no-daemon) owned_mode=1 ;;
      esac
    done
    [[ $owned_mode == 1 ]] || extra+=(--no-daemon)
    if [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
      local launch_state launch_pid=$BASHPID
      launch_state=$(cmux_call top --workspace "$CMUX_WORKSPACE_ID" --json) || die 'cannot validate Codex launch row'
      printf '%s' "$launch_state" | jq -e --arg id "$CMUX_WORKSPACE_ID" --argjson pid "$launch_pid" '
        any(.windows[].workspaces[]; .id == $id and (.resources.pids | index($pid)) != null)' >/dev/null \
        || die 'Codex launch row does not contain this wt run process; reopen the task row'
    fi
    for f in CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_SOCKET_PATH; do
      if [[ -n ${!f:-} ]]; then
        extra+=(-c "shell_environment_policy.set.$f=$(printf '%s' "${!f}" | jq -Rs .)")
      fi
    done
  fi
  : > "$(wt_started "$name")"
  # cmux 0.65 shows a VM agent's state through the cmux-tui hooks. Give them this row's terminal at each hook.
  # lib/workgrove/cmux-tui-hook.sh explains why the pane's own environment names the wrong terminal.
  if is_remote && [[ -n ${TMUX:-} && -x $WG_LIB_DIR/cmux-tui-hook.sh ]]; then
    WT_CMUX_TUI_HOOK=$(cmux_tui_agent_helper)
    export WT_CMUX_TUI_HOOK
    export CMUX_TUI_HOOK="$WG_LIB_DIR/cmux-tui-hook.sh"
  fi
  "$agent" "${model_arg[@]}" "${extra[@]}" "${args[@]}" || rc=$?
  [[ $rc -eq 0 ]] || warn "$agent exited with status $rc"
  return "$rc"
}

cmd_list() {
  local all=0 repo="" format=human r n nn br base ah be di last mg
  local -A opts=() status=()
  wt_opts "$(wt_spec list)" opts "$@"
  all=${opts[all]-$all}
  repo=${opts[repo]-$repo}
  format=${opts[format]-$format}
  local repos=() records=()
  if [[ $all -eq 1 ]]; then
    need_repos_dir
    mapfile -t repos < <(repo_dirs)
  else
    resolve_repo "$repo"; repos=("$REPO")
  fi
  for r in "${repos[@]}"; do
    set_repo "$r" || continue
    local names; names=$(list_names); [[ -n "$names" ]] || continue
    if [[ $format == human ]]; then
      printf '\n%s  (%s)\n' "$(basename "$REPO")" "$REPO"
      printf '  %-28s %-26s %-16s %6s %6s %6s %6s  %s\n' NAME BRANCH BASE AHEAD BEHIND MERGED DIRTY LAST
    fi
    while IFS= read -r n; do
      wt_status "$n" status
      if [[ $format == json ]]; then
        wt_status_args status records
      else
        nn=${status[name]} br=${status[human_branch]} base=${status[base]}
        ah=${status[ahead]} be=${status[behind]} di=${status[human_dirty]} last=${status[last]} mg=${status[merged]}
        printf '  %-28s %-26s %-16s %6s %6s %6s %6s  %s\n' "$nn" "$br" "$base" "$ah" "$be" "$mg" "$di" "$last"
      fi
    done <<<"$names"
  done
  if [[ $format == json ]]; then wt_status_json list "${records[@]}"; fi
  return 0
}

cmd_show() {
  local name="" diff=0 repo="" format=human
  local -A opts=() status=()
  wt_opts "$(wt_spec show)" opts "$@"
  name=${opts[name]-$name}
  diff=${opts[diff]-$diff}
  format=${opts[format]-$format}
  [[ $format != json || $diff == 0 ]] || die "show: --json and --diff cannot be combined"
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "show: worktree name required"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "show"
  wt_status "$name" status
  if [[ $format == json ]]; then
    local records=()
    status[title]=$(task_title "$name" "${WT_META[title]-}")
    status[task]=$(prompt_line "$name") status[model]=${WT_META[model]-}
    wt_status_args status records show
    wt_status_json show "${records[@]}"
    return
  fi
  local nn br base ah be di last mg why title model
  nn=${status[name]} br=${status[human_branch]} base=${status[base]}
  ah=${status[ahead]} be=${status[behind]} di=${status[human_dirty]} last=${status[last]} mg=${status[merged]} why=${status[why]}
  title=$(task_title "$name" "${WT_META[title]-}") model=${WT_META[model]-}
  case "$mg" in   # wt list's MERGED value, with room here for the reason behind it
    squash) mg="squash (every change on $br is in $base, though no commit is)" ;;
    no)     mg="no ($why)" ;;
    '?')    mg="? (no base to compare with)" ;;
  esac
  printf '%s\n  path:    %s\n  repo:    %s\n  branch:  %s  (+%s / -%s vs %s)\n  merged:  %s\n  row:     %s\n  task:    %s\n  dirty:   %s file(s)\n  last:    %s\n' \
    "$nn" "$path" "$REPO" "$br" "$ah" "$be" "$base" "$mg" "$title $(row_tag "" "$REPO")" "$(prompt_line "$name")" "$di" "$last"
  printf '  comparison: %s (cached; removal refreshes and validates)\n' "$(jq -r .ref <<<"${status[comparison]}")"
  [[ -z "$model" ]] || printf '  model:   %s\n' "$model"
  local state=''
  local -A session_status=()
  if is_remote; then
    session_state "$name" session_status
    state=${session_status[state]}
    printf '  session: %s (%s)\n' "$(wt_session "$name" "$REPO")" "$state"
  fi
  local facts='{}' agent=false attached=false started=false
  if [[ -n ${WG_MACHINE_RESULT:-} ]]; then
    if is_remote; then
      agent=${session_status[agent]} attached=${session_status[attached]}
    fi
    [[ ! -e "$(wt_started "$name")" ]] || started=true
    facts=$(jq -cn --argjson agent "$agent" --argjson attached "$attached" --argjson started "$started" \
      '{agent:$agent,attached:$attached,started:$started}')
  fi
  wt_result show found "$name" "$REPO" "$(wt_session "$name" "$REPO")" "$state" "$facts"
  printf '\n--- commits vs %s\n' "$base"; git -C "$path" --no-pager log --oneline --max-count=20 "$base..HEAD" 2>/dev/null
  printf '\n--- diff --stat vs %s (committed)\n' "$base"; git -C "$path" diff --stat "$base...HEAD" 2>/dev/null | tail -15
  printf '\n--- working tree\n'; git -C "$path" status --short 2>/dev/null | sed -n '1,20p'
  if [[ $diff -eq 1 ]]; then
    cmux_ok || die "cmux is not running"
    cmux_diff --branch --repo "$path" --base "$base" --layout split --title "$name vs $base" --focus true >/dev/null \
      || { local rc=$?; warn "$CMUX_ERROR"; return "$rc"; }
    printf 'opened cmux diff pane\n'
  fi
}

cmd_open() { # wt open [name] [-r PATH] — no name: the worktree holding $PWD
  local name="" repo=""
  local -A opts=()
  wt_opts "$(wt_spec open)" opts "$@"
  name=${opts[name]-$name}
  repo=${opts[repo]-$repo}
  if [[ -n "$name" ]]; then
    resolve_repo "$repo"
  else
    local root
    set_repo "$PWD" || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)
    [[ "$root" == "$(wt_root)/"* ]] || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    name=${root#"$(wt_root)/"}
  fi
  local path branch; require_wt "$name" path branch "open"
  open_worktree "$name" "$path"
}

cmd_attach() {
  local name="" agent="" prompt="" repo=""
  local -A opts=()
  wt_opts "$(wt_spec attach)" opts "$@"
  name=${opts[name]-$name}
  agent=${opts[agent]-$agent}
  prompt=${opts[prompt]-$prompt}
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "attach: worktree name required"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "attach"
  meta_require "$name"
  if [[ -n "$agent" ]]; then
    valid_agent "$agent"
    local old_agent; old_agent=${WT_META[agent]-}
    [[ -n "$old_agent" ]] || old_agent="$DEFAULT_AGENT"
    if [[ "$agent" != "$old_agent" ]]; then
      meta_set "$name" "agent=$agent" "model="
      rm -f "$(wt_started "$name")"
    else
      meta_set "$name" "agent=$agent"
    fi
  fi
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; rm -f "$(wt_started "$name")"; fi
  if is_remote; then request_row "$name"; else cmux_require open_workspace "$name"; fi
}

cmd_sync() {
  local name="" merge=0 repo=""
  local -A opts=()
  wt_opts "$(wt_spec sync)" opts "$@"
  name=${opts[name]-$name}
  merge=${opts[merge]-$merge}
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "sync: worktree name required"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "sync"
  meta_require "$name"
  local base; base=${WT_META[base]-}; [[ -n "$base" ]] || base=$(default_base)
  [[ "$base" == origin/* ]] && git -C "$REPO" fetch -q origin "${base#origin/}"
  [[ -z "$(git -C "$path" status --porcelain)" ]] || die "worktree has uncommitted changes; commit or stash first"
  if [[ $merge -eq 1 ]]; then git -C "$path" merge --no-edit "$base"; else git -C "$path" rebase "$base"; fi
  printf 'synced %s onto %s\n' "$name" "$base"
}

cmd_pr() {
  local name="" draft=() repo=""
  local -A opts=()
  wt_opts "$(wt_spec pr)" opts "$@"
  name=${opts[name]-$name}
  repo=${opts[repo]-$repo}
  [[ ${opts[draft_flag]:-0} == 0 ]] || draft=(--draft)
  [[ -n "$name" ]] || die "pr: worktree name required"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "pr"; have gh || die "gh not installed"
  [[ -z "$(git -C "$path" status --porcelain)" ]] || die "worktree has uncommitted changes; commit first"
  meta_require "$name"
  git -C "$path" push -u origin "$branch"
  local base; base=${WT_META[base]-}; [[ -n "$base" ]] || base=$(default_base)
  ( cd "$path" && gh pr create --fill --base "${base#origin/}" "${draft[@]}" )
}

cmd_rm() {
  local discard_commits=0
  local name="" force=0 keep=0 repo="" self_remote=0 host="" session="" title="" native=0
  local -A opts=()
  wt_opts "$(wt_spec rm)" opts "$@"
  name=${opts[name]-$name}
  force=${opts[force]-$force}
  keep=${opts[keep]-$keep}
  discard_commits=${opts[discard_commits]-$discard_commits}
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "rm: worktree name required"
  resolve_repo "$repo"; local path branch
  valid_name "$name" || die "invalid worktree name: $name"
  [[ -z "${CODEX_SANDBOX:-}" ]] || die 'the Codex sandbox can block cmux or tmux cleanup; rerun this command with escalation'
  teardown_lock "$name" "$@"
  WT_TEARDOWN_FILE="$REPO/.git/wt/teardown/$name.json"
  if [[ ! -d $(wt_path "$name") && -f $WT_TEARDOWN_FILE ]]; then
    WT_TEARDOWN_JSON=$(cat "$WT_TEARDOWN_FILE")
    jq -e --arg repo "$REPO" --arg name "$name" --arg path "$(wt_path "$name")" '.repo == $repo and .name == $name and .path == $path and .branch == ("wt/" + $name) and (.head | test("^[0-9a-f]{40}([0-9a-f]{24})?$")) and all(.keep,.native,.remote; IN("0","1")) and (.stage | IN("prepared","worktree_removed","git_removed","close_requested","complete"))' <<<"$WT_TEARDOWN_JSON" >/dev/null \
      || die 'invalid teardown receipt'
    if [[ $(jq -r .stage <<<"$WT_TEARDOWN_JSON") != complete || ! -f $(wt_meta "$name") ]]; then
      if [[ $keep == 1 ]]; then
        WT_TEARDOWN_JSON=$(jq -c '.keep="1"' <<<"$WT_TEARDOWN_JSON")
        teardown_save "$(jq -r .stage <<<"$WT_TEARDOWN_JSON")"
      fi
      teardown_finish; return
    fi
  fi
  require_wt "$name" path branch "rm"
  teardown_preflight "$path"
  local verified_head verified_base='' proof='' generation
  verified_head=$(git -C "$REPO" rev-parse --verify "refs/heads/$branch") || die 'cannot resolve task head'
  local here there; here=$(pwd -P); there=$(cd "$path" 2>/dev/null && pwd -P) || there="$path"   # a symlinked cwd is still inside
  [[ "$here" == "$there" || "$here" == "$there/"* ]] && die "you are inside $name; cd out first (e.g. cd $REPO)"
  meta_require "$name"
  # shellcheck disable=SC2034
  local base landed_why; base=${WT_META[base]-}; [[ -n "$base" ]] || base=$(default_base)
  if [[ $force -eq 0 ]]; then
    local reasons=()
    rm_reasons "$name" "$path" "$branch" "$base" reasons "$discard_commits"
    if [[ ${#reasons[@]} -gt 0 ]]; then
      printf 'wt: refusing to remove %s: %s\n' "$name" "$(IFS=';'; echo "${reasons[*]}")" >&2
      printf 'wt: inspect with: wt show %s — then push/merge, check the branch out again or copy the file back, or re-run with --force to discard.\n' "$name" >&2
      case "${reasons[*]}" in *' not merged into '*) printf 'wt: --discard-commits waives only the commit reason (a squash merge the base later edited or reverted); the other checks stay.\n' >&2 ;; esac
      exit 3
    fi
  fi
  if [[ $force == 0 ]]; then base=${WT_RM_BASE:-$base}; proof=${WT_RM_PROOF:-discard}; else proof=discard; fi
  verified_base=$(git -C "$REPO" rev-parse -q --verify "$base^{commit}" 2>/dev/null || true)
  if is_remote && [[ -n ${TMUX:-} ]]; then
    local current
    session=$(wt_session "$name" "$REPO")
    [[ ${TMUX_PANE:-} =~ ^%[0-9]+$ ]] || die 'cannot identify the caller tmux pane; kept the worktree'
    current=$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>&1) \
      || die "cannot read the current tmux session: $current; rerun this command with escalation if a sandbox blocks the socket"
    [[ -n "$current" ]] || die "cannot read the current tmux session: tmux returned no session name"
    if [[ "$current" == "$session" ]]; then
      local pane_pid
      pane_pid=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}') || die 'cannot identify tmux pane process'
      process_descends "$BASHPID" "$pane_pid" || die 'cannot verify caller tmux ownership; kept the worktree'
      local ownership_rc=0
      tmux_self_ownership "$session" || ownership_rc=$?
      case $ownership_rc in
        0) self_remote=1 ;;
        1) die 'another agent is running in this tmux session; kept the worktree' ;;
        *) die 'cannot verify exclusive agent ownership in this tmux session; kept the worktree' ;;
      esac
    fi
  fi
  local row="" self=""
  title=$(task_title "$name")
  if is_remote; then
    [[ -n "$session" ]] || session=$(wt_session "$name" "$REPO")
    if [[ $self_remote -eq 0 ]]; then
      local agent_rc=0
      tmux_agent "$session" || agent_rc=$?
      case $agent_rc in
        0) die "another agent is running in tmux session $session; kept the worktree" ;;
        1) ;;
        *) die "cannot check the agent in tmux session $session; kept the worktree" ;;
      esac
    fi
    if [[ $self_remote -eq 1 && $(tmux show-environment -t "=$session" WT_CMUX_CLOSE_ON_EXIT 2>/dev/null) == WT_CMUX_CLOSE_ON_EXIT=1 ]]; then
      native=1
    fi
  else
    cmux_require check_row_removal "$title" "$REPO" row self "" "$(wt_path "$name")"
  fi
  if [[ $self_remote -eq 1 && $native -eq 0 ]]; then
    # Check the relay setup only after the reasons above, while the worktree is still intact.
    host=$(wt_host)
    hook_ok_repo || die "cannot request Mac row cleanup for $REPO"
    local _ident=() _tui_socket _tui_terminal
    if ! relay_env _ident _tui_socket _tui_terminal; then
      [[ -z ${CMUX_TUI_SOCKET:-} ]] \
        || die "this row predates native teardown; close and reopen this row on the Mac: wt -H $host attach -r $(shell_join "$REPO") $name, then retry"
      die "cannot find the Mac cmux relay in this session"
    fi
  fi
  local final_reasons=()
  if [[ $force -eq 0 ]]; then
    # shellcheck disable=SC2034  # fetch_base consumes this cache entry.
    WT_BASE_FETCHES["${base#refs/remotes/}"]=''
    rm_reasons "$name" "$path" "$branch" "$base" final_reasons "$discard_commits"
    ((${#final_reasons[@]} == 0)) || die "work changed during teardown: ${final_reasons[*]}"
  fi
  [[ $(git -C "$REPO" rev-parse --verify "refs/heads/$branch") == "$verified_head" ]] || die 'task head changed during teardown'
  [[ $(git -C "$REPO" rev-parse -q --verify "$base^{commit}" 2>/dev/null || true) == "$verified_base" ]] || die 'comparison base changed during teardown'
  generation=${WT_META[generation]:-$verified_head}
  if [[ $proof == published || $base =~ ^[0-9a-f]{40,64}$ ]]; then
    local retained=''
    retained=$(git -C "$REPO" rev-parse -q --verify "refs/wt/preserved/$generation" 2>/dev/null || true)
    if [[ $retained != "$verified_head" ]]; then
      git -C "$REPO" update-ref "refs/wt/preserved/$generation" "$verified_head" '' || die 'cannot retain preserved work'
    fi
    warn "retained published commits at refs/wt/preserved/$generation"
  fi
  if [[ $self_remote == 1 ]]; then self=remote; fi
  local remote=0; is_remote && remote=1
  WT_TEARDOWN_JSON=$(jq -cn --arg name "$name" --arg repo "$REPO" --arg path "$path" --arg branch "$branch" \
    --arg head "$verified_head" --arg metadata_hash "$(file_hash "$(wt_meta "$name")")" --arg base "$base" --arg base_object "$verified_base" --arg proof "$proof" \
    --arg generation "$generation" --arg row "$row" --arg self "$self" --arg session "$session" \
    --arg title "$title" --arg host "$host" --arg keep "$keep" --arg native "$native" --arg remote "$remote" '$ARGS.named')
  teardown_save prepared
  if [[ $force == 0 ]]; then
    rm_reasons "$name" "$path" "$branch" "$base" final_reasons "$discard_commits"
    ((${#final_reasons[@]} == 0)) || die "work changed after preflight: ${final_reasons[*]}"
  fi
  [[ $(git -C "$REPO" rev-parse --verify "refs/heads/$branch") == "$verified_head" ]] || die 'task head changed after preflight'
  [[ $(git -C "$REPO" rev-parse -q --verify "$base^{commit}" 2>/dev/null || true) == "$verified_base" ]] || die 'comparison base changed after preflight'
  if [[ $self_remote == 1 ]]; then
    tmux_self_ownership "$session" || die 'tmux ownership changed after preflight'
  fi
  if ! is_remote; then
    local final_row='' final_self=''
    cmux_require check_row_removal "$title" "$REPO" final_row final_self '' "$path"
    [[ $final_row == "$row" && $final_self == "$self" ]] || die 'row ownership changed after preflight'
  fi
  if [[ -d $path ]]; then
    git -C "$REPO" worktree remove --force "$path" || die "git worktree remove failed; receipt: $WT_TEARDOWN_FILE"
  else git -C "$REPO" worktree prune || die 'cannot prune missing worktree'; fi
  teardown_save worktree_removed
  teardown_finish
}

cmd_prune() {
  local dry=0 repo=""
  local -A opts=()
  wt_opts "$(wt_spec prune)" opts "$@"
  dry=${opts[dry]-$dry}
  repo=${opts[repo]-$repo}
  resolve_repo "$repo"
  local names n p base why failed=0
  local reasons=()
  names=$(list_names)     # before `git worktree prune`; otherwise a directory deleted by hand loses its
                          # registration here and is never examined, so its branch and metadata stay forever
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    meta_require "$n"
    p=$(wt_path "$n"); base=${WT_META[base]-}; [[ -n "$base" ]] || base=$(default_base)
    rm_reasons "$n" "$p" "$(wt_branch "$n")" "$base" reasons
    why=$(IFS=';'; echo "${reasons[*]}")
    if [[ -n "$why" ]]; then printf 'keep %s (%s)\n' "$n" "$why"                            # dry run included
    elif [[ $dry -eq 1 ]]; then printf 'would remove %s (nothing to lose vs %s)\n' "$n" "$base"
    elif ! ( cd "$REPO" && cmd_rm "$n" ); then printf 'keep %s (removal refused above)\n' "$n"; failed=1; fi
  done <<<"$names"
  git -C "$REPO" worktree prune
  return "$failed"
}

cmd_path() {
  local name="" repo=""
  local -A opts=()
  wt_opts "$(wt_spec path)" opts "$@"
  name=${opts[name]-$name}
  repo=${opts[repo]-$repo}
  [[ -n "$name" ]] || die "path: worktree name required"
  resolve_repo "$repo"; local path branch; require_wt "$name" path branch "path"; printf '%s\n' "$path"
  local facts='{}'
  if [[ -n ${WG_MACHINE_RESULT:-} ]]; then facts=$(jq -cn --arg path "$path" '{path:$path}'); fi
  wt_result path found "$name" "$REPO" "" "" "$facts"
}
# The table dispatcher passes arguments; the picker intentionally passes none.
# shellcheck disable=SC2120
cmd_repos()   { # wt repos [<name>] [--porcelain|--table]. No name: list every repo. Print a table (name, number
                # of task worktrees, location) when stdout is a terminal, or with --table; `wt -H <host> repos`
                # asks a VM for a table that way. Print "<name><tab><path>" per repo (the task picker's two
                # columns) when piped or with --porcelain. A name or path: only that repo's path (also over ssh).
  local mode="" name=""
  local -A opts=()
  wt_opts "$(wt_spec repos)" opts "$@"
  name=${opts[name]-$name}
  mode=${opts[mode]-$mode}
  if [[ -n "$name" ]]; then
    # The Mac's creation preflight needs the same refusal as new before it checks the remote agent.
    if [[ ${WG_NEW_PREFLIGHT:-} == 1 ]]; then lookup_new_repo "$name"; else lookup_repo "$name"; fi
    printf '%s\n' "$REPO"; return 0
  fi
  need_repos_dir
  if [[ -z "$mode" ]]; then if [[ -t 1 ]]; then mode=table; else mode=porcelain; fi; fi
  if [[ "$mode" == porcelain ]]; then repo_dirs | awk -F/ '{printf "%s\t%s\n", $NF, $0}'; return 0; fi
  local d n
  while IFS= read -r d; do                     # "<name><tab><path><tab><tasks>": what repo_menu table lays out
    [[ -n "$d" ]] || continue
    n=0; if set_repo "$d"; then n=$(list_names | grep -c . || true); fi
    printf '%s\t%s\t%s\n' "${d##*/}" "$d" "$n"
  done < <(repo_dirs) | repo_menu table
}
cmd_current() {
  local -A opts=()
  wt_opts "$(wt_spec current)" opts "$@"
  local root common
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  common=$(main_root_of "$PWD") || die "not in a git repo"
  if [[ "$root" == "$common" ]]; then printf 'main checkout: %s (%s)\n' "$root" "$(git branch --show-current)"
  else printf 'worktree: %s\n  branch: %s\n  main:   %s\n' "$root" "$(git branch --show-current)" "$common"; fi
}

# ---------------------------------------------------------------- driver and self-update
cmd_driver() { # the driver session, which starts tasks; its cwd is a repos folder, so `wt new` there needs -r
  # parse the args, do not ignore them: `wt driver -h` once created or selected the row instead of printing usage
  local -A opts=()
  wt_opts "$(wt_spec driver)" opts "$@"
  mac_only driver
  cmux_ok || die "cmux is not running; start cmux, then: wt driver"
  local id out cwd
  id=$(cmux_row_field driver "" id)
  if [[ -n "$id" ]]; then
    cmux_require cmux_select "$id"
    printf 'driver %s (selected)\n' "$(row_tag)"
    return 0
  fi
  need_repos_dir
  cwd=$(repos_entries | sed -n 1p)                                   # the first folder that exists
  out=$(cmux_create --name driver --description "$(row_tag)" --cwd "$cwd" --command claude --focus true 2>&1) \
    || die "cmux workspace create failed: $out"
  printf 'driver %s (created)\n' "$(row_tag)"
}

cmd_version() {
  local -A opts=()
  wt_opts "$(wt_spec version)" opts "$@"
  wt_version
}

cmd_update() { # pull this repo and re-run its installer
  # Forward installer flags. Portable profiles accept only their reinstall parser's flags.
  local pass=()
  local -A opts=()
  local spec
  spec=$(wt_spec update)
  wt_opts "$spec" opts "$@"
  wt_opt_args opts pass
  local dir
  dir=$(cd "$WG_LIB_DIR/../.." && pwd -P)
  # Check before fetching so a refusal leaves the checkout and portable readiness unchanged.
  # shellcheck source=lib/workgrove/vm/python-runtime.sh
  source "$WG_LIB_DIR/vm/python-runtime.sh"
  if ((${#pass[@]})) && wg_has_portable_profile "$dir/.."; then
    local flags flag
    local -a candidates=() accepted=()
    wg_select_python || die "$wg_python_issue"
    flags=$(wg_run_python "$WG_LIB_DIR/portable.py" reinstall-flags) || return 1
    read -r -a candidates <<<"$flags"
    # Probe the update parser in a subshell so rejected flags cannot exit this command.
    for flag in "${candidates[@]}"; do
      if (wt_opts "$spec" opts "$flag") >/dev/null 2>&1; then accepted+=("$flag"); fi
    done
    for flag in "${pass[@]}"; do
      wg_run_python "$WG_LIB_DIR/portable.py" reinstall-flags -- "$flag" >/dev/null 2>&1 \
        || die "update: portable host refuses $flag; accepted flags: ${accepted[*]}"
    done
  fi
  [[ -d "$dir/.git" ]] || die "$dir is not a git clone; replace the seed: mv $dir $dir.seed && git clone https://github.com/mal84emma/workgrove $dir"
  local ans
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 \
    || die "$dir has no upstream branch; set one: git -C $dir branch --set-upstream-to origin/main"
  wt_update_record before local "$(wt_version)"
  git -C "$dir" fetch --quiet || die "git fetch failed in $dir"
  # Test containment, not equality. A clone that is only ahead (a local commit, normal on the machine where
  # you edit bin/wt) has nothing incoming. Comparing tips would show your own work as an incoming deletion.
  if git -C "$dir" merge-base --is-ancestor '@{u}' HEAD 2>/dev/null; then
    printf 'Already up to date.\n'
  else                                                     # `wt update` runs install.sh, so show the code first
    printf 'incoming commits:\n'; git -C "$dir" --no-pager log --oneline 'HEAD..@{u}'
    printf '\nfiles changed:\n';  git -C "$dir" --no-pager diff --stat 'HEAD..@{u}'
    [[ -t 0 ]] || die "update: refusing to apply these commits unattended; run wt update from an interactive terminal (for a VM, wt -H <vm> update from one, or a shell on the VM)"
    printf '\n'
    read -r -p "apply them and run $dir/install.sh? [y/N] " ans || ans=""
    [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]] || die "update: cancelled"
    git -C "$dir" merge --ff-only '@{u}'
  fi
  wt_update_record after local "$(bash "$dir/bin/wt" version)"
  bash "$dir/install.sh" "${pass[@]}"
}

cmd_host() { # wt -H <host> <sub> … — a stateless ssh passthrough; the Mac caches nothing about VMs
  local host="$1" sub="${2:-}" args=(); shift 2
  valid_host "$host" || die "invalid host '$host' (an ssh alias: letters, digits, '.', '_' and '-')"
  wt_command "$sub" && [[ $WT_REMOTE != local ]] \
    || die "wt -H: '$sub' does not run remotely ($(wt_remote_commands ' '))"
  sub=$WT_COMMAND
  wt_remote_args "$host" "$sub" args "$@"
  set -- "${args[@]}"
  case "$WT_REMOTE" in
    forward) remote_wt "$host" "$sub" "$@" ;;
    'forward with -r') need_r "$host" "$sub" "$@"; remote_wt "$host" "$sub" "$@" ;;
    host_*) "$WT_REMOTE" "$host" "$@" ;;
  esac
}

cmd_hosts() {
  local format=table records host f pid failed=0 files=() pids=()
  local -A opts=()
  wt_opts "$(wt_spec hosts)" opts "$@"
  format=${opts[format]-$format}
  mac_only hosts
  while IFS= read -r host; do
    f=$(mktemp "${TMPDIR:-/tmp}/wt-host-record.XXXXXX") || die "hosts: could not create a temporary file"
    files+=("$f")
    wt_register_tmpfile "$f"
    (host_record "$host" >"$f") &
    pids+=("$!")
  done < <(ssh_hosts)
  for pid in "${pids[@]}"; do wait "$pid" || failed=1; done
  if [[ $failed -ne 0 ]]; then
    rm -f "${files[@]}"
    die "hosts: one or more probes could not be recorded"
  fi
  records=""
  if [[ ${#files[@]} -gt 0 ]]; then records=$(cat "${files[@]}"); fi
  rm -f "${files[@]}"
  if [[ $format == json ]]; then
    printf '%s\n' "$records" | jq -s '.'
  else
    printf '%s\n' "$records" | jq -sr '
      (["HOST","SSH","CPU","RAM GiB","GPU","ERROR"],
       (.[] | [ .host, .status, (.cpu_logical // "?" | tostring),
         (if .memory_mib == null then "?" else (.memory_mib / 1024 * 10 | round / 10 | tostring) end),
         (if .gpu_status == "none" then "none" elif .gpu_status != "ok" then "unknown"
          elif (.gpus | length) == 0 then "none"
          else (.gpus | map(if .memory_mib == null then "\(.name) (memory unknown)"
                            else "\(.name) (\(.memory_mib) MiB)" end) | join("; ")) end),
         (.error // "") ])) | @tsv' \
      | { if have column; then column -t -s $'\t'; else cat; fi; }
  fi
}

cmd_task() {
  local where="" kind="" repo="" name="" brief="" asked=1 id out
  local args=()
  local -A opts=()
  wt_opts "$(wt_spec task)" opts "$@"
  where=${opts[where]-$where}
  kind=${opts[kind]-$kind}
  repo=${opts[repo]-$repo}
  brief=${opts[brief]-$brief}
  [[ ! -v opts[brief] ]] || asked=0
  mac_only task
  on_exit task_exit
  have fzf || die "fzf not found (brew install fzf)"

  if [[ -z "$where" ]]; then where=$({ printf 'local\n'; ssh_hosts; } | pick where) || die "task: cancelled"; fi
  [[ -n "$where" ]] || die "task: no host picked"
  if [[ "$where" != local ]]; then
    valid_host "$where" || die "task: invalid host '$where' (an ssh alias: letters, digits, '.', '_' and '-')"
    if ! known_host "$where"; then
      warn "cmux will try '$where'; make sure 'ssh $where' works first. Requests from inside that VM (VS Code, new rows) need a Host entry."
    fi
  fi

  if [[ -z "$kind" ]]; then
    kind=$({ printf 'claude\ncodex\nrepo-shell\n'; [[ "$where" == local ]] || printf 'vm-shell\n'; } | pick kind) || die "task: cancelled"
  fi
  case "$kind" in
    claude|codex|repo-shell) ;;
    vm-shell) [[ "$where" != local ]] || die "task: vm-shell needs a VM; for a local shell pick repo-shell" ;;
    *) die "task: unknown kind '$kind' (claude, codex, repo-shell, vm-shell)" ;;
  esac

  if [[ "$kind" != vm-shell && -z "$repo" ]]; then
    local list sel                               # "<name><tab><path>": two folders can hold the same basename,
    if [[ "$where" == local ]]; then             # so the path column, not the name, starts the task
      # shellcheck disable=SC2119
      list=$(cmd_repos) || exit 1                # cmd_repos has already said what is wrong; do not repeat it
      [[ -n "$list" ]] || die "task: no repos in WT_REPOS_DIR ($REPOS_PATH); clone one, or pass -r <path>"
    else
      list=$(remote_wt "$where" repos) || exit 1   # no flag: ssh gives the VM no terminal, so this is the plain form on any wt version
      [[ -n "$list" ]] || die "task: no repos on $where (see: wt -H $where repos)"
    fi
    sel=$(printf '%s\n' "$list" | repo_menu | pick repo --ansi --delimiter $'\t' --with-nth 3 --nth 1,3) \
      || die "task: cancelled"
    [[ -n "$sel" ]] || die "task: no repo picked"
    sel="${sel%$'\t'*}"; repo="${sel##*$'\t'}"   # the path column; a typed query has no tab and is taken as given
  fi
  if [[ "$kind" == claude || "$kind" == codex ]]; then       # the name is never known from the options
    read -r -p 'name (blank = from brief)> ' name || true
    name=$(tidy_name "$name"); [[ -z "$name" ]] || need_name "$name"   # a '-…' name would otherwise reach cmd_new as an option
    if [[ $asked -eq 1 ]]; then read -r -p 'brief> ' brief || true; fi
  fi

  case "$kind" in
    claude|codex)
      args=(-r "$repo" -a "$kind" -p "$brief")                # cmd_new validates the name and slugifies a blank one
      if [[ -n "$name" ]]; then args+=("$name"); fi
      if [[ "$where" == local ]]; then cmd_new "${args[@]}"
      else host_new "$where" "${args[@]}"; fi ;;
    repo-shell)
      if [[ "$where" == local ]]; then
        resolve_repo "$repo"; id=$(repo_id "$REPO")
        cmux_ok || die "cmux is not running; start cmux, then: wt task"
        out=$(cmux_create --name "$id shell" --description "$(row_tag)" --cwd "$REPO" 2>&1) \
          || die "cmux workspace create failed: $out"
        printf 'row: %s shell %s\n' "$id" "$(row_tag)"
      else
        id=$(repo_id "$repo")   # the VM's own wt resolves the name against its $WT_REPOS_DIR; on a failed
                                # lookup its error stays on screen and the pane keeps $HOME as its cwd
        remote_row "$where" "shell-$id" "$id shell" "" "d=\$(\"\$HOME/.local/bin/wt\" repos $(shell_join "$repo")) && cd \"\$d\"" shared
      fi ;;
    vm-shell) remote_row "$where" main shell "" "" shared ;;
  esac
}

# ---------------------------------------------------------------- dispatch
# Check jq before a command creates a worktree or reads task and row data.
# Keep help available so the installation instructions remain accessible.
if [[ ${1:-} == --host=* ]]; then set -- --host "${1#*=}" "${@:2}"; fi
if [[ ${1:-} == -- ]]; then shift; fi
if [[ "${1:-}" == -H || "${1:-}" == --host ]]; then
  [[ $# -ge 3 ]] || die "usage: wt -H <host> <command> [args] (wt help)"
  host="$2"; shift 2
  case ${1:-} in help|setup|doctor) ;; *) need_jq ;; esac
  cmd_host "$host" "$@"
  exit
fi
sub="${1:-help}"; shift || true
case "$sub" in help|-h|--help|setup|doctor) ;; *) need_jq ;; esac
wt_command "$sub" || die "unknown command '$sub' (wt help)"
"cmd_$WT_COMMAND" "$@"
