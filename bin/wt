#!/usr/bin/env bash
# wt — task worktrees for coding agents (git worktree + cmux workspace + VS Code on demand).
#
# One task = one worktree at <repo>/.worktrees/<name> on branch wt/<name>.
# Every command is safe to run from the main checkout or from inside any worktree.
#
# Usage:
#   wt new  [name] [-p|--prompt TEXT] [--prompt-stdin] [-b|--base REF] [--head]
#           [-a|--agent claude|codex|none] [--no-workspace] [-r|--repo PATH]
#                                                             create a worktree (+ a cmux row running `wt run`)
#   wt run  <name> [-r PATH]                                  run the worktree's agent with its brief (cmux runs this)
#   wt list [--all] [-r PATH]                                 list worktrees (--all: every repo in $WT_REPOS_DIR)
#   wt show <name> [--diff] [-r PATH]                         status summary; --diff also opens a cmux diff pane
#   wt open [name] [-r PATH]                                  open a worktree in VS Code (default: the one you are in)
#   wt diff <name>                                            = wt show <name> --diff
#   wt attach <name> [-a AGENT] [-p TEXT] [-r PATH]           open a cmux row for an existing worktree
#   wt sync <name> [--merge]                                  rebase (default) or merge the worktree branch onto its base
#   wt pr <name> [--draft]                                    push the branch and open a GitHub PR (gh)
#   wt rm <name> [--force] [--keep-branch]                    remove a worktree; refuses to destroy work — commits on
#                                                             the branch that are neither merged nor still on a remote,
#                                                             a HEAD that is not that branch, an edited or newly created
#                                                             .wt-include file — unless --force
#   wt prune [--dry-run]                                      remove worktrees whose branch is merged and tree is clean
#   wt repos [<name>] [--porcelain|--table]                   every git repo in $WT_REPOS_DIR: on a terminal a table of
#                                                             name, task count and location; piped, "<name><tab><path>"
#                                                             per repo. Given a name or path, just that repo's path
#   wt task [--where local|<host>] [-a claude|codex|repo-shell|vm-shell] [-r REPO] [-p TEXT]
#                                                             pick where/kind/repo/name/brief, then start it (Mac, needs fzf)
#   wt driver                                                 open (or select) the driver row (@local)
#   wt update [--refresh-config]                              show what git pull would bring in, then, once you confirm,
#                                                             pull this repo and re-run install.sh
#   wt path <name> [-r PATH] | wt current | wt help
#
#   wt -H <host> <new|attach|list|show|rm|path|open|repos|update|help> …
#                                                             run wt on that VM over ssh and keep the cmux row local;
#                                                             show/rm/path/open/attach need -r;
#                                                             attach [--restart-agent|--reattach];
#                                                             update asks here, so run it from a terminal
#
# Where it runs: on a Mac wt drives cmux directly; on a VM (see is_remote) it only prepares worktrees and
# asks the Mac for rows and VS Code windows through `cmux notify` over the relay socket. A VM task's row is a
# plain `cmux ssh` row whose shell runs tmux_cmd: it creates or takes over that task's tmux session.
#
# Identity: cmux row titled "<repo>:<name>" with "@local"/"@<host>" as its description (the sidebar's second
# line), tmux session "wt-<repo>-<name>", <repo> = repo basename
# with anything outside [A-Za-z0-9-] replaced by '-'. Task names: ^[a-z0-9][a-z0-9_-]{0,62}$ (no '.').
#
# Task files (never committed): <repo>/.git/wt/<name>.json    base, created, agent, title, session, includes
#                               <repo>/.git/wt/<name>.prompt  the brief, passed to the agent by `wt run`
#                               <repo>/.git/wt/<name>.started marker: Claude resumes with -c after this exists
#
# Environment / git config:
#   WT_REPOS_DIR        ':'-separated folders `wt list --all`, `wt repos` and `wt new -r <name>` search, in order,
#                       for repos; a name found in two of them must be given as a path (default ~/Documents/Repositories)
#   WT_HOST             on a VM: this machine's alias in the Mac's ~/.ssh/config (set by install.sh in ~/.zshenv.local)
#   WT_AGENT            default agent for `wt new`                                              (default claude)
#   WT_AGENT_ARGS       extra args for the agent command (e.g. "--model opus")
#   git config wt.dir   per-repo override of the worktree folder name                           (default .worktrees)
#
# Per-repo hooks:
#   .wt-include         gitignore-style patterns of *ignored* files to copy into each new worktree (.env etc.)
#   .wt-setup           executable run inside each new worktree after creation (install deps, etc.)
set -euo pipefail

REPOS_PATH="${WT_REPOS_DIR:-$HOME/Documents/Repositories}"   # ':'-separated, searched in order (see repos_entries)
DEFAULT_AGENT="${WT_AGENT:-claude}"

# ---------------------------------------------------------------- helpers
die()  { printf 'wt: %s\n' "$*" >&2; exit 1; }
warn() { printf 'wt: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
usage() { awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0"; }
shell_join() { local out="" a; for a in "$@"; do printf -v a '%q' "$a"; out="${out:+$out }$a"; done; printf '%s' "$out"; }

# The EXIT trap. meta_set builds each sidecar in a temp file beside the real one and moves it into place, so
# a signal arriving between the two would leave <name>.json.new.<pid> in .git/wt for good: list_names reads
# `git worktree list` and never that directory, and cmd_rm removes only the .json, .prompt and .started, so
# nothing else in this file would ever see it again. An EXIT trap runs on SIGINT and SIGTERM too, which is
# when this matters. Nothing here uses exec, so the trap is always reached; the exec's in this file are all
# inside command strings sent to a VM, where they belong to that shell and not to this one.
WT_TMPFILES=()
wt_cleanup() {
  if [[ ${#WT_TMPFILES[@]} -gt 0 ]]; then
    rm -f "${WT_TMPFILES[@]}"          # already moved into place: rm -f on a gone path is a no-op
  fi
}
trap wt_cleanup EXIT

cmux_bin() {
  local c="${CMUX_BUNDLED_CLI_PATH:-}"
  [[ -x "$c" ]] || c=$(command -v cmux 2>/dev/null || true)
  [[ -x "$c" ]] || c="$HOME/.cmux/bin/cmux"                        # cmux uploads its CLI here on a VM
  [[ -x "$c" ]] || c=/Applications/cmux.app/Contents/Resources/bin/cmux
  [[ -x "$c" ]] && printf '%s' "$c"
}
cmux_ok() { local c; c=$(cmux_bin) || return 1; CMUX_QUIET=1 "$c" ping >/dev/null 2>&1; }

# ---------------------------------------------------------------- which side of the ssh we are on
# A cmux remote pane, a cmux relay socket, or simply not a Mac: then this machine hosts worktrees and the
# Mac drives cmux. CMUX_SURFACE_ID is cleared inside remote tmux panes by design — never test it.
is_remote() { [[ -n ${CMUX_SSH_ATTEMPT_ID:-} ]] || [[ ${CMUX_SOCKET_PATH:-} == *:[0-9]* ]] || [[ $(uname -s) != Darwin ]]; }
mac_only()  { if is_remote; then die "wt $1: run this on the Mac"; fi; }

valid_host() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
wt_host() { # this VM's alias in the Mac's ~/.ssh/config
  [[ -n "${WT_HOST:-}" ]] || die "WT_HOST is not set; on this VM: echo 'export WT_HOST=<alias>' >> ~/.zshenv.local"
  valid_host "$WT_HOST" || die "invalid WT_HOST '$WT_HOST'; fix it in ~/.zshenv.local"
  printf '%s' "$WT_HOST"
}

# How to reach the Mac's cmux: the identity of this pane, overridden by the tmux session environment (cmux
# rebinds it there on every attach, which ~/.tmux.conf's update-environment line is what carries). All six,
# because cmux authorises a relayed request against the SURFACE and the WORKSPACE it reads from the
# environment — a pane holding the ids of the connection that started it is refused after cmux reconnects the
# row, with remote_relay_surface_denied. A pane's own environment is never rewritten, only the session's, so
# these are re-read at call time and handed to the cmux child explicitly rather than inherited.
# bin/agent-notify uses the same precedence over the same list.
RELAY_VARS="CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID"
RELAY_SOCKET=""; RELAY_WS=""; RELAY_IDENT=()
relay_env() { # sets RELAY_SOCKET, RELAY_WS and RELAY_IDENT; non-zero when this session has no relay socket
  local s="" n v t
  RELAY_IDENT=(); RELAY_SOCKET=""; RELAY_WS=""
  if [[ -n "${TMUX:-}" ]] && have tmux; then s=$(tmux display-message -p '#S' 2>/dev/null || true); fi
  for n in $RELAY_VARS; do          # unquoted on purpose: RELAY_VARS is a word list, not one value
    v="${!n:-}"
    if [[ -n "$s" ]]; then
      t=$(tmux show-environment -t "=$s" "$n" 2>/dev/null || true)
      # an unset name prints "-NAME", which has no "=" and so leaves the pane's own value in place
      if [[ "$t" == *=* ]]; then v="${t#*=}"; fi
    fi
    if [[ -n "$v" ]]; then RELAY_IDENT+=("$n=$v"); fi
    case "$n" in
      CMUX_SOCKET_PATH) RELAY_SOCKET="$v" ;;
      CMUX_WORKSPACE_ID) RELAY_WS="$v" ;;
    esac
  done
  [[ "$RELAY_SOCKET" == *:[0-9]* ]]
}

# Mirrors safe_path in bin/cmux-hook: the Mac hook drops anything else, so never relay such a path.
hook_safe_path() { [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *//* && "$1" != */ && "$1" != *'/../'* && "$1" != */.. && "$1" != *[\'\"\`\$\\\;]* ]]; }
hook_ok_repo() { # both relayed bodies carry $REPO (wt-open sends a path inside it)
  hook_safe_path "$REPO" && return 0
  warn "the Mac hook rejects this repo path ($REPO); run the printed command by hand"; return 1
}

notify_mac() { # notify_mac <title> <key> <value> …  — JSON body, so paths with spaces survive
  local title="$1" args=() ws=() c body; shift
  while [[ $# -gt 1 ]]; do args+=(--arg "$1" "$2"); shift 2; done
  body=$(jq -cn "${args[@]+"${args[@]}"}" '$ARGS.named')
  relay_env || { warn "no cmux relay socket in this session; run the line below on the Mac"; return 1; }
  c=$(cmux_bin) || { warn "cmux CLI not found here; run the line below on the Mac"; return 1; }
  # Belt and braces, not the mechanism: on cmux 0.64 --workspace neither authorises the request nor changes
  # which workspace it is recorded against — both come from the environment set below, whatever is named
  # (measured). It names this row, which is what the Mac hook's from_row_on_host wants anyway, so it agrees
  # with that environment rather than contradicting it, and stays right if a later cmux does read it.
  if [[ -n "$RELAY_WS" ]]; then ws=(--workspace "$RELAY_WS"); fi
  env -u CMUX_SOCKET "${RELAY_IDENT[@]+"${RELAY_IDENT[@]}"}" "$c" notify "${ws[@]+"${ws[@]}"}" --title "$title" --body "$body" >/dev/null 2>&1 \
    || { warn "cmux notify failed; run the line below on the Mac"; return 1; }
}

# Resolve the MAIN checkout root for a path (follows linked worktrees back to the primary).
main_root_of() {
  local p="$1" common
  common=$(git -C "$p" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ "$common" == */.git ]] || return 1          # bare repos are not supported
  printf '%s' "${common%/.git}"
}

REPO=""      # main checkout root
WT_DIRNAME=""
set_repo() { REPO=$(main_root_of "$1") || return 1; WT_DIRNAME=$(git -C "$REPO" config --get wt.dir 2>/dev/null || echo .worktrees); }
lookup_repo() { # a path is taken as given; a name is searched along $WT_REPOS_DIR, and must be in one folder only
  local want="${1:-}" hits
  if [[ -n "$want" ]]; then
    if [[ ! -d "$want" ]]; then
      hits=$(repo_matches "$want")
      [[ -n "$hits" ]] || die "repo not found: ${1} (see: wt repos)"
      [[ "$hits" == *$'\n'* ]] && die "repo name '${1}' is in more than one WT_REPOS_DIR folder ($(printf '%s' "$hits" | tr '\n' ' ')); pass the path instead"
      want="$hits"
    fi
    set_repo "$want" || die "not a git repo: $want"
  else
    set_repo "$PWD" || die "not inside a git repo; pass -r <repo> (a name in $REPOS_PATH, or a path)"
  fi
}
# every command that makes or reads a worktree needs a commit to branch from; a plain lookup does not
resolve_repo() { lookup_repo "${1:-}"; need_commits; }
need_commits() { git -C "$REPO" rev-parse HEAD >/dev/null 2>&1 || die "$REPO has no commits yet (git -C $REPO commit --allow-empty -m init)"; }
wt_root()   { printf '%s/%s' "$REPO" "$WT_DIRNAME"; }
wt_path()   { printf '%s/%s/%s' "$REPO" "$WT_DIRNAME" "$1"; }
wt_meta()   { printf '%s/.git/wt/%s.json' "$REPO" "$1"; }
wt_prompt() { printf '%s/.git/wt/%s.prompt' "$REPO" "$1"; }
wt_started(){ printf '%s/.git/wt/%s.started' "$REPO" "$1"; }
wt_branch() { printf 'wt/%s' "$1"; }

# Identity — bin/cmux-hook mirrors these formats and tags the rows it relays the same way; keep
# them byte-compatible. A row's title says which task, its description (row_tag) which machine.
repo_id()    { printf '%s' "${1##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'; }
where_am_i() { if is_remote; then printf '%s' "${WT_HOST:-remote}"; else printf 'local'; fi; }
row_title()  { printf '%s:%s' "$(repo_id "$2")" "$1"; }                     # row_title <name> <repo>
row_tag()    { printf '@%s' "${1:-$(where_am_i)}"; }                        # row_tag [host] — the row description
wt_session() { printf 'wt-%s-%s' "$(repo_id "$2")" "$1"; }                  # wt_session <name> <repo>
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; }
need_name()  { valid_name "$1" || die "invalid name '$1' (lowercase letters, digits, _ and -, max 63, no '.')"; }
tidy_name()  { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/-/g'; }  # "Fix Auth" -> fix-auth; anything else must already be valid
valid_agent() { case "$1" in claude|codex|none) ;; *) die "unknown agent '$1' (use claude, codex or none)" ;; esac; }

slugify() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-' \
    | sed 's/^-//; s/-$//' | cut -d- -f1-5 | cut -c1-48 | sed 's/-$//'
}

# $WT_REPOS_DIR is a search path like $PATH: entries in order, each one once, empty and missing ones skipped.
repos_entries() {
  local rest="$REPOS_PATH" d seen=""
  while [[ -n "$rest" ]]; do
    d="${rest%%:*}"
    case "$rest" in *:*) rest="${rest#*:}" ;; *) rest="" ;; esac
    while [[ "$d" == */ && "$d" != / ]]; do d="${d%/}"; done      # "$X/" and "$X" are the same folder
    [[ -n "$d" && -d "$d" ]] || continue
    case "$seen" in *":$d:"*) continue ;; esac
    seen="$seen:$d:"
    printf '%s\n' "$d"
  done
  return 0
}
need_repos_dir() { [[ -n "$(repos_entries)" ]] || die "repos dir not found: $REPOS_PATH (set WT_REPOS_DIR, or pass -r <repo>)"; }
repo_dirs() { # every git repo on the search path: entry order, sorted within an entry, unreadable and hidden folders skipped
  local d
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    [[ -r "$d" ]] || { warn "skipping unreadable folder in WT_REPOS_DIR: $d"; continue; }
    { find "$d" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -exec test -d '{}/.git' ';' -print 2>/dev/null || true; } | sort
  done <<<"$(repos_entries)"
  return 0
}
repo_matches() { # repo_matches <name> -> the entries holding that repo, first entry first; hidden names never match
  local name="$1" d
  case "$name" in ""|*/*|.*) return 0 ;; esac
  while IFS= read -r d; do
    [[ -n "$d" && -d "$d/$name/.git" ]] && printf '%s\n' "$d/$name"
  done <<<"$(repos_entries)"
  return 0
}

default_base() {
  local ref b
  if ref=$(git -C "$REPO" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s' "$ref"; return
  fi
  for b in main master; do
    git -C "$REPO" show-ref -q --verify "refs/remotes/origin/$b" && { printf 'origin/%s' "$b"; return; }
    git -C "$REPO" show-ref -q --verify "refs/heads/$b" && { printf '%s' "$b"; return; }
  done
  # the branch checked out here, or its commit when HEAD is detached; never the literal "HEAD", which
  # resolves in every worktree to that worktree's own tip and so compares a worktree with itself
  git -C "$REPO" symbolic-ref -q --short HEAD || git -C "$REPO" rev-parse HEAD
}

meta_get() { # meta_get <name> <key> — "" for a missing key, and for a key stored as null
  # `.[$k] // ""` looks right and is not: // also fires on a stored `false`, which would read as "".
  # has/tojson is exact — and a non-string (a number, a bool) comes back as JSON, so `false` is "false".
  local f; f=$(wt_meta "$1"); [[ -f "$f" ]] || return 1
  jq -r --arg k "$2" 'if has($k) and .[$k] != null then .[$k] else "" end
                      | if type == "string" then . else tojson end' "$f"
}
meta_set() { # meta_set <name> key=value ...  — a key with no '=' is stored with an empty value
  # jq cannot write the file it is reading, so this goes through a temp file; the mv also makes meta_set
  # crash-safe, which json.dump(d, open(f,'w')) was not — an interrupted write used to truncate the sidecar.
  # index("=") is null when there is no '=', and null+1 is 1 in jq, so the no-'=' arm is not optional:
  # without it `meta_set x bare` would slice the key and store the wrong one.
  local f t; f=$(wt_meta "$1"); shift; mkdir -p "$(dirname "$f")"; t="$f.new.$$"
  WT_TMPFILES+=("$t")                    # a signal between the jq below and the mv would otherwise orphan it
  if ! { if [[ -f "$f" ]]; then cat "$f"; else printf '{}\n'; fi; } \
       | jq --indent 1 'reduce ($ARGS.positional[]) as $kv (.;
             ($kv | index("=")) as $i
             | if $i == null then .[$kv] = "" else .[$kv[0:$i]] = $kv[$i+1:] end)' --args "$@" >"$t" \
     || ! mv "$t" "$f"; then
    rm -f "$t"; die "could not write $f"
  fi
}
prompt_line() { local f; f=$(wt_prompt "$1"); if [[ -f "$f" ]]; then head -1 "$f"; fi; }

require_wt() { # require_wt <name>  -> sets P (path), B (branch)
  local n="$1"; valid_name "$n" || die "invalid worktree name: $n"
  P=$(wt_path "$n"); B=$(wt_branch "$n")
  if git -C "$REPO" worktree list --porcelain | grep -qxF "worktree $P"; then
    # a registration whose directory was deleted outside wt (rm -rf, a lost VM disk) still has a branch and
    # metadata that only `wt rm` can clear, so let it through; the other commands simply find no files there
    [[ -d "$P" ]] || warn "$P is registered but missing (deleted outside wt?); clean it up with: wt rm $n"
    return 0
  fi
  [[ -d "$P" ]] && die "$P exists but is not a registered worktree (try: git -C $REPO worktree prune)"
  die "no worktree named '$n' in $REPO (see: wt list)"
}

rows_json() { # rows_json — every cmux row, in every window, as one {"workspaces":[…]} document.
  # `workspace list --json` answers for ONE window: the caller's, or --window's. A row the user dragged into
  # a second window — which is the only way cmux can show two tasks side by side, since a window displays one
  # workspace at a time — is then simply absent, and every lookup built on this reads that as "no such row":
  # `wt rm` leaves the row open, remote_row builds a second row beside the one already there, check_identity
  # misses a title clash, and the hook's from_row_on_host fails closed so a VM's `wt open` does nothing.
  # Only the LISTING is window-scoped, which is why merging the lists is the whole fix and nothing that acts
  # on a row changes. Measured on cmux 0.64: a workspace keeps its uuid, its title and even its workspace:N
  # ref when it is moved between windows, refs are allocated globally so two windows cannot collide, and
  # read-screen, send, workspace-action and workspace close each reach a row in another window with no
  # --window. Windows are enumerated by uuid and never by the index list-windows prints first: opening a
  # window renumbers the rest — a new window took index 0 and pushed the existing one to 1 — the uuid is fixed.
  # `.workspaces?` and not `.workspaces`: cmux may hand back a bare array, and jq's `//` does not catch the
  # error `Cannot index array with "workspaces"` — only the `?` turns that into the empty it can fall back from.
  local c w out docs=""
  c=$(cmux_bin) || return 0
  for w in $(CMUX_QUIET=1 "$c" list-windows 2>/dev/null | awk '{print $2}' | grep -Ex '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}' || true); do
    out=$(CMUX_QUIET=1 "$c" workspace list --json --window "$w" 2>/dev/null) || continue   # a window closed mid-loop
    docs="$docs$out"
  done
  # No window list at all — an older cmux without the subcommand, or output this cannot parse — falls back to
  # the single-window call that was here before, so such a cmux behaves exactly as it did rather than not at all.
  [[ -n "$docs" ]] || docs=$(CMUX_QUIET=1 "$c" workspace list --json 2>/dev/null) || true
  printf '%s' "$docs" | jq -s -c '{workspaces: (map(.workspaces? // .) | add // [])}' 2>/dev/null || true
}

cmux_row_field() { # cmux_row_field <title> <field> [host] -> that field of the row; no host: the local row
  cmux_bin >/dev/null || return 0        # a local and a VM row share a title, so the host is what tells them apart
  rows_json \
    | jq -r --arg t "$1" --arg k "$2" --arg h "${3:-}" '
        first((.workspaces? // .)[]
          | select(.title == $t)
          | select(if $h == "" then ((.remote.enabled // false) | not)
                   else ((.remote.enabled // false)
                         and (((.remote.destination // "") == $h) or ((.description // "") == "@" + $h))) end)
          | .[$k] // "") // empty' 2>/dev/null || true
}

check_identity() { # refuse a name whose row title is already taken by another repo
  local n="$1" title other s
  if is_remote; then                  # this repo has no such worktree, so a live session belongs to another repo
    s=$(wt_session "$n" "$REPO")
    if tmux has-session -t "=$s" 2>/dev/null; then die "tmux session $s is already in use here; pick another name (or: tmux kill-session -t '=$s')"; fi
    return 0
  fi
  cmux_ok || return 0
  title=$(row_title "$n" "$REPO"); other=$(cmux_row_field "$title" current_directory)
  [[ -n "$other" ]] || return 0
  other=$(main_root_of "$other" 2>/dev/null || printf '%s' "$other")   # resolved like $REPO; raw if the dir is gone
  [[ "$other" == "$REPO" || "$other" == "$REPO/"* ]] && return 0
  die "row '$title' already belongs to $other; pick another name (wt new <other-name> -r $REPO)"
}

open_workspace() { # open_workspace <name> — always unfocused: a new task row must never steal the window
  local n="$1" c out title                 # from whatever the user is doing; they select it when they want it
  cmux_ok || { warn "cmux is not running; skipped workspace creation (cd $(wt_path "$n"))"; return 0; }
  c=$(cmux_bin)
  title=$(meta_get "$n" title 2>/dev/null || true); [[ -n "$title" ]] || title=$(row_title "$n" "$REPO")
  out=$(CMUX_QUIET=1 "$c" workspace create --name "$title" --description "$(row_tag)" --cwd "$(wt_path "$n")" --focus false \
        --command "$(shell_join "$HOME/.local/bin/wt" run "$n" -r "$REPO")" 2>&1) || die "cmux workspace create failed: $out"
  local ref; ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1 || true)
  meta_set "$n" "title=$title"
  printf 'workspace: %s\n' "${ref:-$out}"
}

close_workspace() { # close_workspace <name> — the row is found by its title
  local title
  cmux_ok || return 0
  title=$(meta_get "$1" title 2>/dev/null || true); [[ -n "$title" ]] || title=$(row_title "$1" "$REPO")
  close_row "$(cmux_row_field "$title" id)"
}
close_row() { # close_row <row id> — silent when the row is already gone
  [[ -n "$1" ]] || return 0
  CMUX_QUIET=1 "$(cmux_bin)" workspace close "$1" >/dev/null 2>&1 || true
}

file_hash() { # sha256 of a file, or "" when it cannot be read (the Mac has shasum, Linux sha256sum)
  local h=""
  if have shasum; then h=$(shasum -a 256 "$1" 2>/dev/null) || h=""
  elif have sha256sum; then h=$(sha256sum "$1" 2>/dev/null) || h=""
  else h=$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$1" 2>/dev/null) || h=""
  fi
  printf '%s' "${h%% *}"
}

include_match() { # include_match <path relative to a checkout> — 0 when .wt-include covers it
  local f="$1" inc="$REPO/.wt-include" pat
  [[ -f "$inc" ]] || return 1
  while IFS= read -r pat || [[ -n "$pat" ]]; do
    pat="${pat%%#*}"; pat="${pat#"${pat%%[![:space:]]*}"}"; pat="${pat%"${pat##*[![:space:]]}"}"
    [[ -z "$pat" ]] && continue
    pat="${pat#/}"; pat="${pat%/}"
    # shellcheck disable=SC2053
    if [[ "$f" == $pat || "$f" == $pat/* || "$(basename "$f")" == $pat ]]; then return 0; fi
  done < "$inc"
  return 1
}

copy_includes() { # copy gitignored files listed in .wt-include into the new worktree; prints "<path>:<sha256>"
  local dest="$1" f                       # the hash is of what was copied, so rm can tell a copy edited inside
  [[ -f "$REPO/.wt-include" ]] || return 0   # the worktree from a file changed in the main checkout since
  git -C "$REPO" ls-files --others --ignored --exclude-standard -z | while IFS= read -r -d '' f; do
    if [[ "$f" != "$WT_DIRNAME/"* ]] && include_match "$f"; then
      # errexit does not reach in here (a pipeline inside $( )), so a failed copy has to be caught by
      # hand; printing it anyway would record in "includes" a file the worktree does not have
      mkdir -p "$dest/$(dirname "$f")"
      if cp -p "$REPO/$f" "$dest/$f"; then printf '%s:%s\n' "$f" "$(file_hash "$dest/$f")"
      else warn "could not copy $f into the worktree"; fi
    fi
  done
}

worktree_includes() { # worktree_includes <path> — ignored files inside the worktree that .wt-include covers
  local p="$1" f                          # today, whether or not they existed when the worktree was created
  [[ -f "$REPO/.wt-include" ]] || return 0
  git -C "$p" ls-files --others --ignored --exclude-standard -z 2>/dev/null | while IFS= read -r -d '' f; do
    if [[ "$f" != "$WT_DIRNAME/"* ]] && include_match "$f"; then printf '%s\n' "$f"; fi
  done
}

changed_includes() { # changed_includes <name> <path> -> ignored files that removing the worktree would destroy
  # Two sources, because this protection cannot be a creation-time snapshot: the files recorded at `wt new`
  # (compared against the hash of what was copied then, so rotating a secret in the main checkout does not
  # make every existing worktree unremovable), and every ignored file the patterns cover *now* (an .env.local
  # an agent wrote in there is in no snapshot, and `worktree remove --force` eats it without a word).
  local n="$1" p="$2" f h e seen="" list
  list=$(printf '%s\n%s\n' "$(meta_get "$n" includes 2>/dev/null || true)" "$(worktree_includes "$p")")
  while IFS= read -r e; do
    [[ -n "$e" ]] || continue
    f="${e%:*}"; h="${e##*:}"
    [[ "$h" =~ ^[0-9a-f]{64}$ ]] || { f="$e"; h=""; }   # metadata from an older wt: plain names, no hash
    case "$seen" in *"|$f|"*) continue ;; esac          # recorded and still matching: judge it once
    seen="$seen|$f|"
    [[ -e "$p/$f" ]] || continue
    if [[ -n "$h" ]]; then
      [[ "$(file_hash "$p/$f")" == "$h" ]] || printf '%s\n' "$f"
    elif [[ -e "$REPO/$f" ]]; then
      cmp -s "$p/$f" "$REPO/$f" || printf '%s\n' "$f"   # no hash: the main checkout is all there is to compare with
    else
      printf '%s\n' "$f"                                # nothing anywhere else holds it
    fi
  done <<<"$list"
}

porcelain_paths() { # porcelain_paths <checkout> — one path per line for every entry `git status` reports.
  # -z because a path with a space in it comes back quoted otherwise, and this list is compared by exact
  # string. A rename or copy emits its source as a second record, which is consumed and dropped: the
  # destination is the path that is dirty, and the source no longer exists to hash.
  local p="$1" rec f
  git -C "$p" status --porcelain -z 2>/dev/null | while IFS= read -r -d '' rec; do
    f="${rec:3}"
    case "${rec:0:2}" in R*|C*) IFS= read -r -d '' _src || true ;; esac
    if [[ -n "$f" ]]; then printf '%s\n' "$f"; fi
  done
}

setup_dirt() { # setup_dirt <worktree path> — what .wt-setup left in git's way, as "<path>:<sha256>" lines.
  # Only ever called immediately after the hook ran, so this is the hook's own output and nobody else's.
  # It is recorded for the same reason copy_includes records a hash: so that rm can tell the work a human
  # did inside the worktree from the state the worktree was born with. A `.wt-setup` that runs `uv sync` or
  # `npm ci` rewrites a TRACKED lockfile, which without this makes `git status` dirty from birth and every
  # `wt rm` a refusal for the worktree's whole life — leaving --force, which discards the unmerged-commit
  # check too, as the only way to clean up. Ignored files never reach here: `status` does not list them.
  local p="$1" f
  porcelain_paths "$p" | while IFS= read -r f; do
    printf '%s:%s\n' "$f" "$(file_hash "$p/$f")"      # a file the hook DELETED hashes to "", and matches as ""
  done
}

unexplained_dirt() { # unexplained_dirt <name> <path> — dirty paths that .wt-setup did not put there
  # A recorded path counts as explained only while it still holds exactly what the hook left: edit that
  # lockfile by hand and the hash stops matching, so it is a reason again. Metadata from before this was
  # recorded has no "setup" key, so every path is unexplained and the old refusal stands unchanged.
  local n="$1" p="$2" recorded f h e explained
  recorded=$(meta_get "$n" setup 2>/dev/null || true)
  [[ -n "$recorded" ]] || { porcelain_paths "$p"; return 0; }
  porcelain_paths "$p" | while IFS= read -r f; do
    h=$(file_hash "$p/$f"); explained=0
    while IFS= read -r e; do
      if [[ -n "$e" && "${e%:*}" == "$f" && "${e##*:}" == "$h" ]]; then explained=1; break; fi
    done <<<"$recorded"
    if [[ $explained -eq 0 ]]; then printf '%s\n' "$f"; fi
  done
}

branch_pushed() { # branch_pushed <branch> — 0 only when the remote still has every commit of that branch.
  # A remote-tracking ref is not proof: refs/remotes/origin/wt/x outlives the remote branch (abandoned PR,
  # `git push origin :wt/x`, someone else's cleanup), and the next fetch with fetch.prune drops it and leaves
  # those commits unreachable with no reflog. So ask the remote itself, and count an unreachable remote as
  # not pushed: refusing while offline is the safe direction, and --force is one keystroke away.
  local b="$1" remote
  git -C "$REPO" rev-parse -q --verify "$b@{u}" >/dev/null 2>&1 || return 1
  [[ -z "$(git -C "$REPO" log "$b@{u}..$b" --oneline 2>/dev/null)" ]] || return 1
  remote=$(git -C "$REPO" config "branch.$b.remote" 2>/dev/null || true)
  [[ -n "$remote" ]] || return 1
  warn "asking $remote whether $b is still there (ctrl-c and use --force if it hangs)"
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=5}" \
    git -C "$REPO" ls-remote --exit-code --heads "$remote" "refs/heads/$b" >/dev/null 2>&1
}

rm_reasons() { # rm_reasons <name> <path> <branch> <base> — why removing this worktree would destroy work,
               # one reason per line; nothing at all when there is nothing to lose. `wt rm` and `wt prune`
               # (dry run included) both read this, so the two can never disagree.
  # Every commit check is about the BRANCH, never the worktree's HEAD: under `git bisect`, `git checkout <sha>`
  # or `--detach` the HEAD is usually an ancestor of the base, so a HEAD-based check reads "clean, 0 ahead,
  # merged" while `branch -D` still destroys every commit the branch holds, its reflog with it. $B resolves
  # whether or not it is checked out; refs are shared with the main checkout, so ask $REPO about it.
  local n="$1" p="$2" b="$3" base="$4" dirty ahead=0 merged=0 base_ok=0 head_ref f
  dirty=$(unexplained_dirt "$n" "$p" | wc -l | tr -d ' ')      # what .wt-setup itself wrote is not a reason
  [[ "$dirty" -gt 0 ]] && printf '%s uncommitted change(s)\n' "$dirty"
  # a base that no longer resolves fails both checks below, and each failure reads as "nothing to lose"; the
  # literal HEAD (metadata from before wt canonicalised the base) resolves in every worktree to that
  # worktree's own tip and reads the same way. So settle the base first and let either case be a refusal.
  if [[ "$base" != HEAD ]] && git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1; then
    base_ok=1
    git -C "$REPO" merge-base --is-ancestor "$b" "$base" 2>/dev/null && merged=1
    ahead=$(git -C "$REPO" rev-list --count "$base..$b" 2>/dev/null || echo 0)
  fi
  [[ $base_ok -eq 1 ]] || printf "base '%s' cannot be compared with %s (gone, or the literal HEAD)\n" "$base" "$b"
  if [[ "$ahead" -gt 0 && $merged -eq 0 ]] && ! branch_pushed "$b"; then
    printf '%s commit(s) on %s not merged into %s and not on a remote\n' "$ahead" "$b" "$base"
  fi
  # the checks above are about $b, so a HEAD that is not $b is its own reason: the worktree holds a state
  # (a bisect, a detached checkout) that removing it throws away, and that no branch is keeping
  if [[ -d "$p" ]]; then
    head_ref=$(git -C "$p" symbolic-ref -q --short HEAD 2>/dev/null || true)
    if [[ -z "$head_ref" ]]; then printf 'HEAD is detached at %s (bisect, or a detached checkout), not on %s\n' \
        "$(git -C "$p" rev-parse --short HEAD 2>/dev/null || echo '?')" "$b"
    elif [[ "$head_ref" != "$b" ]]; then printf 'HEAD is on %s, not %s\n' "$head_ref" "$b"; fi
  fi
  while IFS= read -r f; do
    if [[ -n "$f" ]]; then printf '%s was edited or created inside the worktree (.wt-include, not in git)\n' "$f"; fi
  done <<<"$(changed_includes "$n" "$p")"
  return 0
}

open_code() { # open_code <folder uri> <label>   (no --new-window: a repeat call focuses the window)
  have code || die "VS Code CLI 'code' not found (install it from VS Code: Shell Command: Install 'code' command in PATH)"
  code --folder-uri "$1" >/dev/null 2>&1
  printf 'opened in VS Code: %s\n' "$2"
}

open_worktree() { # open_worktree <name> — VS Code here; from a VM ask the Mac to do it
  if ! is_remote; then open_code "file://$P" "$P"; return 0; fi
  local h; h=$(wt_host)
  if hook_ok_repo; then notify_mac wt-open host "$h" path "$P" || true; fi
  printf 'on the Mac: wt -H %s open -r %s %s\n' "$h" "$(shell_join "$REPO")" "$1"
}

request_row() { # request_row <name> — VM side: ask the Mac for a cmux row, and always print the recovery line
  local h; h=$(wt_host)
  if hook_ok_repo; then notify_mac wt-attach host "$h" repo "$REPO" task "$1" || true; fi
  printf 'on the Mac: wt -H %s attach -r %s %s\n' "$h" "$(shell_join "$REPO")" "$1"
}

session_state() { # session_state <name> — what the VM's tmux holds for this task, and whether a row holds that
  local s state=none t; s=$(wt_session "$1" "$REPO")   # session: `wt -H <host> attach` reads both from `wt show`
  if tmux has-session -t "=$s" 2>/dev/null; then
    state='shell only'
    while IFS= read -r t; do                           # the agent is a child of `wt run`, so it is never the pane's
      [[ -n "$t" ]] || continue                        # own command; everything on the pane's tty is what counts
      if pgrep -t "${t#/dev/}" -x 'claude|codex' >/dev/null 2>&1; then state='agent running'; break; fi
    done < <(tmux list-panes -s -t "=$s" -F '#{pane_tty}' 2>/dev/null)
    if [[ -z "$(tmux list-clients -t "=$s" 2>/dev/null)" ]]; then state="$state, detached"; fi
  fi
  printf '%s (%s)' "$s" "$state"
}

# ---------------------------------------------------------------- status
WT_FS=$'\x1f'   # the status line's field separator: git allows '|' in a branch name, and a base like
                # 'feat|x' used to shift every field of the line right, so the branch column printed the base
wt_status_line() { # prints: name<US>branch<US>base<US>ahead<US>behind<US>dirty<US>last
  local n="$1" p b base ahead behind dirty last
  p=$(wt_path "$n"); b=$(wt_branch "$n")
  base=$(meta_get "$n" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  # counted against the BRANCH, not HEAD: the column is labelled with the branch, and inside a worktree that
  # is mid-bisect or on a detached checkout the two differ — which is the shape of the bug wt rm had.
  ahead=$(git -C "$p" rev-list --count "$base..$b" 2>/dev/null || echo '?')
  behind=$(git -C "$p" rev-list --count "$b..$base" 2>/dev/null || echo '?')
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  last=$(git -C "$p" log -1 --format='%cr' 2>/dev/null || echo '-')
  local cur; cur=$(git -C "$p" branch --show-current 2>/dev/null || true)   # empty, exit 0, on a detached HEAD
  [[ -n "$cur" ]] || cur="$b (HEAD detached)"
  printf '%s\n' "$n$WT_FS$cur$WT_FS$base$WT_FS$ahead$WT_FS$behind$WT_FS$dirty$WT_FS$last"
}

list_names() { # registered worktrees under the wt root
  local root p; root=$(wt_root)
  while IFS= read -r p; do          # the prefix is stripped here, not by sed: a repo path may hold '#'
    [[ "$p" == "$root/"* ]] || continue
    p=${p#"$root/"}
    case "$p" in */*) continue ;; esac
    printf '%s\n' "$p"
  done < <(git -C "$REPO" worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')
  return 0
}

# ---------------------------------------------------------------- commands
cmd_new() {
  local name="" prompt="" stdin_prompt=0 base="" from_head=0 agent="$DEFAULT_AGENT" workspace=1 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--prompt) [[ $# -ge 2 ]] || die "new: $1 needs a brief"; prompt="$2"; shift 2 ;;
      --prompt-stdin) stdin_prompt=1; shift ;;
      -b|--base) [[ $# -ge 2 ]] || die "new: $1 needs a ref"; base="$2"; shift 2 ;;
      --head) from_head=1; shift ;;
      -a|--agent) [[ $# -ge 2 ]] || die "new: $1 needs an agent"; agent="$2"; shift 2 ;;
      --no-workspace) workspace=0; shift ;;
      -r|--repo) [[ $# -ge 2 ]] || die "new: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "new: unknown option $1" ;;
      *) if [[ -z "$name" ]]; then name="$1"; else die "new: unexpected argument $1"; fi; shift ;;
    esac
  done
  if [[ $stdin_prompt -eq 1 ]]; then IFS= read -r -d '' prompt || true; fi
  resolve_repo "$repo"
  name=$(tidy_name "$name")
  [[ -n "$name" ]] || name=$(slugify "$prompt")
  [[ -n "$name" ]] || name="task-$(date +%Y%m%d-%H%M%S)"
  need_name "$name"
  valid_agent "$agent"
  local p b; p=$(wt_path "$name"); b=$(wt_branch "$name")
  [[ -e "$p" ]] && die "worktree '$name' already exists at $p (wt attach $name to open it)"
  git -C "$REPO" show-ref -q --verify "refs/heads/$b" && die "branch $b already exists (kept by wt rm --keep-branch, or by a removal git would not call merged, or left behind by a worktree deleted outside wt); inspect it (git -C $REPO log $b), then delete it (git -C $REPO branch -D $b) or pick another name"
  check_identity "$name"
  if [[ $workspace -eq 1 ]] && is_remote; then   # the row request needs it; fail before anything exists
    wt_host >/dev/null
  fi

  # --head is this checkout's HEAD: its branch name, or its commit when HEAD is detached (mid-rebase, a
  # checked-out tag). Never the literal "HEAD": that resolves in every worktree to the worktree's own tip,
  # so the base would compare the worktree with itself and rm and prune would read it as nothing to lose.
  if [[ $from_head -eq 1 ]]; then
    base=$(git -C "$PWD" symbolic-ref -q --short HEAD 2>/dev/null || git -C "$PWD" rev-parse HEAD 2>/dev/null) \
      || base=$(git -C "$REPO" symbolic-ref -q --short HEAD || git -C "$REPO" rev-parse HEAD)
  fi
  [[ -n "$base" ]] || base=$(default_base)
  if [[ "$base" == origin/* ]]; then
    git -C "$REPO" fetch -q origin "${base#origin/}" 2>/dev/null || warn "fetch of $base failed; using local ref"
  fi
  git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null || die "base ref not found: $base"
  # "HEAD", "@", "HEAD^0", "@{0}" … are all the same thing and re-resolve in every worktree to that
  # worktree's own tip, so a base stored that way would compare the worktree with itself and rm and prune
  # would read it as nothing to lose. Canonicalise instead of blacklisting spellings: only a plain ref name
  # means the same thing in every worktree tomorrow, so keep the ref (--symbolic-full-name names it, in the
  # shorthand it was given in) and pin anything else — an expression or a raw sha — to the commit it means now.
  local sym; sym=$(git -C "$REPO" rev-parse --symbolic-full-name "$base" 2>/dev/null || true)
  # --symbolic-full-name prints the bare word HEAD for a detached checkout, which is not a ref and is exactly
  # the spelling this block exists to catch: only a refs/… answer names the same thing in every worktree.
  case "$sym" in refs/*) ;; *) sym="" ;; esac
  case "$base" in
    "$sym"|"${sym#refs/heads/}"|"${sym#refs/remotes/}"|"${sym#refs/tags/}") ;;
    *) base=$(git -C "$REPO" rev-parse "$base^{commit}") ;;
  esac

  mkdir -p "$(wt_root)"
  git -C "$REPO" worktree add -q -b "$b" "$p" "$base" || die "git worktree add failed"
  local includes; includes=$(copy_includes "$p")
  local setup=""
  if [[ -x "$REPO/.wt-setup" ]]; then
    ( cd "$p" && WT_NAME="$name" WT_REPO="$REPO" "$REPO/.wt-setup" ) || warn ".wt-setup exited non-zero"
    setup=$(setup_dirt "$p")               # recorded even when the hook failed: it may have written half of it
  fi
  mkdir -p "$REPO/.git/wt"
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; fi
  meta_set "$name" "base=$base" "created=$(date -u +%FT%TZ)" "agent=$agent" \
    "title=$(row_title "$name" "$REPO")" "session=$(wt_session "$name" "$REPO")" \
    "includes=$includes" "setup=$setup"

  printf 'created %s\n  path:   %s\n  branch: %s (from %s)\n  repo:   %s\n  session: %s\n' \
    "$name" "$p" "$b" "$base" "$REPO" "$(wt_session "$name" "$REPO")"
  [[ $workspace -eq 1 ]] || return 0
  if is_remote; then request_row "$name"; else open_workspace "$name"; fi   # a VM never starts an agent
  return 0
}

cmd_run() { # run the worktree's agent here; cmux types this into the row's shell, which stays after it exits
  local name="" repo=""
  while [[ $# -gt 0 ]]; do case "$1" in -r|--repo) [[ $# -ge 2 ]] || die "run: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "run: unknown option $1";; *) [[ -z "$name" ]] || die "run: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "run: worktree name required (wt run <name> -r <repo>)"
  resolve_repo "$repo"; require_wt "$name"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH"; export PATH ;; esac
  cd "$P"
  local agent brief="" f rc=0
  agent=$(meta_get "$name" agent 2>/dev/null || true); [[ -n "$agent" ]] || agent="$DEFAULT_AGENT"
  case "$agent" in
    none|shell|"") printf '%s: %s\n  agent:  none — this is your shell\n' "$name" "$P"; return 0 ;;
    claude|codex) ;;
    *) die "unknown agent '$agent' in $(wt_meta "$name")" ;;
  esac
  f=$(wt_prompt "$name")                         # a command substitution would eat the trailing newline
  if [[ -f "$f" ]]; then IFS= read -r -d '' brief <"$f" || true; fi
  local extra=() args=()
  if [[ -n "${WT_AGENT_ARGS:-}" ]]; then
    # shellcheck disable=SC2206   # word splitting is the point
    extra=($WT_AGENT_ARGS)
  fi
  if [[ "$agent" == claude && -e "$(wt_started "$name")" ]]; then
    args=(-c)                                    # resume this worktree's last conversation
  elif [[ -n "$brief" ]]; then
    args=(-- "$brief")                           # codex always restarts from the brief
  fi
  : > "$(wt_started "$name")"
  "$agent" "${extra[@]+"${extra[@]}"}" "${args[@]+"${args[@]}"}" || rc=$?
  [[ $rc -eq 0 ]] || warn "$agent exited with status $rc"
  return 0
}

cmd_list() {
  local all=0 repo=""
  while [[ $# -gt 0 ]]; do case "$1" in --all) all=1;; -r|--repo) [[ $# -ge 2 ]] || die "list: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; *) die "list: unknown option $1";; esac; shift; done
  local repos=()
  if [[ $all -eq 1 ]]; then
    need_repos_dir
    while IFS= read -r d; do repos+=("$d"); done < <(repo_dirs)
  else
    resolve_repo "$repo"; repos=("$REPO")
  fi
  for r in "${repos[@]+"${repos[@]}"}"; do
    set_repo "$r" || continue
    local names; names=$(list_names); [[ -n "$names" ]] || continue
    printf '\n%s  (%s)\n' "$(basename "$REPO")" "$REPO"
    printf '  %-28s %-26s %-16s %6s %6s %6s  %s\n' NAME BRANCH BASE AHEAD BEHIND DIRTY LAST
    while IFS= read -r n; do
      IFS="$WT_FS" read -r nn br base ah be di last <<<"$(wt_status_line "$n")"
      # the columns are numbers: a '?' from a base that no longer resolves must not print as a count
      [[ "$ah" =~ ^[0-9]+$ ]] || ah='?'; [[ "$be" =~ ^[0-9]+$ ]] || be='?'; [[ "$di" =~ ^[0-9]+$ ]] || di=0
      printf '  %-28s %-26s %-16s %6s %6s %6s  %s\n' "$nn" "$br" "$base" "$ah" "$be" "$di" "$last"
    done <<<"$names"
  done
  return 0
}

cmd_show() {
  local name="" diff=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --diff) diff=1;; -r|--repo) [[ $# -ge 2 ]] || die "show: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "show: unknown option $1";; *) [[ -z "$name" ]] || die "show: unexpected argument $1"; name="$1";; esac; shift
  done
  [[ -n "$name" ]] || die "show: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  IFS="$WT_FS" read -r nn br base ah be di last <<<"$(wt_status_line "$name")"
  # the counts are numbers: a '?' from a base that no longer resolves must not print as a count
  [[ "$ah" =~ ^[0-9]+$ ]] || ah='?'; [[ "$be" =~ ^[0-9]+$ ]] || be='?'; [[ "$di" =~ ^[0-9]+$ ]] || di=0
  local title; title=$(meta_get "$name" title 2>/dev/null || true); [[ -n "$title" ]] || title=$(row_title "$name" "$REPO")
  printf '%s\n  path:    %s\n  repo:    %s\n  branch:  %s  (+%s / -%s vs %s)\n  row:     %s\n  task:    %s\n  dirty:   %s file(s)\n  last:    %s\n' \
    "$nn" "$P" "$REPO" "$br" "$ah" "$be" "$base" "$title $(row_tag)" "$(prompt_line "$name")" "$di" "$last"
  if is_remote; then printf '  session: %s\n' "$(session_state "$name")"; fi   # `wt -H … attach` reads this line
  printf '\n--- commits vs %s\n' "$base"; git -C "$P" log --oneline "$base..HEAD" 2>/dev/null | head -20
  printf '\n--- diff --stat vs %s (committed)\n' "$base"; git -C "$P" diff --stat "$base...HEAD" 2>/dev/null | tail -15
  printf '\n--- working tree\n'; git -C "$P" status --short 2>/dev/null | head -20
  if [[ $diff -eq 1 ]]; then
    cmux_ok || die "cmux is not running"
    CMUX_QUIET=1 "$(cmux_bin)" diff --branch --repo "$P" --base "$base" --layout split --title "$name vs $base" --focus true >/dev/null && printf 'opened cmux diff pane\n'
  fi
}

cmd_open() { # wt open [name] [-r PATH] — no name: the worktree holding $PWD
  local name="" repo=""
  while [[ $# -gt 0 ]]; do case "$1" in -r|--repo) [[ $# -ge 2 ]] || die "open: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "open: unknown option $1";; *) [[ -z "$name" ]] || die "open: unexpected argument $1"; name="$1";; esac; shift; done
  if [[ -n "$name" ]]; then
    resolve_repo "$repo"
  else
    local root
    set_repo "$PWD" || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)
    [[ "$root" == "$(wt_root)/"* ]] || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    name=${root#"$(wt_root)/"}
  fi
  require_wt "$name"
  open_worktree "$name"
}

cmd_attach() {
  local name="" agent="" prompt="" repo=""
  while [[ $# -gt 0 ]]; do case "$1" in -a|--agent) [[ $# -ge 2 ]] || die "attach: $1 needs an agent"; agent="$2"; shift;; -p|--prompt) [[ $# -ge 2 ]] || die "attach: $1 needs a brief"; prompt="$2"; shift;; -r|--repo) [[ $# -ge 2 ]] || die "attach: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "attach: unknown option $1";; *) [[ -z "$name" ]] || die "attach: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "attach: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  if [[ -n "$agent" ]]; then valid_agent "$agent"; meta_set "$name" "agent=$agent"; fi
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; rm -f "$(wt_started "$name")"; fi
  if is_remote; then request_row "$name"; else open_workspace "$name"; fi
}

cmd_sync() {
  local name="" merge=0 repo=""
  while [[ $# -gt 0 ]]; do case "$1" in --merge) merge=1;; -r|--repo) [[ $# -ge 2 ]] || die "sync: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "sync: unknown option $1";; *) [[ -z "$name" ]] || die "sync: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "sync: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  [[ "$base" == origin/* ]] && git -C "$REPO" fetch -q origin "${base#origin/}"
  [[ -z "$(git -C "$P" status --porcelain)" ]] || die "worktree has uncommitted changes; commit or stash first"
  if [[ $merge -eq 1 ]]; then git -C "$P" merge --no-edit "$base"; else git -C "$P" rebase "$base"; fi
  printf 'synced %s onto %s\n' "$name" "$base"
}

cmd_pr() {
  local name="" draft=() repo=""
  while [[ $# -gt 0 ]]; do case "$1" in --draft) draft=(--draft);; -r|--repo) [[ $# -ge 2 ]] || die "pr: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "pr: unknown option $1";; *) [[ -z "$name" ]] || die "pr: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "pr: worktree name required"
  resolve_repo "$repo"; require_wt "$name"; have gh || die "gh not installed"
  [[ -z "$(git -C "$P" status --porcelain)" ]] || die "worktree has uncommitted changes; commit first"
  git -C "$P" push -u origin "$B"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  ( cd "$P" && gh pr create --fill --base "${base#origin/}" "${draft[@]+"${draft[@]}"}" )
}

cmd_rm() {
  local name="" force=0 keep=0 repo=""
  while [[ $# -gt 0 ]]; do case "$1" in --force|-f) force=1;; --keep-branch) keep=1;; -r|--repo) [[ $# -ge 2 ]] || die "rm: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "rm: unknown option $1";; *) [[ -z "$name" ]] || die "rm: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "rm: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  local here there; here=$(pwd -P); there=$(cd "$P" 2>/dev/null && pwd -P) || there="$P"   # a symlinked cwd is still inside
  [[ "$here" == "$there" || "$here" == "$there/"* ]] && die "you are inside $name; cd out first (e.g. cd $REPO)"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  if [[ $force -eq 0 ]]; then
    local reasons=() r
    while IFS= read -r r; do
      if [[ -n "$r" ]]; then reasons+=("$r"); fi
    done <<<"$(rm_reasons "$name" "$P" "$B" "$base")"
    if [[ ${#reasons[@]} -gt 0 ]]; then
      printf 'wt: refusing to remove %s: %s\n' "$name" "$(IFS=';'; echo "${reasons[*]}")" >&2
      printf 'wt: inspect with: wt show %s — then push/merge, check the branch out again or copy the file back, or re-run with --force to discard.\n' "$name" >&2
      exit 3
    fi
  fi
  # remaining ignored files are unchanged copies or build output, so --force is the normal path here
  if [[ -d "$P" ]]; then
    git -C "$REPO" worktree remove --force "$P" || die "git worktree remove failed for $P; free it, then: rm -rf $P && git -C $REPO worktree prune"
  else
    git -C "$REPO" worktree prune          # the directory went away outside wt; drop the registration
  fi
  if [[ $keep -eq 0 ]]; then
    # branch -d, so git's own merged-check is the last line of defence behind the reasons above; --force
    # stays the one deliberate way to discard commits, and otherwise the branch is kept and said to be kept
    if ! git -C "$REPO" branch -d "$B" >/dev/null 2>&1; then
      if [[ $force -eq 1 ]]; then git -C "$REPO" branch -D "$B" >/dev/null 2>&1 || true
      else keep=1; warn "kept branch $B: git will not delete it as merged (git -C $REPO branch -D $B discards it)"; fi
    fi
  fi
  rm -f "$(wt_meta "$name")" "$(wt_prompt "$name")" "$(wt_started "$name")"
  git -C "$REPO" worktree prune
  if is_remote; then tmux kill-session -t "=$(wt_session "$name" "$REPO")" 2>/dev/null || true   # the Mac owns the row
  else close_workspace "$name"; fi
  printf 'removed %s%s\n' "$name" "$([[ $keep -eq 1 ]] && echo " (branch $B kept)")"
}

cmd_prune() {
  local dry=0 repo=""
  while [[ $# -gt 0 ]]; do case "$1" in --dry-run|-n) dry=1;; -r|--repo) [[ $# -ge 2 ]] || die "prune: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; *) die "prune: unknown option $1";; esac; shift; done
  resolve_repo "$repo"
  local names n p base why
  names=$(list_names)     # before `git worktree prune`: a directory deleted by hand would otherwise lose its
                          # registration here and never be examined, leaving its branch and metadata forever
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    p=$(wt_path "$n"); base=$(meta_get "$n" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
    why=$(rm_reasons "$n" "$p" "$(wt_branch "$n")" "$base" | tr '\n' ';'); why="${why%;}"   # the same reasons as rm,
    if [[ -n "$why" ]]; then printf 'keep %s (%s)\n' "$n" "$why"                            # dry run included
    elif [[ $dry -eq 1 ]]; then printf 'would remove %s (nothing to lose vs %s)\n' "$n" "$base"
    elif ! ( cd "$REPO" && cmd_rm "$n" ); then printf 'keep %s (removal refused above)\n' "$n"; fi
  done <<<"$names"
  git -C "$REPO" worktree prune
}

cmd_path() {
  local name="" repo=""
  while [[ $# -gt 0 ]]; do case "$1" in -r|--repo) [[ $# -ge 2 ]] || die "path: $1 needs a repo"; repo="$2"; shift;; -h|--help) usage; exit 0;; -*) die "path: unknown option $1";; *) [[ -z "$name" ]] || die "path: unexpected argument $1"; name="$1";; esac; shift; done
  [[ -n "$name" ]] || die "path: worktree name required"
  resolve_repo "$repo"; require_wt "$name"; printf '%s\n' "$P"
}
cmd_repos()   { # wt repos [<name>] [--porcelain|--table]. No name: every repo, as a table (name, how many task
                # worktrees it holds, location) when stdout is a terminal or with --table, which is how
                # `wt -H <host> repos` asks a VM for one; as "<name><tab><path>" per repo, the picker's two
                # columns, when piped or with --porcelain. A name or path: just that repo's path (also over ssh).
  local mode="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --porcelain|--table) mode="${1#--}" ;;
      -*) die "repos: unknown option $1 (wt repos [<name>] [--porcelain|--table])" ;;
      *) [[ -z "$name" ]] || die "repos: one name at most (wt repos [<name>])"; name="$1" ;;   # the one resolution rule
    esac
    shift
  done
  if [[ -n "$name" ]]; then lookup_repo "$name"; printf '%s\n' "$REPO"; return 0; fi
  need_repos_dir
  if [[ -z "$mode" ]]; then if [[ -t 1 ]]; then mode=table; else mode=porcelain; fi; fi
  if [[ "$mode" == porcelain ]]; then repo_dirs | awk -F/ '{printf "%s\t%s\n", $NF, $0}'; return 0; fi
  local d n
  while IFS= read -r d; do                     # "<name><tab><path><tab><tasks>": what repo_menu table lays out
    [[ -n "$d" ]] || continue
    n=0; if set_repo "$d"; then n=$(list_names | grep -c . || true); fi
    printf '%s\t%s\t%s\n' "${d##*/}" "$d" "$n"
  done < <(repo_dirs) | repo_menu table
}
cmd_current() {
  while [[ $# -gt 0 ]]; do case "$1" in -h|--help) usage; exit 0;; *) die "current: unexpected argument $1 (wt current takes none)";; esac; done
  local root common
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  common=$(main_root_of "$PWD") || die "not in a git repo"
  if [[ "$root" == "$common" ]]; then printf 'main checkout: %s (%s)\n' "$root" "$(git branch --show-current)"
  else printf 'worktree: %s\n  branch: %s\n  main:   %s\n' "$root" "$(git branch --show-current)" "$common"; fi
}

# ---------------------------------------------------------------- driver and self-update
cmd_driver() { # the session that spawns tasks; its cwd is a repos folder, so `wt new` there needs -r
  # the args are parsed, not ignored: `wt driver -h` used to create or select the row instead of printing usage
  while [[ $# -gt 0 ]]; do case "$1" in -h|--help) usage; exit 0;; *) die "driver: unexpected argument $1 (wt driver takes none)";; esac; done
  mac_only driver
  cmux_ok || die "cmux is not running; start cmux, then: wt driver"
  local c id out cwd; c=$(cmux_bin)
  id=$(cmux_row_field driver id)
  if [[ -n "$id" ]]; then
    CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
    printf 'driver %s (selected)\n' "$(row_tag)"
    return 0
  fi
  need_repos_dir
  cwd=$(repos_entries | sed -n 1p)                                   # the first folder that exists
  out=$(CMUX_QUIET=1 "$c" workspace create --name driver --description "$(row_tag)" --cwd "$cwd" --command claude --focus true 2>&1) \
    || die "cmux workspace create failed: $out"
  printf 'driver %s (created)\n' "$(row_tag)"
}

cmd_update() { # pull this repo and re-run its installer
  # install.sh's own flags are forwarded rather than rejected: the opt-ins are sticky, so a plain update
  # keeps what this machine chose, but opting IN later has to be possible through the command the docs name.
  local pass=()
  while [[ $# -gt 0 ]]; do case "$1" in --refresh-config|--opinionated-config|--with-*) pass+=("$1");; -h|--help) usage; exit 0;; *) die "update: unknown option $1";; esac; shift; done
  local s="$0" dir
  if [[ -L "$s" ]]; then s=$(readlink "$s"); fi            # ~/.local/bin/wt -> <repo>/bin/wt
  [[ "$s" == /* ]] || s="$(dirname "$0")/$s"
  dir=$(cd "$(dirname "$s")/.." && pwd -P)
  [[ -d "$dir/.git" ]] || die "$dir is not a git clone; replace the seed: mv $dir $dir.seed && git clone https://github.com/mal84emma/workgrove $dir"
  local ans
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 \
    || die "$dir has no upstream branch; set one: git -C $dir branch --set-upstream-to origin/main"
  git -C "$dir" fetch --quiet || die "git fetch failed in $dir"
  # containment, not equality: a clone that is merely ahead (a local commit, normal on the machine where you
  # edit bin/wt) has nothing incoming, and comparing tips would show your own work as an incoming deletion
  if git -C "$dir" merge-base --is-ancestor '@{u}' HEAD 2>/dev/null; then
    printf 'Already up to date.\n'
  else                                                     # `wt update` runs install.sh, so show the code first
    printf 'incoming commits:\n'; git -C "$dir" --no-pager log --oneline 'HEAD..@{u}'
    printf '\nfiles changed:\n';  git -C "$dir" --no-pager diff --stat 'HEAD..@{u}'
    [[ -t 0 ]] || die "update: refusing to apply these commits unattended; run wt update from an interactive terminal (for a VM, wt -H <vm> update from one, or a shell on the VM)"
    printf '\n'
    read -r -p "apply them and run $dir/install.sh? [y/N] " ans || ans=""
    [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]] || die "update: cancelled"
    git -C "$dir" merge --ff-only '@{u}'
  fi
  bash "$dir/install.sh" "${pass[@]+"${pass[@]}"}"
}

# ---------------------------------------------------------------- wt -H <host> …
remote_sh() { # remote_sh <host> <command> — one ssh call; 255 means we never reached the VM
  local host="$1" cmd="$2" rc=0
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$cmd" || rc=$?
  if [[ $rc -eq 255 ]]; then die "host unreachable: is the VM running? (ssh $host)"; fi
  return $rc
}
remote_wt() { local host="$1"; shift; remote_sh "$host" "exec \"\$HOME/.local/bin/wt\" $(shell_join "$@")"; }
remote_sh_tty() { # remote_sh_tty <host> <command> — remote_sh, but lends the VM this terminal when we have one,
                  # so a command that asks before it acts (wt update) can read the answer. Never for a caller
                  # that captures stdout: a pty folds stderr into it and turns every \n into \r\n. Without a
                  # local terminal there is nothing to lend, and the VM's own refusal is the right answer.
  local host="$1" cmd="$2" rc=0 tty=()
  [[ -t 0 ]] && tty=(-t)                                   # -t and BatchMode=yes agree: BatchMode only gags prompts
  ssh -o BatchMode=yes -o ConnectTimeout=5 "${tty[@]+"${tty[@]}"}" "$host" "$cmd" || rc=$?
  if [[ $rc -eq 255 ]]; then die "host unreachable: is the VM running? (ssh $host)"; fi
  return $rc
}
remote_wt_tty() { local host="$1"; shift; remote_sh_tty "$host" "exec \"\$HOME/.local/bin/wt\" $(shell_join "$@")"; }
# shellcheck disable=SC2016   # $HOME must reach the VM unexpanded
remote_run_cmd() { printf '"$HOME/.local/bin/wt" run %s -r %s' "$1" "$(shell_join "$2")"; }

tag_row() { # tag_row <workspace ref or ""> <title> <host> — write the row's description
  local ref="$1"
  for _ in 1 2 3; do                    # no workspace:N in the output: the row list lags ~1s behind create
    [[ -n "$ref" ]] && break
    sleep 1; ref=$(cmux_row_field "$2" id "$3")
  done
  [[ -n "$ref" ]] || die "cmux reported no row '$2' on $3; find it with: cmux workspace list --json"
  CMUX_QUIET=1 "$(cmux_bin)" workspace-action --workspace "$ref" --action set-description --description "$(row_tag "$3")" >/dev/null 2>&1 \
    || die "cmux workspace-action failed; run: cmux workspace-action --workspace $ref --action set-description --description $(row_tag "$3")"
}

tmux_cmd() { # tmux_cmd <session> [command] [shared]
  # The line a VM row's shell runs: create that tmux session (running <command>, then a shell) or take over
  # the one already there. A task row owns its session, so it attaches with -d and hands the session THIS
  # row's relay socket and workspace id, which is what makes `cmux notify` from inside it light up this row.
  # The shell cmux starts after "remote session was lost" carries none of the CMUX_* variables, and
  # ~/.tmux.conf carries both in update-environment (install.sh links home/.tmux.conf with --with-tmux-conf,
  # or appends that one line to the file you already have), so attaching from it would mark them removed in the
  # session and silence `cmux notify` there. Each is therefore taken from the session when the shell has
  # none (the row's old relay port stays bound to the row), and only set when it is non-empty.
  # A session you may also be sitting in yourself (the VM shell, a repo shell) is passed "shared" instead:
  # the row joins your clients rather than evicting them, and leaves their relay socket as it is.
  # bin/cmux-hook mirrors this function; keep the two byte-for-byte.
  local run=""
  [[ -n "${2:-}" ]] && printf -v run '%q' "$2; exec bash"
  if [[ "${3:-}" == shared ]]; then
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; tmux attach -t '=%s'" "$1" "$run" "$1"
  else
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; [ -n \"\$CMUX_SOCKET_PATH\" ] || export CMUX_SOCKET_PATH=\"\$(tmux show-environment -t '=%s' CMUX_SOCKET_PATH 2>/dev/null | sed -n 's/^CMUX_SOCKET_PATH=//p')\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] || export CMUX_WORKSPACE_ID=\"\$(tmux show-environment -t '=%s' CMUX_WORKSPACE_ID 2>/dev/null | sed -n 's/^CMUX_WORKSPACE_ID=//p')\"; [ -n \"\$CMUX_SOCKET_PATH\" ] && tmux set-environment -t '=%s' CMUX_SOCKET_PATH \"\$CMUX_SOCKET_PATH\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] && tmux set-environment -t '=%s' CMUX_WORKSPACE_ID \"\$CMUX_WORKSPACE_ID\"; tmux attach -d -t '=%s'" "$1" "$run" "$1" "$1" "$1" "$1" "$1"
  fi
}

remote_row() { # remote_row <host> <session> <title> <command> [shared] [cmux flags…] — the local ssh row for a
               # VM tmux session. One row per title and host: a row that is already there is re-tagged and
               # (unless --no-focus) selected, never typed into, because its pane may hold a running agent
               # whose prompt would swallow the tmux line. Only host_attach's detached branch sends.
  local host="$1" session="$2" title="$3" cmd="$4" shared="" c id line out; shift 4
  if [[ "${1:-}" == shared ]]; then shared=shared; shift; fi
  cmux_ok || die "cmux is not running; start cmux, then re-run this command"
  c=$(cmux_bin)
  id=$(cmux_row_field "$title" id "$host")
  if [[ -n "$id" ]]; then
    tag_row "$id" "$title" "$host"
    case " $* " in
      *" --no-focus "*) ;;
      *) CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id" ;;
    esac
    printf 'row: %s %s (already open)\n' "$title" "$(row_tag "$host")"
    return 0
  fi
  line=$(tmux_cmd "$session" "$cmd" "$shared")
  out=$(CMUX_QUIET=1 "$c" ssh "$host" --name "$title" "$@" --command "$line" 2>&1) || die "cmux ssh failed: $out"
  tag_row "$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1 || true)" "$title" "$host"
  printf 'row: %s %s\n' "$title" "$(row_tag "$host")"
}

need_r() { # need_r <host> <sub> <args…> — a remote call has no cwd to infer the repo from, so -r is required.
  # Presence is all this tests: cmd_host has already normalised the value and refused an empty, relative,
  # '.' or '..' one, so there is nothing left here that a command would have rejected for itself.
  # -h wins over the requirement: asking what a command takes must answer, not complain that an argument
  # it is asking about is missing. Each command's own parser then handles -h.
  local host="$1" sub="$2" a; shift 2
  for a in "$@"; do
    case "$a" in
      -h|--help) return 0 ;;
      -r|--repo) return 0 ;;
    esac
  done
  die "$sub: -r <repo> is required with -H (wt -H $host repos lists them)"
}

host_new() { # create the worktree on the VM, then the cmux row here
  local host="$1" prompt="" args=(); shift
  # both ways of giving a brief are consumed HERE and relayed the same way: forwarding --prompt-stdin to the
  # VM instead would read nothing locally and pipe an empty prompt into ssh, creating the task with no brief
  while [[ $# -gt 0 ]]; do case "$1" in
    -p|--prompt) [[ $# -ge 2 ]] || die "new: $1 needs a brief"; prompt="$2"; shift 2 ;;
    --prompt-stdin) IFS= read -r -d '' prompt || true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac; done
  local out name repo session
  out=$(printf '%s' "$prompt" | remote_wt "$host" new "${args[@]+"${args[@]}"}" --no-workspace --prompt-stdin)
  printf '%s\n' "$out"
  name=$(printf '%s\n' "$out" | sed -n 's/^created //p' | head -1)
  repo=$(printf '%s\n' "$out" | sed -n 's/^ *repo: *//p' | head -1)
  session=$(printf '%s\n' "$out" | sed -n 's/^ *session: *//p' | head -1)
  [[ -n "$name" && -n "$repo" && -n "$session" ]] || die "$host did not report created/repo/session (try: wt -H $host list)"
  valid_name "$name" && [[ "$session" == "$(wt_session "$name" "$repo")" ]] || die "unexpected output from $host"
  remote_row "$host" "$session" "$(row_title "$name" "$repo")" "$(remote_run_cmd "$name" "$repo")" --no-focus
}

agent_on_vm() { # agent_on_vm <host> <session> — 0 when claude or codex holds a pane tty of that tmux session;
                # the same pgrep session_state runs, so an older wt on the VM cannot hide an agent from us
  local q; q=$(shell_join "=$2")
  remote_sh "$1" "for t in \$(tmux list-panes -s -t $q -F '#{pane_tty}' 2>/dev/null); do pgrep -t \"\${t#/dev/}\" -x 'claude|codex' >/dev/null 2>&1 && exit 0; done; exit 1" >/dev/null 2>&1
}

host_attach() { # re-attach to the VM's session; starting an agent again is never implicit
  local host="$1" restart=0 reattach=0 name="" repo=""; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --restart-agent) restart=1; shift ;;
      --reattach) reattach=1; shift ;;
      -r|--repo) [[ $# -ge 2 ]] || die "attach: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "attach: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "attach: unexpected argument $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "attach: worktree name required (wt -H $host attach -r <repo> <name>)"
  if [[ $restart -eq 1 && $reattach -eq 1 ]]; then die "attach: --reattach and --restart-agent do opposite things; pick one"; fi
  local out session state title id path c screen last what=selected
  out=$(remote_wt "$host" show "$name" -r "$repo")
  session=$(printf '%s\n' "$out" | sed -n 's/^ *session: *//p' | head -1)
  path=$(printf '%s\n' "$out" | sed -n 's/^ *repo: *//p' | head -1)
  [[ -n "$session" && -n "$path" ]] || die "$host reported no session for $name (try: wt -H $host show $name -r $(shell_join "$repo"))"
  state="${session#*(}"; state="${state%)}"; session="${session%% *}"
  valid_name "$name" && [[ "$session" == "$(wt_session "$name" "$path")" ]] || die "unexpected output from $host"
  title=$(row_title "$name" "$path")
  if [[ $reattach -eq 1 ]]; then  # A dropped connection can leave the row with a fresh login shell while the VM
                                  # keeps the pty that holds tmux, so the abandoned client is still listed and
                                  # session_state cannot call the session detached. The flag is the user's word
                                  # that the row shows a shell; the screen check is the backstop that stops the
                                  # tmux line from being typed into a running agent's prompt.
    id=$(cmux_row_field "$title" id "$host")
    [[ -n "$id" ]] || die "no row $title $(row_tag "$host") is open; wt -H $host attach -r $(shell_join "$repo") $name opens one"
    c=$(cmux_bin)
    screen=$(CMUX_QUIET=1 "$c" read-screen --workspace "$id" 2>/dev/null || true)
    last=$(printf '%s\n' "$screen" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -1)
    case "$last" in
      *'$'|*'#'|*'%') ;;
      *) die "$title $(row_tag "$host") does not end at a shell prompt (last line: ${last:-empty}); it is probably still attached to tmux. Select the row and look, then re-run, or attach by hand there: tmux attach -d -t '=$session'" ;;
    esac
    CMUX_QUIET=1 "$c" send --workspace "$id" "$(tmux_cmd "$session")" >/dev/null 2>&1 \
      || die "cmux send failed for $id; type this in the row instead: tmux attach -d -t '=$session'"
    CMUX_QUIET=1 "$c" send-key --workspace "$id" enter >/dev/null 2>&1 \
      || die "cmux send-key failed for $id; press return in the row to finish the attach"
    CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
    printf 'row: %s %s (re-attached)\n' "$title" "$(row_tag "$host")"
    return 0
  fi
  if [[ $restart -eq 1 ]]; then
    if agent_on_vm "$host" "$session"; then   # a VM running an older wt reports a live agent as 'shell only'
      die "$name on $host still has an agent running; wt -H $host attach -r $(shell_join "$repo") $name re-attaches it, or wt -H $host update if the VM's wt is older than the Mac's"
    fi
    remote_sh "$host" "exec tmux kill-session -t $(shell_join "=$session")" >/dev/null 2>&1 || true
    close_row "$(cmux_row_field "$title" id "$host")"
    for _ in 1 2 3; do                     # remote_row only ever creates when no row is left, so wait it out
      [[ -n "$(cmux_row_field "$title" id "$host")" ]] || break
      sleep 1
    done
    [[ -z "$(cmux_row_field "$title" id "$host")" ]] \
      || die "row $title $(row_tag "$host") is still open; close it in cmux, then re-run: wt -H $host attach --restart-agent -r $(shell_join "$repo") $name"
    remote_row "$host" "$session" "$title" "$(remote_run_cmd "$name" "$path")" --no-focus
    return 0
  fi
  case "$state" in
    "agent running"|"agent running, detached") ;;
    *) die "$name on $host has no agent pane ($state); restart it: wt -H $host attach --restart-agent -r $(shell_join "$repo") $name; if an agent is visibly running there, the VM's wt is older than the Mac's: wt -H $host update" ;;
  esac
  id=$(cmux_row_field "$title" id "$host")
  [[ -n "$id" ]] || { remote_row "$host" "$session" "$title" ""; return 0; }
  c=$(cmux_bin)
  if [[ "$state" == *detached ]]; then   # the one place an existing row is typed into: the VM reported no tmux
                                         # client, so the row kept its ssh but lost the pty that held tmux
    what=re-attached
    CMUX_QUIET=1 "$c" send --workspace "$id" "$(tmux_cmd "$session")" >/dev/null 2>&1 \
      || die "cmux send failed for $id; re-create the row: wt -H $host attach --restart-agent -r $(shell_join "$repo") $name"
    CMUX_QUIET=1 "$c" send-key --workspace "$id" enter >/dev/null 2>&1 \
      || die "cmux send-key failed for $id; press return in the row to finish the attach"
  fi
  CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
  printf 'row: %s %s (%s)\n' "$title" "$(row_tag "$host")" "$what"
}

host_open() { # VS Code Remote-SSH on a VM worktree
  local host="$1" name="" repo=""; shift
  while [[ $# -gt 0 ]]; do case "$1" in -r|--repo) [[ $# -ge 2 ]] || die "open: $1 needs a repo"; repo="$2"; shift 2;; -h|--help) usage; exit 0;; -*) die "open: unknown option $1";; *) [[ -z "$name" ]] || die "open: unexpected argument $1"; name="$1"; shift;; esac; done
  [[ -n "$name" ]] || die "open: worktree name required (wt -H $host open -r <repo> <name>)"
  local p; p=$(remote_wt "$host" path "$name" -r "$repo")
  hook_safe_path "$p" || die "open: refusing an unsafe path from $host ($p)"
  open_code "vscode-remote://ssh-remote+$host$p/" "$host:$p"
}

host_rm() { # remove on the VM, close the row, then kill the session (closing first stops cmux recreating it)
  local host="$1" name="" repo="" args=(); shift
  while [[ $# -gt 0 ]]; do case "$1" in -r|--repo) [[ $# -ge 2 ]] || die "rm: $1 needs a repo"; repo="$2"; shift 2;; -h|--help) usage; exit 0;; -*) args+=("$1"); shift;; *) [[ -z "$name" ]] || die "rm: unexpected argument $1"; name="$1"; shift;; esac; done
  [[ -n "$name" ]] || die "rm: worktree name required (wt -H $host rm -r <repo> <name>)"
  # the row's identity is built from -r, which cmd_host has already refused unless it is an absolute path or
  # a plain repo name — a relative '.' or '..' would make repo_id '-' and close_row would close nothing
  local session title; session=$(wt_session "$name" "$repo"); title=$(row_title "$name" "$repo")
  remote_wt "$host" rm "$name" -r "$repo" "${args[@]+"${args[@]}"}"
  close_row "$(cmux_row_field "$title" id "$host")"
  remote_sh "$host" "exec tmux kill-session -t $(shell_join "=$session")" >/dev/null 2>&1 || true
}

cmd_host() { # wt -H <host> <sub> … — a stateless ssh passthrough; the Mac caches nothing about VMs
  local host="$1" sub="${2:-}" args=() v; shift 2
  valid_host "$host" || die "invalid host '$host' (an ssh alias: letters, digits, '.', '_' and '-')"
  while [[ $# -gt 0 ]]; do   # normalise -r once: a trailing '/' would change repo_id, and so the identity
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "$sub: $1 needs a repo"; v="$2"; while [[ "$v" == */ && "$v" != / ]]; do v="${v%/}"; done
                 # a relative path means nothing on the VM and its basename is not the repo's: host_rm would
                 # then build a row title nobody has ('.' -> '-') and close a row that does not exist
                 case "$v" in /*) ;; ""|.|..|*/*) die "$sub: -r must be an absolute path on $host, or a repo name there (wt -H $host repos lists them)" ;; esac
                 args+=("$1" "$v"); shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  case "$sub" in
    new)       host_new "$host" "$@" ;;
    attach)    need_r "$host" "$sub" "$@"; host_attach "$host" "$@" ;;
    open)      need_r "$host" "$sub" "$@"; host_open "$host" "$@" ;;
    rm)        need_r "$host" "$sub" "$@"; host_rm "$host" "$@" ;;
    list)      remote_wt "$host" list --all "$@" ;;
    show|path) need_r "$host" "$sub" "$@"; remote_wt "$host" "$sub" "$@" ;;
    repos)     if [[ -t 1 ]]; then case " $* " in *" --porcelain "*|*" --table "*) ;; *) set -- "$@" --table ;; esac; fi
               remote_wt "$host" repos "$@" ;;     # ssh gives the VM no terminal, so ask for the table explicitly
    update)    remote_wt_tty "$host" "$sub" "$@" ;;   # the VM asks before it installs, so it needs a terminal
    help)      remote_wt "$host" "$sub" "$@" ;;
    *) die "wt -H: '$sub' does not run remotely (new attach list show rm path open repos update help)" ;;
  esac
}

# ---------------------------------------------------------------- wt task
task_exit() { # the launcher row closes on exit, so let a message be read first
  local rc=$?
  if [[ $rc -ne 0 && -t 0 ]]; then read -r -p 'press return' _ || true; fi
}
ssh_hosts() { # non-wildcard Host aliases, read as bin/cmux-hook reads them
  { awk '$1=="Host"{for(i=2;i<=NF;i++){if($i ~ /^#/)break; if($i !~ /[*?]/) print $i}}' "$HOME/.ssh/config" 2>/dev/null || true; } | sort -u
}
repo_menu() { # repo_menu [table] — lays out cmd_repos' "<name><tab><path>[<tab><tasks>]" lines. Default: picker
              # rows "<name><tab><path><tab><display>", the display being the name padded to the widest, then a
              # grey location. "table": the terminal listing, a grey header then name, task count ("-" for none)
              # and location per repo. The location is "~" for this home, then at most the three folders above
              # the repo, never the repo itself.
  awk -F'\t' -v home="$HOME" -v table="${1:-}" -v grey=$'\033[90m' -v off=$'\033[0m' '
    function loc(p,   par, m, a) {   # the local home as "~", then the three folders above the repo, never the repo
      if (home != "" && index(p, home "/") == 1) p = "~" substr(p, length(home) + 1)
      par = p; sub(/\/[^\/]*$/, "", par)
      if (par == "") return "/"
      m = split(par, a, "/")
      if (m <= 3) return par
      return a[m-2] "/" a[m-1] "/" a[m]
    }
    { rn[NR] = $1; rp[NR] = $2; rt[NR] = $3; if (length($1) > w) w = length($1) }
    END {
      if (NR == 0) exit
      if (table != "") {
        if (w < 4) w = 4
        printf "%s%-" (w + 2) "s%-7s%s%s\n", grey, "NAME", "TASKS", "LOCATION", off
        for (j = 1; j <= NR; j++) {
          t = sprintf("%-7s", rt[j] == "0" ? "-" : rt[j]); if (rt[j] == "0") t = grey t off
          printf "%-" (w + 2) "s%s%s%s%s\n", rn[j], t, grey, loc(rp[j]), off
        }
        exit
      }
      fmt = "%s\t%s\t%-" (w + 2) "s%s%s%s\n"
      for (j = 1; j <= NR; j++) printf fmt, rn[j], rp[j], rn[j], grey, loc(rp[j]), off
    }
  '
}
pick() { # pick <prompt> [fzf args…] — a line of stdin, or whatever was typed (fzf --print-query: query, selection)
  local out rc=0 q s p="$1"; shift
  out=$(fzf --print-query --prompt "$p> " --height 40% --reverse "$@") || rc=$?
  [[ $rc -le 1 ]] || return 1                                   # 130: aborted
  q=$(printf '%s\n' "$out" | sed -n '1p'); s=$(printf '%s\n' "$out" | sed -n '2p')
  printf '%s' "${s:-$q}"
}

cmd_task() {
  mac_only task
  local where="" kind="" repo="" name="" brief="" asked=1 id out
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --where) [[ $# -ge 2 ]] || die "task: $1 needs local or a host"; where="$2"; shift 2 ;;
      -a|--agent) [[ $# -ge 2 ]] || die "task: $1 needs a kind"; kind="$2"; shift 2 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "task: $1 needs a repo"; repo="$2"; shift 2 ;;
      -p|--prompt) [[ $# -ge 2 ]] || die "task: $1 needs a brief"; brief="$2"; asked=0; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "task: unknown option $1" ;;
    esac
  done
  trap task_exit EXIT
  have fzf || die "fzf not found (brew install fzf)"

  if [[ -z "$where" ]]; then where=$({ printf 'local\n'; ssh_hosts; } | pick where) || die "task: cancelled"; fi
  [[ -n "$where" ]] || die "task: no host picked"
  if [[ "$where" != local ]]; then
    valid_host "$where" || die "task: invalid host '$where' (an ssh alias: letters, digits, '.', '_' and '-')"
    if ! ssh_hosts | grep -qxF "$where"; then
      warn "cmux will try '$where'; make sure 'ssh $where' works first. Requests from inside that VM (VS Code, new rows) need a Host entry."
    fi
  fi

  if [[ -z "$kind" ]]; then
    kind=$({ printf 'claude\ncodex\nrepo-shell\n'; [[ "$where" == local ]] || printf 'vm-shell\n'; } | pick kind) || die "task: cancelled"
  fi
  case "$kind" in
    claude|codex|repo-shell) ;;
    vm-shell) [[ "$where" != local ]] || die "task: vm-shell needs a VM; for a local shell pick repo-shell" ;;
    *) die "task: unknown kind '$kind' (claude, codex, repo-shell, vm-shell)" ;;
  esac

  if [[ "$kind" != vm-shell && -z "$repo" ]]; then
    local list sel                               # "<name><tab><path>": two folders can hold the same basename,
    if [[ "$where" == local ]]; then             # so the path column, not the name, is what starts the task
      list=$(cmd_repos) || exit 1                # cmd_repos has already said what is wrong; do not repeat it
      [[ -n "$list" ]] || die "task: no repos in WT_REPOS_DIR ($REPOS_PATH); clone one, or pass -r <path>"
    else
      list=$(remote_wt "$where" repos) || exit 1   # no flag: ssh gives the VM no terminal, so this is the plain form on any wt version
      [[ -n "$list" ]] || die "task: no repos on $where (see: wt -H $where repos)"
    fi
    sel=$(printf '%s\n' "$list" | repo_menu | pick repo --ansi --delimiter $'\t' --with-nth 3 --nth 1,3) \
      || die "task: cancelled"
    [[ -n "$sel" ]] || die "task: no repo picked"
    sel="${sel%$'\t'*}"; repo="${sel##*$'\t'}"   # the path column; a typed query has no tab and is taken as given
  fi
  if [[ "$kind" == claude || "$kind" == codex ]]; then       # the name is never known from the options
    read -r -p 'name (blank = from brief)> ' name || true
    name=$(tidy_name "$name"); [[ -z "$name" ]] || need_name "$name"   # a '-…' name would otherwise reach cmd_new as an option
    if [[ $asked -eq 1 ]]; then read -r -p 'brief> ' brief || true; fi
  fi

  case "$kind" in
    claude|codex)
      args=(-r "$repo" -a "$kind" -p "$brief")                # cmd_new validates the name and slugifies a blank one
      if [[ -n "$name" ]]; then args+=("$name"); fi
      if [[ "$where" == local ]]; then cmd_new "${args[@]}"
      else host_new "$where" "${args[@]}"; fi ;;
    repo-shell)
      if [[ "$where" == local ]]; then
        resolve_repo "$repo"; id=$(repo_id "$REPO")
        cmux_ok || die "cmux is not running; start cmux, then: wt task"
        out=$(CMUX_QUIET=1 "$(cmux_bin)" workspace create --name "$id shell" --description "$(row_tag)" --cwd "$REPO" 2>&1) \
          || die "cmux workspace create failed: $out"
        printf 'row: %s shell %s\n' "$id" "$(row_tag)"
      else
        id=$(repo_id "$repo")   # the VM's own wt resolves the name against its $WT_REPOS_DIR; on a failed
                                # lookup its error stays on screen and the pane keeps $HOME as its cwd
        remote_row "$where" "shell-$id" "$id shell" "d=\$(\"\$HOME/.local/bin/wt\" repos $(shell_join "$repo")) && cd \"\$d\"" shared
      fi ;;
    vm-shell) remote_row "$where" main shell "" shared ;;
  esac
}

# ---------------------------------------------------------------- dispatch
# One guard, not one per caller: jq reads and writes every sidecar (meta_get/meta_set), reads cmux's row list
# and builds the relay body, so a missing jq is not a per-command problem. Left to fail where it is used it
# fails quietly — meta_get's error is swallowed at every call site and `base` silently becomes default_base(),
# which is the base `wt rm` then judges "not merged" against — or halfway through `wt new`, after
# `git worktree add` has already registered a worktree. So refuse up front, and leave `wt help` readable
# so the line that fixes it is still one command away.
need_jq() { have jq || die "jq not found (brew install jq, or sudo apt-get install -y jq)"; }
if [[ "${1:-}" == -H || "${1:-}" == --host ]]; then
  [[ $# -ge 3 ]] || die "usage: wt -H <host> <command> [args] (wt help)"
  host="$2"; shift 2
  [[ "${1:-}" == help ]] || need_jq
  cmd_host "$host" "$@"
  exit
fi
sub="${1:-help}"; shift || true
case "$sub" in help|-h|--help) ;; *) need_jq ;; esac
case "$sub" in
  new)      cmd_new "$@" ;;
  run)      cmd_run "$@" ;;
  list|ls)  cmd_list "$@" ;;
  show)     cmd_show "$@" ;;
  open)     cmd_open "$@" ;;
  diff)     [[ $# -gt 0 ]] || die "diff: worktree name required"; cmd_show "$@" --diff ;;   # appended, never
                                                                  # spliced: "-r <path> <name>" starts with -r
  attach)   cmd_attach "$@" ;;
  sync)     cmd_sync "$@" ;;
  pr)       cmd_pr "$@" ;;
  rm|remove) cmd_rm "$@" ;;
  prune)    cmd_prune "$@" ;;
  path)     cmd_path "$@" ;;
  repos)    cmd_repos "$@" ;;
  task)     cmd_task "$@" ;;
  driver)   cmd_driver "$@" ;;
  update)   cmd_update "$@" ;;
  current|cur) cmd_current "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$sub' (wt help)" ;;
esac
