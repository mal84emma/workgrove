#!/usr/bin/env bash
# wt — task worktrees for coding agents (git worktree + cmux row + VS Code on demand).
#
# One task is one worktree at <repo>/.worktrees/<name> on branch wt/<name>.
# Every command is safe to run from the main checkout or from inside any worktree.
#
# Usage:
#   wt new  [name] [-p|--prompt TEXT] [--prompt-stdin] [-b|--base REF] [--head]
#           [-a|--agent claude|codex|none] [-m|--model MODEL] [--no-workspace] [-r|--repo PATH]
#                                                             create a worktree and a cmux row that runs `wt run`.
#                                                             --no-workspace leaves the worktree ready for `wt attach`
#   wt run  <name> [-r PATH]                                  run the worktree's agent with its brief (cmux runs this)
#   wt list [--all] [-r PATH]                                 list worktrees (--all: every repo in $WT_REPOS_DIR)
#   wt show <name> [--diff] [-r PATH]                         show a status summary. --diff also opens a cmux diff pane
#   wt open [name] [-r PATH]                                  open a worktree in VS Code (default: the one you are in)
#   wt diff <name>                                            = wt show <name> --diff
#   wt attach <name> [-a AGENT] [-p TEXT] [-r PATH]           open a cmux row for an existing worktree
#   wt sync <name> [--merge]                                  rebase (default) or merge the worktree branch onto its base
#   wt pr <name> [--draft]                                    push the branch and open a GitHub pull request (with gh)
#   wt rm <name> [--force] [--keep-branch] [--discard-commits]
#                                                             remove a worktree. To protect work, rm refuses if it finds
#                                                             any of these:
#                                                             - uncommitted changes
#                                                             - commits on the branch that are not merged and are not
#                                                               still on a remote. "Merged" means an ancestor of the
#                                                               base, or a squash merge whose changes are all in the base
#                                                             - a base ref that rm cannot compare the branch with
#                                                               (a deleted ref, or a literal HEAD from an older wt)
#                                                             - a HEAD that is not that branch
#                                                             - an edited or newly created .wt-include file
#                                                             --force waives all of these refusals.
#                                                             --discard-commits waives only the commit refusal
#                                                             (for a squash that the base later edited or reverted).
#                                                             When rm runs in the task's own VM tmux session, it asks
#                                                             the Mac to close the task's row and to stop that session
#                                                             after removal
#   wt prune [--dry-run]                                      remove worktrees whose branch is merged (by ancestry or
#                                                             as a squash) and whose tree is clean
#   wt repos [<name>] [--porcelain|--table]                   list every git repo in $WT_REPOS_DIR.
#                                                             On a terminal: a table of name, task count and location.
#                                                             Piped: "<name><tab><path>" per repo.
#                                                             With a name or path: print only that repo's path
#   wt hosts [--json]                                         probe SSH aliases for reachability, CPU, RAM and GPUs
#   wt task [--where local|<host>] [-a claude|codex|repo-shell|vm-shell] [-r REPO] [-p TEXT]
#                                                             the task picker: choose where, kind, repo, name and brief,
#                                                             then start the task (on the Mac; needs fzf)
#   wt driver                                                 open (or select) the driver row (@local)
#   wt update [--refresh-config]                              show what git pull would bring in. After you confirm,
#                                                             wt pulls this repo and re-runs install.sh
#   wt path <name> [-r PATH] | wt current | wt help
#
#   wt -H <host> <new|attach|list|show|rm|path|open|repos|update|help> …
#                                                             run wt on that VM over ssh. The cmux row stays local.
#                                                             show, rm, path, open and attach need -r.
#                                                             new --no-workspace leaves the VM task unstarted.
#                                                             A plain attach starts it later with its saved brief.
#                                                             attach recovers a suspended row. It reattaches when it
#                                                             confirms the task's detached tmux session and the row's
#                                                             shell prompt.
#                                                             For an attached task row, attach restores tmux's mouse,
#                                                             focus, paste and extended-key terminal modes.
#                                                             Otherwise, use --reattach.
#                                                             --restart-agent starts over.
#                                                             update asks you to confirm here, so run it from a terminal
#
# Where it runs: on the Mac, wt drives cmux directly. On a VM (see is_remote), wt only prepares worktrees and
# asks the Mac for rows and VS Code windows. It sends these requests through `cmux notify` over the relay socket.
# A VM task's row is a plain `cmux ssh` row whose shell runs tmux_cmd, which creates or takes over that task's
# tmux session.
#
# Identity: a task's cmux row is titled "<name>". Its description (the sidebar's second line) is
# "@<host> · <repo>". <host> is "local" or the VM's alias. The separator is a space, a middle dot (U+00B7)
# and a space. The driver row, a "<repo> shell" row and a VM's "shell" row have the description "@<host>".
# A row that an older wt titled "<repo>:<name>" keeps that title. wt rm, the name check of wt new, and
# wt -H new, attach and rm still find it. Leave a task row's description as wt wrote it: wt finds the row by it.
# The tmux session is "wt-<repo>-<name>". <repo> is the repo basename, with each character outside
# [A-Za-z0-9-] replaced by '-'. Task names match ^[a-z0-9][a-z0-9_-]{0,62}$ (no '.').
#
# Task files (never committed): <repo>/.git/wt/<name>.json    base, created, agent, model, title, session, includes
#                               <repo>/.git/wt/<name>.prompt  the brief, which `wt run` passes to the agent
#                               <repo>/.git/wt/<name>.started marker: once it exists, Claude resumes with -c
#
# Environment / git config:
#   WT_REPOS_DIR        ':'-separated folders that `wt list --all`, `wt repos` and `wt new -r <name>` search for
#                       repos, in order (default ~/Documents/Repositories). If a repo name is in two of these
#                       folders, give that repo as a path
#   WT_HOST             on a VM: this VM's alias in the Mac's ~/.ssh/config (install.sh sets it in ~/.zshenv.local)
#   WT_AGENT            default agent for `wt new`                                              (default claude)
#   WT_AGENT_ARGS       extra agent args. A task's -m model overrides the model options and Claude's --fallback-model here
#   git config wt.dir   per-repo override of the worktree folder name                           (default .worktrees)
#
# Per-repo hooks:
#   .wt-include         gitignore-style patterns of *ignored* files to copy into each new worktree (.env and similar)
#   .wt-setup           an executable that runs inside each new worktree after creation (for example, to install deps)
set -euo pipefail

# The scripts in bin/ need bash 5 or later (README, "Requirements").
# When /bin/bash 3.2 starts this script, use the first Homebrew candidate with version 5 or later.
# WORKGROVE_REEXEC prevents a loop if the candidate changes after the version check.
# This block must use bash 3.2 syntax.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]] && "$bash5" -c '((BASH_VERSINFO[0] >= 5))' >/dev/null 2>&1; then
      export WORKGROVE_REEXEC=1
      exec "$bash5" "$0" "$@"
    fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then
  printf 'wt: needs bash 5 or later, but this is bash %s; install it: brew install bash\n' "$BASH_VERSION" >&2
  exit 1
fi

REPOS_PATH="${WT_REPOS_DIR:-$HOME/Documents/Repositories}"   # ':'-separated, searched in order (see repos_entries)
DEFAULT_AGENT="${WT_AGENT:-claude}"

# ---------------------------------------------------------------- helpers
die()  { printf 'wt: %s\n' "$*" >&2; exit 1; }
warn() { printf 'wt: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
usage() { awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0"; }
shell_join() { local out="" a; for a in "$@"; do printf -v a '%q' "$a"; out="${out:+$out }$a"; done; printf '%s' "$out"; }

# The EXIT trap. meta_set builds each sidecar in a temp file beside the real one, then moves it into place.
# A signal between these two steps would leave <name>.json.new.<pid> in .git/wt permanently. In this file,
# list_names reads `git worktree list` and never that directory, and cmd_rm removes only the .json, .prompt
# and .started files. So nothing else in this file would ever see the temp file again. An EXIT trap also
# runs on SIGINT and SIGTERM, which is when this matters. No code here uses exec, so the shell always
# reaches the trap. Each exec in this file is inside a command string sent to a VM, so it belongs to the
# VM's shell, not to this one.
WT_TMPFILES=()
wt_cleanup() {
  if [[ -n ${WT_STATUS_FILE:-} && -n ${WT_STATUS_HEARTBEAT_PID:-} ]]; then
    kill "$WT_STATUS_HEARTBEAT_PID" 2>/dev/null || true
    rm -f "$WT_STATUS_FILE"
    printf '{"hook_event_name":"SessionEnd"}\n' | WT_STATUS_HEARTBEAT=1 AGENT_NOTIFY_SOURCE="$WT_STATUS_SOURCE" agent-notify || true
    WT_STATUS_FILE=''
  fi
  if [[ ${#WT_TMPFILES[@]} -gt 0 ]]; then
    rm -f "${WT_TMPFILES[@]}"          # already moved into place: rm -f on a gone path is a no-op
  fi
}
trap wt_cleanup EXIT

cmux_bin() {
  local c="${CMUX_BUNDLED_CLI_PATH:-}"
  [[ -x "$c" ]] || c=$(command -v cmux 2>/dev/null || true)
  [[ -x "$c" ]] || c="$HOME/.cmux/bin/cmux"                        # cmux uploads its CLI here on a VM
  [[ -x "$c" ]] || c=/Applications/cmux.app/Contents/Resources/bin/cmux
  [[ -x "$c" ]] && printf '%s' "$c"
}
cmux_ok() { local c; c=$(cmux_bin) || return 1; CMUX_QUIET=1 "$c" ping >/dev/null 2>&1; }

# ---------------------------------------------------------------- which side of the ssh we are on
# In a cmux remote pane, with a cmux relay socket, or on a machine that is not a Mac, is_remote is true.
# Then this machine hosts the worktrees and the Mac drives cmux. CMUX_SURFACE_ID is cleared inside remote
# tmux panes by design, so never test it.
is_remote() { [[ -n ${CMUX_SSH_ATTEMPT_ID:-} ]] || [[ ${CMUX_SOCKET_PATH:-} == *:[0-9]* ]] || [[ $(uname -s) != Darwin ]]; }
mac_only()  { if is_remote; then die "wt $1: run this on the Mac"; fi; }

valid_host() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
wt_host() { # this VM's alias in the Mac's ~/.ssh/config
  [[ -n "${WT_HOST:-}" ]] || die "WT_HOST is not set; on this VM: echo 'export WT_HOST=<alias>' >> ~/.zshenv.local"
  valid_host "$WT_HOST" || die "invalid WT_HOST '$WT_HOST'; fix it in ~/.zshenv.local"
  printf '%s' "$WT_HOST"
}

# How to reach the Mac's cmux: use the identity of this pane, but let the tmux session environment override
# it. On every attach, cmux rebinds the identity in the session environment, and ~/.tmux.conf's
# update-environment line carries the TCP identity there. Read every relay variable, because cmux authorizes a
# relayed request against the SURFACE and the WORKSPACE in the environment. After cmux reconnects the row,
# it refuses, with remote_relay_surface_denied, a pane that holds the ids of the connection that started
# the pane. Only the session's environment is rewritten, never a pane's own. So re-read these at call time
# and hand them to the cmux child explicitly; do not let it inherit them.
# bin/agent-notify uses the same precedence for the TCP relay variables.
RELAY_VARS="CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID CMUX_TUI_SOCKET CMUX_TUI_TERMINAL_ID CMUX_TUI_SESSION_ID"
RELAY_SOCKET=""; RELAY_WS=""; RELAY_IDENT=()
relay_env() { # sets RELAY_SOCKET, RELAY_WS and RELAY_IDENT; non-zero when this session has no relay socket
  local s="" n v t
  RELAY_IDENT=(); RELAY_SOCKET=""; RELAY_WS=""; RELAY_TUI_SOCKET=""; RELAY_TUI_TERMINAL=""
  if [[ -n "${TMUX:-}" ]] && have tmux; then s=$(tmux display-message -p '#S' 2>/dev/null || true); fi
  for n in $RELAY_VARS; do          # unquoted on purpose: RELAY_VARS is a word list, not one value
    v="${!n:-}"
    if [[ -n "$s" ]]; then
      t=$(tmux show-environment -t "=$s" "$n" 2>/dev/null || true)
      # an unset name prints "-NAME", which has no "=" and so leaves the pane's own value in place
      if [[ "$t" == *=* ]]; then v="${t#*=}"; fi
    fi
    if [[ -n "$v" ]]; then RELAY_IDENT+=("$n=$v"); fi
    case "$n" in
      CMUX_SOCKET_PATH) RELAY_SOCKET="$v" ;;
      CMUX_WORKSPACE_ID) RELAY_WS="$v" ;;
      CMUX_TUI_SOCKET) RELAY_TUI_SOCKET="$v" ;;
      CMUX_TUI_TERMINAL_ID) RELAY_TUI_TERMINAL="$v" ;;
    esac
  done
  # Native SSH rows send notifications through the VM's cmux-tui daemon.
  [[ $RELAY_TUI_SOCKET == /* && $RELAY_TUI_TERMINAL =~ ^term_[a-f0-9]{32}$ ]] && return 0
  [[ "$RELAY_SOCKET" == *:[0-9]* ]]
}

# Mirrors safe_path in bin/cmux-hook. The Mac hook drops any other path, so never relay a path that fails this.
hook_safe_path() { [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *//* && "$1" != */ && "$1" != *'/../'* && "$1" != */.. && "$1" != *[\'\"\`\$\\\;]* ]]; }
hook_ok_repo() { # both relayed bodies carry $REPO (wt-open sends a path inside it)
  hook_safe_path "$REPO" && return 0
  warn "the Mac hook rejects this repo path ($REPO); run the printed command by hand"; return 1
}

notify_mac() { # notify_mac <title> <key> <value> …  — JSON body, so paths with spaces survive
  local title="$1" args=() ws=() c body request_id; shift
  while [[ $# -gt 1 ]]; do args+=(--arg "$1" "$2"); shift 2; done
  body=$(jq -cn "${args[@]+"${args[@]}"}" '$ARGS.named')
  relay_env || { warn "no cmux relay socket in this session; run the line below on the Mac"; return 1; }
  if [[ $RELAY_TUI_SOCKET == /* && $RELAY_TUI_TERMINAL =~ ^term_[a-f0-9]{32}$ ]]; then
    c=$(command -v cmux-tui || true)
    [[ -x $c ]] || { warn "cmux-tui CLI not found here; run the line below on the Mac"; return 1; }
    # cmux suppresses identical terminal/title/body content for five seconds, regardless of notification ID.
    request_id=$(LC_ALL=C od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    [[ $request_id =~ ^[a-f0-9]{32}$ ]] || { warn "cannot create a native request ID; run the line below on the Mac"; return 1; }
    body=$(printf '%s' "$body" | jq -c --arg id "$request_id" '. + {request_id:$id}') || return 1
    # Native terminal IDs differ from the Mac's workspace UUIDs. Do not pass --workspace.
    env -u CMUX_SOCKET "${RELAY_IDENT[@]}" "$c" --socket "$RELAY_TUI_SOCKET" notify --surface "$RELAY_TUI_TERMINAL" --title "$title" --body "$body" >/dev/null 2>&1 \
      || { warn "cmux-tui notify failed; run the line below on the Mac"; return 1; }
    return 0
  fi
  c=$(cmux_bin) || { warn "cmux CLI not found here; run the line below on the Mac"; return 1; }
  # --workspace is a second safeguard, not the mechanism. On cmux 0.64, --workspace does not authorize the
  # request and does not change the row that cmux records it against (measured). Both come from the
  # environment set below, whatever --workspace names. The flag names this row, which is what the Mac
  # hook's from_row_on_host wants anyway. So the flag agrees with that environment, and it stays correct if
  # a later cmux does read it.
  if [[ -n "$RELAY_WS" ]]; then ws=(--workspace "$RELAY_WS"); fi
  env -u CMUX_SOCKET "${RELAY_IDENT[@]+"${RELAY_IDENT[@]}"}" "$c" notify "${ws[@]+"${ws[@]}"}" --title "$title" --body "$body" >/dev/null 2>&1 \
    || { warn "cmux notify failed; run the line below on the Mac"; return 1; }
}

# Resolve the MAIN checkout root for a path. A linked worktree resolves back to its main checkout.
main_root_of() {
  local p="$1" common
  common=$(git -C "$p" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ "$common" == */.git ]] || return 1          # bare repos are not supported
  printf '%s' "${common%/.git}"
}

REPO=""      # main checkout root
WT_DIRNAME=""
set_repo() { REPO=$(main_root_of "$1") || return 1; WT_DIRNAME=$(git -C "$REPO" config --get wt.dir 2>/dev/null || echo .worktrees); }
lookup_repo() { # uses a path as given; looks up a name along $WT_REPOS_DIR, where it must be in one folder only
  local want="${1:-}" hits
  if [[ -n "$want" ]]; then
    if [[ ! -d "$want" ]]; then
      hits=$(repo_matches "$want")
      [[ -n "$hits" ]] || die "repo not found: ${1} (see: wt repos)"
      [[ "$hits" == *$'\n'* ]] && die "repo name '${1}' is in more than one WT_REPOS_DIR folder ($(printf '%s' "$hits" | tr '\n' ' ')); pass the path instead"
      want="$hits"
    fi
    set_repo "$want" || die "not a git repo: $want"
  else
    set_repo "$PWD" || die "not inside a git repo; pass -r <repo> (a name in $REPOS_PATH, or a path)"
  fi
}
# every command that makes or reads a worktree needs a commit to branch from; a plain lookup does not
resolve_repo() { lookup_repo "${1:-}"; need_commits; }
need_commits() { git -C "$REPO" rev-parse HEAD >/dev/null 2>&1 || die "$REPO has no commits yet (git -C $REPO commit --allow-empty -m init)"; }
wt_root()   { printf '%s/%s' "$REPO" "$WT_DIRNAME"; }
wt_path()   { printf '%s/%s/%s' "$REPO" "$WT_DIRNAME" "$1"; }
wt_meta()   { printf '%s/.git/wt/%s.json' "$REPO" "$1"; }
wt_prompt() { printf '%s/.git/wt/%s.prompt' "$REPO" "$1"; }
wt_started(){ printf '%s/.git/wt/%s.started' "$REPO" "$1"; }
wt_branch() { printf 'wt/%s' "$1"; }

# Identity. bin/cmux-hook mirrors these formats and tags the rows that it relays in the same way, so keep
# them byte-compatible. A row's title tells which task it is. Its description (row_tag) tells which machine
# and which repo. Two repos can have tasks with the same name, so the title alone does not identify a row.
repo_id()    { printf '%s' "${1##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'; }
where_am_i() { if is_remote; then printf '%s' "${WT_HOST:-remote}"; else printf 'local'; fi; }
row_title()  { printf '%s' "$1"; }                                          # row_title <name> — a task row's title
row_tag() { # row_tag [host] [repo] — the row description: "@<host> · <repo>", or "@<host>" for a row with no repo
  printf '@%s' "${1:-$(where_am_i)}"
  if [[ -n "${2:-}" ]]; then printf '%s%s' "$ROW_SEP" "$(repo_id "$2")"; fi
}
wt_session() { printf 'wt-%s-%s' "$(repo_id "$2")" "$1"; }                  # wt_session <name> <repo>
# The separator in a row description: a space, U+00B7 MIDDLE DOT, and a space. A host alias and a repo_id
# never contain it, so a description splits on it into exactly "@<host>" and "<repo>".
ROW_SEP=' · '
# The jq definitions that decide which row a lookup names. bin/cmux-hook has the same text, and
# test/wt-smoke.sh checks that the two copies are identical.
# - on_host($h; $sep): "" means a local row. Otherwise, an ssh row to $h, by its destination or its description.
# - task_row($t; $r; $h; $sep): the row titled $t, for repo_id $r ("" for a row with no repo), on host $h.
#   A row titled "<repo>:<name>" also matches, whatever its description. Older wt versions gave that title to
#   task rows. Such a row keeps that title, so the lookup accepts both forms.
# - unclaimed_row($t; $h; $sep): a row titled $t on host $h whose description has a form that wt never writes.
#   The user can edit or clear a description in cmux. Such a row may be a task row that task_row can no
#   longer find, so wt rm checks it for a running agent.
# - new_row($t; $h; $ids; $sep): the row that `cmux ssh $h --name $t` just created, for a create that printed
#   no workspace ref. The row has title $t, a description with no repo yet, and an id that is not in $ids,
#   the row ids from before the create. The repo test keeps it off another repo's row even when $ids is empty.
# shellcheck disable=SC2016   # a jq program: each $ name is a jq variable
ROW_JQ='
  def desc($sep): (.description | if type == "string" then . else "" end) | split($sep);
  def on_host($h; $sep): if $h == "" then ((.remote.enabled // false) | not)
    else ((.remote.enabled // false) and ((.remote.destination // "") == $h or (desc($sep)[0] // "") == "@" + $h)) end;
  def task_row($t; $r; $h; $sep): on_host($h; $sep)
    and ((.title == $t and (desc($sep)[1:] | join($sep)) == $r) or ($r != "" and .title == $r + ":" + $t));
  def new_row($t; $h; $ids; $sep): .title == $t and on_host($h; $sep) and (desc($sep) | length < 2)
    and (.id as $i | all($ids[]; . != $i));
  def unclaimed_row($t; $h; $sep): .title == $t and on_host($h; $sep)
    and ((.description | if type == "string" then . else "" end) | test("^@[^ ]+(" + $sep + "[A-Za-z0-9-]+)?$") | not);
'
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; }
need_name()  { valid_name "$1" || die "invalid name '$1' (lowercase letters, digits, _ and -, max 63, no '.')"; }
tidy_name()  { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/-/g'; }  # "Fix Auth" -> fix-auth; anything else must already be valid
valid_agent() { case "$1" in claude|codex|none) ;; *) die "unknown agent '$1' (use claude, codex or none)" ;; esac; }
valid_model() { local LC_ALL=C; [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._/@:-]*(\[[A-Za-z0-9._-]+\])?$ ]]; }
need_model()  { valid_model "$1" || die "invalid model '$1' (use letters, digits, ., _, -, /, @, : and an optional [suffix])"; }

slugify() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-' \
    | sed 's/^-//; s/-$//' | cut -d- -f1-5 | cut -c1-48 | sed 's/-$//'
}

# $WT_REPOS_DIR is a search path like $PATH: entries in order, each one once, empty and missing ones skipped.
repos_entries() {
  local rest="$REPOS_PATH" d seen=""
  while [[ -n "$rest" ]]; do
    d="${rest%%:*}"
    case "$rest" in *:*) rest="${rest#*:}" ;; *) rest="" ;; esac
    while [[ "$d" == */ && "$d" != / ]]; do d="${d%/}"; done      # "$X/" and "$X" are the same folder
    [[ -n "$d" && -d "$d" ]] || continue
    case "$seen" in *":$d:"*) continue ;; esac
    seen="$seen:$d:"
    printf '%s\n' "$d"
  done
  return 0
}
need_repos_dir() { [[ -n "$(repos_entries)" ]] || die "repos dir not found: $REPOS_PATH (set WT_REPOS_DIR, or pass -r <repo>)"; }
repo_dirs() { # every git repo on the search path: entry order, sorted within an entry, unreadable and hidden folders skipped
  local d
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    [[ -r "$d" ]] || { warn "skipping unreadable folder in WT_REPOS_DIR: $d"; continue; }
    { find "$d" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -exec test -d '{}/.git' ';' -print 2>/dev/null || true; } | sort
  done <<<"$(repos_entries)"
  return 0
}
repo_matches() { # repo_matches <name> -> the entries holding that repo, first entry first; hidden names never match
  local name="$1" d
  case "$name" in ""|*/*|.*) return 0 ;; esac
  while IFS= read -r d; do
    [[ -n "$d" && -d "$d/$name/.git" ]] && printf '%s\n' "$d/$name"
  done <<<"$(repos_entries)"
  return 0
}

default_base() {
  local ref b
  if ref=$(git -C "$REPO" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s' "$ref"; return
  fi
  for b in main master; do
    git -C "$REPO" show-ref -q --verify "refs/remotes/origin/$b" && { printf 'origin/%s' "$b"; return; }
    git -C "$REPO" show-ref -q --verify "refs/heads/$b" && { printf '%s' "$b"; return; }
  done
  # Fall back to the branch checked out here, or to the HEAD commit when HEAD is detached. Never use the
  # literal "HEAD": in every worktree it resolves to that worktree's own tip, so it compares a worktree with
  # itself.
  git -C "$REPO" symbolic-ref -q --short HEAD || git -C "$REPO" rev-parse HEAD
}

meta_get() { # meta_get <name> <key> — "" for a missing key, and for a key stored as null
  # `.[$k] // ""` looks correct but is not: // also fires on a stored `false`, which would then read as "".
  # has/tojson is exact. A non-string (a number, a bool) comes back as JSON, so `false` reads as "false".
  local f; f=$(wt_meta "$1"); [[ -f "$f" ]] || return 1
  jq -r --arg k "$2" 'if has($k) and .[$k] != null then .[$k] else "" end
                      | if type == "string" then . else tojson end' "$f"
}
meta_get_pair() { # meta_get_pair <name> <key> <key> — one read for fields used together on each launch/show
  local f; f=$(wt_meta "$1"); [[ -f "$f" ]] || return 1
  jq -r --arg a "$2" --arg b "$3" --arg fs "$WT_FS" '
    [.[$a], .[$b]] | map(if . == null then "" elif type == "string" then . else tojson end) | join($fs)' "$f"
}
meta_set() { # meta_set <name> key=value ...  — a key with no '=' is stored with an empty value
  # jq cannot write the file that it reads, so meta_set writes through a temp file. The mv also makes
  # meta_set crash-safe. The earlier json.dump(d, open(f,'w')) was not: an interrupted write used to truncate
  # the sidecar.
  # In jq, index("=") is null when there is no '=', and null+1 is 1. So the no-'=' arm is necessary: without
  # it, `meta_set x bare` would slice the key and store the wrong one.
  local f t; f=$(wt_meta "$1"); shift; mkdir -p "$(dirname "$f")"; t="$f.new.$$"
  WT_TMPFILES+=("$t")                    # a signal between the jq below and the mv would otherwise orphan it
  if ! { if [[ -f "$f" ]]; then cat "$f"; else printf '{}\n'; fi; } \
       | jq --indent 1 'reduce ($ARGS.positional[]) as $kv (.;
             ($kv | index("=")) as $i
             | if $i == null then .[$kv] = "" else .[$kv[0:$i]] = $kv[$i+1:] end)' --args "$@" >"$t" \
     || ! mv "$t" "$f"; then
    rm -f "$t"; die "could not write $f"
  fi
}
prompt_line() { local f; f=$(wt_prompt "$1"); if [[ -f "$f" ]]; then head -1 "$f"; fi; }

require_wt() { # require_wt <name>  -> sets P (path), B (branch)
  local n="$1"; valid_name "$n" || die "invalid worktree name: $n"
  P=$(wt_path "$n"); B=$(wt_branch "$n")
  if git -C "$REPO" worktree list --porcelain | grep -qxF "worktree $P"; then
    # A registration whose directory was deleted outside wt (rm -rf, a lost VM disk) still has a branch and
    # metadata. Only `wt rm` can clear them, so let it through. The other commands find no files there.
    [[ -d "$P" ]] || warn "$P is registered but missing (deleted outside wt?); clean it up with: wt rm $n"
    return 0
  fi
  [[ -d "$P" ]] && die "$P exists but is not a registered worktree (try: git -C $REPO worktree prune)"
  die "no worktree named '$n' in $REPO (see: wt list)"
}

rows_json() { # rows_json [checked] — every cmux row, in every window, as one {"workspaces":[…]} document.
  # `workspace list --json` answers for ONE window: the caller's window, or the one that --window names.
  # A window displays one row at a time. So the only way to show two tasks side by side in cmux is to drag a
  # row into a second window. That row is then absent from the list, and every lookup built on this reads
  # that as "no such row":
  # - `wt rm` leaves the row open;
  # - remote_row builds a second row beside the one already there;
  # - check_identity misses a row that another repo already uses;
  # - the hook's from_row_on_host fails closed, so a VM's `wt open` does nothing.
  # Only the LISTING is window-scoped. That is why merging the lists is the whole fix, and why nothing that
  # acts on a row changes. Measured on cmux 0.64:
  # - a row keeps its uuid, its title and even its workspace:N ref when it moves between windows;
  # - cmux allocates refs globally, so two windows cannot collide;
  # - read-screen, send, workspace-action and workspace close each reach a row in another window with no
  #   --window.
  # Enumerate windows by uuid, never by the index that list-windows prints first. Opening a window renumbers
  # the others: a new window took index 0 and pushed the existing one to 1. The uuid stays fixed.
  # Use `.workspaces?`, not `.workspaces`: cmux may hand back a bare array, and jq's `//` does not catch the
  # error `Cannot index array with "workspaces"`. Only the `?` turns that error into the empty value that `//`
  # can fall back from.
  local c w out windows docs=""
  c=$(cmux_bin) || { [[ ${1:-} != checked ]] || return 1; return 0; }
  windows=$(CMUX_QUIET=1 "$c" list-windows 2>/dev/null) || {
    [[ ${1:-} != checked ]] || return 1
  }
  if [[ ${1:-} == checked && -n "$windows" ]]; then
    if printf '%s\n' "$windows" | awk '{print ($1 == "*" ? $3 : $2)}' | grep -Eqv '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$'; then return 1; fi
  fi
  for w in $(printf '%s\n' "$windows" | awk '{print ($1 == "*" ? $3 : $2)}' | grep -Ex '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}' || true); do
    out=$(CMUX_QUIET=1 "$c" workspace list --json --window "$w" 2>/dev/null) || {
      [[ ${1:-} != checked ]] || return 1
      continue   # a window closed mid-loop
    }
    [[ ${1:-} != checked || -n "${out//[[:space:]]/}" ]] || return 1
    docs="$docs$out"
  done
  # For display lookups, an older cmux or unrecognized output can give no window list.
  # Then fall back to the single-window call. Checked removal requires a successful, readable window list.
  [[ -n "$docs" ]] || docs=$(CMUX_QUIET=1 "$c" workspace list --json 2>/dev/null) || {
    [[ ${1:-} != checked ]] || return 1
  }
  if [[ ${1:-} == checked ]]; then
    printf '%s' "$docs" | jq -e -s -c '
      map(if type == "array" then . elif type == "object" then .workspaces else null end) as $rows
      | if ($rows | length > 0) and all($rows[]; type == "array"
          and all(.[]; (.id | type == "string" and length > 0) and (.title | type == "string")
            and (.remote == null or (.remote | type == "object"))
            and (.remote.enabled == null or (.remote.enabled | type == "boolean"))
            and (.remote.destination == null or (.remote.destination | type == "string"))
            and (.description == null or (.description | type == "string"))))
        then {workspaces: ($rows | add)} else error("invalid cmux row list") end' 2>/dev/null
    return
  fi
  printf '%s' "$docs" | jq -s -c '{workspaces: (map(.workspaces? // .) | add // [])}' 2>/dev/null || true
}

cmux_row_field() { # cmux_row_field <title> <repo> <field> [host] -> that field; no host: the local row
  # <repo> is a path or a name, or "" for a row with no repo. Two repos can each have a task with the same
  # name, and a local and a VM row can share a title. So the repo and the host tell such rows apart.
  # It prints nothing when cmux or the row is missing.
  cmux_bin >/dev/null || return 0
  local rows r=""
  if [[ -n "$2" ]]; then r=$(repo_id "$2"); fi
  rows=$(rows_json)
  printf '%s' "$rows" \
    | jq -r --arg t "$1" --arg r "$r" --arg k "$3" --arg h "${4:-}" --arg sep "$ROW_SEP" "$ROW_JQ"'
        first((.workspaces? // .)[] | select(task_row($t; $r; $h; $sep)) | .[$k] // "") // empty' \
        2>/dev/null || true
}

task_title() { # task_title <name> [saved title] — the title of the task's row. No saved title: read the sidecar.
  # A title that an older wt saved ("<repo>:<name>") reads as the name, so the sidecar moves to the new form.
  local t="${2-}"
  if [[ $# -lt 2 ]]; then t=$(meta_get "$1" title 2>/dev/null || true); fi
  if [[ -z "$t" || "$t" == "$(repo_id "$REPO"):$1" ]]; then t=$(row_title "$1"); fi
  printf '%s' "$t"
}

row_label() { # row_label <title> <repo> [host] — the matching row as the sidebar shows it. An older wt's row
  # keeps its old title, so this reads the row's own title and description. A row that is gone by then
  # reads as the label that wt would give it.
  local t d
  t=$(cmux_row_field "$1" "$2" title "${3:-}")
  if [[ -z "$t" ]]; then printf '%s %s' "$1" "$(row_tag "${3:-}" "$2")"; return 0; fi
  d=$(cmux_row_field "$1" "$2" description "${3:-}")
  printf '%s%s' "$t" "${d:+ $d}"
}

check_identity() { # refuse a name whose row belongs to another repo with the same basename (same repo_id)
  local n="$1" other s
  if is_remote; then                  # this repo has no such worktree, so a live session belongs to another repo
    s=$(wt_session "$n" "$REPO")
    if tmux has-session -t "=$s" 2>/dev/null; then die "tmux session $s is already in use here; pick another name (or: tmux kill-session -t '=$s')"; fi
    return 0
  fi
  cmux_ok || return 0
  other=$(cmux_row_field "$(row_title "$n")" "$REPO" current_directory)
  [[ -n "$other" ]] || return 0
  other=$(main_root_of "$other" 2>/dev/null || printf '%s' "$other")   # resolved like $REPO; raw if the dir is gone
  [[ "$other" == "$REPO" || "$other" == "$REPO/"* ]] && return 0
  die "row '$(row_label "$(row_title "$n")" "$REPO")' already belongs to $other; pick another name (wt new <other-name> -r $REPO)"
}

open_workspace() { # open_workspace <name> — always unfocused: a new task row must never steal the window
  local n="$1" c out title                 # from whatever the user is doing; they select it when they want it
  cmux_ok || { warn "cmux is not running; skipped workspace creation (cd $(wt_path "$n"))"; return 0; }
  c=$(cmux_bin)
  title=$(task_title "$n")
  out=$(CMUX_QUIET=1 "$c" workspace create --name "$title" --description "$(row_tag "" "$REPO")" --cwd "$(wt_path "$n")" --focus false \
        --command "$(shell_join "$HOME/.local/bin/wt" run "$n" -r "$REPO")" 2>&1) || die "cmux workspace create failed: $out"
  local ref; ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1 || true)
  meta_set "$n" "title=$title"
  printf 'workspace: %s\n' "${ref:-$out}"
}

close_workspace() { # close_workspace <name> [title] — use the saved title after rm deletes the sidecar
  local title="${2:-}"
  [[ -n "$title" ]] || title=$(task_title "$1")
  cmux_ok || { warn "cmux is unreachable; skipped row cleanup for $title $(row_tag "" "$REPO") (titled $(repo_id "$REPO"):$1 if an older wt made it)"; return 0; }
  close_row "$(cmux_row_field "$title" "$REPO" id)"
}
close_row() { # close_row <row id> [self|new] — silent when the row is already gone
  # cmux asks for --force before it closes a row in which a local agent runs, such as the caller's own row
  # ("self"). "new" is a VM row that wt has just created. cmux 0.65 closes such a row without --force, as
  # measured on a VM. wt passes --force anyway, as the hook does, because the row runs only what wt started.
  [[ -n "$1" ]] || return 0
  local err args=()
  [[ ${2:-} == self || ${2:-} == new ]] && args=(--force)
  err=$(CMUX_QUIET=1 "$(cmux_bin)" workspace close "$1" "${args[@]}" 2>&1) || {
    warn "could not close cmux row $1${err:+: $err}"
    warn "on the Mac: cmux workspace close $1${args[*]:+ ${args[*]}}"
    return 1
  }
}

physical_dir() { # physical_dir <dir> — the directory with each symlink resolved, or <dir> itself when it cannot be entered
  (CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"
}
path_within() { [[ -n "$2" && ( "$1" == "$2" || "$1" == "$2/"* ) ]]; }   # path_within <path> <dir> — <dir> or below it

RM_ROW=""; RM_SELF=""
check_row_removal() { # check_row_removal <title> <repo> [host] [worktree path] — refuse unreadable rows or another
  # running agent. Without a host, the worktree path names the local worktree that wt rm removes.
  RM_ROW=""; RM_SELF=""
  local c err
  if ! c=$(cmux_bin); then
    [[ -z ${CMUX_WORKSPACE_ID:-} ]] || die "cmux CLI not found; kept the worktree"
    return 0
  fi
  if ! err=$(CMUX_QUIET=1 "$c" ping 2>&1); then
    # Without a caller row, a missing socket means cmux is absent. Other failures cannot prove that.
    case "$err" in 'Error: Socket not found at '*) [[ -n ${CMUX_WORKSPACE_ID:-} ]] || return 0 ;; esac
    die "cannot reach cmux${err:+: $err}; kept the worktree"
  fi
  # The user can edit or clear a row's description in cmux, and then task_row no longer finds the task's row.
  # So check the agent in every row that may be this task's, not only in the row that task_row finds:
  # - by title: each row that task_row finds ("found"), and each row that unclaimed_row finds ("unclaimed");
  # - by directory: each local row whose current directory is in the worktree ("dir").
  # Refuse when another agent runs in any of them. Close only the first row that task_row finds, or the
  # caller's own row when the title matches it. A row found only by its directory may belong to anything,
  # such as the driver, so wt never closes it.
  local rows checks=() check kind id dir root="" self_row=""
  rows=$(rows_json checked) || die "cannot list cmux rows; kept the worktree"
  # One line for each row to check: "found <id>", "unclaimed <id>" or "dir <id> <current directory>". A
  # directory with a newline in it would split its line, so such a row is not checked by its directory.
  mapfile -t checks < <(printf '%s' "$rows" | jq -r --arg t "$1" --arg r "$(if [[ -n "$2" ]]; then repo_id "$2"; fi)" \
      --arg h "${3:-}" --arg d "${4:-}" --arg sep "$ROW_SEP" "$ROW_JQ"'
      .workspaces[] | (.current_directory | if type == "string" then . else "" end) as $c
      | if task_row($t; $r; $h; $sep) then "found " + .id
        elif unclaimed_row($t; $h; $sep) then "unclaimed " + .id
        elif $h == "" and $d != "" and on_host($h; $sep) and $c != "" and ($c | contains("\n") | not)
        then "dir " + .id + " " + $c
        else empty end')
  wait $! || die "cannot list cmux rows; kept the worktree"
  # A row's directory can name the worktree through a symlink or in another letter case. So a directory that
  # does not match as written is compared again as its physical path.
  if [[ -n "${4:-}" ]]; then root=$(physical_dir "$4"); fi
  for check in "${checks[@]}"; do
    kind=${check%% *}; id=${check#* }
    if [[ $kind == dir ]]; then
      dir=${id#* }; id=${id%% *}
      path_within "$dir" "${4:-}" || path_within "$(physical_dir "$dir")" "$root" || continue
    fi
    [[ $kind != found || -n "$RM_ROW" ]] || RM_ROW=$id
    row_agent "$c" "$id"
    case $kind/$ROW_AGENT in
      found/self|unclaimed/self) self_row=$id ;;
      found/busy) die "another agent is running in cmux row $id; kept the worktree" ;;
      unclaimed/busy) die "an agent is running in cmux row $id, titled '$1', whose second line wt did not write; kept the worktree. Stop that agent or close that row, then re-run" ;;
      dir/busy) die "an agent is running in cmux row $id, whose current directory is in this worktree; kept the worktree. Stop that agent or close that row, then re-run" ;;
    esac
  done
  if [[ -n "$self_row" ]]; then RM_ROW=$self_row; RM_SELF=self; fi
}

ROW_AGENT=""
row_agent() { # row_agent <cmux> <row id> — sets ROW_AGENT: "self" for the caller's own row, "busy" when an agent
  # runs in the row, else "idle". It sets a variable rather than printing, so that its die ends wt itself.
  local state
  state=$(CMUX_QUIET=1 "$1" top --workspace "$2" --json 2>/dev/null) \
    || die "cannot check the agent in cmux row $2; kept the worktree"
  printf '%s' "$state" | jq -e '.coding_agents | type == "array"
    and all(.[]; .resources.process_count | type == "number" and . >= 0)' >/dev/null 2>&1 \
    || die "cannot check the agent in cmux row $2; kept the worktree"
  if printf '%s' "$state" | jq -e --arg id "$2" '.caller.workspace_id == $id' >/dev/null; then
    ROW_AGENT=self
  elif printf '%s' "$state" | jq -e 'any(.coding_agents[]; .resources.process_count > 0)' >/dev/null; then
    ROW_AGENT=busy
  else
    ROW_AGENT=idle
  fi
}

file_hash() { # sha256 of a file, or "" when it cannot be read (the Mac has shasum, Linux sha256sum)
  local h=""
  if have shasum; then h=$(shasum -a 256 "$1" 2>/dev/null) || h=""
  elif have sha256sum; then h=$(sha256sum "$1" 2>/dev/null) || h=""
  else h=$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$1" 2>/dev/null) || h=""
  fi
  printf '%s' "${h%% *}"
}

include_match() { # include_match <path relative to a checkout> — 0 when .wt-include covers it
  local f="$1" inc="$REPO/.wt-include" pat
  [[ -f "$inc" ]] || return 1
  while IFS= read -r pat || [[ -n "$pat" ]]; do
    pat="${pat%%#*}"; pat="${pat#"${pat%%[![:space:]]*}"}"; pat="${pat%"${pat##*[![:space:]]}"}"
    [[ -z "$pat" ]] && continue
    pat="${pat#/}"; pat="${pat%/}"
    # shellcheck disable=SC2053
    if [[ "$f" == $pat || "$f" == $pat/* || "$(basename "$f")" == $pat ]]; then return 0; fi
  done < "$inc"
  return 1
}

copy_includes() { # copy gitignored files listed in .wt-include into the new worktree; prints "<path>:<sha256>"
  local dest="$1" f                       # the hash is of what was copied, so rm can tell a copy edited inside
  [[ -f "$REPO/.wt-include" ]] || return 0   # the worktree from a file changed in the main checkout since
  git -C "$REPO" ls-files --others --ignored --exclude-standard -z | while IFS= read -r -d '' f; do
    if [[ "$f" != "$WT_DIRNAME/"* ]] && include_match "$f"; then
      # errexit does not reach in here (a pipeline inside $( )), so catch a failed copy by hand. If the loop
      # printed a failed copy anyway, "includes" would record a file that the worktree does not have.
      mkdir -p "$dest/$(dirname "$f")"
      if cp -p "$REPO/$f" "$dest/$f"; then printf '%s:%s\n' "$f" "$(file_hash "$dest/$f")"
      else warn "could not copy $f into the worktree"; fi
    fi
  done
}

worktree_includes() { # worktree_includes <path> — ignored files inside the worktree that .wt-include covers
  local p="$1" f                          # today, whether or not they existed when the worktree was created
  [[ -f "$REPO/.wt-include" ]] || return 0
  git -C "$p" ls-files --others --ignored --exclude-standard -z 2>/dev/null | while IFS= read -r -d '' f; do
    if [[ "$f" != "$WT_DIRNAME/"* ]] && include_match "$f"; then printf '%s\n' "$f"; fi
  done
}

changed_includes() { # changed_includes <name> <path> -> ignored files that removing the worktree would destroy
  # This protection cannot be a creation-time snapshot. So it reads the two sources below.
  # - The files recorded at `wt new`, compared with the hash of what was copied then. So rotating a secret in
  #   the main checkout does not make every existing worktree unremovable.
  # - Every ignored file that the patterns cover *now*. An .env.local that an agent wrote in the worktree is
  #   in no snapshot, and `worktree remove --force` deletes it without a warning.
  local n="$1" p="$2" f h e seen="" list
  list=$(printf '%s\n%s\n' "$(meta_get "$n" includes 2>/dev/null || true)" "$(worktree_includes "$p")")
  while IFS= read -r e; do
    [[ -n "$e" ]] || continue
    f="${e%:*}"; h="${e##*:}"
    [[ "$h" =~ ^[0-9a-f]{64}$ ]] || { f="$e"; h=""; }   # metadata from an older wt: plain names, no hash
    case "$seen" in *"|$f|"*) continue ;; esac          # recorded and still matching: judge it once
    seen="$seen|$f|"
    [[ -e "$p/$f" ]] || continue
    if [[ -n "$h" ]]; then
      [[ "$(file_hash "$p/$f")" == "$h" ]] || printf '%s\n' "$f"
    elif [[ -e "$REPO/$f" ]]; then
      cmp -s "$p/$f" "$REPO/$f" || printf '%s\n' "$f"   # no hash: the main checkout is all there is to compare with
    else
      printf '%s\n' "$f"                                # nothing anywhere else holds it
    fi
  done <<<"$list"
}

porcelain_paths() { # porcelain_paths <checkout> — one path per line for every entry `git status` reports.
  # Use -z, because without it a path with a space in it comes back quoted, and this list is compared by
  # exact string. A rename or copy emits its source as a second record. The loop reads that record and drops
  # it: the destination is the dirty path, and the source no longer exists to hash.
  local p="$1" rec f
  git -C "$p" status --porcelain -z 2>/dev/null | while IFS= read -r -d '' rec; do
    f="${rec:3}"
    case "${rec:0:2}" in R*|C*) IFS= read -r -d '' _src || true ;; esac
    if [[ -n "$f" ]]; then printf '%s\n' "$f"; fi
  done
}

setup_dirt() { # setup_dirt <worktree path> — what .wt-setup left in git's way, as "<path>:<sha256>" lines.
  # wt calls this only immediately after the hook ran, so what it finds is the hook's own output and nobody
  # else's. This record exists for the same reason that copy_includes records a hash. With it, rm can tell
  # the work a human did inside the worktree from the state that the worktree was born with. A `.wt-setup`
  # that runs `uv sync` or `npm ci` rewrites a TRACKED lockfile. Without this record, `git status` is dirty
  # from birth, and every `wt rm` refuses for the worktree's whole life. The only way to clean up is then
  # --force, which also discards the unmerged-commit check. Ignored files never reach here: `status` does
  # not list them.
  local p="$1" f
  porcelain_paths "$p" | while IFS= read -r f; do
    printf '%s:%s\n' "$f" "$(file_hash "$p/$f")"      # a file the hook DELETED hashes to "", and matches as ""
  done
}

unexplained_dirt() { # unexplained_dirt <name> <path> — dirty paths that .wt-setup did not put there
  # A recorded path counts as explained only while it still holds exactly what the hook left. If someone
  # edits a recorded lockfile by hand, the hash stops matching, so the path is a reason again. Metadata
  # from before wt recorded this has no "setup" key. Then every path is unexplained, and the old refusal
  # stays unchanged.
  local n="$1" p="$2" recorded f h e explained
  recorded=$(meta_get "$n" setup 2>/dev/null || true)
  [[ -n "$recorded" ]] || { porcelain_paths "$p"; return 0; }
  porcelain_paths "$p" | while IFS= read -r f; do
    h=$(file_hash "$p/$f"); explained=0
    while IFS= read -r e; do
      if [[ -n "$e" && "${e%:*}" == "$f" && "${e##*:}" == "$h" ]]; then explained=1; break; fi
    done <<<"$recorded"
    if [[ $explained -eq 0 ]]; then printf '%s\n' "$f"; fi
  done
}

branch_pushed() { # branch_pushed <branch> — 0 only when the remote still has every commit of that branch.
  # A remote-tracking ref is not proof. refs/remotes/origin/wt/x outlives the remote branch (an abandoned PR,
  # `git push origin :wt/x`, someone else's cleanup). The next fetch with fetch.prune then drops it, and
  # those commits become unreachable with no reflog. So ask the remote itself, and count an unreachable
  # remote as not pushed. Refusing while offline is the safe direction, and --force is one keystroke away.
  local b="$1" remote
  git -C "$REPO" rev-parse -q --verify "$b@{u}" >/dev/null 2>&1 || return 1
  [[ -z "$(git -C "$REPO" log "$b@{u}..$b" --oneline 2>/dev/null)" ]] || return 1
  remote=$(git -C "$REPO" config "branch.$b.remote" 2>/dev/null || true)
  [[ -n "$remote" ]] || return 1
  warn "asking $remote whether $b is still there (ctrl-c and use --force if it hangs)"
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=5}" \
    git -C "$REPO" ls-remote --exit-code --heads "$remote" "refs/heads/$b" >/dev/null 2>&1
}

git_merges_trees() { # 0 when this git has `merge-tree --write-tree` (2.38, September 2022). Ubuntu 22.04's
                     # apt git is 2.34, so a VM can be on either side; the answer is cached for the process.
  if [[ -z "${WT_MERGE_TREE:-}" ]]; then
    local v maj min; v=$(git version 2>/dev/null | awk '{print $3}'); maj="${v%%.*}"; min="${v#*.}"; min="${min%%.*}"
    WT_MERGE_TREE=0
    if [[ "$maj" =~ ^[0-9]+$ && "$min" =~ ^[0-9]+$ ]] && { [[ $maj -gt 2 ]] || [[ $maj -eq 2 && $min -ge 38 ]]; }; then
      WT_MERGE_TREE=1
    fi
  fi
  [[ $WT_MERGE_TREE -eq 1 ]]
}

LANDED_WHY=""      # set by branch_landed when it says no: what it checked, for the refusal to repeat
branch_landed() { # branch_landed <branch> <base> — 0 when every change the branch made since it left the
                  # base is already in the base's tip, the shape a squash merge leaves behind.
  # A PR merged with GitHub's "squash and merge" (the default on most repos) lands as ONE new commit on
  # main. That commit's tree is the merge's tree, and the head branch is deleted. Nothing on wt/<name> is
  # then an ancestor of anything, and branch_pushed finds the remote branch gone. So the only way past
  # `wt rm` was --force, which also waives the dirty-tree and .wt-include checks. But that worktree had
  # nothing left to lose. This check tells that worktree apart from one that does have something to lose.
  #
  # The question it asks git is exact, not a heuristic: would a merge of the branch into the base's tip
  # change anything? A three-way merge looks at every region of every file. It takes the base's side where
  # only the base changed the region, and the branch's side where only the branch changed it. Where both made
  # the same change, it takes either side. So the merged tree equals the base's tree precisely when every
  # change that the branch made is already there. How it landed does not matter: by a squash, a rebase-merge,
  # a cherry-pick into another branch that then merged, or by hand.
  # branch_landed does NOT take these cases as landed:
  # - A change that the base later undid, for example a squash that was later reverted, in whole or in part.
  #   The merge would put it back, so the tree differs.
  # - A change that the base later edited again on the same lines. The merge conflicts.
  # - A commit whose change is not in the base at all: a commit pushed after the PR merged, or never merged.
  # Each of these cases is a refusal, and the refusal says which case it is.
  # A branch whose net change is empty (a commit undone by a later one on the same branch) passes the merge
  # trivially and proves nothing. So it is refused too, as it always was.
  #
  # `git merge-tree --write-tree` (2.38+) does the merge in memory, hunk by hunk. It does not touch any index
  # or working tree, and it exits 1 on conflicts. Older git gets `read-tree -m` into a throwaway index, which
  # merges file by file. There, a file that both sides changed is unmerged, whatever the hunks say. Then
  # `write-tree` refuses the unmerged index, which reads here as not landed. That path is stricter, and safe
  # in the same direction: either path calls a branch landed only when the merge would change nothing.
  local b="$1" base="$2" m tree_b tree_t="" out rc=0 n idx
  LANDED_WHY=""
  m=$(git -C "$REPO" merge-base "$b" "$base" 2>/dev/null) || { LANDED_WHY="$b has no common history with $base"; return 1; }
  if git -C "$REPO" diff-tree --quiet "$m" "$b" 2>/dev/null; then
    LANDED_WHY="the net change of $b since $(git -C "$REPO" rev-parse --short "$m") is empty, which proves nothing"; return 1
  fi
  tree_b=$(git -C "$REPO" rev-parse "$base^{tree}" 2>/dev/null) || { LANDED_WHY="$base has no tree"; return 1; }
  if git_merges_trees; then
    out=$(git -C "$REPO" merge-tree --write-tree "$base" "$b" 2>/dev/null) || rc=$?
    case $rc in
      0) tree_t="${out%%$'\n'*}" ;;
      1) LANDED_WHY="merging $b into $base would conflict: $base changed the same lines again"; return 1 ;;
      *) LANDED_WHY="git merge-tree could not compare $b with $base"; return 1 ;;
    esac
  else
    # read-tree refuses an index file that is empty, so hand it a name that does not exist yet
    idx=$(mktemp "${TMPDIR:-/tmp}/wt-index.XXXXXX") || { LANDED_WHY="no temp file for a merge index"; return 1; }
    WT_TMPFILES+=("$idx"); rm -f "$idx"
    if GIT_INDEX_FILE="$idx" git -C "$REPO" read-tree -m -i --aggressive "$m" "$base" "$b" >/dev/null 2>&1; then
      tree_t=$(GIT_INDEX_FILE="$idx" git -C "$REPO" write-tree 2>/dev/null) || tree_t=""
    fi
    rm -f "$idx"
    if [[ -z "$tree_t" ]]; then
      LANDED_WHY="merging $b into $base would touch a file $base changed since (git $(git version | awk '{print $3}') compares whole files; 2.38 compares hunks)"
      return 1
    fi
  fi
  [[ "$tree_t" == "$tree_b" ]] && return 0
  n=$(git -C "$REPO" diff-tree -r --name-only "$tree_b" "$tree_t" 2>/dev/null | wc -l | tr -d ' ')
  LANDED_WHY="merging $b into $base would still change $n path(s)"
  return 1
}

WT_FETCHED="${TMPDIR:-/tmp}/wt-fetched.$$"   # which bases fetch_base has tried this run; see there
fetch_base() { # fetch_base <base> — refresh a remote-tracking base such as origin/main. Returns:
               # 0 when it refreshed the base; 1 when the fetch failed (now, or earlier this run);
               # 2 when the base is not a remote's branch and there was nothing to do;
               # 3 when the base was already refreshed this run.
  # A squash merge lands on GitHub, and the next command typed is `wt rm`. Here, origin/main is whatever the
  # last fetch left, which is from before the merge, and branch_landed compares against that. So when the
  # offline checks say no and the base is a remote's branch, fetch that one branch and ask again. Offline,
  # the fetch fails quietly within the same 5-second ceiling that branch_pushed already accepts. The offline
  # verdict then stands, and the refusal says that the base could not be refreshed. A local base (`main`) is
  # never fetched.
  # Fetch once per run. `wt prune` asks rm_reasons about every worktree, and asks again through cmd_rm for
  # the ones it removes. Each time, it asks in a command substitution: a subshell, whose variables never
  # reach back. So the record of what was fetched is a file, named after this process and removed on exit.
  # cmd_rm and cmd_prune clear it before their first question, so a file that a killed run left behind
  # cannot answer.
  local base="$1" remote
  [[ "$base" == */* ]] || return 2
  remote="${base%%/*}"
  git -C "$REPO" remote 2>/dev/null | grep -qxF "$remote" || return 2
  if [[ -f "$WT_FETCHED" ]]; then
    grep -qxF "ok $base" "$WT_FETCHED" && return 3
    grep -qxF "failed $base" "$WT_FETCHED" && return 1
  fi
  warn "fetching $base from $remote to see whether the branch landed (ctrl-c and use --force if it hangs)"
  if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=5}" \
       git -C "$REPO" fetch -q "$remote" "${base#*/}" >/dev/null 2>&1; then
    printf 'ok %s\n' "$base" >>"$WT_FETCHED"; return 0
  fi
  printf 'failed %s\n' "$base" >>"$WT_FETCHED"; return 1
}

reset_fetched() { # start the run's record of fetched bases afresh; the first of cmd_rm and cmd_prune to run does it
  if [[ $WT_FETCHED_RESET -eq 0 ]]; then rm -f "$WT_FETCHED"; WT_TMPFILES+=("$WT_FETCHED"); WT_FETCHED_RESET=1; fi
}
WT_FETCHED_RESET=0

RM_DISCARD_COMMITS=0   # `wt rm --discard-commits`: waive the unmerged-commit reason, and only that one
rm_reasons() { # rm_reasons <name> <path> <branch> <base> — why removing this worktree would destroy work,
               # one reason per line; nothing at all when there is nothing to lose. `wt rm` and `wt prune`
               # (dry run included) both read this, so the two can never disagree.
  # Every commit check is about the BRANCH, never the worktree's HEAD. Under `git bisect`, `git checkout <sha>`
  # or `--detach`, the HEAD is usually an ancestor of the base. A HEAD-based check then reads "clean, 0 ahead,
  # merged". But `branch -D` still destroys every commit that the branch holds, and its reflog too. $b
  # resolves whether or not it is checked out. The worktree shares its refs with the main checkout, so ask
  # $REPO about it.
  local n="$1" p="$2" b="$3" base="$4" dirty ahead=0 merged=0 base_ok=0 head_ref f why="" rc
  dirty=$(unexplained_dirt "$n" "$p" | wc -l | tr -d ' ')      # what .wt-setup itself wrote is not a reason
  [[ "$dirty" -gt 0 ]] && printf '%s uncommitted change(s)\n' "$dirty"
  # A base that no longer resolves fails both checks below, and each failure reads as "nothing to lose". The
  # literal HEAD (metadata from before wt canonicalized the base) resolves in every worktree to that
  # worktree's own tip, and reads the same way. So settle the base first, and make either case a refusal.
  if [[ "$base" != HEAD ]] && git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1; then
    base_ok=1
    # merged means one of two things:
    # - the branch is an ancestor of the base (a merge commit, a fast-forward);
    # - all its work is in the base's tip without its commits (a squash merge; see branch_landed).
    # Check the second case offline first. Then, in case the merge is newer than the last fetch, refresh a
    # remote base and check once more. With --discard-commits, check neither: the reason is waived whatever
    # the answer, so there is nothing to go online for.
    if git -C "$REPO" merge-base --is-ancestor "$b" "$base" 2>/dev/null; then merged=1
    elif [[ $RM_DISCARD_COMMITS -eq 1 ]]; then merged=0
    elif branch_landed "$b" "$base"; then merged=1
    else
      why=" ($LANDED_WHY)"
      fetch_base "$base" && rc=0 || rc=$?
      if [[ $rc -eq 0 ]]; then
        if branch_landed "$b" "$base"; then merged=1; else why=" ($LANDED_WHY)"; fi
      elif [[ $rc -eq 1 ]]; then why=" ($LANDED_WHY; $base could not be refreshed from its remote)"
      fi
    fi
    ahead=$(git -C "$REPO" rev-list --count "$base..$b" 2>/dev/null || echo 0)
  fi
  [[ $base_ok -eq 1 ]] || printf "base '%s' cannot be compared with %s (gone, or the literal HEAD)\n" "$base" "$b"
  if [[ "$ahead" -gt 0 && $merged -eq 0 && $RM_DISCARD_COMMITS -eq 0 ]] && ! branch_pushed "$b"; then
    printf '%s commit(s) on %s not merged into %s and not on a remote%s\n' "$ahead" "$b" "$base" "$why"
  fi
  # The checks above are about $b, so a HEAD that is not $b is a reason of its own. The worktree then holds a
  # state (a bisect, a detached checkout) that no branch keeps, and removing the worktree throws it away.
  if [[ -d "$p" ]]; then
    head_ref=$(git -C "$p" symbolic-ref -q --short HEAD 2>/dev/null || true)
    if [[ -z "$head_ref" ]]; then printf 'HEAD is detached at %s (bisect, or a detached checkout), not on %s\n' \
        "$(git -C "$p" rev-parse --short HEAD 2>/dev/null || echo '?')" "$b"
    elif [[ "$head_ref" != "$b" ]]; then printf 'HEAD is on %s, not %s\n' "$head_ref" "$b"; fi
  fi
  while IFS= read -r f; do
    if [[ -n "$f" ]]; then printf '%s was edited or created inside the worktree (.wt-include, not in git)\n' "$f"; fi
  done <<<"$(changed_includes "$n" "$p")"
  return 0
}

open_code() { # open_code <folder uri> <label>   (no --new-window: a repeat call focuses the window)
  have code || die "VS Code CLI 'code' not found (install it from VS Code: Shell Command: Install 'code' command in PATH)"
  # On the Mac, code hands the launch to a detached `open` and exits 0 whatever that does. Codex's sandbox
  # (which sets CODEX_SANDBOX) blocks Launch Services. So from inside that sandbox, no window opens and
  # nothing says so.
  [[ -z "${CODEX_SANDBOX:-}" ]] \
    || die "the Codex sandbox blocks app launches, so VS Code cannot open $2 from here; rerun this command with escalation"
  local err
  err=$(code --folder-uri "$1" 2>&1 >/dev/null) || die "VS Code did not open $2: code exited $?${err:+: $err}"
  printf 'opened in VS Code: %s\n' "$2"
}

open_worktree() { # open_worktree <name> — VS Code here; from a VM ask the Mac to do it
  if ! is_remote; then open_code "file://$P" "$P"; return 0; fi
  local h manual; h=$(wt_host)
  manual="wt -H $h open -r $(shell_join "$REPO") $1"
  if ! hook_ok_repo || ! notify_mac wt-open host "$h" path "$P"; then
    printf 'VS Code request to the Mac failed. Run on the Mac: %s\n' "$manual"
    return 1
  fi
  printf 'requested VS Code on the Mac: %s:%s\n' "$h" "$P"
  printf 'if no window appears, run on the Mac: %s\n' "$manual"
}

request_row() { # request_row <name> — VM side: ask the Mac for a cmux row, and always print the recovery line
  local h; h=$(wt_host)
  if hook_ok_repo; then notify_mac wt-attach host "$h" repo "$REPO" task "$1" || true; fi
  printf 'on the Mac: wt -H %s attach -r %s %s\n' "$h" "$(shell_join "$REPO")" "$1"
}

session_state() { # session_state <name> — what the VM's tmux holds for this task, and whether a row holds that
  local s state=none t; s=$(wt_session "$1" "$REPO")   # session: `wt -H <host> attach` reads both from `wt show`
  if tmux has-session -t "=$s" 2>/dev/null; then
    state='shell only'
    while IFS= read -r t; do                           # the agent is a child of `wt run`, so it is never the pane's
      [[ -n "$t" ]] || continue                        # own command; everything on the pane's tty is what counts
      if pgrep -t "${t#/dev/}" -x 'claude|codex' >/dev/null 2>&1; then state='agent running'; break; fi
    done < <(tmux list-panes -s -t "=$s" -F '#{pane_tty}' 2>/dev/null)
    if [[ -z "$(tmux list-clients -t "=$s" 2>/dev/null)" ]]; then state="$state, detached"; fi
  fi
  printf '%s (%s)' "$s" "$state"
}

tmux_agent() { # tmux_agent <session> — 0 for a running agent, 1 for absent or idle, 2 for unreadable status.
  local err panes t rc=0
  err=$(LC_ALL=C tmux has-session -t "=$1" 2>&1) || rc=$?
  if [[ $rc -ne 0 ]]; then
    case "$err" in
      "can't find session: =$1"|"can't find session: $1") return 1 ;;
      'no server running on '*|'error connecting to '*'(No such file or directory)') return 1 ;;
      *) printf '%s\n' "$err" >&2; return 2 ;;
    esac
  fi
  panes=$(tmux list-panes -s -t "=$1" -F '#{pane_tty}' 2>&1) || { printf '%s\n' "$panes" >&2; return 2; }
  [[ -n "$panes" ]] || return 2
  while IFS= read -r t; do
    [[ "$t" =~ ^/dev/(pts/[0-9]+|tty[[:alnum:]]+)$ ]] || return 2
    rc=0
    pgrep -t "${t#/dev/}" -x 'claude|codex' >/dev/null || rc=$?
    case $rc in 0) return 0 ;; 1) ;; *) return 2 ;; esac
  done <<<"$panes"
  return 1
}

# ---------------------------------------------------------------- status
WT_FS=$'\x1f'   # the status line's field separator: git allows '|' in a branch name, and a base like
                # 'feat|x' used to shift every field of the line right, so the branch column printed the base
wt_status_line() { # prints: name<US>branch<US>base<US>ahead<US>behind<US>dirty<US>last<US>merged<US>why
  local n="$1" p b base ahead behind dirty last merged='?' why=""
  p=$(wt_path "$n"); b=$(wt_branch "$n")
  base=$(meta_get "$n" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  # Count against the BRANCH, not HEAD, because the column is labeled with the branch. In a worktree that is
  # mid-bisect or on a detached checkout, the two differ. That is the shape of the bug that wt rm had.
  ahead=$(git -C "$p" rev-list --count "$base..$b" 2>/dev/null || echo '?')
  behind=$(git -C "$p" rev-list --count "$b..$base" 2>/dev/null || echo '?')
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  last=$(git -C "$p" log -1 --format='%cr' 2>/dev/null || echo '-')
  local cur; cur=$(git -C "$p" branch --show-current 2>/dev/null || true)   # empty, exit 0, on a detached HEAD
  [[ -n "$cur" ]] || cur="$b (HEAD detached)"
  # merged, judged the way `wt rm` will judge it:
  # - "yes" when every commit is in the base (an ahead of 0 is exactly that);
  # - "squash" when the commits are not in the base but their work is (branch_landed, the check rm makes);
  # - "no", with the reason, otherwise;
  # - "?" when there is no base to compare with.
  # A squash-merged branch used to show as 2 ahead here, which reads as unmerged work. The worktree-show
  # skill also told agents to judge merged by a 0. This never fetches, because `wt list` is offline. So
  # right after a PR merges, the column says "no" until something refreshes the base. `wt rm`, `wt prune`
  # and `wt new` all refresh it. The AHEAD and BEHIND columns have always carried the same caveat. The
  # literal HEAD as a base resolves to the worktree's own tip and would read as 0 ahead. So a HEAD base
  # shows "?" here, as it is a refusal in rm_reasons.
  if [[ "$base" != HEAD && "$ahead" =~ ^[0-9]+$ ]]; then
    if [[ "$ahead" -eq 0 ]]; then merged=yes
    elif branch_landed "$b" "$base"; then merged=squash
    else merged=no; why="$LANDED_WHY"; fi
  fi
  printf '%s\n' "$n$WT_FS$cur$WT_FS$base$WT_FS$ahead$WT_FS$behind$WT_FS$dirty$WT_FS$last$WT_FS$merged$WT_FS$why"
}

list_names() { # registered worktrees under the wt root
  local root p; root=$(wt_root)
  while IFS= read -r p; do          # the prefix is stripped here, not by sed: a repo path may hold '#'
    [[ "$p" == "$root/"* ]] || continue
    p=${p#"$root/"}
    case "$p" in */*) continue ;; esac
    printf '%s\n' "$p"
  done < <(git -C "$REPO" worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')
  return 0
}

# ---------------------------------------------------------------- commands
cmd_new() {
  local name="" prompt="" stdin_prompt=0 base="" from_head=0 agent="$DEFAULT_AGENT" model="" workspace=1 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--prompt) [[ $# -ge 2 ]] || die "new: $1 needs a brief"; prompt="$2"; shift 2 ;;
      --prompt-stdin) stdin_prompt=1; shift ;;
      -b|--base) [[ $# -ge 2 ]] || die "new: $1 needs a ref"; base="$2"; shift 2 ;;
      --head) from_head=1; shift ;;
      -a|--agent) [[ $# -ge 2 ]] || die "new: $1 needs an agent"; agent="$2"; shift 2 ;;
      -m|--model) [[ $# -ge 2 ]] || die "new: $1 needs a model"; need_model "$2"; model="$2"; shift 2 ;;
      --no-workspace) workspace=0; shift ;;
      -r|--repo) [[ $# -ge 2 ]] || die "new: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "new: unknown option $1" ;;
      *) if [[ -z "$name" ]]; then name="$1"; else die "new: unexpected argument $1"; fi; shift ;;
    esac
  done
  if [[ $stdin_prompt -eq 1 ]]; then IFS= read -r -d '' prompt || true; fi
  resolve_repo "$repo"
  name=$(tidy_name "$name")
  [[ -n "$name" ]] || name=$(slugify "$prompt")
  [[ -n "$name" ]] || name="task-$(date +%Y%m%d-%H%M%S)"
  need_name "$name"
  valid_agent "$agent"
  [[ "$agent" != none || -z "$model" ]] || die "new: -m needs an agent (claude or codex)"
  [[ "$agent" != codex || "$model" != *'['* ]] || die "new: [suffix] models are for Claude, not Codex"
  local p b; p=$(wt_path "$name"); b=$(wt_branch "$name")
  [[ -e "$p" ]] && die "worktree '$name' already exists at $p (wt attach $name to open it)"
  git -C "$REPO" show-ref -q --verify "refs/heads/$b" && die "branch $b already exists (kept by wt rm --keep-branch, or by a removal git would not call merged, or left behind by a worktree deleted outside wt); inspect it (git -C $REPO log $b), then delete it (git -C $REPO branch -D $b) or pick another name"
  check_identity "$name"
  if [[ $workspace -eq 1 ]] && is_remote; then   # the row request needs the host; fail before anything exists
    wt_host >/dev/null
  fi

  # --head is this checkout's HEAD: its branch name, or its commit when HEAD is detached (mid-rebase, a
  # checked-out tag). Never use the literal "HEAD": it resolves in each worktree to that worktree's own tip.
  # The base would then compare the worktree with itself, and rm and prune would find nothing to lose.
  if [[ $from_head -eq 1 ]]; then
    base=$(git -C "$PWD" symbolic-ref -q --short HEAD 2>/dev/null || git -C "$PWD" rev-parse HEAD 2>/dev/null) \
      || base=$(git -C "$REPO" symbolic-ref -q --short HEAD || git -C "$REPO" rev-parse HEAD)
  fi
  [[ -n "$base" ]] || base=$(default_base)
  if [[ "$base" == origin/* ]]; then
    git -C "$REPO" fetch -q origin "${base#origin/}" 2>/dev/null || warn "fetch of $base failed; using local ref"
  fi
  git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null || die "base ref not found: $base"
  # "HEAD", "@", "HEAD^0", "@{0}" … are all the same thing. Each one re-resolves in every worktree to that
  # worktree's own tip. A base stored in that form would compare the worktree with itself, and rm and prune
  # would find nothing to lose. So canonicalize the base; do not try to block each bad spelling. Only a
  # plain ref name means the same thing in every worktree tomorrow, so keep a ref in its given shorthand
  # (--symbolic-full-name names it). Pin anything else (an expression or a raw sha) to the commit that it
  # means now.
  local sym; sym=$(git -C "$REPO" rev-parse --symbolic-full-name "$base" 2>/dev/null || true)
  # For a detached checkout, --symbolic-full-name prints the bare word HEAD. That word is not a ref, and it is
  # the spelling that this block exists to catch. Only a refs/… answer names the same thing in every worktree.
  case "$sym" in refs/*) ;; *) sym="" ;; esac
  case "$base" in
    "$sym"|"${sym#refs/heads/}"|"${sym#refs/remotes/}"|"${sym#refs/tags/}") ;;
    *) base=$(git -C "$REPO" rev-parse "$base^{commit}") ;;
  esac

  mkdir -p "$(wt_root)"
  git -C "$REPO" worktree add -q -b "$b" "$p" "$base" || die "git worktree add failed"
  # The worktree is now registered. Save its brief, agent and model before the slow copy/setup work.
  # If the SSH channel closes during a hook, attach --restart-agent must still know what to run.
  mkdir -p "$REPO/.git/wt"
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; fi
  meta_set "$name" "base=$base" "created=$(date -u +%FT%TZ)" "agent=$agent" "model=$model" \
    "title=$(row_title "$name")" "session=$(wt_session "$name" "$REPO")" \
    "includes=" "setup="
  local includes; includes=$(copy_includes "$p")
  meta_set "$name" "includes=$includes"
  local setup=""
  if [[ -x "$REPO/.wt-setup" ]]; then
    ( cd "$p" && WT_NAME="$name" WT_REPO="$REPO" "$REPO/.wt-setup" ) || warn ".wt-setup exited non-zero"
    setup=$(setup_dirt "$p")               # recorded even when the hook failed: it may have written part of it
    meta_set "$name" "setup=$setup"
  fi

  printf 'created %s\n  path:   %s\n  branch: %s (from %s)\n  repo:   %s\n  session: %s\n' \
    "$name" "$p" "$b" "$base" "$REPO" "$(wt_session "$name" "$REPO")"
  [[ $workspace -eq 1 ]] || return 0
  if is_remote; then request_row "$name"; else open_workspace "$name"; fi   # a VM never starts an agent
  return 0
}

cmd_run() { # run the task's agent here; cmux types this into the row's shell, which stays after the agent exits
  local name="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "run: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "run: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "run: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "run: worktree name required (wt run <name> -r <repo>)"
  resolve_repo "$repo"; require_wt "$name"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH"; export PATH ;; esac
  cd "$P"
  local agent model brief="" f rc=0
  IFS="$WT_FS" read -r agent model <<<"$(meta_get_pair "$name" agent model 2>/dev/null || true)"
  [[ -n "$agent" ]] || agent="$DEFAULT_AGENT"
  case "$agent" in
    none|shell|"") printf '%s: %s\n  agent:  none — this is your shell\n' "$name" "$P"; return 0 ;;
    claude|codex) ;;
    *) die "unknown agent '$agent' in $(wt_meta "$name")" ;;
  esac
  valid_model "$model" || [[ -z "$model" ]] || die "invalid model '$model' in $(wt_meta "$name")"
  [[ "$agent" != codex || "$model" != *'['* ]] || die "Claude-style model suffix in $(wt_meta "$name") for Codex"
  f=$(wt_prompt "$name")                         # a command substitution would remove the trailing newline
  if [[ -f "$f" ]]; then IFS= read -r -d '' brief <"$f" || true; fi
  local extra=() filtered=() model_arg=() args=() i=0
  if [[ -n "${WT_AGENT_ARGS:-}" ]]; then
    # shellcheck disable=SC2206   # word splitting is the point
    extra=($WT_AGENT_ARGS)
  fi
  if [[ -n "$model" ]]; then
    # Remove machine-wide model choices and Claude's fallback before adding this task's choice. Then neither
    # CLI has to decide which repeated model flag wins, even on a Claude -c resume.
    while [[ $i -lt ${#extra[@]} ]]; do
      case "${extra[$i]}" in
        -m|--model|--fallback-model) i=$((i + 2)); continue ;;
        -m?*|--model=*|--fallback-model=*) i=$((i + 1)); continue ;;
        -c|--config)
          if [[ "$agent" == codex && "${extra[$((i + 1))]:-}" == model=* ]]; then i=$((i + 2)); continue; fi ;;
        -cmodel=*|--config=model=*)
          if [[ "$agent" == codex ]]; then i=$((i + 1)); continue; fi ;;
      esac
      filtered+=("${extra[$i]}"); i=$((i + 1))
    done
    extra=("${filtered[@]+"${filtered[@]}"}")
    if [[ "$agent" == claude ]]; then model_arg=(--model "$model"); else model_arg=(-m "$model"); fi
  fi
  if [[ "$agent" == claude && -e "$(wt_started "$name")" ]]; then
    args=(-c)                                    # resume this worktree's last conversation
  elif [[ -n "$brief" ]]; then
    args=(-- "$brief")                           # Codex always restarts from the brief
  fi
  : > "$(wt_started "$name")"
  if is_remote && [[ ${WT_STATUS_BRIDGE:-} == 1 && -n ${TMUX:-} && ${CMUX_SOCKET_PATH:-} == *:[0-9]* ]]; then
    WT_STATUS_OWNER_PID=$$ WT_STATUS_OWNER_PANE=${TMUX_PANE:-}
    WT_STATUS_SOURCE=$([[ $agent == claude ]] && echo 'Claude Code' || echo Codex)
    WT_STATUS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/wt-agent-status/$(wt_session "$name" "$REPO")"
    (umask 077; mkdir -p "${WT_STATUS_FILE%/*}")
    rm -f "$WT_STATUS_FILE"
    export WT_STATUS_OWNER_PID WT_STATUS_OWNER_PANE WT_STATUS_FILE
    ( while kill -0 "$WT_STATUS_OWNER_PID" 2>/dev/null; do
        sleep 45
        kill -0 "$WT_STATUS_OWNER_PID" 2>/dev/null || break
        [[ -r $WT_STATUS_FILE ]] && WT_STATUS_HEARTBEAT=1 AGENT_NOTIFY_SOURCE="$WT_STATUS_SOURCE" agent-notify </dev/null || true
      done ) >/dev/null 2>&1 &
    WT_STATUS_HEARTBEAT_PID=$!
  fi
  "$agent" "${model_arg[@]+"${model_arg[@]}"}" "${extra[@]+"${extra[@]}"}" "${args[@]+"${args[@]}"}" || rc=$?
  [[ -n ${WT_STATUS_FILE:-} ]] && wt_cleanup
  [[ $rc -eq 0 ]] || warn "$agent exited with status $rc"
  return 0
}

cmd_list() {
  local all=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "list: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "list: unknown option $1" ;;
    esac
    shift
  done
  local repos=()
  if [[ $all -eq 1 ]]; then
    need_repos_dir
    while IFS= read -r d; do repos+=("$d"); done < <(repo_dirs)
  else
    resolve_repo "$repo"; repos=("$REPO")
  fi
  for r in "${repos[@]+"${repos[@]}"}"; do
    set_repo "$r" || continue
    local names; names=$(list_names); [[ -n "$names" ]] || continue
    printf '\n%s  (%s)\n' "$(basename "$REPO")" "$REPO"
    printf '  %-28s %-26s %-16s %6s %6s %6s %6s  %s\n' NAME BRANCH BASE AHEAD BEHIND MERGED DIRTY LAST
    while IFS= read -r n; do
      IFS="$WT_FS" read -r nn br base ah be di last mg why <<<"$(wt_status_line "$n")"
      # the columns are numbers: a '?' from a base that no longer resolves must not print as a count
      [[ "$ah" =~ ^[0-9]+$ ]] || ah='?'; [[ "$be" =~ ^[0-9]+$ ]] || be='?'; [[ "$di" =~ ^[0-9]+$ ]] || di=0
      printf '  %-28s %-26s %-16s %6s %6s %6s %6s  %s\n' "$nn" "$br" "$base" "$ah" "$be" "$mg" "$di" "$last"
    done <<<"$names"
  done
  return 0
}

cmd_show() {
  local name="" diff=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --diff) diff=1 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "show: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "show: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "show: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "show: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  IFS="$WT_FS" read -r nn br base ah be di last mg why <<<"$(wt_status_line "$name")"
  # the counts are numbers: a '?' from a base that no longer resolves must not print as a count
  [[ "$ah" =~ ^[0-9]+$ ]] || ah='?'; [[ "$be" =~ ^[0-9]+$ ]] || be='?'; [[ "$di" =~ ^[0-9]+$ ]] || di=0
  local title model; IFS="$WT_FS" read -r title model <<<"$(meta_get_pair "$name" title model 2>/dev/null || true)"
  title=$(task_title "$name" "$title")
  case "$mg" in   # wt list's MERGED value, with room here for the reason behind it
    squash) mg="squash (every change on $br is in $base, though no commit is)" ;;
    no)     mg="no ($why)" ;;
    '?')    mg="? (no base to compare with)" ;;
  esac
  printf '%s\n  path:    %s\n  repo:    %s\n  branch:  %s  (+%s / -%s vs %s)\n  merged:  %s\n  row:     %s\n  task:    %s\n  dirty:   %s file(s)\n  last:    %s\n' \
    "$nn" "$P" "$REPO" "$br" "$ah" "$be" "$base" "$mg" "$title $(row_tag "" "$REPO")" "$(prompt_line "$name")" "$di" "$last"
  [[ -z "$model" ]] || printf '  model:   %s\n' "$model"
  if is_remote; then printf '  session: %s\n' "$(session_state "$name")"; fi   # `wt -H … attach` reads this line
  printf '\n--- commits vs %s\n' "$base"; git -C "$P" log --oneline "$base..HEAD" 2>/dev/null | head -20
  printf '\n--- diff --stat vs %s (committed)\n' "$base"; git -C "$P" diff --stat "$base...HEAD" 2>/dev/null | tail -15
  printf '\n--- working tree\n'; git -C "$P" status --short 2>/dev/null | head -20
  if [[ $diff -eq 1 ]]; then
    cmux_ok || die "cmux is not running"
    CMUX_QUIET=1 "$(cmux_bin)" diff --branch --repo "$P" --base "$base" --layout split --title "$name vs $base" --focus true >/dev/null && printf 'opened cmux diff pane\n'
  fi
}

cmd_open() { # wt open [name] [-r PATH] — no name: the worktree holding $PWD
  local name="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "open: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "open: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "open: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  if [[ -n "$name" ]]; then
    resolve_repo "$repo"
  else
    local root
    set_repo "$PWD" || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)
    [[ "$root" == "$(wt_root)/"* ]] || die "not inside a task worktree; pass a name (wt open <name> -r <repo>)"
    name=${root#"$(wt_root)/"}
  fi
  require_wt "$name"
  open_worktree "$name"
}

cmd_attach() {
  local name="" agent="" prompt="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a|--agent) [[ $# -ge 2 ]] || die "attach: $1 needs an agent"; agent="$2"; shift ;;
      -p|--prompt) [[ $# -ge 2 ]] || die "attach: $1 needs a brief"; prompt="$2"; shift ;;
      -r|--repo) [[ $# -ge 2 ]] || die "attach: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "attach: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "attach: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "attach: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  if [[ -n "$agent" ]]; then
    valid_agent "$agent"
    local old_agent; old_agent=$(meta_get "$name" agent 2>/dev/null || true)
    [[ -n "$old_agent" ]] || old_agent="$DEFAULT_AGENT"
    if [[ "$agent" != "$old_agent" ]]; then
      meta_set "$name" "agent=$agent" "model="
      rm -f "$(wt_started "$name")"
    else
      meta_set "$name" "agent=$agent"
    fi
  fi
  if [[ -n "$prompt" ]]; then printf '%s' "$prompt" > "$(wt_prompt "$name")"; rm -f "$(wt_started "$name")"; fi
  if is_remote; then request_row "$name"; else open_workspace "$name"; fi
}

cmd_sync() {
  local name="" merge=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --merge) merge=1 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "sync: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "sync: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "sync: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "sync: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  [[ "$base" == origin/* ]] && git -C "$REPO" fetch -q origin "${base#origin/}"
  [[ -z "$(git -C "$P" status --porcelain)" ]] || die "worktree has uncommitted changes; commit or stash first"
  if [[ $merge -eq 1 ]]; then git -C "$P" merge --no-edit "$base"; else git -C "$P" rebase "$base"; fi
  printf 'synced %s onto %s\n' "$name" "$base"
}

cmd_pr() {
  local name="" draft=() repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --draft) draft=(--draft) ;;
      -r|--repo) [[ $# -ge 2 ]] || die "pr: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "pr: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "pr: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "pr: worktree name required"
  resolve_repo "$repo"; require_wt "$name"; have gh || die "gh not installed"
  [[ -z "$(git -C "$P" status --porcelain)" ]] || die "worktree has uncommitted changes; commit first"
  git -C "$P" push -u origin "$B"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  ( cd "$P" && gh pr create --fill --base "${base#origin/}" "${draft[@]+"${draft[@]}"}" )
}

cmd_rm() {
  local name="" force=0 keep=0 repo="" self_remote=0 host="" session="" title="" native=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1 ;;
      --keep-branch) keep=1 ;;
      --discard-commits) RM_DISCARD_COMMITS=1 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "rm: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "rm: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "rm: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "rm: worktree name required"
  resolve_repo "$repo"; require_wt "$name"
  local here there; here=$(pwd -P); there=$(cd "$P" 2>/dev/null && pwd -P) || there="$P"   # a symlinked cwd is still inside
  [[ "$here" == "$there" || "$here" == "$there/"* ]] && die "you are inside $name; cd out first (e.g. cd $REPO)"
  local base; base=$(meta_get "$name" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
  reset_fetched
  if [[ $force -eq 0 ]]; then
    local reasons=() r
    while IFS= read -r r; do
      if [[ -n "$r" ]]; then reasons+=("$r"); fi
    done <<<"$(rm_reasons "$name" "$P" "$B" "$base")"
    if [[ ${#reasons[@]} -gt 0 ]]; then
      printf 'wt: refusing to remove %s: %s\n' "$name" "$(IFS=';'; echo "${reasons[*]}")" >&2
      printf 'wt: inspect with: wt show %s — then push/merge, check the branch out again or copy the file back, or re-run with --force to discard.\n' "$name" >&2
      case "${reasons[*]}" in *' not merged into '*) printf 'wt: --discard-commits waives only the commit reason (a squash merge the base later edited or reverted); the other checks stay.\n' >&2 ;; esac
      exit 3
    fi
  fi
  # Socket access can fail after Git deletes the worktree. Require escalation before removal.
  [[ -z "${CODEX_SANDBOX:-}" ]] \
    || die "the Codex sandbox can block cmux or tmux cleanup; rerun this command with escalation"
  if is_remote && [[ -n ${TMUX:-} ]]; then
    local current
    session=$(wt_session "$name" "$REPO")
    current=$(tmux display-message -p '#S' 2>&1) \
      || die "cannot read the current tmux session: $current; rerun this command with escalation if a sandbox blocks the socket"
    [[ -n "$current" ]] || die "cannot read the current tmux session: tmux returned no session name"
    if [[ "$current" == "$session" ]]; then self_remote=1; fi
  fi
  title=$(task_title "$name")
  if is_remote; then
    [[ -n "$session" ]] || session=$(wt_session "$name" "$REPO")
    if [[ $self_remote -eq 0 ]]; then
      local agent_rc=0
      tmux_agent "$session" || agent_rc=$?
      case $agent_rc in
        0) die "another agent is running in tmux session $session; kept the worktree" ;;
        1) ;;
        *) die "cannot check the agent in tmux session $session; kept the worktree" ;;
      esac
    fi
    if [[ $self_remote -eq 1 && $(tmux show-environment -t "=$session" WT_CMUX_CLOSE_ON_EXIT 2>/dev/null) == WT_CMUX_CLOSE_ON_EXIT=1 ]]; then
      native=1
    fi
  else
    check_row_removal "$title" "$REPO" "" "$(wt_path "$name")"
  fi
  if [[ $self_remote -eq 1 && $native -eq 0 ]]; then
    # Check the relay setup only after the reasons above, while the worktree is still intact.
    host=$(wt_host)
    hook_ok_repo || die "cannot request Mac row cleanup for $REPO"
    if ! relay_env; then
      [[ -z ${CMUX_TUI_SOCKET:-} ]] \
        || die "this row predates native teardown; close and reopen this row on the Mac: wt -H $host attach -r $(shell_join "$REPO") $name, then retry"
      die "cannot find the Mac cmux relay in this session"
    fi
  fi
  # the ignored files that remain are unchanged copies or build output, so --force is normal here
  if [[ -d "$P" ]]; then
    git -C "$REPO" worktree remove --force "$P" || die "git worktree remove failed for $P; free it, then: rm -rf $P && git -C $REPO worktree prune"
  else
    git -C "$REPO" worktree prune          # the directory was removed outside wt; drop its registration
  fi
  if [[ $keep -eq 0 ]]; then
    # Use branch -d, so git's own merged check is the last safeguard behind the reasons above. The flags
    # --force and --discard-commits are the deliberate ways to discard commits. Otherwise wt keeps the
    # branch and says so. One more case gets -D: a branch whose work branch_landed found in the base.
    # Git's -d knows nothing of squash merges, so it declines to delete that branch. The exception is when
    # a stale remote-tracking ref still equals the branch: -d takes that as merged upstream. The reasons
    # above already let the worktree go on that same finding, made against this same base, so the branch
    # goes with it.
    if ! git -C "$REPO" branch -d "$B" >/dev/null 2>&1; then
      if [[ $force -eq 1 || $RM_DISCARD_COMMITS -eq 1 ]] || { [[ "$base" != HEAD ]] && branch_landed "$B" "$base"; }; then
        git -C "$REPO" branch -D "$B" >/dev/null 2>&1 || true
      else keep=1; warn "kept branch $B: git will not delete it as merged (git -C $REPO branch -D $B discards it)"; fi
    fi
  fi
  rm -f "$(wt_meta "$name")" "$(wt_prompt "$name")" "$(wt_started "$name")"
  git -C "$REPO" worktree prune
  printf 'removed %s%s\n' "$name" "$([[ $keep -eq 1 ]] && echo " (branch $B kept)")"
  if is_remote; then
    [[ -n "$session" ]] || session=$(wt_session "$name" "$REPO")
    if [[ $native -eq 1 ]]; then
      # The row execs its tmux client. Stopping this session ends the terminal and its Mac row.
      tmux kill-session -t "=$session"
    elif [[ $self_remote -eq 1 ]]; then
      # The Mac hook closes the row and kills this session.
      # If this process is still alive after the hook's deadline, the cleanup did not finish.
      if notify_mac wt-close host "$host" repo "$REPO" task "$name"; then
        local close_wait="${WT_CLOSE_WAIT_SECONDS:-22}" i
        [[ "$close_wait" =~ ^[0-9]+$ ]] || close_wait=22
        for ((i=0; i<close_wait; i++)); do sleep 1; done
      fi
      warn "worktree removed, but its Mac row or tmux session is still open"
      warn "on the Mac: close row $(row_title "$name") $(row_tag "$host" "$REPO") (titled $(repo_id "$REPO"):$name if an older wt made it), then run: ssh $host tmux kill-session -t '=$session'"
    else
      tmux kill-session -t "=$session" 2>/dev/null || true   # the Mac owns the row
    fi
  elif [[ -n "$RM_ROW" ]]; then close_row "$RM_ROW" "$RM_SELF"
  else close_workspace "$name" "$title"; fi
}

cmd_prune() {
  local dry=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry=1 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "prune: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "prune: unknown option $1" ;;
    esac
    shift
  done
  resolve_repo "$repo"
  local names n p base why
  reset_fetched           # one fetch per base for the whole run, also for cmd_rm's checks; see fetch_base
  names=$(list_names)     # before `git worktree prune`; otherwise a directory deleted by hand loses its
                          # registration here and is never examined, so its branch and metadata stay forever
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    p=$(wt_path "$n"); base=$(meta_get "$n" base 2>/dev/null || true); [[ -n "$base" ]] || base=$(default_base)
    why=$(rm_reasons "$n" "$p" "$(wt_branch "$n")" "$base" | tr '\n' ';'); why="${why%;}"   # the same reasons as rm,
    if [[ -n "$why" ]]; then printf 'keep %s (%s)\n' "$n" "$why"                            # dry run included
    elif [[ $dry -eq 1 ]]; then printf 'would remove %s (nothing to lose vs %s)\n' "$n" "$base"
    elif ! ( cd "$REPO" && cmd_rm "$n" ); then printf 'keep %s (removal refused above)\n' "$n"; fi
  done <<<"$names"
  git -C "$REPO" worktree prune
}

cmd_path() {
  local name="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "path: $1 needs a repo"; repo="$2"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "path: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "path: unexpected argument $1"; name="$1" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "path: worktree name required"
  resolve_repo "$repo"; require_wt "$name"; printf '%s\n' "$P"
}
cmd_repos()   { # wt repos [<name>] [--porcelain|--table]. No name: list every repo. Print a table (name, number
                # of task worktrees, location) when stdout is a terminal, or with --table; `wt -H <host> repos`
                # asks a VM for a table that way. Print "<name><tab><path>" per repo (the task picker's two
                # columns) when piped or with --porcelain. A name or path: only that repo's path (also over ssh).
  local mode="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --porcelain|--table) mode="${1#--}" ;;
      -*) die "repos: unknown option $1 (wt repos [<name>] [--porcelain|--table])" ;;
      *) [[ -z "$name" ]] || die "repos: one name at most (wt repos [<name>])"; name="$1" ;;   # the one resolution rule
    esac
    shift
  done
  if [[ -n "$name" ]]; then lookup_repo "$name"; printf '%s\n' "$REPO"; return 0; fi
  need_repos_dir
  if [[ -z "$mode" ]]; then if [[ -t 1 ]]; then mode=table; else mode=porcelain; fi; fi
  if [[ "$mode" == porcelain ]]; then repo_dirs | awk -F/ '{printf "%s\t%s\n", $NF, $0}'; return 0; fi
  local d n
  while IFS= read -r d; do                     # "<name><tab><path><tab><tasks>": what repo_menu table lays out
    [[ -n "$d" ]] || continue
    n=0; if set_repo "$d"; then n=$(list_names | grep -c . || true); fi
    printf '%s\t%s\t%s\n' "${d##*/}" "$d" "$n"
  done < <(repo_dirs) | repo_menu table
}
cmd_current() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      *) die "current: unexpected argument $1 (wt current takes none)" ;;
    esac
  done
  local root common
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  common=$(main_root_of "$PWD") || die "not in a git repo"
  if [[ "$root" == "$common" ]]; then printf 'main checkout: %s (%s)\n' "$root" "$(git branch --show-current)"
  else printf 'worktree: %s\n  branch: %s\n  main:   %s\n' "$root" "$(git branch --show-current)" "$common"; fi
}

# ---------------------------------------------------------------- driver and self-update
cmd_driver() { # the driver session, which starts tasks; its cwd is a repos folder, so `wt new` there needs -r
  # parse the args, do not ignore them: `wt driver -h` once created or selected the row instead of printing usage
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      *) die "driver: unexpected argument $1 (wt driver takes none)" ;;
    esac
  done
  mac_only driver
  cmux_ok || die "cmux is not running; start cmux, then: wt driver"
  local c id out cwd; c=$(cmux_bin)
  id=$(cmux_row_field driver "" id)
  if [[ -n "$id" ]]; then
    CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
    printf 'driver %s (selected)\n' "$(row_tag)"
    return 0
  fi
  need_repos_dir
  cwd=$(repos_entries | sed -n 1p)                                   # the first folder that exists
  out=$(CMUX_QUIET=1 "$c" workspace create --name driver --description "$(row_tag)" --cwd "$cwd" --command claude --focus true 2>&1) \
    || die "cmux workspace create failed: $out"
  printf 'driver %s (created)\n' "$(row_tag)"
}

cmd_update() { # pull this repo and re-run its installer
  # Forward install.sh's own flags; do not reject them. The opt-ins are sticky, so a plain update keeps what
  # this machine chose. But a user must be able to opt IN later through the command that the docs name.
  local pass=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --refresh-config|--opinionated-config|--with-*) pass+=("$1") ;;
      -h|--help) usage; exit 0 ;;
      *) die "update: unknown option $1" ;;
    esac
    shift
  done
  local s="$0" dir
  if [[ -L "$s" ]]; then s=$(readlink "$s"); fi            # ~/.local/bin/wt -> <repo>/bin/wt
  [[ "$s" == /* ]] || s="$(dirname "$0")/$s"
  dir=$(cd "$(dirname "$s")/.." && pwd -P)
  [[ -d "$dir/.git" ]] || die "$dir is not a git clone; replace the seed: mv $dir $dir.seed && git clone https://github.com/mal84emma/workgrove $dir"
  local ans
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 \
    || die "$dir has no upstream branch; set one: git -C $dir branch --set-upstream-to origin/main"
  git -C "$dir" fetch --quiet || die "git fetch failed in $dir"
  # Test containment, not equality. A clone that is only ahead (a local commit, normal on the machine where
  # you edit bin/wt) has nothing incoming. Comparing tips would show your own work as an incoming deletion.
  if git -C "$dir" merge-base --is-ancestor '@{u}' HEAD 2>/dev/null; then
    printf 'Already up to date.\n'
  else                                                     # `wt update` runs install.sh, so show the code first
    printf 'incoming commits:\n'; git -C "$dir" --no-pager log --oneline 'HEAD..@{u}'
    printf '\nfiles changed:\n';  git -C "$dir" --no-pager diff --stat 'HEAD..@{u}'
    [[ -t 0 ]] || die "update: refusing to apply these commits unattended; run wt update from an interactive terminal (for a VM, wt -H <vm> update from one, or a shell on the VM)"
    printf '\n'
    read -r -p "apply them and run $dir/install.sh? [y/N] " ans || ans=""
    [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]] || die "update: cancelled"
    git -C "$dir" merge --ff-only '@{u}'
  fi
  bash "$dir/install.sh" "${pass[@]+"${pass[@]}"}"
}

# ---------------------------------------------------------------- wt -H <host> …
remote_sh_raw() { # keep SSH's exit status intact for callers that must tell a refusal from a dropped connection
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$1" "$2"
}
remote_sh() { # remote_sh <host> <command> — one ssh call; 255 means transport failure
  local host="$1" cmd="$2" rc=0
  remote_sh_raw "$host" "$cmd" || rc=$?
  if [[ $rc -eq 255 ]]; then die "host unreachable: is the VM running? (ssh $host)"; fi
  return $rc
}
remote_wt() { local host="$1"; shift; remote_sh "$host" "exec \"\$HOME/.local/bin/wt\" $(shell_join "$@")"; }
remote_wt_raw() { local host="$1"; shift; remote_sh_raw "$host" "exec \"\$HOME/.local/bin/wt\" $(shell_join "$@")"; }
remote_sh_tty() { # remote_sh_tty <host> <command> — remote_sh, but lends the VM this terminal when there is one,
                  # so a command that asks before it acts (wt update) can read the answer. Never use it for a
                  # caller that captures stdout: a pty folds stderr into stdout and turns every \n into \r\n.
                  # Without a local terminal there is nothing to lend, and the VM's own refusal is correct.
  local host="$1" cmd="$2" rc=0 tty=()
  [[ -t 0 ]] && tty=(-t)                                   # -t works with BatchMode=yes, which only blocks prompts
  ssh -o BatchMode=yes -o ConnectTimeout=5 "${tty[@]+"${tty[@]}"}" "$host" "$cmd" || rc=$?
  if [[ $rc -eq 255 ]]; then die "host unreachable: is the VM running? (ssh $host)"; fi
  return $rc
}
remote_wt_tty() { local host="$1"; shift; remote_sh_tty "$host" "exec \"\$HOME/.local/bin/wt\" $(shell_join "$@")"; }
# shellcheck disable=SC2016   # $HOME must reach the VM unexpanded
status_bridge_ready() {
  [[ -f $HOME/.local/bin/cmux-hook ]] && grep -qF 'CMUX_NOTIFICATION_SUBTITLE' "$HOME/.local/bin/cmux-hook" &&
    jq -e 'any(.notifications.hooks[]?; .id == "wt" and .command == "~/.local/bin/cmux-hook")' \
      "$HOME/.config/cmux/cmux.json" >/dev/null 2>&1
}
remote_run_cmd() {
  status_bridge_ready && printf 'WT_STATUS_BRIDGE=1 '
  # shellcheck disable=SC2016  # $HOME belongs to the VM shell, not this Mac
  printf '"$HOME/.local/bin/wt" run %s -r %s' "$1" "$(shell_join "$2")"
}

row_ids() { # row_ids — one row id per line, from the full row list. It fails when any window's list fails,
            # because then new_row would take an older row that the partial list left out for a new one.
  local rows; rows=$(rows_json checked) || return 1
  printf '%s' "$rows" | jq -r '.workspaces[] | .id'
}

tag_row() { # tag_row <workspace ref or ""> <title> <repo> <host> [row ids before the create, or "-"] — write the description
  # A 5th argument marks a row that the caller has just created. "-" means that the list before the create
  # was unreadable.
  # A new row has no description yet, so a lookup by repo cannot find it. So when the create printed no ref,
  # take the row that new_row in ROW_JQ names. That needs the full list from before the create. Without it,
  # an older row with this title and no repo, such as the user's own `cmux ssh` row, would look new.
  # A task row's description holds the repo, so it is part of the row's identity. If it cannot be written on
  # a new task row, no later lookup finds that row, and the next attach builds a second row beside it. So
  # close that row and fail. A row with no repo (a shell row) is found by its title and host, so it stays.
  local ref="$1" tag; tag=$(row_tag "$4" "$3")
  [[ -n "$ref" || "${5:-}" != - ]] \
    || die "cmux printed no ref for the new row '$2' on $4, and the row list from before the create was unreadable; close that row in cmux"
  for _ in 1 2 3; do                    # no workspace:N in the output: the row list lags ~1s behind a create
    [[ -n "$ref" ]] && break
    sleep 1
    ref=$(rows_json | jq -r --arg t "$2" --arg h "$4" --arg before "${5:-}" --arg sep "$ROW_SEP" "$ROW_JQ"'
      first((.workspaces? // .)[] | select(new_row($t; $h; $before | split("\n"); $sep)) | .id // empty) // empty' \
      2>/dev/null || true)
  done
  [[ -n "$ref" ]] || die "cmux reported no row '$2' on $4; if cmux shows a new row '$2' with no repo on its second line, close it"
  CMUX_QUIET=1 "$(cmux_bin)" workspace-action --workspace "$ref" --action set-description --description "$tag" >/dev/null 2>&1 \
    && return 0
  [[ $# -ge 5 && -n "$3" ]] || die "cmux workspace-action failed; run: cmux workspace-action --workspace $ref --action set-description --description '$tag'"
  close_row "$ref" new || die "cmux could not write '$tag' on the new row $2, and wt could not close that row; close it in cmux"
  die "cmux could not write '$tag' on the new row $2, so wt closed that row"
}

tmux_cmd() { # tmux_cmd <session> [command] [shared] [reinit]
  # The line that a VM row's shell runs. It creates that tmux session (running <command>, then a shell) or
  # takes over the session that is already there. A task row owns its session, so it attaches with -d. It
  # hands the session THIS row's relay socket and workspace id. That makes `cmux notify` from inside the
  # session light up this row.
  # After "remote session was lost", cmux starts a shell that carries none of the CMUX_* variables.
  # The file ~/.tmux.conf lists CMUX_SOCKET_PATH and CMUX_WORKSPACE_ID in update-environment (install.sh
  # links home/.tmux.conf with --with-tmux-conf, or appends that one line to the file you already have).
  # So an attach from that shell would mark them removed in the session and silence `cmux notify` there.
  # Therefore, when the shell has none, the line takes each variable from the session (the row's old relay
  # port stays bound to the row). It sets each one only when it is non-empty.
  # A native attachment clears TCP values. A TCP attachment clears native values to override stale panes.
  # A session that you may also be in yourself (the VM shell, a repo shell) gets "shared" instead. Then the
  # row joins your clients and does not evict them, and it leaves their relay socket as it is.
  # bin/cmux-hook mirrors this function; keep the two byte-for-byte.
  # Native cmux closes a row when its terminal exits. Exec the tmux client so self-removal ends that terminal.
  local run="" native_mark=""
  # Replacing an old client does not replace its parent shell. Preserve its original cleanup contract.
  [[ ${4:-} == reinit ]] || native_mark="tmux set-environment -t '=$1' WT_CMUX_CLOSE_ON_EXIT 1; "
  [[ -n "${2:-}" ]] && printf -v run '%q' "$2; exec bash"
  if [[ "${3:-}" == shared ]]; then
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; tmux attach -t '=%s'" "$1" "$run" "$1"
  else
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; " "$1" "$run"
    # Bind the current transport before reading the old session's identity.
    printf "if [ -n \"\$CMUX_TUI_SOCKET\" ]; then for v in CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID; do export \"\$v=\"; tmux set-environment -t '=%s' \"\$v\" ''; done; " "$1"
    printf "for v in CMUX_TUI_SOCKET CMUX_TUI_TERMINAL_ID CMUX_TUI_SESSION_ID; do tmux set-environment -t '=%s' \"\$v\" \"\$(printenv \"\$v\")\"; done; %sexec tmux attach -d -t '=%s'; fi; " "$1" "$native_mark" "$1"
    printf "[ -n \"\$CMUX_SOCKET_PATH\" ] || export CMUX_SOCKET_PATH=\"\$(tmux show-environment -t '=%s' CMUX_SOCKET_PATH 2>/dev/null | sed -n 's/^CMUX_SOCKET_PATH=//p')\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] || export CMUX_WORKSPACE_ID=\"\$(tmux show-environment -t '=%s' CMUX_WORKSPACE_ID 2>/dev/null | sed -n 's/^CMUX_WORKSPACE_ID=//p')\"; [ -n \"\$CMUX_SOCKET_PATH\" ] && tmux set-environment -t '=%s' CMUX_SOCKET_PATH \"\$CMUX_SOCKET_PATH\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] && tmux set-environment -t '=%s' CMUX_WORKSPACE_ID \"\$CMUX_WORKSPACE_ID\"; " "$1" "$1" "$1" "$1"
    printf "for v in CMUX_TUI_SOCKET CMUX_TUI_TERMINAL_ID CMUX_TUI_SESSION_ID; do export \"\$v=\"; tmux set-environment -t '=%s' \"\$v\" ''; done; tmux attach -d -t '=%s'" "$1" "$1"
  fi
}

remote_row() { # remote_row <host> <session> <title> <repo> <command> [shared] [cmux flags…] — the local ssh row
               # for a VM tmux session. <repo> is "" for a row with no repo. One row per title, repo and host.
               # A row that is already there is re-tagged and (unless --no-focus) selected. It is never typed
               # into, because its pane may hold a running agent whose prompt would swallow the tmux line.
               # Only host_attach's detached branch sends.
  local host="$1" session="$2" title="$3" repo="$4" cmd="$5" shared="" c id line out before; shift 5
  if [[ "${1:-}" == shared ]]; then shared=shared; shift; fi
  cmux_ok || die "cmux is not running; start cmux, then re-run this command"
  c=$(cmux_bin)
  id=$(cmux_row_field "$title" "$repo" id "$host")
  if [[ -n "$id" ]]; then
    tag_row "$id" "$title" "$repo" "$host"
    case " $* " in
      *" --no-focus "*) ;;
      *) CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id" ;;
    esac
    printf 'row: %s %s (already open)\n' "$title" "$(row_tag "$host" "$repo")"
    return 0
  fi
  before=$(row_ids) || before=-          # "-" tells tag_row that it cannot know which row is new
  line=$(tmux_cmd "$session" "$cmd" "$shared")
  out=$(CMUX_QUIET=1 "$c" ssh "$host" --name "$title" "$@" --command "$line" 2>&1) || die "cmux ssh failed: $out"
  tag_row "$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1 || true)" "$title" "$repo" "$host" "$before"
  printf 'row: %s %s\n' "$title" "$(row_tag "$host" "$repo")"
}

need_r() { # need_r <host> <sub> <args…> — a remote call has no cwd to infer the repo from, so -r is required.
  # This tests presence only. cmd_host has already normalized the value and refused an empty, relative,
  # '.' or '..' one. So nothing is left here that a command would have rejected for itself.
  # -h wins over the requirement. A question about what a command takes must get an answer, not a complaint
  # that an argument it asks about is missing. Each command's own parser then handles -h.
  local host="$1" sub="$2" a; shift 2
  for a in "$@"; do
    case "$a" in
      -h|--help) return 0 ;;
      -r|--repo) return 0 ;;
    esac
  done
  die "$sub: -r <repo> is required with -H (wt -H $host repos lists them)"
}

host_new_preflight() { # read-only checks in the same non-interactive SSH environment as remote_wt
  local host="$1" repo="$2" agent="$3" cmd
  # shellcheck disable=SC2016   # $HOME and $PATH must expand on the VM
  cmd='PATH="$HOME/.local/bin:$PATH"; export PATH;'
  # shellcheck disable=SC2016
  cmd+=' test -x "$HOME/.local/bin/wt" || { echo "remote wt is missing" >&2; exit 1; };'
  if [[ -n "$repo" ]]; then
    cmd+=" \"\$HOME/.local/bin/wt\" repos $(shell_join "$repo") >/dev/null || exit 1;"
  fi
  cmd+=' command -v tmux >/dev/null 2>&1 || { echo "remote tmux is missing" >&2; exit 1; };'
  cmd+=" agent=$(shell_join "$agent");"
  # shellcheck disable=SC2016   # $agent and $WT_AGENT must expand on the VM
  cmd+=' [ -n "$agent" ] || agent=${WT_AGENT:-claude};'
  # shellcheck disable=SC2016
  cmd+=' case "$agent" in none) ;; claude|codex) command -v "$agent" >/dev/null 2>&1 || { echo "remote agent is missing: $agent" >&2; exit 1; } ;; *) echo "invalid remote agent: $agent" >&2; exit 1 ;; esac'
  remote_sh "$host" "$cmd"
}

host_new() { # create the worktree on the VM, then the cmux row here unless --no-workspace
  local host="$1" prompt="" repo_request="" requested_agent="" inspect="" no_workspace=0 args=(); shift
  # Consume both ways of giving a brief HERE, and relay them the same way. A forwarded --prompt-stdin would
  # read nothing locally and pipe an empty prompt into ssh. The VM would then create the task with no brief.
  while [[ $# -gt 0 ]]; do case "$1" in
    -p|--prompt) [[ $# -ge 2 ]] || die "new: $1 needs a brief"; prompt="$2"; shift 2 ;;
    --prompt-stdin) IFS= read -r -d '' prompt || true; shift ;;
    -r|--repo) [[ $# -ge 2 ]] || die "new: $1 needs a repo"; repo_request="$2"; args+=("$1" "$2"); shift 2 ;;
    -a|--agent) [[ $# -ge 2 ]] || die "new: $1 needs an agent"; requested_agent="$2"; valid_agent "$requested_agent"; args+=("$1" "$2"); shift 2 ;;
    -m|--model) [[ $# -ge 2 ]] || die "new: $1 needs a model"; need_model "$2"; args+=("$1" "$2"); shift 2 ;;
    --no-workspace) no_workspace=1; shift ;;
    --model=*|-m?*) die "new: unknown option $1 (use -m <model>)" ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac; done
  if [[ $no_workspace -eq 0 ]]; then
    cmux_ok || die "cmux is not running; start cmux before creating a task on $host"
  fi
  host_new_preflight "$host" "$repo_request" "$requested_agent"
  inspect="wt -H $host list"
  [[ -z "$repo_request" ]] || inspect+=" -r $(shell_join "$repo_request")"
  local out name repo session rc
  if out=$(printf '%s' "$prompt" | remote_wt_raw "$host" new "${args[@]+"${args[@]}"}" --no-workspace --prompt-stdin 2>&1); then
    :
  else
    rc=$?
    [[ -z "$out" ]] || printf '%s\n' "$out" >&2
    if [[ "$out" == *'new: unknown option -m'* || "$out" == *'new: unknown option --model'* ]]; then
      warn "$host has an older wt without -m; update it with: wt -H $host update"
    fi
    if [[ $rc -eq 255 ]]; then
      warn "SSH disconnected during creation on $host; could not confirm whether a worktree was created; inspect with: $inspect"
      warn "a disconnected create may still be finishing; recheck before starting the same task elsewhere"
    fi
    return "$rc"
  fi
  printf '%s\n' "$out"
  name=$(printf '%s\n' "$out" | sed -n 's/^created //p' | head -1)
  repo=$(printf '%s\n' "$out" | sed -n 's/^ *repo: *//p' | head -1)
  session=$(printf '%s\n' "$out" | sed -n 's/^ *session: *//p' | head -1)
  [[ -n "$name" && -n "$repo" && -n "$session" ]] || die "$host did not report created/repo/session; the worktree may exist; inspect with: $inspect before retrying"
  valid_name "$name" && [[ "$session" == "$(wt_session "$name" "$repo")" ]] || die "unexpected output from $host; the worktree may exist; inspect with: $inspect before retrying"
  if [[ $no_workspace -eq 1 ]]; then
    printf 'start later: wt -H %s attach -r %s %s\n' "$host" "$(shell_join "$repo")" "$(shell_join "$name")"
    return 0
  fi
  if [[ -n "$(cmux_row_field "$(row_title "$name")" "$repo" id "$host")" ]]; then
    warn "the worktree was created on $host, but a row for this task is already open; do not run new again"
    warn "close the stale row in cmux, then recover with: wt -H $host attach --restart-agent -r $(shell_join "$repo") $(shell_join "$name")"
    return 1
  fi
  if ! (remote_row "$host" "$session" "$(row_title "$name")" "$repo" "$(remote_run_cmd "$name" "$repo")" --no-focus); then
    warn "the worktree was created on $host; do not run new again"
    warn "inspect: wt -H $host show -r $(shell_join "$repo") $(shell_join "$name")"
    warn "if an agent is running: wt -H $host attach -r $(shell_join "$repo") $(shell_join "$name")"
    warn "if no agent pane exists: wt -H $host attach --restart-agent -r $(shell_join "$repo") $(shell_join "$name")"
    return 1
  fi
}

agent_on_vm() { # agent_on_vm <host> <session> — use the Mac's checked probe, even with an older wt on the VM.
  local script
  # shellcheck disable=SC2016  # $1 belongs to the remote Bash command.
  script="$(declare -f tmux_agent)"$'\n''tmux_agent "$1"'
  remote_sh "$1" "bash -c $(shell_join "$script" wt "$2")" >/dev/null
}

row_remote_field() { # row_remote_field <id> <field>… — this row's current remote fields (state, daemon slot) from one
                     # rows_json read, joined by $WT_FS. Never a tab: read would collapse it when a field is empty.
                     # Capture it before you split it: bash 3.2 applies `IFS=… read` to a here-string's $(…) too
  local id="$1"; shift
  rows_json | jq -r --arg id "$id" --arg fs "$WT_FS" \
    'first((.workspaces? // .)[] | select(.id == $id) | .remote as $r
       | [$ARGS.positional[] as $k | ($r[$k] // "") | tostring] | join($fs)) // empty' --args "$@" 2>/dev/null || true
}

clear_stale_relay() { # clear_stale_relay <host> <slot> — signal only this user's sshd, and only when its session is
                      # not from the Mac's current address; the last line on stdout is `stopped <port> <pid>` or `free <port>`
  local script
  # Bash 3.2 misparses case patterns in a heredoc nested inside command substitution.
  IFS= read -r -d '' script <<'WT_RELAY' || :
slot=$1
case "$slot" in ssh-[A-Za-z0-9-]*) ;; *) echo 'invalid relay slot' >&2; exit 1 ;; esac
# Without a keepalive a stale session holds its port for hours; the Mac warns. These files are world-readable.
if [ -r /etc/ssh/sshd_config ] && ! grep -qisE '^[[:space:]]*ClientAliveInterval[[:space:]=]+0*[1-9]' \
    /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null; then echo 'keepalive missing'; fi
port=''
for file in "$HOME"/.cmux/relay/*.slot; do
  [ -f "$file" ] || continue
  [ "$(cat "$file")" = "$slot" ] || continue
  candidate=${file##*/}; candidate=${candidate%.slot}
  case "$candidate" in *[!0-9]*|'') echo 'invalid relay port' >&2; exit 1 ;; esac
  [ -z "$port" ] || { echo 'multiple ports for relay slot' >&2; exit 1; }
  port=$candidate
done
[ -n "$port" ] || { echo 'relay slot file not found' >&2; exit 1; }
on_port() { # every listener on $port at any local address: field 4 after a State column, else field 3
  awk -v port="$port" '{ o = ($1 ~ /^[0-9]+$/) ? 0 : 1; n = split($(3 + o), a, ":"); if (n > 1 && a[n] == port) print }'
}
lines=$(ss -H -ltnp "sport = :$port") || { echo 'ss failed' >&2; exit 1; }
held=$(printf '%s\n' "$lines" | on_port)
if [ -z "$held" ]; then printf 'free %s\n' "$port"; exit 0; fi
if printf '%s\n' "$held" | grep -qv 'pid='; then
  # Some VMs hide even this user's sshd PID from unprivileged ss. Sudo is only for inspection.
  lines=$(sudo -n ss -H -ltnp "sport = :$port") || { echo "cannot inspect listener PID on $port" >&2; exit 1; }
  held=$(printf '%s\n' "$lines" | on_port)
fi
if [ -z "$held" ] || printf '%s\n' "$held" | grep -qv 'pid='; then echo "cannot identify one listener on $port" >&2; exit 1; fi
# One sshd may hold the port on IPv4 and IPv6 at once: one PID across every line, never one line.
pids=$(printf '%s\n' "$held" | grep -oE 'pid=[0-9]+' | sort -u)
[ "$(printf '%s\n' "$pids" | grep -c .)" -eq 1 ] || { echo "multiple listeners on $port" >&2; exit 1; }
pid=${pids#pid=}
# OpenSSH 9.8 and later run each session as sshd-session.
if printf '%s\n' "$held" | grep -qvF -e "\"sshd\",pid=$pid," -e "\"sshd-session\",pid=$pid,"; then
  echo "listener on $port is not sshd" >&2; exit 1
fi
case "$(ps -o comm= -p "$pid" | tr -d ' ')" in sshd|sshd-session) ;; *) echo "listener on $port is not a user-owned sshd" >&2; exit 1 ;; esac
[ "$(ps -o uid= -p "$pid" | tr -d ' ')" = "$(id -u)" ] || { echo "listener on $port is not a user-owned sshd" >&2; exit 1; }
# Stale means connected from an address the Mac no longer has. This call's own SSH_CONNECTION is the
# Mac's current address; a session from it may be live (a ControlMaster VS Code shares) and is refused.
[ -n "${SSH_CONNECTION:-}" ] || { echo "SSH_CONNECTION is empty, so sshd $pid holding relay port $port cannot be shown to be stale" >&2; exit 1; }
client_ip=${SSH_CONNECTION%% *}; server_port=${SSH_CONNECTION##* }
case "$server_port" in *[!0-9]*|'') echo "unexpected SSH_CONNECTION: $SSH_CONNECTION" >&2; exit 1 ;; esac
bare_ip() { a=${1#\[}; a=${a%\]}; printf '%s\n' "${a#::ffff:}"; }   # [addr], ::ffff:v4 and v4 compare equal
conns=$(ss -H -tnp state established "( sport = :$server_port )") || { echo 'ss failed' >&2; exit 1; }
conn=$(printf '%s\n' "$conns" | grep -F ",pid=$pid,")
if [ -z "$conn" ]; then   # hidden PIDs again; sudo only reads
  conns=$(sudo -n ss -H -tnp state established "( sport = :$server_port )") || conns=''
  conn=$(printf '%s\n' "$conns" | grep -F ",pid=$pid,")
fi
# `state established` drops ss's State column, so the peer is field 4, or 5 when a State column is there.
peer=$(printf '%s\n' "$conn" | awk '{ o = ($1 ~ /^[0-9]+$/) ? 0 : 1; print $(4 + o) }')
[ "$(printf '%s\n' "$conn" | grep -c .)" -eq 1 ] && [ -n "$peer" ] \
  || { echo "cannot find sshd $pid's SSH connection on port $server_port, so it cannot be shown to be stale" >&2; exit 1; }
peer=$(bare_ip "${peer%:*}"); here=$(bare_ip "$client_ip")
[ "$peer" != "$here" ] || { echo "sshd $pid holding relay port $port is connected from this Mac's current address ($here); it may still be live" >&2; exit 1; }
env kill -TERM "$pid" || { echo "could not stop sshd $pid on $port" >&2; exit 1; }
for attempt in 1 2 3 4 5; do
  lines=$(ss -H -ltnp "sport = :$port") || { echo 'ss failed after signal' >&2; exit 1; }
  held=$(printf '%s\n' "$lines" | on_port)
  [ -z "$held" ] && break
  sleep 1
done
[ -z "$held" ] || { echo "relay port $port is still held after signal" >&2; exit 1; }
printf 'stopped %s %s\n' "$port" "$pid"
WT_RELAY
  remote_sh_raw "$1" "bash -s -- $(shell_join "$2") <<'WT_RELAY'
$script
WT_RELAY"
}

recover_suspended_row() { # reconnect one suspended row, after freeing only its own stale SSH forward
  local host="$1" id="$2" slot="$3" fallback="$4" c out rc=0 reason result reply body state tick port left=0
  local why="did not connect within 30 seconds"
  [[ -n "$slot" ]] || { warn "suspended row $id has no persistent daemon slot"; die "manual fallback: $fallback"; }
  # The relay script writes every refusal to its stderr. A VM's login files may print before its result.
  out=$(clear_stale_relay "$host" "$slot" 2>&1) || rc=$?
  [[ $rc -ne 255 ]] || die "host unreachable: is the VM running? (ssh $host)"
  if printf '%s\n' "$out" | grep -x 'keepalive missing' >/dev/null; then   # no -q: pipefail and SIGPIPE
    warn "$host's sshd has no ClientAliveInterval, so a stale SSH session holds its relay port until TCP keepalive gives up; apply docs/new-vm.md block 1's keepalive lines"
  fi
  if [[ $rc -ne 0 ]]; then   # the script's reason is its last line
    reason=$(printf '%s\n' "$out" | grep -vx 'keepalive missing' | sed '/^[[:space:]]*$/d' | tail -1 || true)
    warn "could not clear $id's stale relay on $host: ${reason:-no reason given}"; die "manual fallback: $fallback"
  fi
  result=$(printf '%s\n' "$out" | grep -E '^(stopped|free) ' | tail -1 || true)
  case "$result" in
    stopped\ *) port=${result#stopped }; port=${port%% *}
                printf 'relay: stopped stale user sshd %s on %s port %s\n' "${result##* }" "$host" "$port" ;;
    free\ *) printf 'relay: port %s on %s was free\n' "${result#free }" "$host" ;;
    *) warn "unexpected relay check: $out"; die "manual fallback: $fallback" ;;
  esac
  c=$(cmux_bin); body=$(jq -cn --arg id "$id" '{workspace_id: $id}')
  rc=0; reply=$(CMUX_QUIET=1 "$c" rpc workspace.remote.reconnect "$body" 2>&1) || rc=$?
  reply=${reply//$'\n'/ }   # kept for every failure message below
  [[ $rc -eq 0 ]] || die "cmux reconnect failed for $id (${reply:-no reply}); manual fallback: $fallback"
  for ((tick=0; tick<30; tick++)); do
    state=$(row_remote_field "$id" state)
    if [[ "$state" == connected ]]; then printf 'row: %s connected after reconnect\n' "$id"; return 0; fi
    # The first reads may still say suspended. Suspended again after any other state means cmux gave up.
    if [[ "$state" == suspended && $left -eq 1 ]]; then why="went back to suspended after cmux tried to reconnect it"; break; fi
    [[ -z "$state" || "$state" == suspended ]] || left=1
    sleep 1
  done
  die "row $id $why (last state: ${state:-missing}; cmux reconnect reply: ${reply:-empty}); manual fallback: $fallback"
}

ROW_SHELL_LAST=""
row_shell_prompt() { # row_shell_prompt <id> — 0 when the row's last non-blank line ends in $, # or % and names a
                     # user@host, or is that character alone under a line that does (a two-line theme such as
                     # workgrove's). A TUI footer such as `Context 100%` names none. 2: the screen is unavailable.
                     # ROW_SHELL_LAST holds that last line
  local id="$1" c screen lines above="" nl=$'\n' who='[[:alnum:]_.-]+@[[:alnum:]_.-]+' end='[$#%]$' bare='^[$#%]$'
  ROW_SHELL_LAST=""
  c=$(cmux_bin) || return 2
  screen=$(CMUX_QUIET=1 "$c" read-screen --workspace "$id" 2>/dev/null) || return 2
  lines=$(printf '%s\n' "$screen" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -2)
  ROW_SHELL_LAST=${lines##*"$nl"}
  [[ "$lines" != *"$nl"* ]] || above=${lines%%"$nl"*}
  [[ "$ROW_SHELL_LAST" =~ $end ]] || return 1
  [[ "$ROW_SHELL_LAST" =~ $who ]] || { [[ "$ROW_SHELL_LAST" =~ $bare && "$above" =~ $who ]]; }
}

send_tmux_line() { # send_tmux_line <id> <session> — type the row's tmux attach line into it and press return
  local c; c=$(cmux_bin)
  CMUX_QUIET=1 "$c" send --workspace "$1" "$(tmux_cmd "$2")" >/dev/null 2>&1 \
    || die "cmux send failed for $1; type this in the row instead: tmux attach -d -t '=$2'"
  CMUX_QUIET=1 "$c" send-key --workspace "$1" enter >/dev/null 2>&1 \
    || die "cmux send-key failed for $1; press return in the row to finish the attach"
}

vm_session_detached() { # vm_session_detached <host> <session> — 0 only when the VM has that tmux session and lists no
                        # client on it. One ssh call; any failure, ssh's own included, counts as "not proven"
  local q; q=$(shell_join "=$2")
  remote_sh_raw "$1" "tmux has-session -t $q 2>/dev/null && c=\$(tmux list-clients -t $q 2>/dev/null) && [ -z \"\$c\" ]" >/dev/null 2>&1
}

reattach_shell_row() { # reattach_shell_row <id> <session> [host] — send the tmux line only to a row at a shell prompt.
                       # With a host (after a reconnect), the row must also still be connected, and that VM must list
                       # no client on the session. The checks run in that order, immediately before the send
  local id="$1" session="$2" host="${3:-}"
  row_shell_prompt "$id" || return 1
  if [[ -n "$host" ]]; then   # the connection can drop again, and a restored pty can still hold tmux
    [[ "$(row_remote_field "$id" state)" == connected ]] || return 1
    vm_session_detached "$host" "$session" || return 1
  fi
  send_tmux_line "$id" "$session"
}

reattach_recovered_row() { # reattach_recovered_row <host> <id> <session> — a reconnected row can say connected before its
                           # new login shell paints a prompt, so try for 5 ticks ~1 s apart. Each tick reads the screen
                           # first (local) and asks the VM only when that shows a prompt. 1: never proven, nothing sent
  local tick
  for ((tick=0; tick<5; tick++)); do
    reattach_shell_row "$2" "$3" "$1" && return 0
    [[ $tick -eq 4 ]] || sleep 1
  done
  return 1
}

reinit_task_client() { # reinit_task_client <host> <id> <session> — restart this task row's attached tmux client
  local host="$1" id="$2" session="$3" line script screen_rc=0 nonce proof screen c
  [[ "$(row_remote_field "$id" state)" == connected ]] || return 2
  row_shell_prompt "$id" || screen_rc=$?
  [[ $screen_rc -eq 1 ]] || return 2   # skip a shell or an unreadable screen
  line=$(tmux_cmd "$session" "" "" reinit)
  nonce="WT_REINIT_${RANDOM}_${RANDOM}_$$_$(date +%s)"
  # A restored row may show a cached agent screen while its old client is on an abandoned pty.
  # A fresh tmux status message proves that this row shows that client's output. It sends no pane input.
  IFS= read -r -d '' script <<'WT_CLIENT' || :
session=$1 nonce=$2
clients=$(tmux list-clients -t "$session" -F '#{client_pid} #{client_tty}' 2>/dev/null) || exit 1
[ -n "$clients" ] || exit 2
[[ "$clients" =~ ^[0-9]+[[:space:]]+/dev/pts/[0-9]+$ ]] || exit 2
tmux display-message -d 5000 -t "$session" "$nonce" || exit 1
printf '%s\n' "$clients"
WT_CLIENT
  proof=$(remote_sh_raw "$host" "bash -s -- $(shell_join "=$session" "$nonce") <<'WT_CLIENT'
$script
WT_CLIENT" 2>/dev/null) || return $?
  proof=${proof##*$'\n'}
  [[ "$proof" =~ ^[0-9]+[[:space:]]+/dev/pts/[0-9]+$ ]] || return 2
  c=$(cmux_bin) || return 1
  screen=$(CMUX_QUIET=1 "$c" read-screen --workspace "$id" 2>/dev/null) || return 2
  [[ "$screen" == *"$nonce"* && "$(row_remote_field "$id" state)" == connected ]] || return 2
  # -E replaces the client process on its own pty. A fresh attach sends every terminal mode again.
  # If that attach fails, the row's shell gets its prompt back. Recheck the client after the screen proof.
  IFS= read -r -d '' script <<'WT_CLIENT' || :
session=$1 expected=$2 line=$3
clients=$(tmux list-clients -t "$session" -F '#{client_pid} #{client_tty}' 2>/dev/null) || exit 1
[[ "$clients" == "$expected" ]] || exit 2
tmux detach-client -t "${clients#* }" -E "$line"
WT_CLIENT
  remote_sh_raw "$host" "bash -s -- $(shell_join "=$session" "$proof" "$line") <<'WT_CLIENT'
$script
WT_CLIENT" >/dev/null 2>&1 || return 1
  # The row can reconnect again between the screen proof and the replacement. Confirm the new client
  # is visible there before reporting that its terminal modes were restored.
  nonce="WT_REINIT_${RANDOM}_${RANDOM}_$$_$(date +%s)"
  IFS= read -r -d '' script <<'WT_CLIENT' || :
session=$1 tty=$2 nonce=$3
clients=$(tmux list-clients -t "$session" -F '#{client_pid} #{client_tty}' 2>/dev/null) || exit 1
[[ "$clients" =~ ^[0-9]+[[:space:]]+/dev/pts/[0-9]+$ && "${clients#* }" == "$tty" ]] || exit 1
tmux display-message -d 5000 -t "$session" "$nonce"
WT_CLIENT
  remote_sh_raw "$host" "bash -s -- $(shell_join "=$session" "${proof#* }" "$nonce") <<'WT_CLIENT'
$script
WT_CLIENT" >/dev/null 2>&1 || return 1
  screen=$(CMUX_QUIET=1 "$c" read-screen --workspace "$id" 2>/dev/null) || return 1
  [[ "$screen" == *"$nonce"* && "$(row_remote_field "$id" state)" == connected ]] || return 1
}

host_attach() { # re-attach to the VM's session; start an agent only for a task never started before
  local host="$1" restart=0 reattach=0 name="" repo=""; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --restart-agent) restart=1; shift ;;
      --reattach) reattach=1; shift ;;
      -r|--repo) [[ $# -ge 2 ]] || die "attach: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "attach: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "attach: unexpected argument $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "attach: worktree name required (wt -H $host attach -r <repo> <name>)"
  if [[ $restart -eq 1 && $reattach -eq 1 ]]; then die "attach: --reattach and --restart-agent do opposite things; pick one"; fi
  local out session state title id path c remote remote_state slot fallback recovered=0 what=selected
  out=$(remote_wt "$host" show "$name" -r "$repo")
  session=$(printf '%s\n' "$out" | sed -n 's/^ *session: *//p' | head -1)
  path=$(printf '%s\n' "$out" | sed -n 's/^ *repo: *//p' | head -1)
  [[ -n "$session" && -n "$path" ]] || die "$host reported no session for $name (try: wt -H $host show $name -r $(shell_join "$repo"))"
  state="${session#*(}"; state="${state%)}"; session="${session%% *}"
  valid_name "$name" && [[ "$session" == "$(wt_session "$name" "$path")" ]] || die "unexpected output from $host"
  title=$(row_title "$name")
  id=$(cmux_row_field "$title" "$path" id "$host")
  if [[ -n "$id" && $restart -eq 0 ]]; then
    remote=$(row_remote_field "$id" state persistent_daemon_slot)
    IFS="$WT_FS" read -r remote_state slot <<<"$remote"
    if [[ "$remote_state" == suspended ]]; then
      fallback="once $host has dropped the old SSH session (about a minute with docs/new-vm.md block 1's keepalive), press Reconnect on the row or re-run: wt -H $host attach -r $(shell_join "$repo") $name"
      recover_suspended_row "$host" "$id" "$slot" "$fallback"
      recovered=1
    fi
  fi
  if [[ $reattach -eq 1 ]]; then  # A dropped connection can leave the row with a fresh login shell while the VM
                                  # keeps the pty that holds tmux. The abandoned client is then still listed, and
                                  # session_state cannot call the session detached. The flag is the user's word
                                  # that the row shows a shell. The screen check is the backstop: it stops the
                                  # tmux line from going into a running agent's prompt. A row that reconnected
                                  # a moment ago may still show its pre-suspension screen, and its restored pty
                                  # may still hold tmux. The user cannot have seen that, so the row gets
                                  # reattach_recovered_row's proof.
    [[ -n "$id" ]] || die "no row $title $(row_tag "$host" "$path") is open; wt -H $host attach -r $(shell_join "$repo") $name opens one"
    c=$(cmux_bin)
    if [[ $recovered -eq 1 ]]; then
      if ! reattach_recovered_row "$host" "$id" "$session"; then
        CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
        die "$title $(row_tag "$host" "$path") reconnected, but its shell prompt and a detached VM session were not both confirmed (last line: ${ROW_SHELL_LAST:-empty}); look at the row and, if it shows a bare shell, re-run: wt -H $host attach --reattach -r $(shell_join "$repo") $name"
      fi
    else
      reattach_shell_row "$id" "$session" \
        || die "$title $(row_tag "$host" "$path") does not end at a shell prompt naming user@host, on its own line or the one above (last line: ${ROW_SHELL_LAST:-empty}); it is probably still attached to tmux, or its prompt names no user@host. Select the row and look, then re-run, or attach by hand there: tmux attach -d -t '=$session'"
    fi
    CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
    printf 'row: %s %s (re-attached)\n' "$title" "$(row_tag "$host" "$path")"
    return 0
  fi
  if [[ $restart -eq 1 ]]; then
    local agent_rc=0
    agent_on_vm "$host" "$session" || agent_rc=$?
    case $agent_rc in
      0) die "$name on $host still has an agent running; wt -H $host attach -r $(shell_join "$repo") $name re-attaches it, or wt -H $host update if the VM's wt is older than the Mac's" ;;
      1) ;;
      *) die "cannot check the agent in tmux session $session on $host; kept the session" ;;
    esac
    remote_sh "$host" "exec tmux kill-session -t $(shell_join "=$session")" >/dev/null 2>&1 || true
    close_row "$(cmux_row_field "$title" "$path" id "$host")"
    for _ in 1 2 3; do                     # remote_row creates a row only when no row is left, so wait for that
      [[ -n "$(cmux_row_field "$title" "$path" id "$host")" ]] || break
      sleep 1
    done
    [[ -z "$(cmux_row_field "$title" "$path" id "$host")" ]] \
      || die "row $(row_label "$title" "$path" "$host") is still open; close it in cmux, then re-run: wt -H $host attach --restart-agent -r $(shell_join "$repo") $name"
    remote_row "$host" "$session" "$title" "$path" "$(remote_run_cmd "$name" "$path")" --no-focus
    return 0
  fi
  if [[ "$state" == none && -z "$id" ]]; then
    # No tmux session and no started marker means that this task has never run. Restarting a lost agent
    # must stay a deliberate choice.
    if remote_sh "$host" "test ! -e $(shell_join "$path/.git/wt/$name.started") && ! tmux has-session -t $(shell_join "=$session") 2>/dev/null"; then
      remote_row "$host" "$session" "$title" "$path" "$(remote_run_cmd "$name" "$path")" --no-focus
      return 0
    fi
  fi
  case "$state" in
    "agent running"|"agent running, detached") ;;
    *) die "$name on $host has no agent pane ($state); restart it: wt -H $host attach --restart-agent -r $(shell_join "$repo") $name; if an agent is visibly running there, the VM's wt is older than the Mac's: wt -H $host update" ;;
  esac
  [[ -n "$id" ]] || { remote_row "$host" "$session" "$title" "$path" ""; return 0; }
  c=$(cmux_bin)
  if [[ $recovered -eq 1 ]]; then
    # The show above ran before the reconnect. A prompt-shaped footer alone says nothing about what holds
    # the pty. So wait for a prompt, and ask the VM again immediately before any send.
    if reattach_recovered_row "$host" "$id" "$session"; then what=re-attached; fi
  elif [[ "$state" == *detached ]]; then   # show may be stale; prove the prompt and detached session again
    if reattach_shell_row "$id" "$session" "$host"; then what=re-attached
    else warn "did not re-attach $title $(row_tag "$host" "$path"); inspect the row, then use: wt -H $host attach --reattach -r $(shell_join "$repo") $name"
    fi
  fi
  if [[ "$what" == selected ]]; then   # a detached report can be stale by the time the row is checked
    local reinit_rc=0
    reinit_task_client "$host" "$id" "$session" || reinit_rc=$?
    if [[ $reinit_rc -eq 0 ]]; then what=re-initialized
    elif [[ $reinit_rc -eq 2 ]]; then warn "could not confirm $session's client in this row; inspect it, then re-run attach if its terminal settings are missing; for a bare shell use: wt -H $host attach --reattach -r $(shell_join "$repo") $name"
    else warn "could not confirm $session's replacement client on $host; inspect the row, then re-run attach; for a bare shell use: wt -H $host attach --reattach -r $(shell_join "$repo") $name"
    fi
  fi
  CMUX_QUIET=1 "$c" workspace select "$id" >/dev/null 2>&1 || die "cmux workspace select failed for $id"
  printf 'row: %s %s (%s)\n' "$title" "$(row_tag "$host" "$path")" "$what"
  if [[ "$what" == re-initialized ]]; then
    printf 'if the replacement attach fails, the row returns to its shell prompt; recover with: wt -H %s attach --reattach -r %s %s\n' "$host" "$(shell_join "$repo")" "$name"
  fi
  if [[ $recovered -eq 1 && "$what" == selected ]]; then
    warn "re-attach this row if it shows a bare shell: wt -H $host attach --reattach -r $(shell_join "$repo") $name"
  fi
}

host_open() { # VS Code Remote-SSH on a VM worktree
  local host="$1" name="" repo=""; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "open: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "open: unknown option $1" ;;
      *) [[ -z "$name" ]] || die "open: unexpected argument $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "open: worktree name required (wt -H $host open -r <repo> <name>)"
  local p; p=$(remote_wt "$host" path "$name" -r "$repo")
  hook_safe_path "$p" || die "open: refusing an unsafe path from $host ($p)"
  open_code "vscode-remote://ssh-remote+$host$p/" "$host:$p"
}

host_rm() { # remove on the VM, close the row, then kill the session (closing first stops cmux recreating it)
  local host="$1" name="" repo="" args=(); shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "rm: $1 needs a repo"; repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) args+=("$1"); shift ;;
      *) [[ -z "$name" ]] || die "rm: unexpected argument $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "rm: worktree name required (wt -H $host rm -r <repo> <name>)"
  # The row's identity comes from -r. cmd_host has already refused -r unless it is an absolute path or
  # a plain repo name. A relative '.' or '..' would make repo_id '-', and close_row would close nothing.
  local session title; session=$(wt_session "$name" "$repo"); title=$(row_title "$name")
  check_row_removal "$title" "$repo" "$host"
  local agent_rc=0
  agent_on_vm "$host" "$session" || agent_rc=$?
  case $agent_rc in
    0) die "another agent is running in tmux session $session on $host; kept the worktree" ;;
    1) ;;
    *) die "cannot check the agent in tmux session $session on $host; kept the worktree" ;;
  esac
  remote_wt "$host" rm "$name" -r "$repo" "${args[@]}"
  close_row "$(cmux_row_field "$title" "$repo" id "$host")"
  remote_sh "$host" "exec tmux kill-session -t $(shell_join "=$session")" >/dev/null 2>&1 || true
}

cmd_host() { # wt -H <host> <sub> … — a stateless ssh passthrough; the Mac caches nothing about VMs
  local host="$1" sub="${2:-}" args=() v scoped=0; shift 2
  valid_host "$host" || die "invalid host '$host' (an ssh alias: letters, digits, '.', '_' and '-')"
  while [[ $# -gt 0 ]]; do   # normalize -r once: a trailing '/' would change repo_id, and so the identity
    case "$1" in
      -r|--repo) [[ $# -ge 2 ]] || die "$sub: $1 needs a repo"; v="$2"; while [[ "$v" == */ && "$v" != / ]]; do v="${v%/}"; done
                 # a relative path means nothing on the VM, and its basename is not the repo's. host_rm would
                 # then look for a row of repo '-' ('.' -> '-') and close a row that does not exist
                 case "$v" in /*) ;; ""|.|..|*/*) die "$sub: -r must be an absolute path on $host, or a repo name there (wt -H $host repos lists them)" ;; esac
                 args+=("$1" "$v"); shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  case "$sub" in
    new)       host_new "$host" "$@" ;;
    attach)    need_r "$host" "$sub" "$@"; host_attach "$host" "$@" ;;
    open)      need_r "$host" "$sub" "$@"; host_open "$host" "$@" ;;
    rm)        need_r "$host" "$sub" "$@"; host_rm "$host" "$@" ;;
    list)      for v in "$@"; do case "$v" in -r|--repo) scoped=1 ;; esac; done
               if [[ $scoped -eq 1 ]]; then remote_wt "$host" list "$@"
               else remote_wt "$host" list --all "$@"; fi ;;
    show|path) need_r "$host" "$sub" "$@"; remote_wt "$host" "$sub" "$@" ;;
    repos)     if [[ -t 1 ]]; then case " $* " in *" --porcelain "*|*" --table "*) ;; *) set -- "$@" --table ;; esac; fi
               remote_wt "$host" repos "$@" ;;     # ssh gives the VM no terminal, so ask for the table explicitly
    update)    remote_wt_tty "$host" "$sub" "$@" ;;   # the VM asks before it installs, so it needs a terminal
    help)      remote_wt "$host" "$sub" "$@" ;;
    *) die "wt -H: '$sub' does not run remotely (new attach list show rm path open repos update help)" ;;
  esac
}

# ---------------------------------------------------------------- wt task
task_exit() { # the launcher row closes on exit, so give the user time to read a message first
  local rc=$?
  if [[ $rc -ne 0 && -t 0 ]]; then read -r -p 'press return' _ || true; fi
}
ssh_hosts() { # non-wildcard Host aliases, read as bin/cmux-hook reads them
  { awk '$1=="Host"{for(i=2;i<=NF;i++){if($i ~ /^#/)break; if($i !~ /^[!]/ && $i !~ /[*?]/) print $i}}' "$HOME/.ssh/config" 2>/dev/null || true; } | sort -u
}

probe_host() { # one SSH login proves remote-command access and gathers Linux hardware
  local out_file err_file ssh_pid rc=0 tick
  out_file=$(mktemp "${TMPDIR:-/tmp}/wt-host-stdout.XXXXXX") || return 1
  err_file=$(mktemp "${TMPDIR:-/tmp}/wt-host-stderr.XXXXXX") || { rm -f "$out_file"; return 1; }
  # The remote timeout limits an nvidia-smi that ignores TERM. The client deadline also limits a remote
  # command that is stuck in uninterruptible I/O: SSH may stay connected and answer keepalives forever.
  # Redirect SSH to files, so that an unkillable child cannot hold this function's output pipes open.
  ssh -T -o BatchMode=yes -o NumberOfPasswordPrompts=0 -o StrictHostKeyChecking=yes \
      -o ConnectTimeout=5 -o ConnectionAttempts=1 -o ServerAliveInterval=5 \
      -o ServerAliveCountMax=2 "$1" 'sh -s' >"$out_file" 2>"$err_file" <<'PROBE' &
cpu=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
mem_kib=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)
printf 'cpu\t%s\nmem_kib\t%s\n' "$cpu" "$mem_kib"
if command -v nvidia-smi >/dev/null 2>&1 &&
   gpu_rows=$(timeout -k 2 10 nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader,nounits 2>/dev/null); then
  printf 'gpu_status\tok\n'
  if [ -n "$gpu_rows" ]; then
    printf '%s\n' "$gpu_rows" | while IFS=, read -r index model vram; do
      printf 'gpu\t%s\t%s\t%s\n' "$index" "$model" "$vram"
    done
  fi
else
  # A failed nvidia-smi is not proof of absent hardware. A complete PCI scan with no
  # NVIDIA display device is; keep unknown if sysfs is missing or any entry is unreadable.
  gpu_status=unknown
  if [ -d /sys/bus/pci/devices ]; then
    pci_seen=0 pci_readable=1 nvidia_gpu=0
    for pci in /sys/bus/pci/devices/*; do
      [ -d "$pci" ] || continue
      pci_seen=1
      if [ ! -r "$pci/vendor" ] || [ ! -r "$pci/class" ] ||
         ! IFS= read -r vendor <"$pci/vendor" || ! IFS= read -r class <"$pci/class"; then
        pci_readable=0
        break
      fi
      case "$vendor:$class" in 0x10de:0x03*) nvidia_gpu=1 ;; esac
    done
    if [ "$pci_seen" -eq 1 ] && [ "$pci_readable" -eq 1 ] && [ "$nvidia_gpu" -eq 0 ]; then
      gpu_status=none
    fi
  fi
  printf 'gpu_status\t%s\n' "$gpu_status"
fi
PROBE
  ssh_pid=$!
  for ((tick=0; tick<200; tick++)); do
    kill -0 "$ssh_pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$ssh_pid" 2>/dev/null; then
    kill -KILL "$ssh_pid" 2>/dev/null || true
    printf 'SSH probe timed out after 20 seconds\n' >&2
    rc=124
  else
    wait "$ssh_pid" || rc=$?
  fi
  cat "$out_file"
  cat "$err_file" >&2
  rm -f "$out_file" "$err_file"
  return "$rc"
}

host_record() { # stable JSON for agents; unknown hardware never becomes a false zero
  local host="$1" report="" rc=0 err_file err=""
  if ! valid_host "$host"; then
    jq -nc --arg host "$host" '{host:$host,status:"unavailable",cpu_logical:null,memory_mib:null,gpu_status:"unknown",gpus:[],error:"invalid SSH alias"}'
    return
  fi
  err_file=$(mktemp "${TMPDIR:-/tmp}/wt-host-error.XXXXXX") || return 1
  report=$(probe_host "$host" 2>"$err_file") || rc=$?
  if [[ $rc -ne 0 ]]; then
    err=$(sed -n '1p' "$err_file" | LC_ALL=C tr -d '\r' | cut -c1-180)
    rm -f "$err_file"
    jq -nc --arg host "$host" --arg error "SSH probe failed (exit $rc)${err:+: $err}" \
      '{host:$host,status:"unavailable",cpu_logical:null,memory_mib:null,gpu_status:"unknown",gpus:[],error:$error}'
    return
  fi
  rm -f "$err_file"
  printf '%s' "$report" | jq -Rsc --arg host "$host" '
    def field($rows; $key): [ $rows[] | select(.[0] == $key) | .[1] ][0] // "";
    def unsigned: if type == "string" and test("^[0-9]+$") then tonumber else null end;
    [split("\n")[] | select(length > 0) | split("\t")] as $rows
    | (field($rows; "cpu") | unsigned) as $cpu
    | (field($rows; "mem_kib") | unsigned) as $mem
    | [ $rows[] | select(.[0] == "gpu") ] as $raw_gpus
    | [ $raw_gpus[] | select(length == 4 and (.[1] | gsub(" "; "") | unsigned) != null
           and (.[2] | gsub("^ +| +$"; "") | length > 0)
           and (.[3] | gsub(" "; "") | test("^[0-9]+$|^\\[N/A\\]$"))) ] as $valid_gpus
    | [ $valid_gpus[] | {name:(.[2] | gsub("^ +| +$"; "")),
           memory_mib:(.[3] | gsub(" "; "") | unsigned)} ] as $gpus
    | ([ $valid_gpus[] | .[1] | gsub(" "; "") ] | unique | length) as $unique_indices
    | (if field($rows; "gpu_status") == "ok" and ($raw_gpus | length) == ($gpus | length)
         and $unique_indices == ($gpus | length)
       then (if ($gpus | length) == 0 then "none" else "ok" end)
       elif field($rows; "gpu_status") == "none" and ($raw_gpus | length) == 0
       then "none" else "unknown" end) as $gpu_status
    | {host:$host,status:"available",cpu_logical:(if $cpu != null and $cpu > 0 then $cpu else null end),
       memory_mib:(if $mem != null and $mem > 0 then ($mem / 1024 | floor) else null end),
       gpu_status:$gpu_status,gpus:$gpus,
       error:(if $cpu == null or $cpu == 0 or $mem == null or $mem == 0 then "incomplete CPU/RAM report" else null end)}'
}

cmd_hosts() {
  mac_only hosts
  local format=table records host f pid failed=0 files=() pids=()
  case "${1:-}" in
    "") ;;
    --json) format=json; shift ;;
    -h|--help) usage; return 0 ;;
    *) die "hosts: usage: wt hosts [--json]" ;;
  esac
  [[ $# -eq 0 ]] || die "hosts: usage: wt hosts [--json]"
  while IFS= read -r host; do
    f=$(mktemp "${TMPDIR:-/tmp}/wt-host-record.XXXXXX") || die "hosts: could not create a temporary file"
    files+=("$f")
    WT_TMPFILES+=("$f")
    (host_record "$host" >"$f") &
    pids+=("$!")
  done < <(ssh_hosts)
  for pid in "${pids[@]+"${pids[@]}"}"; do wait "$pid" || failed=1; done
  if [[ $failed -ne 0 ]]; then
    rm -f "${files[@]+"${files[@]}"}"
    die "hosts: one or more probes could not be recorded"
  fi
  records=""
  if [[ ${#files[@]} -gt 0 ]]; then records=$(cat "${files[@]}"); fi
  rm -f "${files[@]+"${files[@]}"}"
  if [[ $format == json ]]; then
    printf '%s\n' "$records" | jq -s '.'
  else
    printf '%s\n' "$records" | jq -sr '
      (["HOST","SSH","CPU","RAM GiB","GPU","ERROR"],
       (.[] | [ .host, .status, (.cpu_logical // "?" | tostring),
         (if .memory_mib == null then "?" else (.memory_mib / 1024 * 10 | round / 10 | tostring) end),
         (if .gpu_status == "none" then "none" elif .gpu_status != "ok" then "unknown"
          elif (.gpus | length) == 0 then "none"
          else (.gpus | map(if .memory_mib == null then "\(.name) (memory unknown)"
                            else "\(.name) (\(.memory_mib) MiB)" end) | join("; ")) end),
         (.error // "") ])) | @tsv' \
      | { if have column; then column -t -s $'\t'; else cat; fi; }
  fi
}
repo_menu() { # repo_menu [table] — lays out cmd_repos' "<name><tab><path>[<tab><tasks>]" lines.
              # Default: task picker rows "<name><tab><path><tab><display>". The display is the name padded
              # to the widest name, then a gray location. "table": the terminal listing. It has a gray header,
              # then name, task count ("-" for none) and location per repo. The location is "~" for this
              # home, then at most the three folders above the repo, never the repo itself.
  awk -F'\t' -v home="$HOME" -v table="${1:-}" -v grey=$'\033[90m' -v off=$'\033[0m' '
    function loc(p,   par, m, a) {   # the local home as "~", then the three folders above the repo, never the repo
      if (home != "" && index(p, home "/") == 1) p = "~" substr(p, length(home) + 1)
      par = p; sub(/\/[^\/]*$/, "", par)
      if (par == "") return "/"
      m = split(par, a, "/")
      if (m <= 3) return par
      return a[m-2] "/" a[m-1] "/" a[m]
    }
    { rn[NR] = $1; rp[NR] = $2; rt[NR] = $3; if (length($1) > w) w = length($1) }
    END {
      if (NR == 0) exit
      if (table != "") {
        if (w < 4) w = 4
        printf "%s%-" (w + 2) "s%-7s%s%s\n", grey, "NAME", "TASKS", "LOCATION", off
        for (j = 1; j <= NR; j++) {
          t = sprintf("%-7s", rt[j] == "0" ? "-" : rt[j]); if (rt[j] == "0") t = grey t off
          printf "%-" (w + 2) "s%s%s%s%s\n", rn[j], t, grey, loc(rp[j]), off
        }
        exit
      }
      fmt = "%s\t%s\t%-" (w + 2) "s%s%s%s\n"
      for (j = 1; j <= NR; j++) printf fmt, rn[j], rp[j], rn[j], grey, loc(rp[j]), off
    }
  '
}
pick() { # pick <prompt> [fzf args…] — a line of stdin, or whatever was typed (fzf --print-query: query, selection)
  local out rc=0 q s p="$1"; shift
  out=$(fzf --print-query --prompt "$p> " --height 40% --reverse "$@") || rc=$?
  [[ $rc -le 1 ]] || return 1                                   # 130: aborted
  q=$(printf '%s\n' "$out" | sed -n '1p'); s=$(printf '%s\n' "$out" | sed -n '2p')
  printf '%s' "${s:-$q}"
}

cmd_task() {
  mac_only task
  local where="" kind="" repo="" name="" brief="" asked=1 id out
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --where) [[ $# -ge 2 ]] || die "task: $1 needs local or a host"; where="$2"; shift 2 ;;
      -a|--agent) [[ $# -ge 2 ]] || die "task: $1 needs a kind"; kind="$2"; shift 2 ;;
      -r|--repo) [[ $# -ge 2 ]] || die "task: $1 needs a repo"; repo="$2"; shift 2 ;;
      -p|--prompt) [[ $# -ge 2 ]] || die "task: $1 needs a brief"; brief="$2"; asked=0; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "task: unknown option $1" ;;
    esac
  done
  trap task_exit EXIT
  have fzf || die "fzf not found (brew install fzf)"

  if [[ -z "$where" ]]; then where=$({ printf 'local\n'; ssh_hosts; } | pick where) || die "task: cancelled"; fi
  [[ -n "$where" ]] || die "task: no host picked"
  if [[ "$where" != local ]]; then
    valid_host "$where" || die "task: invalid host '$where' (an ssh alias: letters, digits, '.', '_' and '-')"
    if ! ssh_hosts | grep -qxF "$where"; then
      warn "cmux will try '$where'; make sure 'ssh $where' works first. Requests from inside that VM (VS Code, new rows) need a Host entry."
    fi
  fi

  if [[ -z "$kind" ]]; then
    kind=$({ printf 'claude\ncodex\nrepo-shell\n'; [[ "$where" == local ]] || printf 'vm-shell\n'; } | pick kind) || die "task: cancelled"
  fi
  case "$kind" in
    claude|codex|repo-shell) ;;
    vm-shell) [[ "$where" != local ]] || die "task: vm-shell needs a VM; for a local shell pick repo-shell" ;;
    *) die "task: unknown kind '$kind' (claude, codex, repo-shell, vm-shell)" ;;
  esac

  if [[ "$kind" != vm-shell && -z "$repo" ]]; then
    local list sel                               # "<name><tab><path>": two folders can hold the same basename,
    if [[ "$where" == local ]]; then             # so the path column, not the name, starts the task
      list=$(cmd_repos) || exit 1                # cmd_repos has already said what is wrong; do not repeat it
      [[ -n "$list" ]] || die "task: no repos in WT_REPOS_DIR ($REPOS_PATH); clone one, or pass -r <path>"
    else
      list=$(remote_wt "$where" repos) || exit 1   # no flag: ssh gives the VM no terminal, so this is the plain form on any wt version
      [[ -n "$list" ]] || die "task: no repos on $where (see: wt -H $where repos)"
    fi
    sel=$(printf '%s\n' "$list" | repo_menu | pick repo --ansi --delimiter $'\t' --with-nth 3 --nth 1,3) \
      || die "task: cancelled"
    [[ -n "$sel" ]] || die "task: no repo picked"
    sel="${sel%$'\t'*}"; repo="${sel##*$'\t'}"   # the path column; a typed query has no tab and is taken as given
  fi
  if [[ "$kind" == claude || "$kind" == codex ]]; then       # the name is never known from the options
    read -r -p 'name (blank = from brief)> ' name || true
    name=$(tidy_name "$name"); [[ -z "$name" ]] || need_name "$name"   # a '-…' name would otherwise reach cmd_new as an option
    if [[ $asked -eq 1 ]]; then read -r -p 'brief> ' brief || true; fi
  fi

  case "$kind" in
    claude|codex)
      args=(-r "$repo" -a "$kind" -p "$brief")                # cmd_new validates the name and slugifies a blank one
      if [[ -n "$name" ]]; then args+=("$name"); fi
      if [[ "$where" == local ]]; then cmd_new "${args[@]}"
      else host_new "$where" "${args[@]}"; fi ;;
    repo-shell)
      if [[ "$where" == local ]]; then
        resolve_repo "$repo"; id=$(repo_id "$REPO")
        cmux_ok || die "cmux is not running; start cmux, then: wt task"
        out=$(CMUX_QUIET=1 "$(cmux_bin)" workspace create --name "$id shell" --description "$(row_tag)" --cwd "$REPO" 2>&1) \
          || die "cmux workspace create failed: $out"
        printf 'row: %s shell %s\n' "$id" "$(row_tag)"
      else
        id=$(repo_id "$repo")   # the VM's own wt resolves the name against its $WT_REPOS_DIR; on a failed
                                # lookup its error stays on screen and the pane keeps $HOME as its cwd
        remote_row "$where" "shell-$id" "$id shell" "" "d=\$(\"\$HOME/.local/bin/wt\" repos $(shell_join "$repo")) && cd \"\$d\"" shared
      fi ;;
    vm-shell) remote_row "$where" main shell "" "" shared ;;
  esac
}

# ---------------------------------------------------------------- dispatch
# One guard, not one per caller. jq reads and writes every sidecar (meta_get/meta_set), reads cmux's row
# list and builds the relay body, so a missing jq is not a per-command problem. Left to fail where it is used,
# it fails in one of two ways. It can fail quietly: every call site swallows meta_get's error, and `base`
# silently becomes default_base(), the base that `wt rm` then judges "not merged" against. Or it can fail
# halfway through `wt new`, after `git worktree add` has already registered a worktree. So refuse up front,
# but keep `wt help` readable, so that the line that fixes the problem is still one command away.
need_jq() { have jq || die "jq not found (brew install jq, or sudo apt-get install -y jq)"; }
if [[ "${1:-}" == -H || "${1:-}" == --host ]]; then
  [[ $# -ge 3 ]] || die "usage: wt -H <host> <command> [args] (wt help)"
  host="$2"; shift 2
  [[ "${1:-}" == help ]] || need_jq
  cmd_host "$host" "$@"
  exit
fi
sub="${1:-help}"; shift || true
case "$sub" in help|-h|--help) ;; *) need_jq ;; esac
case "$sub" in
  new)      cmd_new "$@" ;;
  run)      cmd_run "$@" ;;
  list|ls)  cmd_list "$@" ;;
  show)     cmd_show "$@" ;;
  open)     cmd_open "$@" ;;
  diff)     [[ $# -gt 0 ]] || die "diff: worktree name required"; cmd_show "$@" --diff ;;   # appended, never
                                                                  # spliced: "-r <path> <name>" starts with -r
  attach)   cmd_attach "$@" ;;
  sync)     cmd_sync "$@" ;;
  pr)       cmd_pr "$@" ;;
  rm|remove) cmd_rm "$@" ;;
  prune)    cmd_prune "$@" ;;
  path)     cmd_path "$@" ;;
  repos)    cmd_repos "$@" ;;
  hosts)    cmd_hosts "$@" ;;
  task)     cmd_task "$@" ;;
  driver)   cmd_driver "$@" ;;
  update)   cmd_update "$@" ;;
  current|cur) cmd_current "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$sub' (wt help)" ;;
esac
