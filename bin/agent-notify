#!/usr/bin/env bash
# Agent lifecycle hook → notification. Remote cmux pane: relay to the Mac. Local cmux pane: no-op. Elsewhere on a Mac: banner.
#
# Claude prompt timestamps gate short local Mac banners. VM lifecycle events also update the cmux row.
set -u
: "${HOME:?agent-notify: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
[[ -t 0 ]] && payload= || payload=$(cat)
event_seq=''
[[ $(uname -s) == Linux ]] && event_seq=$(date +%s%N)  # capture before tmux or relay latency can reorder hooks
title=${AGENT_NOTIFY_SOURCE:-Claude Code}
status=''; status_only=''; body=''; sound=''
if [[ ${WT_STATUS_HEARTBEAT:-} == 1 && -n ${WT_STATUS_FILE:-} && -r $WT_STATUS_FILE ]]; then
  payload=$(cat "$WT_STATUS_FILE")
fi
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null | tr -cd 'A-Za-z0-9-' || true)
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/claude-start-times"   # private state, not /tmp: TMPDIR is empty on the VMs
quiet_seconds=${AGENT_NOTIFY_MIN_SECONDS:-180}   # a turn shorter than this finishes without a banner
# Validated for the same reason the stamp is: both land in the (( )) below, where bash expands identifiers
# and evaluates array subscripts, so a typo aborts the script under set -u and a crafted value runs commands.
[[ $quiet_seconds =~ ^[0-9]+$ ]] || quiet_seconds=180

case $event in
  UserPromptSubmit)
    if [[ $title == 'Claude Code' && -n $session ]] && (umask 077; mkdir -p "$stamps") 2>/dev/null; then
      chmod 700 "$stamps" 2>/dev/null ||
        echo "agent-notify: cannot chmod 700 $stamps; it is not ours, so the stamps in it are not either" >&2
      find "$stamps" -type f -mtime +2 -delete 2>/dev/null || true
      date +%s > "$stamps/$session"
    fi
    status=running; status_only=1 ;;
  SessionEnd)
    [[ -n $session ]] && rm -f "$stamps/$session"
    status=clear; status_only=1 ;;
  Stop) body="finished"; sound=Funk; status=idle ;;
  StopFailure|Interrupt) status=idle; status_only=1 ;;
  Heartbeat) status=$(printf '%s' "$payload" | jq -r '.state // empty' 2>/dev/null); status_only=1 ;;
  PermissionRequest) body="needs approval"; sound=Glass ;;
  Notification)
    body=$(printf '%s' "$payload" | jq -r '.message // "needs input"' 2>/dev/null || echo "needs input"); sound=Glass
    [[ $title == 'Claude Code' && $(printf '%s' "$payload" | jq -r '.notification_type // empty' 2>/dev/null) == idle_prompt ]] && status=idle ;;
  *) body="needs attention"; sound=Glass ;;
esac

# The same list and the same precedence as relay_env in bin/wt, and for the same reason: cmux authorises a
# relayed notification against the surface and workspace in the environment, and a pane keeps the identity of
# whichever cmux connection started it. Only the tmux SESSION environment is rebound on reattach, so re-read
# it here and hand the values to cmux explicitly instead of letting the child inherit this pane's stale ones.
relay_vars="CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID"
socket=${CMUX_SOCKET_PATH:-}; ws=${CMUX_WORKSPACE_ID:-}; ident=()
s=""
if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null; then s=$(tmux display-message -p '#S' 2>/dev/null || true); fi
tmux_env=''
[[ -n $s ]] && tmux_env=$(tmux show-environment -t "=$s" 2>/dev/null || true)
for n in $relay_vars; do
  v=${!n:-}
  if [[ -n $s ]]; then
    t=$(printf '%s\n' "$tmux_env" | sed -n "s/^$n=//p" | head -1); [[ -n $t ]] && v=$t
  fi
  [[ -n $v ]] && ident+=("$n=$v")
  case $n in
    CMUX_SOCKET_PATH) socket=$v ;;
    CMUX_WORKSPACE_ID) ws=$v ;;
  esac
done

# Only the agent started by `wt run` owns a VM row. Hooks from other panes, nested agents, and
# a child `wt new -p` before its own row exists must not change the parent's status.
status_owner() {
  [[ -n ${WT_STATUS_OWNER_PID:-} && ${TMUX_PANE:-} == "${WT_STATUS_OWNER_PANE:-}" ]] || return 1
  local pid=$PPID parent comm agents=0
  while [[ $pid =~ ^[0-9]+$ && $pid -gt 1 && $pid != "$WT_STATUS_OWNER_PID" ]]; do
    [[ -r /proc/$pid/status ]] || return 1
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    [[ $comm == claude || $comm == codex ]] && agents=$((agents + 1))
    parent=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status")
    pid=$parent
  done
  [[ $pid == "$WT_STATUS_OWNER_PID" && $agents -eq 1 ]]
}

relay_notify() {
  env -u CMUX_SOCKET CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 "${ident[@]+"${ident[@]}"}" \
    "${CMUX_BUNDLED_CLI_PATH:-$HOME/.cmux/bin/cmux}" notify ${ws:+--workspace "$ws"} "$@" >/dev/null 2>&1
}

# frontmost_terminal: true when the app this agent runs in is the one already on screen, so a banner would
# tell the user what they are looking at. cmux rows never reach here; this is for a bare terminal window.
frontmost_terminal() {
  local front t=
  case ${TERM_PROGRAM:-} in
    Apple_Terminal) t=Terminal ;;
    iTerm.app) t=iTerm2 ;;
    ghostty) t=ghostty ;;
    WezTerm) t=WezTerm ;;
    vscode) t=Code ;;
  esac
  [[ -n $t ]] || return 1
  front=$(/usr/bin/osascript -e 'tell application "System Events" to name of first process whose frontmost is true' 2>/dev/null || true)
  [[ $front == "$t" ]]
}

# short_turn: true when this session's prompt was submitted less than quiet_seconds ago. No stamp — or one
# that is not a plain count of seconds — means the agent does not keep one, so the turn is never called short.
short_turn() {
  local start now
  [[ -n $session ]] || return 1
  start=$(cat "$stamps/$session" 2>/dev/null || true)
  # Digits only, checked before (( )) ever sees it: bash re-expands identifiers inside arithmetic and
  # evaluates array subscripts, so a stamp reading `session[$(…)]` would run that command. A partial write
  # or another tool's file is not a stamp either, and under set -u it would abort the Stop notification here.
  [[ $start =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  (( now >= start )) || return 1   # the clock stepped back (NTP, or a stamp dir shared with a faster host):
                                   # a stamp in the future must not make every turn look short until it passes
  (( now - start < quiet_seconds ))
}

if [[ $socket == *:[0-9]* ]]; then
  # cmux 0.64's SSH relay accepts notifications but has no sidebar or agent lifecycle method. The Mac-side
  # cmux-hook turns this private control notification into the same status pill local agent hooks show.
  # It verifies that cmux assigned the notification to a row on WT_HOST before changing that row.
  case $title in 'Claude Code') agent=claude ;; Codex) agent=codex ;; *) agent= ;; esac
  send_status=0
  if [[ $status == running || $status == idle || $status == clear ]] && [[ -n $agent && ${WT_HOST:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
     { { [[ ${WT_STATUS_HEARTBEAT:-} == 1 && -n ${WT_STATUS_OWNER_PID:-} &&
           ${TMUX_PANE:-} == "${WT_STATUS_OWNER_PANE:-}" ]] && kill -0 "$WT_STATUS_OWNER_PID" 2>/dev/null; } || status_owner; }; then
    send_status=1
    if [[ -n ${WT_STATUS_FILE:-} && ${WT_STATUS_HEARTBEAT:-} != 1 ]]; then
      if [[ $status == clear ]]; then rm -f "$WT_STATUS_FILE"; else
        printf '{"hook_event_name":"Heartbeat","session_id":"%s","state":"%s"}\n' "$session" "$status" > "$WT_STATUS_FILE"
      fi
    fi
  fi
  # Record the new state before a heartbeat can read it; send completion before sidebar network work.
  if [[ -z $status_only ]]; then
    relay_notify --title "$title" --body "$body" ||
      echo 'agent-notify: relay failed; close and reopen this cmux row (wt -H <host> attach …)' >&2
  fi
  if [[ $send_status -eq 1 ]]; then
    relay_notify --title "$title status" --body "$title: $status on $WT_HOST" \
      --subtitle "wt-agent-status|$WT_HOST|$agent|$status|$event_seq|$session" ||
      echo 'agent-notify: status relay failed; close and reopen this cmux row (wt -H <host> attach …)' >&2
  fi
  [[ -n ${status_only:-} ]] && exit 0
elif [[ -z ${CMUX_SURFACE_ID:-} && $(uname -s) == Darwin ]]; then
  [[ -n ${status_only:-} ]] && exit 0
  # A row in the sidebar is passive and costs nothing, but a banner interrupts, so only this path is gated.
  if [[ $event == Stop ]] && short_turn; then
    exit 0
  fi
  frontmost_terminal && exit 0
  /usr/bin/osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)' \
    -e 'end run' -- "$title" "$body" "$sound" >/dev/null 2>&1
fi
exit 0
