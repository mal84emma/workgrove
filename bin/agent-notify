#!/usr/bin/env bash
# Agent lifecycle hook → notification. In a remote cmux pane: send it through the relay to the Mac.
# In a local cmux pane: do nothing. Elsewhere on a Mac: show a banner.
#
# Claude prompt timestamps gate the local Mac banners: a short turn gets none.
# VM lifecycle events also update the cmux row.
set -u

# The scripts in bin/ need bash 5 or later (README, "Requirements"). On a Mac, /bin/bash 3.2 runs this file when
# it comes first on PATH, for example when cmux starts it. Then run the file again with Homebrew's bash.
# WORKGROVE_REEXEC stops a loop if that bash is also older than 5. This block must stay valid bash 3.2.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]]; then export WORKGROVE_REEXEC=1; exec "$bash5" "$0" "$@"; fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then
  [[ -t 0 ]] || cat >/dev/null 2>&1   # read the payload, so that the agent's write cannot fail
  echo "agent-notify: needs bash 5 or later, but this is bash $BASH_VERSION; install it: brew install bash" >&2
  exit 0                              # a hook must never block the agent
fi

: "${HOME:?agent-notify: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
[[ -t 0 ]] && payload= || payload=$(cat)
event_seq=''
[[ $(uname -s) == Linux ]] && event_seq=$(date +%s%N)  # capture before tmux or relay latency can reorder hooks
title=${AGENT_NOTIFY_SOURCE:-Claude Code}
status=''; status_only=''; body=''; sound=''
interrupted=0
if [[ ${WT_STATUS_HEARTBEAT:-} == 1 && -z $payload ]]; then
  [[ -n ${WT_STATUS_FILE:-} && -r $WT_STATUS_FILE ]] || exit 0
  # Lifecycle hooks also write this file. If they wait long for the lock, they drop their update.
  # Hold the lock to read and write, not while scanning the transcript: a long turn can take seconds to parse.
  exec 9>"$WT_STATUS_FILE.lock"
  if command -v flock >/dev/null; then flock -w 1 9 || exit 0; fi
  payload=$(cat "$WT_STATUS_FILE" 2>/dev/null) || exit 0
  if command -v flock >/dev/null; then flock -u 9; fi
  path=$(printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null)
  offset=$(printf '%s' "$payload" | jq -r '.offset // empty' 2>/dev/null)
  start=$(printf '%s' "$payload" | jq -r '.start // empty' 2>/dev/null)
  if [[ $path == "$HOME/.claude/projects/"*.jsonl && $offset =~ ^[0-9]+$ && $start =~ ^[0-9]+$ && -r $path ]]; then
    size=$(wc -c < "$path")
    if { (( size > offset )) && tail -c "+$((offset + 1))" "$path" | jq -n -e '
      any(inputs; .type == "user" and
        (.message.content | if type == "string" then startswith("[Request interrupted by user")
         elif type == "array" then any(.[]; .type == "text" and (.text | startswith("[Request interrupted by user")))
         else false end))' >/dev/null 2>&1; } ||
       { (( size == offset && $(date +%s) - start >= 180 )); }; then
      if command -v flock >/dev/null; then flock -w 1 9 || exit 0; fi
      current=$(cat "$WT_STATUS_FILE" 2>/dev/null) || exit 0
      if [[ $current == "$payload" ]]; then
        prompt_seq=$(printf '%s' "$payload" | jq -r '.seq // empty' 2>/dev/null)
        [[ $prompt_seq =~ ^[0-9]{19}$ ]] && event_seq=$((10#$prompt_seq + 1))
        payload=$(printf '%s' "$payload" | jq -c --arg q "$event_seq" '.state = "idle" | .seq = $q | del(.transcript_path, .offset, .start)')
        printf '%s\n' "$payload" > "$WT_STATUS_FILE"
        interrupted=1
      else
        payload=$current  # a hook wrote during the scan; its state is newer than the marker
      fi
      if command -v flock >/dev/null; then flock -u 9; fi
    fi
  fi
  exec 9>&-
fi
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null | tr -cd 'A-Za-z0-9-' || true)
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/claude-start-times"   # private state, not /tmp: TMPDIR is empty on the VMs
quiet_seconds=${AGENT_NOTIFY_MIN_SECONDS:-180}   # a turn shorter than this finishes without a banner
# Validated for the same reason as the stamp: both go into the (( )) below, where bash expands identifiers
# and evaluates array subscripts. So under set -u a typo aborts the script, and a crafted value runs commands.
[[ $quiet_seconds =~ ^[0-9]+$ ]] || quiet_seconds=180

case $event in
  UserPromptSubmit)
    if [[ $title == 'Claude Code' && -n $session ]] && (umask 077; mkdir -p "$stamps") 2>/dev/null; then
      chmod 700 "$stamps" 2>/dev/null ||
        echo "agent-notify: cannot chmod 700 $stamps; it is not ours, so the stamps in it are not either" >&2
      find "$stamps" -type f -mtime +2 -delete 2>/dev/null || true
      date +%s > "$stamps/$session"
    fi
    status=running; status_only=1 ;;
  SessionEnd)
    [[ -n $session ]] && rm -f "$stamps/$session"
    if [[ $title == 'Claude Code' && $(printf '%s' "$payload" | jq -r '.reason // empty' 2>/dev/null) == clear ]]; then
      status=idle
    else
      status=clear
    fi
    status_only=1 ;;
  Stop) body="finished"; sound=Funk; status=idle ;;
  StopFailure|Interrupt) status=idle; status_only=1 ;;
  Heartbeat)
    status=$(printf '%s' "$payload" | jq -r '.state // empty' 2>/dev/null)
    saved_seq=$(printf '%s' "$payload" | jq -r '.seq // empty' 2>/dev/null)
    if [[ $saved_seq =~ ^[0-9]{19}$ ]]; then event_seq=$saved_seq; else status=renew; fi
    status_only=1 ;;
  PermissionRequest) body="needs approval"; sound=Glass ;;
  Notification)
    body=$(printf '%s' "$payload" | jq -r '.message // "needs input"' 2>/dev/null || echo "needs input"); sound=Glass
    [[ $title == 'Claude Code' && $(printf '%s' "$payload" | jq -r '.notification_type // empty' 2>/dev/null) == idle_prompt ]] && status=idle ;;
  *) body="needs attention"; sound=Glass ;;
esac
[[ $interrupted == 1 ]] && status=idle

# cmux authorizes a relayed notification against the surface and workspace in the environment. A pane keeps
# the identity of the cmux connection that started it, and a reattach rebinds only the tmux SESSION
# environment. So re-read that environment here and give the values to cmux explicitly, instead of letting
# the child inherit the stale values of this pane. The relay_env function in bin/wt uses the same list and
# the same precedence, for the same reason.
relay_vars="CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID"
socket=${CMUX_SOCKET_PATH:-}; ws=${CMUX_WORKSPACE_ID:-}; ident=()
s=""
if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null; then s=$(tmux display-message -p '#S' 2>/dev/null || true); fi
tmux_env=''
[[ -n $s ]] && tmux_env=$(tmux show-environment -t "=$s" 2>/dev/null || true)
for n in $relay_vars; do
  v=${!n:-}
  if [[ -n $s ]]; then
    t=$(printf '%s\n' "$tmux_env" | sed -n "s/^$n=//p" | head -1); [[ -n $t ]] && v=$t
  fi
  [[ -n $v ]] && ident+=("$n=$v")
  case $n in
    CMUX_SOCKET_PATH) socket=$v ;;
    CMUX_WORKSPACE_ID) ws=$v ;;
  esac
done

# Only the agent that `wt run` started owns a VM row. Hooks from other panes, from nested agents, and
# from a child `wt new -p` before its own row exists must not change the status of the parent.
status_owner() {
  [[ -n ${WT_STATUS_OWNER_PID:-} && ${TMUX_PANE:-} == "${WT_STATUS_OWNER_PANE:-}" ]] || return 1
  local pid=$PPID parent comm agents=0
  while [[ $pid =~ ^[0-9]+$ && $pid -gt 1 && $pid != "$WT_STATUS_OWNER_PID" ]]; do
    [[ -r /proc/$pid/status ]] || return 1
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    [[ $comm == claude || $comm == codex ]] && agents=$((agents + 1))
    parent=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status")
    pid=$parent
  done
  [[ $pid == "$WT_STATUS_OWNER_PID" && $agents -eq 1 ]]
}

relay_notify() {
  local cli="${CMUX_BUNDLED_CLI_PATH:-$HOME/.cmux/bin/cmux}"
  if command -v timeout >/dev/null; then
    timeout 1 env -u CMUX_SOCKET "${ident[@]+"${ident[@]}"}" "$cli" notify ${ws:+--workspace "$ws"} "$@" >/dev/null 2>&1
  else
    env -u CMUX_SOCKET "${ident[@]+"${ident[@]}"}" "$cli" notify ${ws:+--workspace "$ws"} "$@" >/dev/null 2>&1
  fi
}

# frontmost_terminal: true when the app that this agent runs in is the one already on screen. So a banner
# would tell the user what they are looking at. cmux rows never get here; this is for a bare terminal window.
frontmost_terminal() {
  local front t=
  case ${TERM_PROGRAM:-} in
    Apple_Terminal) t=Terminal ;;
    iTerm.app) t=iTerm2 ;;
    ghostty) t=ghostty ;;
    WezTerm) t=WezTerm ;;
    vscode) t=Code ;;
  esac
  [[ -n $t ]] || return 1
  front=$(/usr/bin/osascript -e 'tell application "System Events" to name of first process whose frontmost is true' 2>/dev/null || true)
  [[ $front == "$t" ]]
}

# short_turn: true when this session's prompt was submitted less than quiet_seconds ago. No stamp, or a stamp
# that is not a plain count of seconds, means that the agent keeps none. So the turn is never called short.
short_turn() {
  local start now
  [[ -n $session ]] || return 1
  start=$(cat "$stamps/$session" 2>/dev/null || true)
  # Digits only, checked before (( )) sees the value. Bash re-expands identifiers inside arithmetic and
  # evaluates array subscripts, so a stamp that reads `session[$(…)]` would run that command. A partial write
  # or another tool's file is not a stamp either. Under set -u, each would abort the Stop notification here.
  [[ $start =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  (( now >= start )) || return 1   # the clock stepped back (NTP, or a stamp dir shared with a faster host):
                                   # a stamp in the future must not make every turn look short until it passes
  (( now - start < quiet_seconds ))
}

if [[ $socket == *:[0-9]* ]]; then
  # cmux 0.64's SSH relay accepts notifications, but it has no sidebar or agent lifecycle method. The Mac hook,
  # cmux-hook, turns this private control notification into the same status pill that local agent hooks show.
  # It verifies that cmux assigned the notification to a row on WT_HOST before it changes that row.
  case $title in 'Claude Code') agent=claude ;; Codex) agent=codex ;; *) agent= ;; esac
  send_status=0
  if [[ $status == running || $status == idle || $status == clear || $status == renew ]] && [[ -n $agent && ${WT_HOST:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
     { { [[ ${WT_STATUS_HEARTBEAT:-} == 1 && -n ${WT_STATUS_OWNER_PID:-} &&
           ${TMUX_PANE:-} == "${WT_STATUS_OWNER_PANE:-}" ]] && kill -0 "$WT_STATUS_OWNER_PID" 2>/dev/null; } || status_owner; }; then
    send_status=1
    if [[ -n ${WT_STATUS_FILE:-} && ${WT_STATUS_HEARTBEAT:-} != 1 ]]; then
      exec 9>"$WT_STATUS_FILE.lock"
      if command -v flock >/dev/null && flock -w 1 9; then
        old_seq=''; old_session=''
        if [[ -r $WT_STATUS_FILE ]]; then
          old_seq=$(jq -r '.seq // empty' "$WT_STATUS_FILE" 2>/dev/null)
          old_session=$(jq -r '.session_id // empty' "$WT_STATUS_FILE" 2>/dev/null)
        fi
        # A late hook must not replace a newer transition or a different session's status.
        # shellcheck disable=SC2071  # both sequences are fixed-width decimal strings
        if { [[ $event != UserPromptSubmit ]] &&
             { [[ ! -r $WT_STATUS_FILE ]] || [[ $old_session != "$session" ]]; }; } ||
           { [[ $old_seq =~ ^[0-9]{19}$ ]] && [[ $event_seq == "$old_seq" || $event_seq < $old_seq ]]; }; then
          send_status=0
        elif [[ $status == clear ]]; then rm -f "$WT_STATUS_FILE"; else
          transcript=''; offset=0; start=0
          if [[ $event == UserPromptSubmit && $title == 'Claude Code' ]]; then
            transcript=$(printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null)
            if [[ $transcript == "$HOME/.claude/projects/"*.jsonl ]]; then
              [[ -r $transcript ]] && offset=$(wc -c < "$transcript")
              start=$(date +%s)
            else transcript=''; fi
          fi
          jq -nc --arg s "$session" --arg st "$status" --arg q "$event_seq" --arg p "$transcript" --argjson o "$offset" --argjson t "$start" \
            '{hook_event_name:"Heartbeat",session_id:$s,state:$st,seq:$q} + (if $p == "" then {} else {transcript_path:$p,offset:$o,start:$t} end)' > "$WT_STATUS_FILE"
        fi
        flock -u 9
      else
        send_status=0
      fi
      exec 9>&-
    fi
  fi
  # Record the new state before a heartbeat can read it. Send the completion before the sidebar network work.
  if [[ -z $status_only ]]; then
    relay_notify --title "$title" --body "$body" ||
      echo 'agent-notify: relay failed; close and reopen this cmux row (wt -H <host> attach …)' >&2
  fi
  if [[ $send_status -eq 1 ]]; then
    relay_notify --title "$title status" --body "$title: $status on $WT_HOST" \
      --subtitle "wt-agent-status|$WT_HOST|$agent|$status|$event_seq|$session" ||
      echo 'agent-notify: status relay failed; close and reopen this cmux row (wt -H <host> attach …)' >&2
  fi
  [[ -n ${status_only:-} ]] && exit 0
elif [[ -z ${CMUX_SURFACE_ID:-} && $(uname -s) == Darwin ]]; then
  [[ -n ${status_only:-} ]] && exit 0
  # A row in the sidebar is passive and costs nothing, but a banner interrupts, so only this path is gated.
  if [[ $event == Stop ]] && short_turn; then
    exit 0
  fi
  frontmost_terminal && exit 0
  /usr/bin/osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)' \
    -e 'end run' -- "$title" "$body" "$sound" >/dev/null 2>&1
fi
exit 0
