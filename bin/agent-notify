#!/usr/bin/env bash
# Agent lifecycle hook: show a banner outside cmux on the Mac.
#
# Claude prompt timestamps gate the local Mac banners: a short turn gets none.
set -u

# The scripts in bin/ need bash 5 or later (README, "Requirements").
# When /bin/bash 3.2 starts this script, use the first Homebrew candidate with version 5 or later.
# WORKGROVE_REEXEC prevents a loop if the candidate changes after the version check.
# This block must use bash 3.2 syntax.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]] && "$bash5" -c '((BASH_VERSINFO[0] >= 5))' >/dev/null 2>&1; then
      export WORKGROVE_REEXEC=1
      exec "$bash5" "$0" "$@"
    fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then
  [[ -t 0 ]] || cat >/dev/null 2>&1   # read the payload, so that the agent's write cannot fail
  echo "agent-notify: needs bash 5 or later, but this is bash $BASH_VERSION; install it: brew install bash" >&2
  exit 0                              # a hook must never block the agent
fi

# Load lib/workgrove/common.sh from the repository that holds this script. install.sh links the script into
# ~/.local/bin, so follow the link chain to the real file. macOS readlink has no -f, so take one link at a time,
# as resolve_config_path in bin/azml-ssh-host does. A relative target is read from the link's folder.
wg_path=$0 wg_hops=0
# Given a name with no '/', bash runs the file in the current folder or else the first one on PATH. Do the same.
[[ $wg_path == */* || -e $wg_path ]] || wg_path=$(type -P -- "$wg_path") || true
while [[ -L $wg_path && $wg_hops -lt 32 ]]; do
  wg_hops=$((wg_hops + 1))
  wg_target=$(readlink "$wg_path") || break
  case $wg_target in
    /*) wg_path=$wg_target ;;
    *) case $wg_path in */*) wg_path=${wg_path%/*}/$wg_target ;; *) wg_path=$wg_target ;; esac ;;
  esac
done
case $wg_path in */*) wg_lib=${wg_path%/*}/../lib/workgrove/common.sh ;; *) wg_lib=../lib/workgrove/common.sh ;; esac
unset wg_path wg_hops wg_target
# shellcheck source=lib/workgrove/common.sh
if ! source "$wg_lib" 2>/dev/null; then
  [[ -t 0 ]] || cat >/dev/null 2>&1   # read the payload, so that the agent's write cannot fail
  echo "agent-notify: cannot load $wg_lib; reinstall workgrove or check the link to bin/agent-notify" >&2
  exit 0                              # a hook must never block the agent
fi
unset wg_lib

: "${HOME:?agent-notify: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
[[ -t 0 ]] && payload= || payload=$(cat)
title=${AGENT_NOTIFY_SOURCE:-Claude Code}
status_only=''; body=''; sound=''
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null | tr -cd 'A-Za-z0-9-' || true)
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/claude-start-times"   # private state, not /tmp: TMPDIR is empty on the VMs
quiet_seconds=${AGENT_NOTIFY_MIN_SECONDS:-180}   # a turn shorter than this finishes without a banner
# Validated for the same reason as the stamp: both go into the (( )) below, where bash expands identifiers
# and evaluates array subscripts. So under set -u a typo aborts the script, and a crafted value runs commands.
[[ $quiet_seconds =~ ^[0-9]+$ ]] || quiet_seconds=180

case $event in
  UserPromptSubmit)
    if [[ $title == 'Claude Code' && -n $session ]] && (umask 077; mkdir -p "$stamps") 2>/dev/null; then
      chmod 700 "$stamps" 2>/dev/null ||
        echo "agent-notify: cannot chmod 700 $stamps; it is not ours, so the stamps in it are not either" >&2
      find "$stamps" -type f -mtime +2 -delete 2>/dev/null || true
      date +%s > "$stamps/$session"
    fi
    status_only=1 ;;
  SessionEnd)
    [[ -n $session ]] && rm -f "$stamps/$session"
    status_only=1 ;;
  Stop) body="finished"; sound=Funk ;;
  StopFailure|Interrupt) status_only=1 ;;
  PermissionRequest) body="needs approval"; sound=Glass ;;
  Notification)
    body=$(printf '%s' "$payload" | jq -r '.message // "needs input"' 2>/dev/null || echo "needs input"); sound=Glass
    ;;
  *) body="needs attention"; sound=Glass ;;
esac
# frontmost_terminal: true when the app that this agent runs in is the one already on screen. So a banner
# would tell the user what they are looking at. cmux rows never get here; this is for a bare terminal window.
frontmost_terminal() {
  local front t=
  case ${TERM_PROGRAM:-} in
    Apple_Terminal) t=Terminal ;;
    iTerm.app) t=iTerm2 ;;
    ghostty) t=ghostty ;;
    WezTerm) t=WezTerm ;;
    vscode) t=Code ;;
  esac
  [[ -n $t ]] || return 1
  front=$(/usr/bin/osascript -e 'tell application "System Events" to name of first process whose frontmost is true' 2>/dev/null || true)
  [[ $front == "$t" ]]
}

# short_turn: true when this session's prompt was submitted less than quiet_seconds ago. No stamp, or a stamp
# that is not a plain count of seconds, means that the agent keeps none. So the turn is never called short.
short_turn() {
  local start now
  [[ -n $session ]] || return 1
  start=$(cat "$stamps/$session" 2>/dev/null || true)
  # Digits only, checked before (( )) sees the value. Bash re-expands identifiers inside arithmetic and
  # evaluates array subscripts, so a stamp that reads `session[$(…)]` would run that command. A partial write
  # or another tool's file is not a stamp either. Under set -u, each would abort the Stop notification here.
  [[ $start =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  (( now >= start )) || return 1   # the clock stepped back (NTP, or a stamp dir shared with a faster host):
                                   # a stamp in the future must not make every turn look short until it passes
  (( now - start < quiet_seconds ))
}

if [[ -z ${CMUX_SURFACE_ID:-} && $(uname -s) == Darwin ]]; then
  [[ -n ${status_only:-} ]] && exit 0
  # A row in the sidebar is passive and costs nothing, but a banner interrupts, so only this path is gated.
  if [[ $event == Stop ]] && short_turn; then
    exit 0
  fi
  frontmost_terminal && exit 0
  /usr/bin/osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)' \
    -e 'end run' -- "$title" "$body" "$sound" >/dev/null 2>&1
fi
exit 0
