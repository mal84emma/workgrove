#!/usr/bin/env bash
# Agent lifecycle hook → notification. Remote cmux pane: relay to the Mac. Local cmux pane: no-op. Elsewhere on a Mac: banner.
#
# Two events carry no notification of their own, they only keep the turn timer that the Stop banner below reads:
# UserPromptSubmit stamps the session's start time, SessionEnd removes the stamp. Claude Code sends both; Codex
# does not, and a Stop with no stamp notifies as usual, so the gate never silences an agent that cannot stamp.
set -u
[[ -t 0 ]] && payload= || payload=$(cat)
title=${AGENT_NOTIFY_SOURCE:-Claude Code}
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null | tr -cd 'A-Za-z0-9-' || true)
stamps="${TMPDIR:-/tmp}/claude-start-times"
quiet_seconds=${AGENT_NOTIFY_MIN_SECONDS:-180}   # a turn shorter than this finishes without a banner

case $event in
  UserPromptSubmit)
    [[ -n $session ]] || exit 0
    mkdir -p "$stamps"
    find "$stamps" -type f -mtime +2 -delete 2>/dev/null || true   # a session that never ends leaves its stamp
    date +%s > "$stamps/$session"
    exit 0 ;;
  SessionEnd)
    [[ -n $session ]] && rm -f "$stamps/$session"
    exit 0 ;;
  Stop) body="finished"; sound=Funk ;;
  PermissionRequest) body="needs approval"; sound=Glass ;;
  Notification) body=$(printf '%s' "$payload" | jq -r '.message // "needs input"' 2>/dev/null || echo "needs input"); sound=Glass ;;
  *) body="needs attention"; sound=Glass ;;
esac

socket=${CMUX_SOCKET_PATH:-}; ws=${CMUX_WORKSPACE_ID:-}
if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null; then          # prefer the session env: cmux rebinds it on reattach
  s=$(tmux display-message -p '#S' 2>/dev/null || true)
  v=$(tmux show-environment -t "=$s" CMUX_SOCKET_PATH 2>/dev/null || true); [[ $v == *=* ]] && socket=${v#*=}
  v=$(tmux show-environment -t "=$s" CMUX_WORKSPACE_ID 2>/dev/null || true); [[ $v == *=* ]] && ws=${v#*=}
fi

# frontmost_terminal: true when the app this agent runs in is the one already on screen, so a banner would
# tell the user what they are looking at. cmux rows never reach here; this is for a bare terminal window.
frontmost_terminal() {
  local front t=
  case ${TERM_PROGRAM:-} in
    Apple_Terminal) t=Terminal ;;
    iTerm.app) t=iTerm2 ;;
    ghostty) t=ghostty ;;
    WezTerm) t=WezTerm ;;
    vscode) t=Code ;;
  esac
  [[ -n $t ]] || return 1
  front=$(/usr/bin/osascript -e 'tell application "System Events" to name of first process whose frontmost is true' 2>/dev/null || true)
  [[ $front == "$t" ]]
}

# short_turn: true when this session's prompt was submitted less than quiet_seconds ago. No stamp means the
# agent does not keep one, so the turn is never called short.
short_turn() {
  local start
  [[ -n $session ]] || return 1
  start=$(cat "$stamps/$session" 2>/dev/null || true)
  [[ -n $start ]] || return 1
  (( $(date +%s) - start < quiet_seconds ))
}

if [[ $socket == *:[0-9]* ]]; then
  CMUX_SOCKET_PATH=$socket env -u CMUX_SOCKET "${CMUX_BUNDLED_CLI_PATH:-$HOME/.cmux/bin/cmux}" notify \
    ${ws:+--workspace "$ws"} --title "$title" --body "$body" >/dev/null 2>&1 ||
    echo 'agent-notify: relay failed; close and reopen this cmux row (wt -H <host> attach …)' >&2
elif [[ -z ${CMUX_SURFACE_ID:-} && $(uname -s) == Darwin ]]; then
  # A row in the sidebar is passive and costs nothing, but a banner interrupts, so only this path is gated.
  if [[ $event == Stop ]] && short_turn; then
    exit 0
  fi
  frontmost_terminal && exit 0
  /usr/bin/osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)' \
    -e 'end run' -- "$title" "$body" "$sound" >/dev/null 2>&1
fi
exit 0
