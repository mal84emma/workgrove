#!/usr/bin/env bash
# cmux notification hook. Acts only on wt-open / wt-attach relayed from a VM; otherwise prints nothing (= unchanged).
set -u
in=$(cat)
t=${CMUX_NOTIFICATION_TITLE:-}; b=${CMUX_NOTIFICATION_BODY:-}; o=${CMUX_NOTIFICATION_ORIGIN:-}
[[ $o == ssh-relay:* ]] || exit 0
known_host() { awk -v w="$1" '$1=="Host"{for(i=2;i<=NF;i++){if($i~/^#/)break; if($i==w && $i!~/[*?]/)f=1}} END{exit(f?0:1)}' "$HOME/.ssh/config" 2>/dev/null; }
quiet() { printf '%s' "$in" | jq -c '.effects.desktop=false | .effects.sound=false | .effects.markUnread=false | .effects.paneFlash=false' 2>/dev/null || true; }
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
CMUX="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
valid_host() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
safe_path() { [[ $1 == /* && $1 != *$'\n'* && $1 != *//* && $1 != */ && $1 != *'/../'* && $1 != */.. && $1 != *[\'\"\`\$\\\;]* ]]; }
field() { printf '%s' "$b" | jq -er --arg k "$1" '.[$k] | strings' 2>/dev/null; }
row_by_session() { # the row cmux made for a VM tmux session; mirrors cmux_row_field session … in wt
  "$CMUX" workspace list --json 2>/dev/null \
    | jq -er --arg s "$1" 'first((.workspaces // .)[] | select(.remote.terminal_tmux_session == $s) | .id) // empty' 2>/dev/null; }
attach_row() { # attach_row <host> <session> <title> <command> — create the row, then write its description (= tag_row in wt)
  local out ref
  out=$("$CMUX" mosh-tmux "$1" --session "$2" --name "$3" --no-focus --command "$4" 2>&1) || return 0
  ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1)
  for _ in 1 2 3; do                       # no workspace:N in the output: the row list lags ~1s behind create
    [[ -n $ref ]] && break
    sleep 1; ref=$(row_by_session "$2")
  done
  [[ -n $ref ]] && "$CMUX" workspace-action --workspace "$ref" --action set-description --description "@$1"; }
case $t in
  wt-open)   # body: {"host":…,"path":…}
    h=$(field host || true); p=$(field path || true)
    if valid_host "$h" && known_host "$h" && safe_path "$p"; then
      "$CODE" --folder-uri "vscode-remote://ssh-remote+$h$p/" >/dev/null 2>&1 & quiet; fi ;;
  wt-attach) # body: {"host":…,"repo":…,"task":…}
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && safe_path "$r" && [[ $n =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
      id=$(printf '%s' "${r##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'); printf -v q '%q' "$r"   # mirrors valid_name / repo_id / row_title / wt_session in wt
      attach_row "$h" "wt-$id-$n" "$id:$n" "\"\$HOME/.local/bin/wt\" run $n -r $q" >/dev/null 2>&1 & quiet; fi ;;
esac
exit 0
