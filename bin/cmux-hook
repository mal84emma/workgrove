#!/usr/bin/env bash
# This is the Mac hook: the cmux notification hook on the Mac. It handles wt row requests and VM agent
# status. It leaves all other notifications unchanged.
set -u
mode=${1:-hook}
if [[ $mode == hook ]]; then cat >/dev/null; fi   # drain the envelope

# The scripts in bin/ need bash 5 or later (README, "Requirements").
# When /bin/bash 3.2 starts this script, use the first Homebrew candidate with version 5 or later.
# WORKGROVE_REEXEC prevents a loop if the candidate changes after the version check.
# This block must use bash 3.2 syntax.
# It comes after the drain, so that the envelope is read once. The hook takes its data from the environment.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]] && "$bash5" -c '((BASH_VERSINFO[0] >= 5))' >/dev/null 2>&1; then
      export WORKGROVE_REEXEC=1
      exec "$bash5" "$0" "$@"
    fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then exit 0; fi   # print no patch, so cmux keeps the notification as it is

t=${CMUX_NOTIFICATION_TITLE:-}; b=${CMUX_NOTIFICATION_BODY:-}; ws=${CMUX_NOTIFICATION_WORKSPACE_ID:-}
if [[ $mode == hook && ${CMUX_NOTIFICATION_SUBTITLE:-} == wt-agent-status\|* ]]; then
  t=wt-agent-status; b=${CMUX_NOTIFICATION_SUBTITLE}
fi
case $mode:$t in hook:*|--event:*|--apply:*|--expire:*) ;; *) exit 0 ;; esac
: "${HOME:?cmux-hook: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/cmux-hook.log"
log() { # stdout is the patch, and every call site discards stderr. So the reason that a jump did not
        # happen must go where the user can find it: tail "$LOG"
  (umask 077; mkdir -p "${LOG%/*}" &&
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG") 2>/dev/null
  return 0; }
PERL=$(command -v perl || true)
DEADLINE=${WT_STATUS_DEADLINE:-$(( $(date +%s) + 15 ))}   # child --apply shares this hook's 20 s budget
capped() { # capped <cmd…>: one cmux call, inside what is left of that budget. `workspace list --json`
           # answers in ~0.02 s, and `cmux ssh` in ~4 s. The 1.2-2.9 s quoted in the notes is how long a
           # row takes to *paint*: UI work that happens after the CLI has already returned. So the cap is
           # for an app that has hung, not for ordinary latency. Because macOS has no timeout(1), perl runs
           # the call in a process group of its own. On the alarm, perl kills the group. If it killed only
           # the leader, a child would stay behind and hold open the pipe that this call is read through.
  local left=$(( DEADLINE - $(date +%s) ))
  (( left > 0 )) || return 142
  [[ -n $PERL ]] || { "$@"; return; }      # no perl: uncapped beats not running the call at all
  # shellcheck disable=SC2016   # this is a perl program, not a shell string: the sigils are perl's
  "$PERL" -e 'my $t = shift; my $p = fork; defined $p or exit 127;
              unless ($p) { setpgrp(0, 0); exec @ARGV; exit 127 }   # own group, so nothing it spawns
              $SIG{ALRM} = sub { kill 9, -$p; waitpid $p, 0; exit 142 };   # survives to hold the pipe open
              alarm $t; waitpid $p, 0; exit($? >> 8)' "$left" "$@"
}
known_host() { awk -v w="$1" '$1=="Host"{for(i=2;i<=NF;i++){if($i~/^#/)break; if($i==w && $i!~/[*?]/)f=1}} END{exit(f?0:1)}' "$HOME/.ssh/config" 2>/dev/null; }
# A hook response is a patch: cmux merges the keys that it gets and leaves the rest alone. (The other hook
# in cmux.json answers `{"effects":{"desktop":false}}` or `{}`.) So this prints a fixed literal. It does not
# echo the envelope back, because the envelope carries whatever the agent session was working on.
event_handled() {
  [[ $mode == --event ]] || return 0
  # Closing a row removes its notifications too. Open and attach remove only their own request.
  if [[ $t != wt-close ]]; then
    capped "$CMUX" dismiss-notification --id "$nid" >/dev/null 2>&1 || log "could not dismiss $t notification $nid"
  fi
  log "handled $t for workspace $ws"
}
quiet() { event_handled; printf '%s\n' '{"effects":{"desktop":false,"sound":false,"markUnread":false,"paneFlash":false}}'; }
quiet_control() { event_handled; printf '%s\n' '{"effects":{"record":false,"markUnread":false,"reorderWorkspace":false,"desktop":false,"sound":false,"command":false,"paneFlash":false}}'; }
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
CMUX="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
valid_host() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
safe_path() { [[ $1 == /* && $1 != *$'\n'* && $1 != *//* && $1 != */ && $1 != *'/../'* && $1 != */.. && $1 != *[\'\"\`\$\\\;]* ]]; }
field() { printf '%s' "$b" | jq -er --arg k "$1" '.[$k] | strings' 2>/dev/null; }
status_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cmux-agent-status"
status_file() { printf '%s/%s-%s' "$status_dir" "$1" "$2"; }
status_locked() { # called under lockf, with: workspace agent state sequence session
  local f old_seq=0 lease=0 old_session='' old_state='' expires=0 key label icon color state seq session
  f=$(status_file "$1" "$2"); key="vm-$2"
  [[ -r $f ]] && read -r old_seq lease old_session old_state expires < "$f"
  # Older installs wrote a three-field state; upgrade it in place.
  if [[ ! $lease =~ ^[0-9]+$ ]]; then old_state=$old_session; old_session=$lease; lease=0; expires=0; fi
  state=$3; seq=$4; session=$5
  if [[ $state == expire ]]; then
    [[ $lease == "$seq" && ( $old_state == running || $old_state == idle ) && $expires =~ ^[0-9]+$ && $(date +%s) -ge $expires ]] || return 0
    state=expired-$old_state; seq=$old_seq; session=$old_session
  elif [[ $state == renew ]]; then
    [[ $old_state != clear && $old_session == "$session" && $old_seq != 0 ]] || return 0
    # Older VM state files have no transition sequence; keep their lease alive until the next event.
    state=${old_state#expired-}; seq=$old_seq
  else
    # An agent's SessionEnd must not clear a newer session; `wt run` sends '-' when it exits.
    [[ $state != clear || $session == - || -z $old_session || $old_session == - || $session == "$old_session" ]] || return 0
    # shellcheck disable=SC2071  # fixed-width decimal strings; avoid signed 64-bit overflow in arithmetic
    [[ $seq < $old_seq ]] && return 0
    if [[ $seq == "$old_seq" ]]; then
      [[ ( $state == "$old_state" || $old_state == "expired-$state" ) && $session == "$old_session" && $state != clear ]] || return 0
    fi
  fi
  case $state in
    running) label=Running; icon=bolt.fill; color='#4C8DFF' ;;
    idle) label=Idle; icon=pause.fill; color='#8E8E93' ;;
  esac
  if [[ $state == clear || $state == expired-* ]]; then
    capped "$CMUX" clear-status "$key" --workspace "$1" >/dev/null 2>&1 || { log "clear-status $key failed on $1"; return 1; }
  else
    capped "$CMUX" set-status "$key" "$label" --workspace "$1" --icon "$icon" --color "$color" >/dev/null 2>&1 ||
      { log "set-status $key failed on $1"; return 1; }
  fi
  printf '%s %s %s %s %s\n' "$seq" "$((lease + 1))" "${session:--}" "$state" "$(( $(date +%s) + ${WT_STATUS_LEASE_SECONDS:-120} ))" > "$f"
}
status_apply() {
  if [[ $3 == expire ]]; then
    [[ -d $status_dir ]] || return 0  # an orphan timer must not recreate removed state
  else
    (umask 077; mkdir -p "$status_dir") || { log "cannot create $status_dir"; return 1; }
  fi
  local f rc=0 lease state
  f=$(status_file "$1" "$2")
  if command -v lockf >/dev/null; then
    WT_STATUS_DEADLINE=$DEADLINE lockf -k -t 1 "$f.lock" "$0" --apply "$@" || rc=$?
  elif command -v flock >/dev/null; then
    WT_STATUS_DEADLINE=$DEADLINE flock -o -w 1 "$f.lock" "$0" --apply "$@" || rc=$?
  else
    log 'no file lock command for VM status'; return 1
  fi
  [[ $rc -eq 0 ]] || return "$rc"
  # Launch after lockf/flock exits: a sleeping child must not inherit its lock descriptor.
  if [[ $3 != clear && $3 != expire && -r $f ]]; then
    read -r _ lease _ state _ < "$f"
    if [[ $state == running || $state == idle ]]; then
      nohup bash "$0" --expire "$1" "$2" "$lease" >/dev/null 2>&1 </dev/null &
    fi
  fi
}
status_sweep() { # a detached expiry may lose its cmux ancestry, so later hook calls retry expired clears
  local f base row agent seq lease session state expires
  for f in "$status_dir"/*; do
    [[ -f $f && $f != *.lock ]] || continue
    base=${f##*/}; row=${base%-*}; agent=${base##*-}
    [[ $row =~ ^[A-Fa-f0-9-]{36}$ && ( $agent == claude || $agent == codex ) ]] || continue
    read -r seq lease session state expires < "$f"
    [[ $lease =~ ^[0-9]+$ && $expires =~ ^[0-9]+$ && ( $state == running || $state == idle ) && $(date +%s) -ge $expires ]] || continue
    status_apply "$row" "$agent" expire "$lease" - || true
    (( DEADLINE - $(date +%s) > 2 )) || break
  done
}
WS_JSON=""; WS_RC=""
ws_load() { # ws_load [fresh] — one shared snapshot of every cmux row, in every window. The snapshot is
            # in $WS_JSON, and its status is in $WS_RC.
            # Both queries below used to make their own capped call and pipe it straight into jq. That
            # threw away capped's exit status. So a list that timed out looked exactly like "no such row".
            # Then attach_row took its create branch, and a task that already had a row got a second one. One
            # snapshot with a checked status fixes both halves of that. Also, a failure now propagates, so
            # the caller creates nothing and the notification keeps its ordinary banner.
            # `workspace list --json` covers ONE window, and a hook has no caller surface. So the call
            # answered for whichever window was current. A task row was invisible here when the user had
            # moved it into a second window, to work on two tasks side by side. The result was worse than a
            # missing row: from_row_on_host could not show that the notification came from that host, so it
            # failed closed. Then a VM's `wt open` did nothing but write a line to $LOG.
            # So this enumerates the windows and merges their lists, exactly as rows_json does in wt. It
            # names each window by its uuid, never by the index that list-windows prints first, because
            # opening a window renumbers the others. The uuid stays the same.
  [[ ${1:-} == fresh ]] && WS_RC=""       # the post-create lookup wants the list as it is now, not as it was
  [[ -n $WS_RC ]] && return "$WS_RC"
  local wins w out docs="" rc=0
  wins=$(capped "$CMUX" list-windows 2>/dev/null) || wins=""      # cannot enumerate: the fallback below stands in
  wins=$(printf '%s\n' "$wins" | awk '{print ($1 == "*" ? $3 : $2)}' | grep -Ex '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}') || wins=""
  for w in $wins; do
    out=$(capped "$CMUX" workspace list --json --window "$w" 2>/dev/null); rc=$?
    [[ $rc -eq 0 ]] || break               # a window whose list timed out must not pass for one holding no rows
    docs="$docs$out"
  done
  # When this enumerates nothing, it falls back to the single-window call that was here before. That
  # happens with an older cmux that has no list-windows, or with output that this could not parse. So
  # such a cmux keeps the reach that it had, and does not lose the hook.
  if [[ $rc -eq 0 && -z $docs ]]; then
    docs=$(capped "$CMUX" workspace list --json 2>/dev/null); rc=$?
  fi
  WS_RC=$rc
  # `.workspaces?` and not `.workspaces`: cmux may hand back a bare array. jq's `//` does not catch the
  # error `Cannot index array with "workspaces"`. Only the `?` turns that error into the empty result that
  # `//` can fall back from.
  if [[ $WS_RC -eq 0 ]]; then
    WS_JSON=$(printf '%s' "$docs" | jq -s -c '{workspaces: (map(.workspaces? // .) | add // [])}' 2>/dev/null) || WS_RC=1
  fi
  case $WS_RC in
    0) ;;
    142) log "the cmux row list hit the hook deadline (capped exit 142)" ;;   # "did it time out": yes
    *)   log "the cmux row list failed (exit $WS_RC)" ;;
  esac
  return "$WS_RC"; }
row_by_title() { # the local row for a VM task; mirrors cmux_row_field <title> <field> <host> in wt
  ws_load || return                       # callers load first; this is only here so the filter never runs blind
  printf '%s' "$WS_JSON" \
    | jq -er --arg t "$1" --arg h "$2" 'first((.workspaces? // .)[] | select(.title == $t and .remote.enabled and (((.remote.destination // "") == $h) or ((.description // "") == "@" + $h))) | .id) // empty' 2>/dev/null; }
from_row_on_host() { # from_row_on_host <workspace uuid> <host> — the notifying row is an SSH row to that host.
  # cmux 0.64 reports CMUX_NOTIFICATION_ORIGIN=local for a `cmux ssh` row's own notifications. (Only the old
  # mosh-tmux relay said ssh-relay:<uuid>.) So the row's remote destination is the check that the
  # notification came from a VM.
  # That check is worth something only because cmux assigns the workspace id from the SENDING surface. cmux
  # does not take it from the sender's --workspace. Measured on 0.64:
  # `cmux notify --workspace <other id>` from one row is still recorded against the row that it was typed in,
  # whichever id it names. So this check asks where the notification came from, not what the sender claims.
  # If the sender chose the id, a VM could name any ssh row to the host that it claims. Then this would check
  # only the VM's own assertion. Still, notify_mac passes --workspace and names the VM's own row, so it stays
  # correct if a later cmux honors the flag. But nothing here may depend on it.
  # This runs in the caller's shell, not a subshell, so attach_row then uses the snapshot that this loads.
  [[ -n $1 ]] || return 1
  ws_load || return 1
  printf '%s' "$WS_JSON" \
    | jq -e --arg w "$1" --arg h "$2" 'any((.workspaces? // .)[]; .id == $w and .remote.enabled and (.remote.destination // "") == $h)' >/dev/null 2>&1; }
tmux_cmd() { # tmux_cmd <session> [command] [shared] [reinit]
  # The body below mirrors tmux_cmd in bin/wt byte for byte, although the hook only ever needs the task form.
  # This command must print nothing:
  # diff <(sed -n '/^tmux_cmd()/,/^}/p' bin/wt | grep -v '^ *#') <(sed -n '/^tmux_cmd()/,/^}/p' bin/cmux-hook |
  # grep -v '^ *#')
  # Comments may differ between the two. Executable lines may not.
  # Native cmux closes a row when its terminal exits. Exec the tmux client so self-removal ends that terminal.
  local run="" native_mark=""
  # Replacing an old client does not replace its parent shell. Preserve its original cleanup contract.
  [[ ${4:-} == reinit ]] || native_mark="tmux set-environment -t '=$1' WT_CMUX_CLOSE_ON_EXIT 1; "
  [[ -n "${2:-}" ]] && printf -v run '%q' "$2; exec bash"
  if [[ "${3:-}" == shared ]]; then
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; tmux attach -t '=%s'" "$1" "$run" "$1"
  else
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; " "$1" "$run"
    # Bind the current transport before reading the old session's identity.
    printf "if [ -n \"\$CMUX_TUI_SOCKET\" ]; then for v in CMUX_SOCKET_PATH CMUX_WORKSPACE_ID CMUX_SURFACE_ID CMUX_PANEL_ID CMUX_TAB_ID CMUX_TERMINAL_LIFECYCLE_ID; do export \"\$v=\"; tmux set-environment -t '=%s' \"\$v\" ''; done; " "$1"
    printf "for v in CMUX_TUI_SOCKET CMUX_TUI_TERMINAL_ID CMUX_TUI_SESSION_ID; do tmux set-environment -t '=%s' \"\$v\" \"\$(printenv \"\$v\")\"; done; %sexec tmux attach -d -t '=%s'; fi; " "$1" "$native_mark" "$1"
    printf "[ -n \"\$CMUX_SOCKET_PATH\" ] || export CMUX_SOCKET_PATH=\"\$(tmux show-environment -t '=%s' CMUX_SOCKET_PATH 2>/dev/null | sed -n 's/^CMUX_SOCKET_PATH=//p')\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] || export CMUX_WORKSPACE_ID=\"\$(tmux show-environment -t '=%s' CMUX_WORKSPACE_ID 2>/dev/null | sed -n 's/^CMUX_WORKSPACE_ID=//p')\"; [ -n \"\$CMUX_SOCKET_PATH\" ] && tmux set-environment -t '=%s' CMUX_SOCKET_PATH \"\$CMUX_SOCKET_PATH\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] && tmux set-environment -t '=%s' CMUX_WORKSPACE_ID \"\$CMUX_WORKSPACE_ID\"; " "$1" "$1" "$1" "$1"
    printf "for v in CMUX_TUI_SOCKET CMUX_TUI_TERMINAL_ID CMUX_TUI_SESSION_ID; do export \"\$v=\"; tmux set-environment -t '=%s' \"\$v\" ''; done; tmux attach -d -t '=%s'" "$1" "$1"
  fi
}
attach_row() { # attach_row <host> <session> <title> <command> — bring this task's row forward, or create it
               # first, then write its description. This mirrors remote_row in wt: one row per title+host.
               # It only selects an existing row and never types into it, because the row's pane may hold
               # an agent that would eat the line.
               # When it reaches no row, it returns non-zero and says why in $LOG. That is the same contract
               # as wt, which dies when the select or the create fails. The caller must not quiet a
               # notification that produced nothing.
  local out ref line
  ws_load || { log "no row list for $3 on $1: not creating a row on a lookup that failed"; return 1; }
  ref=$(row_by_title "$3" "$1")
  if [[ -n $ref ]]; then
    capped "$CMUX" workspace select "$ref" >/dev/null 2>&1 || { log "cmux workspace select $ref failed"; return 1; }
  else
    line=$(tmux_cmd "$2" "$4")
    out=$(capped "$CMUX" ssh "$1" --name "$3" --no-focus --command "$line" 2>&1) ||
      { log "cmux ssh $1 --name $3 failed: $out"; return 1; }
    ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1)
    if [[ -z $ref ]]; then                 # no workspace:N in the output: the row list lags ~1s behind create.
      sleep 1; ws_load fresh; ref=$(row_by_title "$3" "$1")   # one look back is enough, now that giving up is reported
    fi
    [[ -n $ref ]] || { log "cmux reported no row for $3 on $1: $out"; return 1; }
  fi
  capped "$CMUX" workspace-action --workspace "$ref" --action set-description --description "@$1" ||
    log "set-description @$1 failed for $ref"   # cosmetic only: the row is there, so the jump did happen
  return 0; }
case $mode in
  --event)
    # Native notifications bypass notifications.hooks in cmux 0.65. Use the recorded event's identity.
    event=${CMUX_AUTOMATION_EVENT_JSON:-}
    nid=$(printf '%s' "$event" | jq -er 'select(.name == "notification.created") | .payload.notification_id | strings' 2>/dev/null) || exit 0
    ws=$(printf '%s' "$event" | jq -er '.workspace_id | strings' 2>/dev/null) || exit 0
    [[ $nid =~ ^[A-Fa-f0-9-]{36}$ && $ws =~ ^[A-Fa-f0-9-]{36}$ ]] || exit 0
    ws_load || exit 0
    printf '%s' "$WS_JSON" | jq -e --arg w "$ws" 'any(.workspaces[]; .id == $w and .remote.enabled and .remote.backend == "cmux-tui")' >/dev/null 2>&1 || exit 0
    # Public events redact notification text. Read only the record with the event's ID and row.
    record=$(capped "$CMUX" --json list-notifications 2>/dev/null | jq -ec --arg i "$nid" --arg w "$ws" 'first(.[] | select(.id == $i and .workspace_id == $w))' 2>/dev/null) || exit 0
    t=$(printf '%s' "$record" | jq -er '.title | strings') || exit 0
    b=$(printf '%s' "$record" | jq -er '.body | strings') || exit 0
    case $t in wt-open|wt-attach|wt-close) ;; *) exit 0 ;; esac
    ;;
  --apply)
    [[ $# -eq 6 && $2 =~ ^[A-Fa-f0-9-]{36}$ && ( $3 == claude || $3 == codex ) &&
       ( $4 == running || $4 == idle || $4 == clear || $4 == renew || $4 == expire ) && $5 =~ ^[0-9]{1,19}$ ]] || exit 1
    status_locked "$2" "$3" "$4" "$5" "$6"; exit $? ;;
  --expire)
    [[ $# -eq 4 && $2 =~ ^[A-Fa-f0-9-]{36}$ && ( $3 == claude || $3 == codex ) && $4 =~ ^[0-9]+$ ]] || exit 1
    sleep "${WT_STATUS_LEASE_SECONDS:-120}"
    DEADLINE=$(( $(date +%s) + 15 ))
    [[ -r $(status_file "$2" "$3") ]] || exit 0
    status_apply "$2" "$3" expire "$4" -
    exit $? ;;
esac
case $t in
  wt-agent-status) # subtitle: wt-agent-status|host|agent|state|sequence|session
    quiet_control  # control traffic is never a user notification, even if validation or cmux fails
    IFS='|' read -r marker h agent state seq session extra <<< "$b"
    if valid_host "$h" && known_host "$h" && [[ $agent == claude || $agent == codex ]] &&
       [[ $state == running || $state == idle || $state == clear || $state == renew ]] &&
       [[ $marker == wt-agent-status && -z ${extra:-} && $seq =~ ^[0-9]{19}$ && $session =~ ^[A-Za-z0-9-]*$ ]] &&
       [[ $ws =~ ^[A-Fa-f0-9-]{36}$ ]] && from_row_on_host "$ws" "$h"; then
      status_apply "$ws" "$agent" "$state" "$seq" "${session:--}" || log "status $state for $agent on $ws failed"
    else
      log "ignored invalid VM agent status for workspace $ws"
    fi ;;
  wt-open)   # body: {"host":…,"path":…}
    h=$(field host || true); p=$(field path || true)
    # -x $CODE first: the fallback above is a hard-coded path. A machine can have no VS Code, or have it
    # installed elsewhere. On such a machine, quieting the row for a window that can never open is the
    # worst of both.
    if [[ -x $CODE ]] && valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$p"; then
      "$CODE" --folder-uri "vscode-remote://ssh-remote+$h$p/" >/dev/null 2>&1 &
      pid=$!; sleep 1                      # the code CLI hands the folder to the app and exits 0 well inside
      if kill -0 "$pid" 2>/dev/null; then  # a second, so both "still running" and "exited 0" mean it launched;
        quiet                              # only a non-zero exit is a failure, and that one keeps its banner
      elif wait "$pid"; then
        quiet
      else
        log "$CODE --folder-uri vscode-remote://ssh-remote+$h$p/ failed; no window opened"
      fi
    fi ;;
  wt-attach) # body: {"host":…,"repo":…,"task":…}
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$r" && [[ $n =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
      id=$(printf '%s' "${r##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'); printf -v q '%q' "$r"   # mirrors valid_name / repo_id / row_title / wt_session in wt
      # Synchronous on purpose: cmux authorizes the socket by process ancestry. The moment this hook
      # exits, a backgrounded child is reparented away from the cmux tree. The app then refuses that
      # child ("Access denied - only processes started inside cmux can connect"). Creating the row costs
      # ~4 s against the hook's 20 s budget in cmux.json.
      # Quiet only on success: a notification whose jump failed keeps its banner, sound and unread mark.
      # When this prints nothing at all, cmux reads that as "leave the effects alone". $LOG says what
      # went wrong.
      if attach_row "$h" "wt-$id-$n" "$id:$n" "WT_STATUS_BRIDGE=1 \"\$HOME/.local/bin/wt\" run $n -r $q" >/dev/null 2>&1; then
        quiet
      fi
    fi ;;
  wt-close) # a VM task removed itself; only its own row may ask to close
    DEADLINE=$(( $(date +%s) + 12 ))   # leave time under cmux's 20 s hook limit to stop tmux after closing
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && safe_path "$r" && [[ $n =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] &&
       from_row_on_host "$ws" "$h"; then
      id=$(printf '%s' "${r##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-')
      if [[ $(row_by_title "$id:$n" "$h") == "$ws" ]]; then
        printf -v q '%q' "$r"; rc=0
        gone=$(capped ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" "exec \"\$HOME/.local/bin/wt\" path $n -r $q" 2>&1) || rc=$?
        if [[ $rc -ne 1 || $gone != *"no worktree named '$n' in $r"* ]]; then
          log "ignored wt-close for $id:$n on $h: could not confirm its worktree is gone"
        elif capped "$CMUX" workspace close "$ws" --force >/dev/null 2>&1; then
          # Close first: an open SSH row can reconnect and recreate the tmux session after it is killed.
          DEADLINE=$(( $(date +%s) + 5 ))
          if capped ssh -o BatchMode=yes -o ConnectTimeout=4 "$h" "exec tmux kill-session -t '=wt-$id-$n'" >/dev/null 2>&1; then
            quiet_control
          else
            log "could not stop tmux session wt-$id-$n on $h after closing $ws"
            if command -v osascript >/dev/null 2>&1; then
              osascript -e 'on run argv' \
                -e 'display notification (item 1 of argv) with title "workgrove teardown incomplete"' \
                -e 'end run' "Run: ssh $h tmux kill-session -t '=wt-$id-$n'" >/dev/null 2>&1 || true
            fi
          fi
        else log "could not close row $ws for $id:$n on $h"; fi
      else log "ignored wt-close for a row other than $id:$n on $h"; fi
    else log "ignored invalid wt-close for workspace $ws"; fi ;;
esac
[[ $mode == hook ]] && status_sweep
exit 0
