#!/usr/bin/env bash
# cmux notification hook. Acts only on wt-open / wt-attach sent from a VM row; otherwise prints nothing (= unchanged).
set -u
cat >/dev/null          # drain the envelope: everything acted on comes from the CMUX_NOTIFICATION_* env
t=${CMUX_NOTIFICATION_TITLE:-}; b=${CMUX_NOTIFICATION_BODY:-}; ws=${CMUX_NOTIFICATION_WORKSPACE_ID:-}
case $t in wt-open|wt-attach) ;; *) exit 0 ;; esac
: "${HOME:?cmux-hook: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/cmux-hook.log"
log() { # stdout is the patch and every call site discards stderr, so the reason a jump did not happen
        # has to land where the user can find it: tail "$LOG"
  (umask 077; mkdir -p "${LOG%/*}" &&
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG") 2>/dev/null
  return 0; }
PERL=$(command -v perl || true)
DEADLINE=$(( $(date +%s) + 15 ))   # cmux.json allows this hook 20 s; leave room to print the patch
capped() { # capped <cmd…>: one cmux call, inside what is left of that budget. `workspace list --json`
           # answers in ~0.02 s and `cmux ssh` in ~4 s; the 1.2-2.9 s quoted in the notes is how long a row
           # takes to *paint*, UI work that happens after the CLI has already returned. So the cap is here
           # for an app that has hung, not for ordinary latency. macOS has no timeout(1), so perl
           # runs the call in a process group of its own and, on the alarm, kills the group: killing only
           # the leader would leave a child behind holding open the pipe this call is being read through.
  local left=$(( DEADLINE - $(date +%s) ))
  (( left > 0 )) || return 142
  [[ -n $PERL ]] || { "$@"; return; }      # no perl: uncapped beats not running the call at all
  # shellcheck disable=SC2016   # this is a perl program, not a shell string: the sigils are perl's
  "$PERL" -e 'my $t = shift; my $p = fork; defined $p or exit 127;
              unless ($p) { setpgrp(0, 0); exec @ARGV; exit 127 }   # own group, so nothing it spawns
              $SIG{ALRM} = sub { kill 9, -$p; waitpid $p, 0; exit 142 };   # survives to hold the pipe open
              alarm $t; waitpid $p, 0; exit($? >> 8)' "$left" "$@"
}
known_host() { awk -v w="$1" '$1=="Host"{for(i=2;i<=NF;i++){if($i~/^#/)break; if($i==w && $i!~/[*?]/)f=1}} END{exit(f?0:1)}' "$HOME/.ssh/config" 2>/dev/null; }
# A hook response is a patch: cmux merges the keys it is given and leaves the rest alone (the other hook in
# cmux.json answers `{"effects":{"desktop":false}}` or `{}`). So this prints a fixed literal rather than
# echoing the envelope back, which carries whatever the agent session was working on.
quiet() { printf '%s\n' '{"effects":{"desktop":false,"sound":false,"markUnread":false,"paneFlash":false}}'; }
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
CMUX="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
valid_host() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
safe_path() { [[ $1 == /* && $1 != *$'\n'* && $1 != *//* && $1 != */ && $1 != *'/../'* && $1 != */.. && $1 != *[\'\"\`\$\\\;]* ]]; }
field() { printf '%s' "$b" | jq -er --arg k "$1" '.[$k] | strings' 2>/dev/null; }
WS_JSON=""; WS_RC=""
ws_load() { # ws_load [fresh] — one shared snapshot of every cmux row, in every window, kept in $WS_JSON
            # with its status in $WS_RC.
            # Both queries below used to make their own capped call and pipe it straight into jq, which threw
            # away capped's exit status: a list that timed out then looked exactly like "no such row", so
            # attach_row took its create branch and gave a task that already had a row a second one. One
            # snapshot, status checked, fixes both halves of that — and a failure now propagates, so the
            # caller creates nothing and the notification keeps its ordinary banner.
            # `workspace list --json` covers ONE window, and a hook has no caller surface, so it answered for
            # whichever window happened to be current. A task row the user had moved into a second window to
            # work on two tasks side by side was invisible here, and the consequence is worse than a missing
            # row: from_row_on_host could not show the notification came from that host, so it failed closed
            # and a VM's `wt open` did nothing but write a line to $LOG. Windows are enumerated and their
            # lists merged, exactly as rows_json does in wt — by uuid, never by the index list-windows prints
            # first, because opening a window renumbers the others while the uuid stays put.
  [[ ${1:-} == fresh ]] && WS_RC=""       # the post-create lookup wants the list as it is now, not as it was
  [[ -n $WS_RC ]] && return "$WS_RC"
  local wins w out docs="" rc=0
  wins=$(capped "$CMUX" list-windows 2>/dev/null) || wins=""      # cannot enumerate: the fallback below stands in
  wins=$(printf '%s\n' "$wins" | awk '{print $2}' | grep -Ex '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}') || wins=""
  for w in $wins; do
    out=$(capped "$CMUX" workspace list --json --window "$w" 2>/dev/null); rc=$?
    [[ $rc -eq 0 ]] || break               # a window whose list timed out must not pass for one holding no rows
    docs="$docs$out"
  done
  # Nothing enumerated — an older cmux with no list-windows, or output this could not parse — falls back to
  # the single-window call that was here before, so that cmux keeps the reach it had instead of losing the hook.
  if [[ $rc -eq 0 && -z $docs ]]; then
    docs=$(capped "$CMUX" workspace list --json 2>/dev/null); rc=$?
  fi
  WS_RC=$rc
  # `.workspaces?` and not `.workspaces`: cmux may hand back a bare array, and jq's `//` does not catch the
  # error `Cannot index array with "workspaces"` — only the `?` turns that into the empty it can fall back from.
  if [[ $WS_RC -eq 0 ]]; then
    WS_JSON=$(printf '%s' "$docs" | jq -s -c '{workspaces: (map(.workspaces? // .) | add // [])}' 2>/dev/null) || WS_RC=1
  fi
  case $WS_RC in
    0) ;;
    142) log "the cmux row list hit the hook deadline (capped exit 142)" ;;   # "did it time out": yes
    *)   log "the cmux row list failed (exit $WS_RC)" ;;
  esac
  return "$WS_RC"; }
row_by_title() { # the local row for a VM task; mirrors cmux_row_field <title> <field> <host> in wt
  ws_load || return                       # callers load first; this is only here so the filter never runs blind
  printf '%s' "$WS_JSON" \
    | jq -er --arg t "$1" --arg h "$2" 'first((.workspaces? // .)[] | select(.title == $t and .remote.enabled and (((.remote.destination // "") == $h) or ((.description // "") == "@" + $h))) | .id) // empty' 2>/dev/null; }
from_row_on_host() { # from_row_on_host <workspace uuid> <host> — the notifying row is an SSH row to that host.
  # cmux 0.64 reports CMUX_NOTIFICATION_ORIGIN=local for a `cmux ssh` row's own notifications (only the old
  # mosh-tmux relay said ssh-relay:<uuid>), so the row's remote destination is the check that it came from a VM.
  # What makes that check worth anything: the workspace id is assigned by cmux from the SENDING surface, not
  # taken from the sender's --workspace. Measured on 0.64 — `cmux notify --workspace <other id>` from one row
  # is still recorded against the row it was typed in, whichever id is named. So this asks where the
  # notification actually came from. Were it sender-chosen, a VM could name any ssh row to the host it claims
  # and this would be checking the VM's own assertion; notify_mac still passes --workspace (naming the VM's
  # own row, so it stays correct if a later cmux honours it), but nothing here may lean on it.
  # Runs in the caller's shell, not a subshell, so the snapshot it loads is the one attach_row goes on to use.
  [[ -n $1 ]] || return 1
  ws_load || return 1
  printf '%s' "$WS_JSON" \
    | jq -e --arg w "$1" --arg h "$2" 'any((.workspaces? // .)[]; .id == $w and .remote.enabled and (.remote.destination // "") == $h)' >/dev/null 2>&1; }
tmux_cmd() { # tmux_cmd <session> [command] [shared]
  # The body below mirrors tmux_cmd in bin/wt byte for byte, although the hook only ever needs the task form:
  # diff <(sed -n '/^tmux_cmd()/,/^}/p' bin/wt | grep -v '^ *#') <(sed -n '/^tmux_cmd()/,/^}/p' bin/cmux-hook |
  # grep -v '^ *#') must print nothing. Comments may differ between the two, executable lines may not.
  local run=""
  [[ -n "${2:-}" ]] && printf -v run '%q' "$2; exec bash"
  if [[ "${3:-}" == shared ]]; then
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; tmux attach -t '=%s'" "$1" "$run" "$1"
  else
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; [ -n \"\$CMUX_SOCKET_PATH\" ] || export CMUX_SOCKET_PATH=\"\$(tmux show-environment -t '=%s' CMUX_SOCKET_PATH 2>/dev/null | sed -n 's/^CMUX_SOCKET_PATH=//p')\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] || export CMUX_WORKSPACE_ID=\"\$(tmux show-environment -t '=%s' CMUX_WORKSPACE_ID 2>/dev/null | sed -n 's/^CMUX_WORKSPACE_ID=//p')\"; [ -n \"\$CMUX_SOCKET_PATH\" ] && tmux set-environment -t '=%s' CMUX_SOCKET_PATH \"\$CMUX_SOCKET_PATH\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] && tmux set-environment -t '=%s' CMUX_WORKSPACE_ID \"\$CMUX_WORKSPACE_ID\"; tmux attach -d -t '=%s'" "$1" "$run" "$1" "$1" "$1" "$1" "$1"
  fi
}
attach_row() { # attach_row <host> <session> <title> <command> — bring this task's row forward, or create it
               # first, then write its description (= remote_row in wt: one row per title+host, and an existing
               # row is only selected, never typed into: its pane may hold an agent that would eat the line).
               # Returns non-zero, and says why in $LOG, when no row was reached — same contract as wt, which
               # dies on both of these. The caller must not quiet a notification that produced nothing.
  local out ref line
  ws_load || { log "no row list for $3 on $1: not creating a row on a lookup that failed"; return 1; }
  ref=$(row_by_title "$3" "$1")
  if [[ -n $ref ]]; then
    capped "$CMUX" workspace select "$ref" >/dev/null 2>&1 || { log "cmux workspace select $ref failed"; return 1; }
  else
    line=$(tmux_cmd "$2" "$4")
    out=$(capped "$CMUX" ssh "$1" --name "$3" --no-focus --command "$line" 2>&1) ||
      { log "cmux ssh $1 --name $3 failed: $out"; return 1; }
    ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1)
    if [[ -z $ref ]]; then                 # no workspace:N in the output: the row list lags ~1s behind create.
      sleep 1; ws_load fresh; ref=$(row_by_title "$3" "$1")   # one look back is enough now that giving up is reported
    fi
    [[ -n $ref ]] || { log "cmux reported no row for $3 on $1: $out"; return 1; }
  fi
  capped "$CMUX" workspace-action --workspace "$ref" --action set-description --description "@$1" ||
    log "set-description @$1 failed for $ref"   # cosmetic only: the row is there, so the jump did happen
  return 0; }
case $t in
  wt-open)   # body: {"host":…,"path":…}
    h=$(field host || true); p=$(field path || true)
    # -x $CODE first: the fallback above is a hard-coded path, and on a machine with no VS Code, or with it
    # installed elsewhere, quieting the row for a window that can never open is the worst of both.
    if [[ -x $CODE ]] && valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$p"; then
      "$CODE" --folder-uri "vscode-remote://ssh-remote+$h$p/" >/dev/null 2>&1 &
      pid=$!; sleep 1                      # the code CLI hands the folder to the app and exits 0 well inside
      if kill -0 "$pid" 2>/dev/null; then  # a second, so both "still running" and "exited 0" mean it launched;
        quiet                              # only a non-zero exit is a failure, and that one keeps its banner
      elif wait "$pid"; then
        quiet
      else
        log "$CODE --folder-uri vscode-remote://ssh-remote+$h$p/ failed; no window opened"
      fi
    fi ;;
  wt-attach) # body: {"host":…,"repo":…,"task":…}
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$r" && [[ $n =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
      id=$(printf '%s' "${r##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'); printf -v q '%q' "$r"   # mirrors valid_name / repo_id / row_title / wt_session in wt
      # Synchronous on purpose: cmux authorises the socket by process ancestry, and a backgrounded child is
      # reparented away from the cmux tree the moment this hook exits, which the app then refuses
      # ("Access denied - only processes started inside cmux can connect"). Creating the row costs ~4 s
      # against the hook's 20 s budget in cmux.json.
      # Only on success: a notification whose jump failed keeps its banner, sound and unread mark, and
      # printing nothing at all is what cmux reads as "leave the effects alone". $LOG says what went wrong.
      if attach_row "$h" "wt-$id-$n" "$id:$n" "\"\$HOME/.local/bin/wt\" run $n -r $q" >/dev/null 2>&1; then
        quiet
      fi
    fi ;;
esac
exit 0
