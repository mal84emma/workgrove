#!/usr/bin/env bash
# The Mac hook handles wt row requests from native VM notifications.
set -u
mode=${1:-}

# The scripts in bin/ need bash 5 or later (README, "Requirements").
# When /bin/bash 3.2 starts this script, use the first Homebrew candidate with version 5 or later.
# WORKGROVE_REEXEC prevents a loop if the candidate changes after the version check.
# This block must use bash 3.2 syntax.
if ((BASH_VERSINFO[0] < 5)) && [[ -z ${WORKGROVE_REEXEC:-} ]]; then
  for bash5 in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x $bash5 ]] && "$bash5" -c '((BASH_VERSINFO[0] >= 5))' >/dev/null 2>&1; then
      export WORKGROVE_REEXEC=1
      exec "$bash5" "$0" "$@"
    fi
  done
fi
unset WORKGROVE_REEXEC
if ((BASH_VERSINFO[0] < 5)); then exit 0; fi   # print no patch, so cmux keeps the notification as it is
# Load lib/workgrove/common.sh from the repository that holds this script. install.sh links the script into
# ~/.local/bin, so follow the link chain to the real file. macOS readlink has no -f, so take one link at a time,
# as resolve_config_path in bin/azml-ssh-host does. A relative target is read from the link's folder.
wg_path=$0 wg_hops=0
# Given a name with no '/', bash runs the file in the current folder or else the first one on PATH. Do the same.
[[ $wg_path == */* || -e $wg_path ]] || wg_path=$(type -P -- "$wg_path") || true
while [[ -L $wg_path && $wg_hops -lt 32 ]]; do
  wg_hops=$((wg_hops + 1))
  wg_target=$(readlink "$wg_path") || break
  case $wg_target in
    /*) wg_path=$wg_target ;;
    *) case $wg_path in */*) wg_path=${wg_path%/*}/$wg_target ;; *) wg_path=$wg_target ;; esac ;;
  esac
done
case $wg_path in */*) wg_lib=${wg_path%/*}/../lib/workgrove/common.sh ;; *) wg_lib=../lib/workgrove/common.sh ;; esac
unset wg_path wg_hops wg_target
# shellcheck source=lib/workgrove/common.sh
if ! source "$wg_lib" 2>/dev/null; then
  exit 0
fi
unset wg_lib
WG_PREFIX=cmux-hook
[[ $mode == --event ]] || exit 0

: "${HOME:?cmux-hook: HOME is not set}"   # name the script; bash alone says only "HOME: unbound variable"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/cmux-hook.log"
log() { # Keep diagnostics in this log so the native automation response stays unchanged.
        # Read a failed request's reason with: tail "$LOG"
  (umask 077; mkdir -p "${LOG%/*}" &&
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG") 2>/dev/null
  return 0; }
PERL=$(command -v perl || true)
DEADLINE=$(( $(date +%s) + 15 ))
# shellcheck disable=SC2329  # CMUX_RUN and VM_SSH_RUN invoke this function.
capped() { # capped <cmd…>: one cmux call, inside what is left of that budget. `workspace list --json`
           # answers in ~0.02 s, and `cmux ssh` in ~4 s. The 1.2-2.9 s quoted in the notes is how long a
           # row takes to *paint*: UI work that happens after the CLI has already returned. So the cap is
           # for an app that has hung, not for ordinary latency. Because macOS has no timeout(1), perl runs
           # the call in a process group of its own. On the alarm, perl kills the group. If it killed only
           # the leader, a child would stay behind and hold open the pipe that this call is read through.
  local left=$(( DEADLINE - $(date +%s) ))
  (( left > 0 )) || return 142
  [[ -n $PERL ]] || { "$@"; return; }      # no perl: uncapped beats not running the call at all
  # shellcheck disable=SC2016   # this is a perl program, not a shell string: the sigils are perl's
  "$PERL" -e 'my $t = shift; my $p = fork; defined $p or exit 127;
              unless ($p) { setpgrp(0, 0); exec @ARGV; exit 127 }   # own group, so nothing it spawns
              $SIG{ALRM} = sub { kill 9, -$p; waitpid $p, 0; exit 142 };   # survives to hold the pipe open
              alarm $t; waitpid $p, 0; my $s = $?; exit(($s & 127) ? 128 + ($s & 127) : ($s >> 8))' "$left" "$@"
}
event_handled() {
  [[ $mode == --event ]] || return 0
  # Closing a row removes its notifications too. Open and attach remove only their own request.
  if [[ $t != wt-close ]]; then
    cmux_dismiss "$nid" >/dev/null 2>&1 || log "could not dismiss $t notification $nid"
  fi
  log "handled $t for workspace $ws"
}
quiet() { event_handled; printf '%s\n' '{"effects":{"desktop":false,"sound":false,"markUnread":false,"paneFlash":false}}'; }
quiet_control() { event_handled; printf '%s\n' '{"effects":{"record":false,"markUnread":false,"reorderWorkspace":false,"desktop":false,"sound":false,"command":false,"paneFlash":false}}'; }
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
CMUX=$(cmux_bin) || { log "cmux executable not found"; exit 0; }
CMUX_RUN=(capped "$CMUX")
VM_SSH_RUN=(capped ssh)
VM_SSH_CHECK_RUN=(capped)
field() { printf '%s' "$b" | jq -er --arg k "$1" '.[$k] | strings' 2>/dev/null; }

attach_row() { # attach_row <host> <session> <title> <repo id> <command>
  local rc=0
  cmux_row_open_ssh "$1" "$3" "@$1$ROW_SEP$4" "$(tmux_cmd "$2" "$5")" --no-focus || rc=$?
  if [[ $rc == 0 && -n ${CMUX_ROW_EXISTING:-} ]]; then
    cmux_select "$CMUX_ROW_ID" || { log "$CMUX_ERROR"; return 1; }
  fi
  [[ -z $CMUX_ERROR ]] || log "$CMUX_ERROR"
  return "$rc"
}

case $mode in
  --event)
    # Native notifications bypass notifications.hooks in cmux 0.65. Use the recorded event's identity.
    event=${CMUX_AUTOMATION_EVENT_JSON:-}
    event_name=$(printf '%s' "$event" | jq -er '.name | strings' 2>/dev/null) || { log "missing or invalid event name"; exit 0; }
    [[ $event_name == notification.created ]] || exit 0
    nid=$(printf '%s' "$event" | jq -er '.payload.notification_id | strings' 2>/dev/null) || { log "missing or invalid notification id"; exit 0; }
    ws=$(printf '%s' "$event" | jq -er '.workspace_id | strings' 2>/dev/null) || { log "missing or invalid workspace id"; exit 0; }
    uuid_pattern='^[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}$'
    [[ $nid =~ $uuid_pattern ]] || { log "malformed notification id"; exit 0; }
    [[ $ws =~ $uuid_pattern ]] || { log "malformed workspace id"; exit 0; }
    ws_load || { log "$CMUX_ERROR"; exit 0; }
    row=$(printf '%s' "$WS_JSON" | jq -ec --arg w "$ws" 'first(.workspaces[] | select(.id == $w))' 2>/dev/null) || { log "workspace $ws not found in row list"; exit 0; }
    printf '%s' "$row" | jq -e '.remote.enabled' >/dev/null 2>&1 || exit 0
    printf '%s' "$row" | jq -e '.remote.backend == "cmux-tui"' >/dev/null 2>&1 || { log "workspace $ws remote.backend is not cmux-tui"; exit 0; }
    # Public events redact notification text. Read only the record with the event's ID and row.
    record=$(cmux_notifications 2>/dev/null | jq -ec --arg i "$nid" --arg w "$ws" 'first(.[] | select(.id == $i and .workspace_id == $w))' 2>/dev/null) || { log "notification record $nid not found for workspace $ws"; exit 0; }
    t=$(printf '%s' "$record" | jq -er '.title | strings' 2>/dev/null) || { log "notification record $nid title is not a string"; exit 0; }
    b=$(printf '%s' "$record" | jq -er '.body | strings' 2>/dev/null) || { log "notification record $nid body is not a string"; exit 0; }
    case $t in wt-open|wt-attach|wt-close) ;; *) log "notification record $nid title is not a wt request"; exit 0 ;; esac
    ;;
esac
request_valid() {
  if [[ $t == wt-open && ! -x $CODE ]]; then log "ignored $t: VS Code executable unavailable"; return 1; fi
  valid_host "$h" || { log "ignored $t: invalid host"; return 1; }
  known_host "$h" || { log "ignored $t: unknown SSH host"; return 1; }
  from_row_on_host "$ws" "$h" || { log "ignored $t: sending row does not match host"; return 1; }
  if [[ $t == wt-open ]]; then
    hook_safe_path "$p" || { log "ignored $t: unsafe path"; return 1; }
  else
    hook_safe_path "$r" || { log "ignored $t: unsafe repo path"; return 1; }
    valid_name "$n" || { log "ignored $t: invalid task name"; return 1; }
  fi
}

case $t in
  wt-open)   # body: {"host":…,"path":…}
    h=$(field host || true); p=$(field path || true)
    # -x $CODE first: the fallback above is a hard-coded path. A machine can have no VS Code, or have it
    # installed elsewhere. On such a machine, quieting the row for a window that can never open is the
    # worst of both.
    if request_valid; then
      "$CODE" --folder-uri "vscode-remote://ssh-remote+$h$p/" >/dev/null 2>&1 &
      pid=$!; wg_sleep                      # the code CLI hands the folder to the app and exits 0 well inside
      if kill -0 "$pid" 2>/dev/null; then  # a second, so both "still running" and "exited 0" mean it launched;
        quiet                              # only a non-zero exit is a failure, and that one keeps its banner
      elif wait "$pid"; then
        quiet
      else
        log "$CODE --folder-uri vscode-remote://ssh-remote+$h$p/ failed; no window opened"
      fi
    fi ;;
  wt-attach) # body: {"host":…,"repo":…,"task":…}
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if request_valid; then
      # valid_name, repo_id, row_title and wt_session come from lib/workgrove/common.sh, which wt loads too.
      # attach_row writes the description in the format of row_tag in wt.
      id=$(repo_id "$r")
      # Synchronous on purpose: cmux authorizes the socket by process ancestry. The moment this hook
      # exits, a backgrounded child is reparented away from the cmux tree. The app then refuses that
      # child ("Access denied - only processes started inside cmux can connect"). Creating the row costs
      # ~4 s against the automation rule's 20 s budget in ~/.cmuxterm/automations.json.
      #
      # Dismiss successful requests by ID. Native notifications arrive before the automation runs.
      # The automation cannot suppress delivery effects. Keep diagnostics in $LOG.
      if attach_row "$h" "$(wt_session "$n" "$r")" "$(row_title "$n")" "$id" "$(vm_run_line "$n" "$r")" >/dev/null 2>&1; then
        quiet
      else
        log "ignored wt-attach: could not attach row for workspace $ws"
      fi
    fi ;;
  wt-close) # a VM task removed itself; only its own row may ask to close
    DEADLINE=$(( $(date +%s) + 12 ))   # leave time under cmux's 20 s hook limit to stop tmux after closing
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && hook_safe_path "$r" && valid_name "$n" &&
       from_row_on_host "$ws" "$h"; then
      id=$(repo_id "$r"); sess=$(wt_session "$n" "$r")
      if [[ $(row_by_title "$(row_title "$n")" "$id" "$h") == "$ws" ]]; then
        rc=0; result_rc=0
        declare -A result=()
        vm_result "$h" path result gone gone_error rc -- "$n" -r "$r" || result_rc=$?
        if ! vm_wt_failure "$h" close "$rc" "" "$result_rc" "${result[status]-}" "$n" "$id"; then
          :
        elif ! receiver=$(vm_wt "$h" version 2>/dev/null) || ! printf '%s' "$receiver" | wt_read_version | jq -e '.capabilities | index("teardown-receipts") != null' >/dev/null 2>&1; then
          log "VM teardown receiver lacks receipt support; update workgrove on $h before closing $ws"
        elif ! vm_wt "$h" rm "$n" -r "$r" --defer-close >/dev/null 2>&1; then
          log "recorded VM owner validation failed; kept row $ws"
        elif ! ws_load fresh || ! from_row_on_host "$ws" "$h" || [[ $(row_by_title "$(row_title "$n")" "$id" "$h") != "$ws" ]]; then
          log "relay row identity changed; kept row $ws"
        elif ! remote_row_idle "$ws"; then
          log "relay row ownership prevents closure: $CMUX_ERROR"
        elif close_row "$ws" self >/dev/null 2>&1; then
          # Close first: an open SSH row can reconnect and recreate the tmux session after it is killed.
          DEADLINE=$(( $(date +%s) + 5 ))
          if vm_wt "$h" rm "$n" -r "$r" --row-closed >/dev/null 2>&1; then
            quiet_control
          else
            log "could not stop tmux session $sess on $h after closing $ws"
            if command -v osascript >/dev/null 2>&1; then
              osascript -e 'on run argv' \
                -e 'display notification (item 1 of argv) with title "workgrove teardown incomplete"' \
                -e 'end run' "Run: ssh $h tmux kill-session -t '=$sess'" >/dev/null 2>&1 || true
            fi
          fi
        else log "could not close row $ws for task $n of $id on $h"; fi
      else log "ignored wt-close for a row other than that of task $n of $id on $h"; fi
    else log "ignored invalid wt-close for workspace $ws"; fi ;;
esac
exit 0
