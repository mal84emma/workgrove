#!/usr/bin/env bash
# cmux notification hook. Acts only on wt-open / wt-attach sent from a VM row; otherwise prints nothing (= unchanged).
set -u
in=$(cat)
t=${CMUX_NOTIFICATION_TITLE:-}; b=${CMUX_NOTIFICATION_BODY:-}; ws=${CMUX_NOTIFICATION_WORKSPACE_ID:-}
case $t in wt-open|wt-attach) ;; *) exit 0 ;; esac
known_host() { awk -v w="$1" '$1=="Host"{for(i=2;i<=NF;i++){if($i~/^#/)break; if($i==w && $i!~/[*?]/)f=1}} END{exit(f?0:1)}' "$HOME/.ssh/config" 2>/dev/null; }
quiet() { printf '%s' "$in" | jq -c '.effects.desktop=false | .effects.sound=false | .effects.markUnread=false | .effects.paneFlash=false' 2>/dev/null || true; }
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
CMUX="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
valid_host() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
safe_path() { [[ $1 == /* && $1 != *$'\n'* && $1 != *//* && $1 != */ && $1 != *'/../'* && $1 != */.. && $1 != *[\'\"\`\$\\\;]* ]]; }
field() { printf '%s' "$b" | jq -er --arg k "$1" '.[$k] | strings' 2>/dev/null; }
row_by_title() { # the local row for a VM task; mirrors cmux_row_field <title> <field> <host> in wt
  "$CMUX" workspace list --json 2>/dev/null \
    | jq -er --arg t "$1" --arg h "$2" 'first((.workspaces // .)[] | select(.title == $t and .remote.enabled and (((.remote.destination // "") == $h) or ((.description // "") == "@" + $h))) | .id) // empty' 2>/dev/null; }
from_row_on_host() { # from_row_on_host <workspace uuid> <host> — the notifying row is an SSH row to that host.
  # cmux 0.64 reports CMUX_NOTIFICATION_ORIGIN=local for a `cmux ssh` row's own notifications (only the old
  # mosh-tmux relay said ssh-relay:<uuid>), so the row's remote destination is the check that it came from a VM.
  [[ -n $1 ]] && "$CMUX" workspace list --json 2>/dev/null \
    | jq -e --arg w "$1" --arg h "$2" 'any((.workspaces // .)[]; .id == $w and .remote.enabled and (.remote.destination // "") == $h)' >/dev/null 2>&1; }
tmux_cmd() { # tmux_cmd <session> [command] [shared]
  # The body below mirrors tmux_cmd in bin/wt byte for byte, although the hook only ever needs the task form:
  # diff <(sed -n '/^tmux_cmd()/,/^}/p' bin/wt | grep -v '^ *#') <(sed -n '/^tmux_cmd()/,/^}/p' bin/cmux-hook |
  # grep -v '^ *#') must print nothing. Comments may differ between the two, executable lines may not.
  local run=""
  [[ -n "${2:-}" ]] && printf -v run '%q' "$2; exec bash"
  if [[ "${3:-}" == shared ]]; then
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; tmux attach -t '=%s'" "$1" "$run" "$1"
  else
    printf "tmux new-session -d -s '%s' %s 2>/dev/null; [ -n \"\$CMUX_SOCKET_PATH\" ] || export CMUX_SOCKET_PATH=\"\$(tmux show-environment -t '=%s' CMUX_SOCKET_PATH 2>/dev/null | sed -n 's/^CMUX_SOCKET_PATH=//p')\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] || export CMUX_WORKSPACE_ID=\"\$(tmux show-environment -t '=%s' CMUX_WORKSPACE_ID 2>/dev/null | sed -n 's/^CMUX_WORKSPACE_ID=//p')\"; [ -n \"\$CMUX_SOCKET_PATH\" ] && tmux set-environment -t '=%s' CMUX_SOCKET_PATH \"\$CMUX_SOCKET_PATH\"; [ -n \"\$CMUX_WORKSPACE_ID\" ] && tmux set-environment -t '=%s' CMUX_WORKSPACE_ID \"\$CMUX_WORKSPACE_ID\"; tmux attach -d -t '=%s'" "$1" "$run" "$1" "$1" "$1" "$1" "$1"
  fi
}
attach_row() { # attach_row <host> <session> <title> <command> — bring this task's row forward, or create it
               # first, then write its description (= remote_row in wt: one row per title+host, and an existing
               # row is only selected, never typed into: its pane may hold an agent that would eat the line)
  local out ref line
  ref=$(row_by_title "$3" "$1")
  if [[ -n $ref ]]; then
    "$CMUX" workspace select "$ref" >/dev/null 2>&1
  else
    line=$(tmux_cmd "$2" "$4")
    out=$("$CMUX" ssh "$1" --name "$3" --no-focus --command "$line" 2>&1) || return 0
    ref=$(printf '%s' "$out" | grep -oE 'workspace:[0-9]+' | head -1)
    for _ in 1 2 3; do                     # no workspace:N in the output: the row list lags ~1s behind create
      [[ -n $ref ]] && break
      sleep 1; ref=$(row_by_title "$3" "$1")
    done
  fi
  [[ -n $ref ]] && "$CMUX" workspace-action --workspace "$ref" --action set-description --description "@$1"; }
case $t in
  wt-open)   # body: {"host":…,"path":…}
    h=$(field host || true); p=$(field path || true)
    if valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$p"; then
      "$CODE" --folder-uri "vscode-remote://ssh-remote+$h$p/" >/dev/null 2>&1 & quiet; fi ;;
  wt-attach) # body: {"host":…,"repo":…,"task":…}
    h=$(field host || true); r=$(field repo || true); n=$(field task || true)
    if valid_host "$h" && known_host "$h" && from_row_on_host "$ws" "$h" && safe_path "$r" && [[ $n =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
      id=$(printf '%s' "${r##*/}" | LC_ALL=C tr -c 'A-Za-z0-9-' '-'); printf -v q '%q' "$r"   # mirrors valid_name / repo_id / row_title / wt_session in wt
      # Synchronous on purpose: cmux authorises the socket by process ancestry, and a backgrounded child is
      # reparented away from the cmux tree the moment this hook exits, which the app then refuses
      # ("Access denied - only processes started inside cmux can connect"). Creating the row costs ~4 s
      # against the hook's 20 s budget in cmux.json.
      attach_row "$h" "wt-$id-$n" "$id:$n" "\"\$HOME/.local/bin/wt\" run $n -r $q" >/dev/null 2>&1; quiet; fi ;;
esac
exit 0
