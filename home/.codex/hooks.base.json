{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 3
          }
        ]
      }
    ]
  }
