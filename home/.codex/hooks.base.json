{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NOTIFY_SOURCE=Codex agent-notify",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
