{
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(wt list *)",
      "Bash(wt show *)"
    ],
    "deny": [
      "Bash(git -c *)",
      "Bash(git config *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(git remote add *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo create *)",
      "Bash(gh repo fork *)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/github-guard",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark"
}
