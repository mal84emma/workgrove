#!/usr/bin/env bash
# Serve the recorded cmux contract with optional state and queued responses.
set -euo pipefail
source_path=${BASH_SOURCE[0]}
while [[ -L $source_path ]]; do
  source_dir=$(cd "${source_path%/*}" && pwd -P)
  source_path=$(readlink "$source_path")
  [[ $source_path == /* ]] || source_path=$source_dir/$source_path
done
HERE=$(cd "${source_path%/*}" && pwd -P)
# shellcheck source=test/fakes/rows.sh
source "$HERE/rows.sh"
fixtures=${CMUX_FIXTURES:-$FAKE_CMUX_FIXTURES}
ssh_fixture=$fixtures/ssh.json
[[ -f $ssh_fixture ]] || ssh_fixture=$FAKE_CMUX_SSH_FIXTURE
state=${FAKE_CMUX_STATE:-}
if [[ -n $state ]]; then
  printf '%s\n' "$*" >>"$state/$(if [[ ${0##*/} == cmux-tui && -f $state/native-log ]]; then echo native-calls.log; else echo calls.log; fi)"
fi
apply_effects() {
  if [[ -n $state && -d $state/after/$key ]]; then cp -R "$state/after/$key/." "$state/"; fi
}
screen_append() {
  if [[ $key == read-screen && -f $state/screen-append ]]; then
    if [[ ! -f $state/screen-append-hidden ]]; then cat "$state/screen-append"; fi
    rm "$state/screen-append"
  fi
}
update_rows() {
  local document=$1
  shift
  jq "$@" "$document" >"$document.tmp"
  mv "$document.tmp" "$document"
}
update_row_snapshots() {
  local document
  for document in "$state/rows.json" "$state/rows/"*.json; do
    [[ -f $document ]] || continue
    update_rows "$document" "$@"
  done
}
# Materialize successful SSH replies only when a scenario requests row lifecycle behavior.
materialize_ssh() {
  [[ -n $state && -f $state/materialize-ssh ]] || return 0
  local response=$1 id host=$2 title='' arg previous='' count=0 reset=false delay=0 publish=0 row window
  shift 2
  for arg; do
    [[ $previous != --name ]] || title=$arg
    previous=$arg
  done
  id=$(jq -er '.workspace_id | strings' <<<"$response") || return 0
  mkdir -p "$state/ssh-tasks/$host"
  if [[ -f $state/ssh-tasks/$host/$title ]]; then count=$(cat "$state/ssh-tasks/$host/$title"); fi
  count=$((count + 1)); printf '%s' "$count" >"$state/ssh-tasks/$host/$title"
  if [[ -f $state/ssh-reset-title || ( -f $state/ssh-reset-first-reattach && $count == 2 ) ]]; then reset=true; fi
  if [[ -f $state/ssh-reset-burst ]]; then
    local burst=0
    [[ ! -f $state/burst-count ]] || burst=$(cat "$state/burst-count")
    burst=$((burst + 1)); printf '%s' "$burst" >"$state/burst-count"
    ((burst > 3)) || reset=true
  fi
  if [[ -f $state/ssh-connect-after ]]; then delay=$(cat "$state/ssh-connect-after"); fi
  if [[ -f $state/ssh-publish-after ]]; then publish=$(cat "$state/ssh-publish-after"); fi
  row=$(fake_row "$id" "$title" '' "$host" | jq -c --argjson delay "$delay" --argjson reset "$reset" --argjson publish "$publish" '
    .fake_remaining=$delay | .fake_reset=$reset | .fake_publish_remaining=$publish
    | .fake_remote_title=(if $reset then "workspace-" + .ref[10:] else .title end)
    | .remote.state="connecting" | .remote.remote_workspace_id=null | .remote.active_terminal_sessions=0')
  # shellcheck disable=SC2016  # jq expands its own variables.
  update_rows "$state/rows.json" --argjson row "$row" '.workspaces += [$row]'
  while IFS= read -r window; do
    [[ -f $state/rows/$window.json ]] || continue
    # shellcheck disable=SC2016  # jq expands its own variables.
    update_rows "$state/rows/$window.json" --argjson row "$row" '.workspaces += [$row]'
    break
  done < <(jq -r '.[].id' "$state/windows.json")
}
advance_ssh() {
  [[ -n $state && $key == workspace-list* && -f $state/materialize-ssh ]] || return 0
  # Connection and title publication finish independently. A pending title can fail after terminal projection.
  update_row_snapshots '
    (.workspaces[] | select(has("fake_remaining"))) |= (
      .remote.state="connected"
      | if .fake_remaining > 0 then .fake_remaining -= 1
        else .remote.remote_workspace_id=("remote-" + .id) | .remote.active_terminal_sessions=1
          | if .fake_publish_remaining > 0 then .fake_publish_remaining -= 1
            else if .fake_reset then .title=.fake_remote_title else . end
              | del(.fake_remaining,.fake_reset,.fake_publish_remaining) end end)
    | (.workspaces[] | select(has("fake_rename_remaining"))) |= (
      if .fake_rename_remaining > 0 then .fake_rename_remaining -= 1
      else .title=.fake_rename_title | .fake_remote_title=.fake_rename_title
        | del(.fake_rename_remaining,.fake_rename_title) end)'
}
# Set id and ref to unused identities across all row snapshots.
allocate_row_identity() {
  local identities count
  identities=$(fake_identity_records | jq '[.[] | .id, .ref] | map(select(type == "string"))')
  count=$(cat "$state/next-row" 2>/dev/null || echo 1)
  while :; do
    printf -v id '00000000-0000-4000-8000-%012d' "$count"
    ref=workspace:$count
    if ! jq -e --arg id "$id" --arg ref "$ref" 'index($id) != null or index($ref) != null' <<<"$identities" >/dev/null; then break; fi
    count=$((count + 1))
  done
  fake_ref "$id" "$ref" >/dev/null
  printf '%s\n' "$((count + 1))" >"$state/next-row"
}
unexpected_command() {
  printf 'fake cmux: unexpected command: %s\n' "$*" >&2
  exit 64
}
refresh_windows() {
  local window document index
  while IFS=$'\t' read -r window index; do
    document=$state/rows/$window.json
    [[ -f $document ]] || fake_window_rows "$window" >"$document"
    # shellcheck disable=SC2016  # jq expands the filter variables.
    update_rows "$document" --arg ref "window:$((index + 1))" '.window_ref=$ref'
    # shellcheck disable=SC2016  # jq expands the filter variables.
    update_rows "$state/windows.json" --arg id "$window" --slurpfile rows "$document" '
      (.[] | select(.id == $id)) |= (
        .workspace_count=($rows[0].workspaces | length)
        | .selected_workspace_id as $selected
        | .selected_workspace_id=(if any($rows[0].workspaces[]; .id == $selected)
            then $selected else ($rows[0].workspaces[0].id // null) end))'
  done < <(jq -r '.[] | [.id,.index] | @tsv' "$state/windows.json")
}
[[ $# -gt 0 ]] || unexpected_command
if [[ $1 == --socket ]]; then
  [[ $# -ge 3 ]] || unexpected_command "$@"
  shift 2
fi
# Validate supported argument forms before queues, overrides, or mutations run.
case "$1 ${2:-}" in
  'version '|'capabilities '|'ping ')
    [[ $# == 1 ]] || unexpected_command "$@"
    key=$1; file=$1.json ;;
  '--json agent')
    [[ $# == 6 && $* == '--json agent hook status claude codex' ]] || unexpected_command "$@"
    key=agent-hook-status; file=agent-hook-status.json ;;
  '--json list-windows'|'--json list-notifications')
    [[ $# == 2 ]] || unexpected_command "$@"
    key=$2
    if [[ $2 == list-windows ]]; then file=windows.json; else file=notifications.json; fi ;;
  'workspace list')
    [[ $# == 3 && $3 == --json || $# == 5 && $3 == --json && $4 == --window && -n $5 ]] || unexpected_command "$@"
    key=workspace-list; file=rows.json
    if [[ $# == 5 ]]; then key+=--$5; file=rows/$5.json; fi ;;
  'surface ls')
    [[ $# == 5 && $3 == --json && $4 == --refresh && -n $5 ]] || unexpected_command "$@"
    key=surface-catalog; file=surface-catalog.json ;;
  'top --json'|'top --workspace')
    [[ $# == 2 && $2 == --json || $# == 4 && $2 == --workspace && -n $3 && $4 == --json || $# == 5 && $2 == --workspace && -n $3 && $4 == --processes && $5 == --json ]] || unexpected_command "$@"
    key=top; file=top.json
    if [[ $# -ge 4 && -n $state && -f $state/top/$3.json ]]; then file=top/$3.json; fi ;;
  'workspace create') key=workspace-create; file=create.json ;;
  'workspace close')
    [[ $# == 3 || $# == 4 && $4 == --force ]] || unexpected_command "$@"
    key=workspace-close; file=close.txt ;;
  'workspace select')
    [[ $# == 3 ]] || unexpected_command "$@"
    key=workspace-select; file=select.txt ;;
  'workspace-action --workspace')
    [[ $# == 7 && -n $3 && $4 == --action ]] || unexpected_command "$@"
    target=$3
    case "$5 $6" in
      'set-description --description') key=workspace-action; description=$7 ;;
      'rename --title') key=workspace-rename; title=$7 ;;
      *) unexpected_command "$@" ;;
    esac
    file=$key.json ;;
  'automation show')
    [[ $# == 3 && $3 == wt-native-relay ]] || unexpected_command "$@"
    key=automation; file=automation.json ;;
  'events --after')
    [[ $# == 11 && $* == 'events --after 0 --name notification.created --limit 1 --timeout 3 --no-ack --no-heartbeat' ]] || unexpected_command "$@"
    key=events; file=event.json ;;
  'read-screen --workspace'|'dismiss-notification --id')
    [[ $# == 3 ]] || unexpected_command "$@"
    key=$1; file=$1.json ;;
  'send --workspace'|'send-key --workspace')
    [[ $# == 4 ]] || unexpected_command "$@"
    key=$1; file=$1.json ;;
  'ssh '*)
    key=ssh; file=ssh.json; ssh_uuids=0
    if (($# >= 5)) && [[ ${*: -3:1} == --json && ${*: -2:1} == --id-format && ${*: -1} == uuids ]]; then
      ssh_uuids=1
    fi ;;
  'diff --branch')
    [[ $# == 12 && $3 == --repo && -n $4 && $5 == --base && -n $6 && $7 == --layout && $8 == split && $9 == --title && ${11} == --focus && ${12} == true ]] || unexpected_command "$@"
    key='diff'; file=diff.txt ;;
  'notify '*)
    [[ ${0##*/} == cmux-tui && $# == 7 && $2 == --surface && $3 =~ ^term_[a-f0-9]{32}$ && $4 == --title && $6 == --body ]] || unexpected_command "$@"
    key=notify; file=notify.json ;;
  '--json client')
    [[ ${0##*/} == cmux-tui && $# == 3 && $3 == list ]] || unexpected_command "$@"
    key=client-list; file=clients.json ;;
  *) unexpected_command "$@" ;;
esac
if [[ -n $state ]]; then
  # A queue entry contains stdout, stderr, and an exit status. Consume each entry once.
  if [[ -d $state/queue/$key ]]; then
    for entry in "$state/queue/$key/"*; do
      [[ -d $entry ]] || continue
      if [[ $key == ssh && $(cat "$entry/status") == 0 ]]; then materialize_ssh "$(cat "$entry/stdout")" "$2" "$@"; fi
      cat "$entry/stdout" 2>/dev/null || true
      cat "$entry/stderr" >&2 2>/dev/null || true
      rc=$(cat "$entry/status")
      rm -r "$entry"
      screen_append
      if [[ $rc == 0 ]]; then apply_effects; fi
      exit "$rc"
    done
  fi
  failure=$state/fail/$key
  [[ -f $failure ]] || failure=$state/fail/${key%%--*}
  [[ -f $failure ]] || failure=$state/fail/all
  if [[ -f $failure ]]; then
    { read -r rc; cat >&2; } <"$failure"
    exit "$rc"
  fi
  if [[ $key == workspace-close && ${4:-} != --force && -f $state/close-confirmation ]]; then
    cat "$state/close-confirmation" >&2
    exit 1
  fi
  if [[ $key == top && $# -ge 4 && -f $state/$file ]] &&
      jq -e 'all(.coding_agents[]; .resources.process_count == 0)' "$state/$file" >/dev/null; then
    jq --arg id "$3" '.windows=[{workspaces:[{id:$id,resources:{pids:[],process_count:0}}]}]' "$state/$file"
    apply_effects
    exit 0
  fi
  advance_ssh
  if [[ -f $state/$file && $key != workspace-action && $key != workspace-rename ]]; then
    if [[ $key == ssh ]]; then materialize_ssh "$(cat "$state/$file")" "$2" "$@"; fi
    cat "$state/$file"; screen_append; apply_effects; exit 0
  fi
fi
if [[ -n $state && ( -f $state/mutate || ( -f $state/materialize-ssh && ( $key == workspace-action || $key == workspace-rename ) ) || ( $key == workspace-close && -f $state/mutate-close ) ) ]]; then
  case $key in
    ssh|workspace-create)
      # Local creation keeps its reference. Explicit SSH formatting returns the UUID.
      allocate_row_identity
      host='' title='<title>' description='' cwd=''
      if [[ $key == ssh ]]; then host=$2; fi
      while (($#)); do
        case $1 in
          --name) title=$2; shift ;;
          --description) description=$2; shift ;;
          --cwd) cwd=$2; shift ;;
        esac
        shift
      done
      row=$(fake_row "$id" "$title" "$description" "$host" connected cmux-tui null "$ref" \
        | jq -c --arg cwd "$cwd" '.current_directory=$cwd')
      # shellcheck disable=SC2016  # jq expands the filter variables.
      update_rows "$state/rows.json" --argjson row "$row" '.workspaces += [$row]'
      window=$(jq -r '[.[] | select(.key == true)][0].id // .[0].id // empty' "$state/windows.json")
      if [[ -n $window ]]; then
        document=$state/rows/$window.json
        [[ -f $document ]] || fake_window_rows "$window" >"$document"
        # shellcheck disable=SC2016  # jq expands the filter variables.
        update_rows "$document" --argjson row "$row" '.workspaces += [$row]'
      fi
      refresh_windows
      if [[ $key == ssh && $ssh_uuids == 1 ]]; then
        fake_ssh_response "$id" "$host" "$ssh_fixture"
      else printf '%s\n' "$ref"; fi
      apply_effects
      exit 0 ;;
    workspace-close)
      # shellcheck disable=SC2016  # jq expands the filter variables.
      update_row_snapshots --arg id "$3" '.workspaces |= map(select(.id != $id and .ref != $id))'
      refresh_windows ;;
    workspace-rename)
      delay=0
      [[ ! -f $state/rename-publish-after ]] || delay=$(cat "$state/rename-publish-after")
      # An accepted CLI request can precede daemon publication, including an ineffective remote write.
      # shellcheck disable=SC2016  # jq expands its own variables.
      update_row_snapshots --arg id "$target" --arg title "$title" --argjson delay "$delay" '
        (.workspaces[] | select(.id == $id)) |= (
          del(.fake_remaining,.fake_reset,.fake_publish_remaining)
          | if $delay > 0 then .title=$title | .fake_rename_remaining=$delay | .fake_rename_title=$title
            else .title=$title | .fake_remote_title=$title end)'
      apply_effects
      exit 0 ;;
    workspace-action)
      # shellcheck disable=SC2016  # jq expands the filter variables.
      update_row_snapshots --arg id "$target" --arg description "$description" \
        '(.workspaces[] | select(.id == $id or .ref == $id) | .description)=$description'
      apply_effects
      exit 0 ;;
  esac
fi
case "$key" in
  version)
    if [[ -n ${FAKE_CMUX_VERSION:-} ]]; then printf 'cmux %s\n' "$FAKE_CMUX_VERSION"
    else cat "$fixtures/version.txt"; fi ;;
  capabilities)
    jq --arg method "${FAKE_CMUX_MISSING_METHOD:-}" '.methods -= [$method]' "$fixtures/capabilities.json" ;;
  list-windows|list-notifications|top|automation) cat "$fixtures/$file" ;;
  workspace-list*)
    if [[ -n $state ]]; then
      jq '.workspaces = []' "$fixtures/rows.json"
    elif [[ ${4:-} == --window && -f $fixtures/rows_by_window.json ]]; then
      jq -e --arg window "$5" 'if has($window) then .[$window] else error("unknown fixture window") end' "$fixtures/rows_by_window.json"
    else cat "$fixtures/rows.json"; fi ;;
  surface-catalog)
    fake_surface_catalog "$5" "${state:-$fixtures}/rows.json" ;;
  events) cat "$fixtures/event.json" ;;
  notify)
    : "${state:?notify needs FAKE_CMUX_STATE}"
    title='' body=''
    while (($#)); do
      case $1 in --title) title=$2; shift ;; --body) body=$2; shift ;; esac
      shift
    done
    jq -cn --arg title "$title" --argjson body "$body" '{title:$title,body:$body}' >>"$state/notify.requests.jsonl"
    if [[ -f $state/notify-dedupe && -f $state/last-content && $(cat "$state/last-content") == "$title|$body" ]]; then exit 0; fi
    printf '%s' "$title|$body" >"$state/last-content"
    if [[ -f $state/notify-unmirrored ]]; then exit 0; fi
    tail -n 1 "$state/notify.requests.jsonl" >>"$state/notify.delivered.jsonl"
    if [[ -x $state/notify-callback ]]; then "$state/notify-callback"; fi ;;
  client-list) printf '[]\n' ;;
  ping|diff|workspace-close|workspace-select|workspace-action|workspace-rename|send|send-key|dismiss-notification) ;;
  ssh)
    if ((ssh_uuids)); then
      id=00000000-0000-4000-8000-000000000099
      if [[ -n $state && -f $state/ssh-allocate ]]; then allocate_row_identity; fi
      response=$(fake_ssh_response "$id" "$2" "$ssh_fixture")
      materialize_ssh "$response" "$2" "$@"
      printf '%s\n' "$response"
    else printf 'workspace:99\n'; fi ;;
  workspace-create) printf 'workspace:99\n' ;;
  read-screen) exit 1 ;;
  *) unexpected_command "$@" ;;
esac
apply_effects
